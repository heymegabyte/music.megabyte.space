6.101,"line":89},{"w":"story—let","s":296.101,"e":297.077,"line":89},{"w":"it","s":297.077,"e":297.402,"line":89},{"w":"stand.","s":297.402,"e":297.727,"line":89},{"w":"You","s":297.727,"e":298.053,"line":90},{"w":"don’t","s":298.053,"e":298.378,"line":90},{"w":"have","s":298.378,"e":298.703,"line":90},{"w":"to","s":298.703,"e":299.028,"line":90},{"w":"understand.","s":299.028,"e":300.004,"line":90},{"w":"Whether","s":300.004,"e":300.655,"line":91},{"w":"it’s","s":300.655,"e":300.98,"line":91},{"w":"chance","s":300.98,"e":301.305,"line":91},{"w":"or","s":301.305,"e":301.631,"line":91},{"w":"something","s":301.631,"e":302.606,"line":91},{"w":"more,","s":302.606,"e":302.932,"line":91},{"w":"It","s":302.932,"e":303.257,"line":92},{"w":"doesn’t","s":303.257,"e":303.582,"line":92},{"w":"get","s":303.582,"e":303.907,"line":92},{"w":"to","s":303.907,"e":304.233,"line":92},{"w":"run","s":304.233,"e":304.558,"line":92},{"w":"my","s":304.558,"e":304.883,"line":92},{"w":"world.","s":304.883,"e":305.209,"line":92},{"w":"**[Outro]**","s":305.209,"e":306.109,"line":93},{"w":"Another","s":306.109,"e":307.084,"line":94},{"w":"plate,","s":307.084,"e":307.41,"line":94},{"w":"another","s":307.41,"e":308.385,"line":94},{"w":"phrase—","s":308.385,"e":308.711,"line":94},{"w":"I","s":308.711,"e":309.036,"line":95},{"w":"see","s":309.036,"e":309.361,"line":95},{"w":"it,","s":309.361,"e":309.687,"line":95},{"w":"breathe,","s":309.687,"e":310.012,"line":95},{"w":"and","s":310.012,"e":310.337,"line":95},{"w":"let","s":310.337,"e":310.662,"line":95},{"w":"it","s":310.662,"e":310.988,"line":95},{"w":"fade.","s":310.988,"e":311.313,"line":95},{"w":"No","s":311.313,"e":311.638,"line":96},{"w":"answer","s":311.638,"e":312.289,"line":96},{"w":"owed,","s":312.289,"e":312.939,"line":96},{"w":"no","s":312.939,"e":313.264,"line":96},{"w":"code","s":313.264,"e":313.59,"line":96},{"w":"to","s":313.59,"e":313.915,"line":96},{"w":"crack.","s":313.915,"e":314.24,"line":96},{"w":"I","s":314.24,"e":314.566,"line":97},{"w":"keep","s":314.566,"e":314.891,"line":97},{"w":"my","s":314.891,"e":315.216,"line":97},{"w":"peace.","s":315.216,"e":315.541,"line":97},{"w":"I","s":315.541,"e":315.867,"line":97},{"w":"take","s":315.867,"e":316.192,"line":97},{"w":"it","s":316.192,"e":316.517,"line":97},{"w":"back.","s":316.517,"e":316.842,"line":97},{"w":"The","s":316.842,"e":317.168,"line":98},{"w":"light","s":317.168,"e":317.493,"line":98},{"w":"said,","s":317.493,"e":317.818,"line":98},{"w":"**“Go","s":317.818,"e":318.143,"line":98},{"w":"and","s":318.143,"e":318.469,"line":98},{"w":"tell","s":318.469,"e":318.794,"line":98},{"w":"your","s":318.794,"e":319.119,"line":98},{"w":"story.”**","s":319.119,"e":319.77,"line":98},{"w":"So","s":319.77,"e":320.095,"line":99},{"w":"I","s":320.095,"e":320.42,"line":99},{"w":"told","s":320.42,"e":320.746,"line":99},{"w":"it—this","s":320.746,"e":321.396,"line":99},{"w":"is","s":321.396,"e":321.721,"line":99},{"w":"mine.","s":321.721,"e":322.047,"line":99},{"w":"But","s":322.047,"e":322.372,"line":100},{"w":"I","s":322.372,"e":322.697,"line":100},{"w":"won’t","s":322.697,"e":323.022,"line":100},{"w":"let","s":323.022,"e":323.348,"line":100},{"w":"every","s":323.348,"e":324.324,"line":100},{"w":"coincidence","s":324.324,"e":325.299,"line":100},{"w":"Control","s":324.93,"e":325.01,"line":101},{"w":"my","s":324.93,"e":325.01,"line":101},{"w":"life","s":324.93,"e":325.01,"line":101},{"w":"or","s":324.93,"e":325.01,"line":101},{"w":"time.","s":324.93,"e":325.01,"line":101}],"lines":[{"s":3.24,"e":5.517,"text":"# **Coincidence Overload**"},{"s":5.517,"e":6.417,"text":"**[Intro]**"},{"s":6.417,"e":11.946,"text":"Another plate, another phrase, another perfectly placed sign,"},{"s":11.946,"e":15.85,"text":"Maybe it means nothing—but it keeps invading mine."},{"s":15.85,"e":21.054,"text":"I’m tired of decoding every number, every noise,"},{"s":21.054,"e":24.957,"text":"Trying to find silence while the static finds a voice."},{"s":24.957,"e":25.857,"text":"**[Verse 1]**"},{"s":25.857,"e":28.134,"text":"“WTC2001” rolling right beside me,"},{"s":28.134,"e":33.013,"text":"History in the mirror like the past came back to find me."},{"s":33.013,"e":37.242,"text":"Then “SUP FOOL” flashes while I’m fighting for my focus,"},{"s":37.242,"e":42.121,"text":"Cheap chrome letters somehow feeling cold and overbearing."},{"s":42.121,"e":46.674,"text":"Every streetlight switches when I step beneath the glow,"},{"s":46.674,"e":51.553,"text":"Every shuffled song says something I already know."},{"s":51.553,"e":54.806,"text":"Maybe random rhythm, maybe stress inside my sight,"},{"s":54.806,"e":59.034,"text":"But coincidence gets cruel when it follows me all night."},{"s":59.034,"e":60.01,"text":"**[Pre-Chorus]**"},{"s":60.01,"e":61.311,"text":"One time—strange."},{"s":61.311,"e":62.612,"text":"Two times—tense."},{"s":62.612,"e":65.215,"text":"Ten times daily doesn’t make sense."},{"s":65.215,"e":68.793,"text":"I don’t need a message, I don’t need a sign—"},{"s":68.793,"e":72.696,"text":"I need the world to quit colliding with my mind."},{"s":72.696,"e":73.596,"text":"**[Chorus]**"},{"s":73.596,"e":76.523,"text":"I’m sick of all the coincidences,"},{"s":76.523,"e":79.125,"text":"The numbers and the sentences,"},{"s":79.125,"e":81.727,"text":"The timing so ridiculous,"},{"s":81.727,"e":84.33,"text":"The unwanted significance."},{"s":84.33,"e":86.932,"text":"Quit crowding every quiet thought,"},{"s":86.932,"e":89.859,"text":"Quit making every moment talk."},{"s":89.859,"e":92.461,"text":"Whether it’s fate or random noise,"},{"s":92.461,"e":95.714,"text":"I’m sick of feeling like I’ve got no choice."},{"s":95.714,"e":96.614,"text":"**[Verse 2]**"},{"s":96.614,"e":100.517,"text":"Then I saw a light that read, **“Go tell your story,”**"},{"s":100.517,"e":104.095,"text":"Like the night itself was pointing toward me."},{"s":104.095,"e":108.649,"text":"So I tried to speak plainly, tried explaining what I’d seen,"},{"s":108.649,"e":112.877,"text":"But nobody wanted any part of what I mean."},{"s":112.877,"e":117.106,"text":"For the life of them, they wouldn’t hear a single sentence,"},{"s":117.106,"e":122.961,"text":"Every question met with distance, every detail met resistance."},{"s":122.961,"e":127.514,"text":"They said, “Let it go,” before I finished telling why—"},{"s":127.514,"e":132.719,"text":"But how can there be this many things all perfectly aligned?"},{"s":132.719,"e":137.272,"text":"A billboard answers questions that I never said aloud,"},{"s":137.272,"e":141.826,"text":"A stranger drops a phrase that cuts directly through the crowd."},{"s":141.826,"e":147.03,"text":"A notification lands exactly when my fear is raised,"},{"s":147.03,"e":152.885,"text":"And suddenly the ordinary feels deliberately staged."},{"s":152.885,"e":153.861,"text":"**[Pre-Chorus]**"},{"s":153.861,"e":154.837,"text":"Why this phrase?"},{"s":154.837,"e":155.813,"text":"Why this date?"},{"s":155.813,"e":160.366,"text":"Why does everything arrive too perfectly placed?"},{"s":160.366,"e":164.595,"text":"Maybe my mind is searching for a reason or design,"},{"s":164.595,"e":169.474,"text":"But I’m exhausted by the feeling that the timing isn’t mine."},{"s":169.474,"e":170.374,"text":"**[Chorus]**"},{"s":170.374,"e":173.301,"text":"I’m sick of all the coincidences,"},{"s":173.301,"e":175.904,"text":"The synchronized specifics,"},{"s":175.904,"e":178.831,"text":"The constant near-impossibleness,"},{"s":178.831,"e":181.758,"text":"The cold, coordinated incidents."},{"s":181.758,"e":184.36,"text":"Quit crowding every quiet thought,"},{"s":184.36,"e":187.288,"text":"Quit making every moment talk."},{"s":187.288,"e":189.89,"text":"Whether it’s fate or random noise,"},{"s":189.89,"e":193.143,"text":"I’m sick of feeling like I’ve got no choice."},{"s":193.143,"e":194.043,"text":"**[Verse 3]**"},{"s":194.043,"e":198.922,"text":"It feels like they would need time travel on an obscene level,"},{"s":198.922,"e":204.126,"text":"An abomination engine with its foot upon the pedal."},{"s":204.126,"e":208.68,"text":"Rearranging roads and radios, the license plates and lights,"},{"s":208.68,"e":213.559,"text":"Planting phrases in the daytime that return to me at night."},{"s":213.559,"e":218.438,"text":"Like some future reached backward just to bend the present tense,"},{"s":218.438,"e":223.642,"text":"Breaking every boundary of mercy, nature, consequence."},{"s":223.642,"e":229.172,"text":"And if reality were twisted with that much deliberate detail,"},{"s":229.172,"e":234.051,"text":"I could understand the terror that this life itself was hell."},{"s":234.051,"e":238.604,"text":"Not fire underneath me, not a horned and hidden beast—"},{"s":238.604,"e":243.158,"text":"Just patterns without privacy and pressure without peace."},{"s":243.158,"e":248.037,"text":"A world where every object seems recruited for a role,"},{"s":248.037,"e":252.266,"text":"Till the smallest coincidence can swallow someone whole."},{"s":252.266,"e":253.166,"text":"**[Bridge]**"},{"s":253.166,"e":256.093,"text":"But I don’t know who arranged it."},{"s":256.093,"e":258.695,"text":"I don’t know that it was planned."},{"s":258.695,"e":261.297,"text":"I only know the weight I feel"},{"s":261.297,"e":263.249,"text":"When patterns start to land."},{"s":263.249,"e":266.176,"text":"I don’t have to solve the timeline."},{"s":266.176,"e":268.453,"text":"I don’t have to crack the code."},{"s":268.453,"e":271.055,"text":"I can tell my honest story"},{"s":271.055,"e":273.332,"text":"Without carrying the whole load."},{"s":273.332,"e":275.609,"text":"Let the plate remain a plate."},{"s":275.609,"e":277.886,"text":"Let the light remain a light."},{"s":277.886,"e":280.163,"text":"I can feel how strange it felt"},{"s":280.163,"e":282.765,"text":"Without surrendering the night."},{"s":282.765,"e":284.066,"text":"**[Final Chorus]**"},{"s":284.066,"e":286.994,"text":"I’m sick of all the coincidences,"},{"s":286.994,"e":289.596,"text":"The unwanted significance,"},{"s":289.596,"e":292.198,"text":"The timing so ridiculous,"},{"s":292.198,"e":295.125,"text":"The endless repetition of it."},{"s":295.125,"e":297.727,"text":"I told my story—let it stand."},{"s":297.727,"e":300.004,"text":"You don’t have to understand."},{"s":300.004,"e":302.932,"text":"Whether it’s chance or something more,"},{"s":302.932,"e":305.209,"text":"It doesn’t get to run my world."},{"s":305.209,"e":306.109,"text":"**[Outro]**"},{"s":306.109,"e":308.711,"text":"Another plate, another phrase—"},{"s":308.711,"e":311.313,"text":"I see it, breathe, and let it fade."},{"s":311.313,"e":314.24,"text":"No answer owed, no code to crack."},{"s":314.24,"e":316.842,"text":"I keep my peace. I take it back."},{"s":316.842,"e":319.77,"text":"The light said, **“Go and tell your story.”**"},{"s":319.77,"e":322.047,"text":"So I told it—this is mine."},{"s":322.047,"e":325.299,"text":"But I won’t let every coincidence"},{"s":324.93,"e":325.01,"text":"Control my life or time."}],"duration":328.64,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.112Z","realignedFrom":"whisper-aligned","vocalStart":3.24,"vocalEnd":324.93}