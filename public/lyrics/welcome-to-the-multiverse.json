237.94,"e":238.66,"line":110},{"w":"Maybe","s":238.82,"e":239.14,"line":111},{"w":"every","s":239.14,"e":239.74,"line":111},{"w":"world","s":239.74,"e":240.18,"line":111},{"w":"gets","s":240.18,"e":240.5,"line":111},{"w":"better","s":240.5,"e":241,"line":111},{"w":"when","s":241,"e":241.28,"line":112},{"w":"somebody","s":241.28,"e":241.92,"line":112},{"w":"volunteers","s":241.92,"e":242.64,"line":112},{"w":"to","s":242.64,"e":243.06,"line":112},{"w":"take","s":243.06,"e":243.52,"line":112},{"w":"the","s":243.52,"e":243.8,"line":112},{"w":"loss.","s":243.8,"e":244.34,"line":112},{"w":"Us","s":244.38,"e":244.62,"line":113},{"w":"first.","s":244.62,"e":245,"line":113},{"w":"Love","s":245.06,"e":245.5,"line":113},{"w":"first.","s":245.5,"e":245.88,"line":113},{"w":"Let","s":246.02,"e":246.1,"line":114},{"w":"the","s":246.08,"e":246.26,"line":114},{"w":"old","s":246.26,"e":246.42,"line":114},{"w":"timeline","s":246.42,"e":247.26,"line":114},{"w":"burst.","s":247.26,"e":247.6,"line":114},{"w":"Maybe","s":247.76,"e":247.96,"line":115},{"w":"heaven","s":247.96,"e":248.3,"line":115},{"w":"starts","s":248.3,"e":248.64,"line":115},{"w":"happening","s":248.64,"e":249.08,"line":115},{"w":"when","s":249.08,"e":249.5,"line":116},{"w":"we","s":249.5,"e":249.72,"line":116},{"w":"reverse","s":249.72,"e":250.52,"line":116},{"w":"the","s":250.52,"e":250.9,"line":116},{"w":"curse.","s":250.9,"e":251.54,"line":116},{"w":"Not","s":251.56,"e":251.94,"line":117},{"w":"with","s":251.94,"e":252.18,"line":117},{"w":"gods.","s":252.18,"e":252.64,"line":117},{"w":"Not","s":252.76,"e":252.84,"line":118},{"w":"with","s":252.84,"e":253.6,"line":118},{"w":"time","s":253.6,"e":253.74,"line":118},{"w":"machines.","s":253.74,"e":254.38,"line":118},{"w":"With","s":254.68,"e":254.8,"line":119},{"w":"somebody","s":254.8,"e":255.32,"line":119},{"w":"finally","s":255.32,"e":256.14,"line":119},{"w":"saying—","s":256.14,"e":256.58,"line":119},{"w":"**“I’ll","s":256.82,"e":257.02,"line":120},{"w":"fix","s":257.22,"e":257.3,"line":120},{"w":"it","s":257.28,"e":257.68,"line":120},{"w":"even","s":257.68,"e":257.94,"line":120},{"w":"if","s":257.94,"e":258.2,"line":120},{"w":"it","s":258.2,"e":258.72,"line":120},{"w":"hurts","s":258.72,"e":258.8,"line":120},{"w":"me.”**","s":258.72,"e":259.24,"line":120},{"w":"The","s":260.6,"e":261.08,"line":122},{"w":"future","s":261.08,"e":261.42,"line":122},{"w":"wasn’t","s":261.42,"e":261.65,"line":122},{"w":"doomed.","s":261.88,"e":262.42,"line":122},{"w":"It","s":263.24,"e":263.54,"line":123},{"w":"was","s":263.54,"e":263.68,"line":123},{"w":"waiting","s":263.68,"e":264.12,"line":123},{"w":"for","s":264.12,"e":264.58,"line":124},{"w":"somebody","s":264.58,"e":265.5,"line":124},{"w":"to","s":265.5,"e":265.93,"line":125},{"w":"stop","s":266.36,"e":266.86,"line":125},{"w":"asking:","s":266.86,"e":268,"line":125},{"w":"**“What’s","s":271.56,"e":271.96,"line":126},{"w":"in","s":272.36,"e":272.44,"line":126},{"w":"it","s":272.44,"e":272.56,"line":126},{"w":"for","s":272.56,"e":272.72,"line":126},{"w":"me?”**","s":272.72,"e":272.9,"line":126}],"lines":[{"s":0,"e":0.5,"text":"**[Intro — Bare Piano, Male Voice]**"},{"s":1.98,"e":4,"text":"They found the fracture."},{"s":3.92,"e":8.3,"text":"They knew where it started."},{"s":9.04,"e":11.28,"text":"They knew how to fix it."},{"s":11.28,"e":13.66,"text":"They just asked one question:"},{"s":17.16,"e":18.82,"text":"“What does fixing it cost *me*?”"},{"s":18.82,"e":19.32,"text":"**[Verse 1 — Male Rap-Singing]**"},{"s":32.24,"e":34.48,"text":"Time bent backward, files came through,"},{"s":34.58,"e":36.26,"text":"future sent warnings with receipts and proof."},{"s":36.34,"e":37.98,"text":"Names, dates, damage, every domino mapped,"},{"s":38.06,"e":39.82,"text":"every little choice and where the timeline cracked."},{"s":40.18,"e":41.64,"text":"Decision-makers sitting with tomorrow on screen,"},{"s":41.64,"e":43.48,"text":"watching whole worlds turn cruel and obscene."},{"s":43.48,"e":45.14,"text":"Could’ve changed one choice, could’ve closed one door,"},{"s":45.14,"e":46.9,"text":"but somebody might lose what they already scored."},{"s":46.94,"e":48.74,"text":"So they weighed one life against leverage and rank,"},{"s":48.8,"e":50.62,"text":"one city against somebody’s money in the bank."},{"s":50.62,"e":52.28,"text":"One generation versus one comfortable chair—"},{"s":52.45,"e":54.12,"text":"then called doing nothing “being measured and fair.”"},{"s":54.48,"e":55.98,"text":"Everybody knew. Nobody moved."},{"s":56.18,"e":57.64,"text":"Everybody had something personal to lose."},{"s":57.68,"e":59.46,"text":"So the future kept screaming through holes in the past,"},{"s":59.5,"e":61.42,"text":"while the people with power kept protecting their ass."},{"s":61.42,"e":61.92,"text":"**[Pre-Chorus — Female Vocal]**"},{"s":61.42,"e":63.26,"text":"One said, “Not my family.”"},{"s":63.26,"e":65.06,"text":"One said, “Not my fight.”"},{"s":65.06,"e":68.64,"text":"One said, “Fixing this could ruin my life.”"},{"s":68.66,"e":71.58,"text":"One by one, they protected their side—"},{"s":71.6,"e":75.1,"text":"and built a universe where nobody survives right."},{"s":75.1,"e":75.6,"text":"**[Chorus — Huge]**"},{"s":75.4,"e":76.98,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":77.14,"e":78.62,"text":"everybody saving themselves."},{"s":78.96,"e":80.18,"text":"Everybody knows what’s broken,"},{"s":80.48,"e":82.56,"text":"everybody leaves it for somebody else."},{"s":82.56,"e":84.14,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":84.1,"e":86.34,"text":"where conscience comes second to cost."},{"s":86.4,"e":87.66,"text":"Every world could’ve been better,"},{"s":87.74,"e":90.72,"text":"but nobody wanted to personally take the loss."},{"s":90.84,"e":92.3,"text":"Me first. Mine first."},{"s":92.34,"e":94.1,"text":"Let the next timeline hurt."},{"s":94.16,"e":95.3,"text":"That’s how heaven turns hell"},{"s":95.32,"e":98.26,"text":"without anybody doing the worst."},{"s":98.26,"e":101.56,"text":"Just millions doing nothing"},{"s":101.78,"e":104.78,"text":"when doing something might hurt."},{"s":104.78,"e":105.28,"text":"**[Verse 2 — Male Rap]**"},{"s":104.92,"e":106.48,"text":"Branch after branch, the disease gets deep,"},{"s":106.5,"e":108.26,"text":"promises cheap and the consequences steep."},{"s":108.36,"e":110.08,"text":"Every timeline inherits the cowardice before it,"},{"s":110.08,"e":112.2,"text":"then teaches the next generation to ignore it."},{"s":112.2,"e":113.64,"text":"Politician sees truth but election comes first."},{"s":113.82,"e":115.4,"text":"Executive sees harm but the quarter looks worse."},{"s":115.6,"e":117.2,"text":"Scientist sees danger but the funding might vanish."},{"s":117.3,"e":119.2,"text":"Judge knows the wound but says, “Not my jurisdiction to manage.”"},{"s":119.3,"e":120.76,"text":"Neighbor hears screaming, turns television loud."},{"s":120.9,"e":122.56,"text":"Whole damn planet learns to disappear in a crowd."},{"s":122.6,"e":124,"text":"Nobody wakes up planning evil at dawn—"},{"s":123.92,"e":126.14,"text":"they just protect their little piece while the whole thing goes wrong."},{"s":126.3,"e":127.96,"text":"That’s the terrifying part, that’s the twist in the knife:"},{"s":128.14,"e":129.82,"text":"hell doesn’t always need monsters destroying your life."},{"s":129.84,"e":131.52,"text":"Sometimes hell is reasonable people who knew,"},{"s":131.52,"e":133.26,"text":"saying, “Yes, this is awful… but what can **I** do?”"},{"s":133.26,"e":133.76,"text":"**[Pre-Chorus — Female Vocal]**"},{"s":133.26,"e":134.86,"text":"One said, “Not my money.”"},{"s":134.86,"e":136.64,"text":"One said, “Not my name.”"},{"s":136.64,"e":139.94,"text":"One said, “Someone else can carry the blame.”"},{"s":139.98,"e":143.72,"text":"Till every branch of reality learned the same game—"},{"s":143.96,"e":146.96,"text":"save yourself first, let tomorrow burn in flames."},{"s":146.88,"e":147.38,"text":"**[Chorus]**"},{"s":146.96,"e":148.54,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":148.68,"e":150.18,"text":"everybody saving themselves."},{"s":150.58,"e":151.62,"text":"Everybody knows what’s broken,"},{"s":151.82,"e":154.1,"text":"everybody leaves it for somebody else."},{"s":154.1,"e":155.6,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":155.7,"e":157.9,"text":"where conscience comes second to cost."},{"s":157.9,"e":159.22,"text":"Every world could’ve been better,"},{"s":159.26,"e":162.34,"text":"but nobody wanted to personally take the loss."},{"s":162.34,"e":163.8,"text":"Me first. Mine first."},{"s":163.92,"e":165.58,"text":"Let the next timeline hurt."},{"s":165.66,"e":166.8,"text":"That’s how heaven turns hell"},{"s":166.8,"e":169.48,"text":"without anybody doing the worst."},{"s":169.48,"e":169.98,"text":"**[Bridge — Piano Only, Female Vocal]**"},{"s":169.88,"e":172.84,"text":"But somewhere there has to be"},{"s":173.28,"e":176.38,"text":"one branch that breaks the chain."},{"s":176.38,"e":179.88,"text":"One person who sees tomorrow"},{"s":180.2,"e":183.72,"text":"and chooses somebody else’s pain."},{"s":184.2,"e":186.78,"text":"One hand that signs the paper."},{"s":187.66,"e":190.62,"text":"One voice that tells the truth."},{"s":191.16,"e":194.54,"text":"One soul willing to lose something"},{"s":194.68,"e":197.66,"text":"so strangers don’t have to lose."},{"s":197.64,"e":198.14,"text":"**[Male Rap — Building]**"},{"s":197.66,"e":199.8,"text":"So send me every timeline, let me study every scar,"},{"s":200.04,"e":201.56,"text":"show me where we traded human hearts for who we are."},{"s":201.62,"e":203.38,"text":"You don’t need to save infinity in one heroic night—"},{"s":203.38,"e":205.16,"text":"you just stop making selfishness the price of doing right."},{"s":205.2,"e":206.04,"text":"Maybe courage costs comfort."},{"s":206.12,"e":206.9,"text":"Maybe mercy costs pride."},{"s":206.98,"e":208.88,"text":"Maybe fixing what’s broken means you lose on your side."},{"s":209.74,"e":210.14,"text":"Fine."},{"s":211.16,"e":211.6,"text":"Take the title."},{"s":211.6,"e":212.42,"text":"Take the table."},{"s":212.5,"e":213.36,"text":"Take the treasure."},{"s":214.3,"e":215.16,"text":"Take the throne."},{"s":215.2,"e":217.28,"text":"If my comfort needs your suffering—"},{"s":217.7,"e":221.72,"text":"**I don’t want my comfort anymore.**"},{"s":221.72,"e":222.22,"text":"**[Final Chorus — Massive]**"},{"s":221.72,"e":222.515,"text":"**CHANGE THE MULTIVERSE,**"},{"s":222.78,"e":226.32,"text":"somebody finally goes first."},{"s":226.32,"e":229.92,"text":"Somebody sees what’s broken"},{"s":230.74,"e":233.56,"text":"and decides their loss is worth it."},{"s":233.56,"e":234.76,"text":"**CHANGE THE MULTIVERSE,**"},{"s":235.16,"e":238.66,"text":"make conscience bigger than cost."},{"s":238.82,"e":241,"text":"Maybe every world gets better"},{"s":241,"e":244.34,"text":"when somebody volunteers to take the loss."},{"s":244.38,"e":245.88,"text":"Us first. Love first."},{"s":246.02,"e":247.6,"text":"Let the old timeline burst."},{"s":247.76,"e":249.08,"text":"Maybe heaven starts happening"},{"s":249.08,"e":251.54,"text":"when we reverse the curse."},{"s":251.56,"e":252.64,"text":"Not with gods."},{"s":252.76,"e":254.38,"text":"Not with time machines."},{"s":254.68,"e":256.58,"text":"With somebody finally saying—"},{"s":256.82,"e":259.24,"text":"**“I’ll fix it even if it hurts me.”**"},{"s":259.24,"e":259.74,"text":"**[Outro — Bare Piano]**"},{"s":260.6,"e":262.42,"text":"The future wasn’t doomed."},{"s":263.24,"e":264.12,"text":"It was waiting"},{"s":264.12,"e":265.5,"text":"for somebody"},{"s":265.5,"e":268,"text":"to stop asking:"},{"s":271.56,"e":272.9,"text":"**“What’s in it for me?”**"}],"duration":274.6,"source":"whisper-aligned","generatedAt":"2026-08-21T03:45:08.149Z","stats":{"whisperWords":711,"polishedWords":705,"matched":643,"matchRate":0.912}}