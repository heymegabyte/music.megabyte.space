"w":"the","s":232.4,"e":232.652,"line":95},{"w":"title.","s":232.652,"e":233.156,"line":95},{"w":"Take","s":233.156,"e":233.407,"line":96},{"w":"the","s":233.407,"e":233.659,"line":96},{"w":"table.","s":233.659,"e":234.163,"line":96},{"w":"Take","s":234.163,"e":234.414,"line":97},{"w":"the","s":234.414,"e":234.666,"line":97},{"w":"treasure.","s":234.666,"e":235.17,"line":97},{"w":"Take","s":235.17,"e":235.47,"line":98},{"w":"the","s":235.47,"e":235.77,"line":98},{"w":"throne.","s":235.77,"e":236.07,"line":98},{"w":"If","s":236.07,"e":236.322,"line":99},{"w":"my","s":236.322,"e":236.573,"line":99},{"w":"comfort","s":236.573,"e":237.077,"line":99},{"w":"needs","s":237.077,"e":237.329,"line":99},{"w":"your","s":237.329,"e":237.581,"line":99},{"w":"suffering—","s":237.581,"e":238.336,"line":99},{"w":"**I","s":238.336,"e":238.588,"line":100},{"w":"don’t","s":238.588,"e":238.839,"line":100},{"w":"want","s":238.839,"e":239.091,"line":100},{"w":"my","s":239.091,"e":239.343,"line":100},{"w":"comfort","s":239.343,"e":239.847,"line":100},{"w":"anymore.**","s":239.847,"e":240.602,"line":100},{"w":"somebody","s":240.602,"e":241.609,"line":101},{"w":"finally","s":241.609,"e":242.364,"line":101},{"w":"goes","s":242.364,"e":242.616,"line":101},{"w":"first.","s":242.616,"e":242.868,"line":101},{"w":"Somebody","s":242.868,"e":243.875,"line":102},{"w":"sees","s":243.875,"e":244.127,"line":102},{"w":"what’s","s":244.127,"e":244.379,"line":102},{"w":"broken","s":244.379,"e":244.882,"line":102},{"w":"and","s":244.882,"e":245.134,"line":103},{"w":"decides","s":245.134,"e":245.889,"line":103},{"w":"their","s":245.889,"e":246.141,"line":103},{"w":"loss","s":246.141,"e":246.393,"line":103},{"w":"is","s":246.393,"e":246.645,"line":103},{"w":"worth","s":246.645,"e":246.897,"line":103},{"w":"it.","s":246.897,"e":247.148,"line":103},{"w":"**CHANGE","s":247.148,"e":247.4,"line":104},{"w":"THE","s":247.4,"e":247.652,"line":104},{"w":"MULTIVERSE,**","s":247.652,"e":248.407,"line":104},{"w":"make","s":248.407,"e":248.659,"line":105},{"w":"conscience","s":248.659,"e":249.163,"line":105},{"w":"bigger","s":249.163,"e":249.666,"line":105},{"w":"than","s":249.666,"e":249.918,"line":105},{"w":"cost.","s":249.918,"e":250.17,"line":105},{"w":"Maybe","s":250.17,"e":250.422,"line":106},{"w":"every","s":250.422,"e":251.177,"line":106},{"w":"world","s":251.177,"e":251.429,"line":106},{"w":"gets","s":251.429,"e":251.68,"line":106},{"w":"better","s":251.68,"e":252.184,"line":106},{"w":"when","s":252.184,"e":252.436,"line":107},{"w":"somebody","s":252.436,"e":253.443,"line":107},{"w":"volunteers","s":253.443,"e":254.198,"line":107},{"w":"to","s":254.198,"e":254.45,"line":107},{"w":"take","s":254.45,"e":254.702,"line":107},{"w":"the","s":254.702,"e":254.954,"line":107},{"w":"loss.","s":254.954,"e":255.205,"line":107},{"w":"Us","s":255.205,"e":255.457,"line":108},{"w":"first.","s":255.457,"e":255.709,"line":108},{"w":"Love","s":255.709,"e":255.961,"line":108},{"w":"first.","s":255.961,"e":256.213,"line":108},{"w":"Let","s":256.213,"e":256.464,"line":109},{"w":"the","s":256.464,"e":256.716,"line":109},{"w":"old","s":256.716,"e":256.968,"line":109},{"w":"timeline","s":256.968,"e":257.723,"line":109},{"w":"burst.","s":257.723,"e":257.975,"line":109},{"w":"Maybe","s":257.975,"e":258.227,"line":110},{"w":"heaven","s":258.227,"e":258.73,"line":110},{"w":"starts","s":258.73,"e":258.982,"line":110},{"w":"happening","s":258.982,"e":259.738,"line":110},{"w":"when","s":259.738,"e":259.989,"line":111},{"w":"we","s":259.989,"e":260.241,"line":111},{"w":"reverse","s":260.241,"e":260.745,"line":111},{"w":"the","s":260.745,"e":260.997,"line":111},{"w":"curse.","s":260.997,"e":261.248,"line":111},{"w":"Not","s":261.248,"e":261.548,"line":112},{"w":"with","s":261.548,"e":261.848,"line":112},{"w":"gods.","s":261.848,"e":262.148,"line":112},{"w":"Not","s":262.148,"e":262.4,"line":113},{"w":"with","s":262.4,"e":262.652,"line":113},{"w":"time","s":262.652,"e":262.904,"line":113},{"w":"machines.","s":262.904,"e":263.659,"line":113},{"w":"With","s":263.659,"e":263.911,"line":114},{"w":"somebody","s":263.911,"e":264.918,"line":114},{"w":"finally","s":264.918,"e":265.673,"line":114},{"w":"saying—","s":265.673,"e":265.925,"line":114},{"w":"**“I’ll","s":265.925,"e":266.177,"line":115},{"w":"fix","s":266.177,"e":266.429,"line":115},{"w":"it","s":266.429,"e":266.68,"line":115},{"w":"even","s":266.68,"e":267.184,"line":115},{"w":"if","s":267.184,"e":267.436,"line":115},{"w":"it","s":267.436,"e":267.688,"line":115},{"w":"hurts","s":267.688,"e":267.939,"line":115},{"w":"me.”**","s":267.939,"e":268.191,"line":115},{"w":"The","s":268.191,"e":268.443,"line":116},{"w":"future","s":268.443,"e":268.946,"line":116},{"w":"wasn’t","s":268.946,"e":269.198,"line":116},{"w":"doomed.","s":269.198,"e":269.702,"line":116},{"w":"It","s":269.702,"e":269.954,"line":117},{"w":"was","s":269.954,"e":270.205,"line":117},{"w":"waiting","s":270.205,"e":270.709,"line":117},{"w":"for","s":270.709,"e":270.961,"line":118},{"w":"somebody","s":270.961,"e":271.968,"line":118},{"w":"to","s":271.968,"e":272.22,"line":119},{"w":"stop","s":272.22,"e":272.471,"line":119},{"w":"asking:","s":272.471,"e":272.975,"line":119},{"w":"**“What’s","s":272.9,"e":272.98,"line":120},{"w":"in","s":272.9,"e":272.98,"line":120},{"w":"it","s":272.9,"e":272.98,"line":120},{"w":"for","s":272.9,"e":272.98,"line":120},{"w":"me?”**","s":272.9,"e":272.98,"line":120}],"lines":[{"s":1.98,"e":3.994,"text":"**[Intro — Bare Piano, Male Voice]**"},{"s":3.994,"e":5.253,"text":"They found the fracture."},{"s":5.253,"e":6.764,"text":"They knew where it started."},{"s":6.764,"e":8.275,"text":"They knew how to fix it."},{"s":8.275,"e":10.037,"text":"They just asked one question:"},{"s":10.037,"e":11.8,"text":"“What does fixing it cost *me*?”"},{"s":11.8,"e":14.317,"text":"future sent warnings with receipts and proof."},{"s":14.317,"e":17.842,"text":"Names, dates, damage, every domino mapped,"},{"s":17.842,"e":21.367,"text":"every little choice and where the timeline cracked."},{"s":21.367,"e":24.641,"text":"Decision-makers sitting with tomorrow on screen,"},{"s":24.641,"e":26.907,"text":"watching whole worlds turn cruel and obscene."},{"s":26.907,"e":29.424,"text":"Could’ve changed one choice, could’ve closed one door,"},{"s":29.424,"e":32.949,"text":"but somebody might lose what they already scored."},{"s":32.949,"e":36.223,"text":"So they weighed one life against leverage and rank,"},{"s":36.223,"e":39.748,"text":"one city against somebody’s money in the bank."},{"s":39.748,"e":43.021,"text":"One generation versus one comfortable chair—"},{"s":43.021,"e":46.042,"text":"then called doing nothing “being measured and fair.”"},{"s":46.042,"e":48.812,"text":"Everybody knew. Nobody moved."},{"s":48.812,"e":52.337,"text":"Everybody had something personal to lose."},{"s":52.337,"e":55.61,"text":"So the future kept screaming through holes in the past,"},{"s":55.61,"e":58.883,"text":"while the people with power kept protecting their ass."},{"s":58.883,"e":60.898,"text":"**[Pre-Chorus — Female Vocal]**"},{"s":60.898,"e":62.66,"text":"One said, “Not my family.”"},{"s":62.66,"e":63.919,"text":"One said, “Not my fight.”"},{"s":63.919,"e":66.185,"text":"One said, “Fixing this could ruin my life.”"},{"s":66.185,"e":68.451,"text":"One by one, they protected their side—"},{"s":68.451,"e":71.976,"text":"and built a universe where nobody survives right."},{"s":71.976,"e":72.983,"text":"**[Chorus — Huge]**"},{"s":72.983,"e":74.746,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":74.746,"e":77.264,"text":"everybody saving themselves."},{"s":77.264,"e":79.53,"text":"Everybody knows what’s broken,"},{"s":79.53,"e":83.055,"text":"everybody leaves it for somebody else."},{"s":83.055,"e":84.817,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":84.817,"e":87.083,"text":"where conscience comes second to cost."},{"s":87.083,"e":89.097,"text":"Every world could’ve been better,"},{"s":89.097,"e":92.622,"text":"but nobody wanted to personally take the loss."},{"s":92.622,"e":93.63,"text":"Me first. Mine first."},{"s":93.63,"e":95.392,"text":"Let the next timeline hurt."},{"s":95.392,"e":96.903,"text":"That’s how heaven turns hell"},{"s":96.903,"e":99.169,"text":"without anybody doing the worst."},{"s":99.169,"e":100.679,"text":"Just millions doing nothing"},{"s":100.679,"e":102.442,"text":"when doing something might hurt."},{"s":102.442,"e":103.701,"text":"**[Verse 2 — Male Rap]**"},{"s":103.701,"e":105.967,"text":"Branch after branch, the disease gets deep,"},{"s":105.967,"e":108.737,"text":"promises cheap and the consequences steep."},{"s":108.737,"e":112.765,"text":"Every timeline inherits the cowardice before it,"},{"s":112.765,"e":116.038,"text":"then teaches the next generation to ignore it."},{"s":116.038,"e":119.312,"text":"Politician sees truth but election comes first."},{"s":119.312,"e":122.333,"text":"Executive sees harm but the quarter looks worse."},{"s":122.333,"e":125.354,"text":"Scientist sees danger but the funding might vanish."},{"s":125.354,"e":129.131,"text":"Judge knows the wound but says, “Not my jurisdiction to manage.”"},{"s":129.131,"e":131.901,"text":"Neighbor hears screaming, turns television loud."},{"s":131.901,"e":134.922,"text":"Whole damn planet learns to disappear in a crowd."},{"s":134.922,"e":137.944,"text":"Nobody wakes up planning evil at dawn—"},{"s":137.944,"e":141.469,"text":"they just protect their little piece while the whole thing goes wrong."},{"s":141.469,"e":144.49,"text":"That’s the terrifying part, that’s the twist in the knife:"},{"s":144.49,"e":147.26,"text":"hell doesn’t always need monsters destroying your life."},{"s":147.26,"e":150.785,"text":"Sometimes hell is reasonable people who knew,"},{"s":150.785,"e":153.554,"text":"saying, “Yes, this is awful… but what can **I** do?”"},{"s":153.554,"e":155.568,"text":"**[Pre-Chorus — Female Vocal]**"},{"s":155.568,"e":157.079,"text":"One said, “Not my money.”"},{"s":157.079,"e":158.338,"text":"One said, “Not my name.”"},{"s":158.338,"e":160.856,"text":"One said, “Someone else can carry the blame.”"},{"s":160.856,"e":164.381,"text":"Till every branch of reality learned the same game—"},{"s":164.381,"e":167.402,"text":"save yourself first, let tomorrow burn in flames."},{"s":167.402,"e":168.302,"text":"**[Chorus]**"},{"s":168.302,"e":170.065,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":170.065,"e":172.583,"text":"everybody saving themselves."},{"s":172.583,"e":174.849,"text":"Everybody knows what’s broken,"},{"s":174.849,"e":178.374,"text":"everybody leaves it for somebody else."},{"s":178.374,"e":180.136,"text":"**WELCOME TO THE MULTIVERSE,**"},{"s":180.136,"e":182.402,"text":"where conscience comes second to cost."},{"s":182.402,"e":184.417,"text":"Every world could’ve been better,"},{"s":184.417,"e":187.942,"text":"but nobody wanted to personally take the loss."},{"s":187.942,"e":188.949,"text":"Me first. Mine first."},{"s":188.949,"e":190.711,"text":"Let the next timeline hurt."},{"s":190.711,"e":192.222,"text":"That’s how heaven turns hell"},{"s":192.222,"e":194.488,"text":"without anybody doing the worst."},{"s":194.488,"e":196.502,"text":"But somewhere there has to be"},{"s":196.502,"e":198.013,"text":"one branch that breaks the chain."},{"s":198.013,"e":200.027,"text":"One person who sees tomorrow"},{"s":200.027,"e":202.545,"text":"and chooses somebody else’s pain."},{"s":202.545,"e":204.308,"text":"One hand that signs the paper."},{"s":204.308,"e":205.818,"text":"One voice that tells the truth."},{"s":205.818,"e":208.084,"text":"One soul willing to lose something"},{"s":208.084,"e":209.847,"text":"so strangers don’t have to lose."},{"s":209.847,"e":211.106,"text":"**[Male Rap — Building]**"},{"s":211.106,"e":215.386,"text":"So send me every timeline, let me study every scar,"},{"s":215.386,"e":218.659,"text":"show me where we traded human hearts for who we are."},{"s":218.659,"e":222.184,"text":"You don’t need to save infinity in one heroic night—"},{"s":222.184,"e":225.457,"text":"you just stop making selfishness the price of doing right."},{"s":225.457,"e":226.968,"text":"Maybe courage costs comfort."},{"s":226.968,"e":228.227,"text":"Maybe mercy costs pride."},{"s":228.227,"e":231.248,"text":"Maybe fixing what’s broken means you lose on your side."},{"s":231.248,"e":232.148,"text":"Fine."},{"s":232.148,"e":233.156,"text":"Take the title."},{"s":233.156,"e":234.163,"text":"Take the table."},{"s":234.163,"e":235.17,"text":"Take the treasure."},{"s":235.17,"e":236.07,"text":"Take the throne."},{"s":236.07,"e":238.336,"text":"If my comfort needs your suffering—"},{"s":238.336,"e":240.602,"text":"**I don’t want my comfort anymore.**"},{"s":240.602,"e":242.868,"text":"somebody finally goes first."},{"s":242.868,"e":244.882,"text":"Somebody sees what’s broken"},{"s":244.882,"e":247.148,"text":"and decides their loss is worth it."},{"s":247.148,"e":248.407,"text":"**CHANGE THE MULTIVERSE,**"},{"s":248.407,"e":250.17,"text":"make conscience bigger than cost."},{"s":250.17,"e":252.184,"text":"Maybe every world gets better"},{"s":252.184,"e":255.205,"text":"when somebody volunteers to take the loss."},{"s":255.205,"e":256.213,"text":"Us first. Love first."},{"s":256.213,"e":257.975,"text":"Let the old timeline burst."},{"s":257.975,"e":259.738,"text":"Maybe heaven starts happening"},{"s":259.738,"e":261.248,"text":"when we reverse the curse."},{"s":261.248,"e":262.148,"text":"Not with gods."},{"s":262.148,"e":263.659,"text":"Not with time machines."},{"s":263.659,"e":265.925,"text":"With somebody finally saying—"},{"s":265.925,"e":268.191,"text":"**“I’ll fix it even if it hurts me.”**"},{"s":268.191,"e":269.702,"text":"The future wasn’t doomed."},{"s":269.702,"e":270.709,"text":"It was waiting"},{"s":270.709,"e":271.968,"text":"for somebody"},{"s":271.968,"e":272.975,"text":"to stop asking:"},{"s":272.9,"e":272.98,"text":"**“What’s in it for me?”**"}],"duration":274.6,"source":"curated-realigned","generatedAt":"2026-08-21T01:03:02.363Z","realignedFrom":"curated-realigned","vocalStart":1.98,"vocalEnd":272.9}