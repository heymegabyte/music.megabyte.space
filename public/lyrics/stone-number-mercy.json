32.074,"e":232.901,"line":65},{"w":"we","s":232.901,"e":233.315,"line":65},{"w":"refuse","s":233.315,"e":234.142,"line":65},{"w":"to","s":234.142,"e":234.555,"line":65},{"w":"see,","s":234.555,"e":234.969,"line":65},{"w":"Walk","s":234.969,"e":235.383,"line":66},{"w":"through","s":235.383,"e":235.796,"line":66},{"w":"the","s":235.796,"e":236.21,"line":66},{"w":"prison,","s":236.21,"e":237.037,"line":66},{"w":"whisper","s":237.037,"e":237.864,"line":66},{"w":"their","s":237.864,"e":238.278,"line":66},{"w":"names—","s":238.278,"e":239.105,"line":66},{"w":"No","s":239.105,"e":239.518,"line":67},{"w":"soul","s":239.518,"e":239.932,"line":67},{"w":"is","s":239.932,"e":240.346,"line":67},{"w":"only","s":240.346,"e":241.173,"line":67},{"w":"its","s":241.173,"e":241.586,"line":67},{"w":"chains","s":241.586,"e":242,"line":67}],"lines":[{"s":8.32,"e":12.87,"text":"God of the locked room, God of the stone floor,"},{"s":12.87,"e":17.005,"text":"God of the man who can’t take anymore,"},{"s":17.005,"e":21.555,"text":"God of the woman with no window or name,"},{"s":21.555,"e":26.104,"text":"Only a number and a body in pain."},{"s":26.104,"e":30.654,"text":"Hear every soul behind concrete tonight,"},{"s":30.654,"e":34.376,"text":"Sleeping in darkness, starving for light."},{"s":34.376,"e":40.167,"text":"If it’s animal abuse to cage a creature that way,"},{"s":40.167,"e":44.716,"text":"Then don’t call it justice when humans decay."},{"s":44.716,"e":48.025,"text":"Send clean water, send bread, send air,"},{"s":48.025,"e":52.988,"text":"Send one honest witness who still dares to care."},{"s":52.988,"e":57.538,"text":"Send a doctor, send a lawyer, send a key,"},{"s":57.538,"e":61.673,"text":"Send mercy where mercy is hard to see."},{"s":61.673,"e":64.155,"text":"Break the loop, hold the dam,"},{"s":64.155,"e":67.464,"text":"Put your light in a trembling hand."},{"s":67.464,"e":70.773,"text":"Turn the asteroid into dust,"},{"s":70.773,"e":74.081,"text":"Save the ones the world won’t trust."},{"s":74.081,"e":76.563,"text":"Break the loop, clear the road,"},{"s":76.563,"e":79.872,"text":"Lift the prisoner’s heavy load."},{"s":79.872,"e":83.18,"text":"If there’s hell behind those bars,"},{"s":83.18,"e":86.489,"text":"Send Heaven through the iron scars."},{"s":86.489,"e":90.211,"text":"For the sick cell, for the crowded room,"},{"s":90.211,"e":94.761,"text":"For the brother breathing in a living tomb,"},{"s":94.761,"e":99.724,"text":"For the guilty judged, for the innocent freed,"},{"s":99.724,"e":103.446,"text":"For the human underneath the deed."},{"s":103.446,"e":107.996,"text":"No one should rot where the cameras don’t go,"},{"s":107.996,"e":112.545,"text":"No one should vanish where the records don’t show."},{"s":112.545,"e":115.854,"text":"Let the courts move faster than fear,"},{"s":115.854,"e":119.576,"text":"Let the world finally hear them clear."},{"s":119.576,"e":122.885,"text":"Send clean water, send bread, send air,"},{"s":122.885,"e":127.021,"text":"Send someone brave enough to stand right there."},{"s":127.021,"e":130.33,"text":"Send a hand through the wire and say,"},{"s":130.33,"e":133.225,"text":"“You are still a soul today.”"},{"s":133.225,"e":135.707,"text":"Break the loop, hold the dam,"},{"s":135.707,"e":139.015,"text":"Put your light in a trembling hand."},{"s":139.015,"e":142.324,"text":"Turn the asteroid into dust,"},{"s":142.324,"e":145.633,"text":"Save the ones the world won’t trust."},{"s":145.633,"e":148.114,"text":"Break the loop, clear the road,"},{"s":148.114,"e":151.423,"text":"Lift the prisoner’s heavy load."},{"s":151.423,"e":154.732,"text":"If there’s hell behind those bars,"},{"s":154.732,"e":158.041,"text":"Send Heaven through the iron scars."},{"s":158.041,"e":162.177,"text":"Hologram death scenes playing on repeat,"},{"s":162.177,"e":166.312,"text":"False little endings at the edge of sleep,"},{"s":166.312,"e":170.862,"text":"A voice says “jump,” but a higher voice says “stay,”"},{"s":170.862,"e":175.412,"text":"The nightmare is loud, but it fades away."},{"s":175.412,"e":180.375,"text":"The protagonist drives past the dam at night,"},{"s":180.375,"e":184.097,"text":"Sky split open by a burning light,"},{"s":184.097,"e":188.233,"text":"But God puts a hand where the impact lands—"},{"s":188.233,"e":191.955,"text":"No flood today, no blood on the sands."},{"s":191.955,"e":193.196,"text":"Break the loop."},{"s":193.196,"e":194.437,"text":"Hold the dam."},{"s":194.437,"e":195.678,"text":"Clear the road."},{"s":195.678,"e":196.918,"text":"Save the man."},{"s":196.918,"e":198.159,"text":"Break the loop."},{"s":198.159,"e":199.4,"text":"Hold the dam."},{"s":199.4,"e":200.641,"text":"Feed the cell."},{"s":200.641,"e":201.881,"text":"Free the lamb."},{"s":201.881,"e":204.363,"text":"Break the loop, hold the dam,"},{"s":204.363,"e":207.672,"text":"Put your light in a trembling hand."},{"s":207.672,"e":210.981,"text":"Turn the asteroid into dust,"},{"s":210.981,"e":214.289,"text":"Save the ones the world won’t trust."},{"s":214.289,"e":216.771,"text":"Break the loop, clear the road,"},{"s":216.771,"e":220.08,"text":"Lift the prisoner’s heavy load."},{"s":220.08,"e":223.388,"text":"If there’s hell behind those bars,"},{"s":223.388,"e":226.697,"text":"Send Heaven through the iron scars."},{"s":226.697,"e":230.833,"text":"God of the locked room, God of the key,"},{"s":230.833,"e":234.969,"text":"God of the ones we refuse to see,"},{"s":234.969,"e":239.105,"text":"Walk through the prison, whisper their names—"},{"s":239.105,"e":242,"text":"No soul is only its chains"}],"duration":259.08,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.871Z","realignedFrom":"whisper-aligned","vocalStart":8.32,"vocalEnd":242}