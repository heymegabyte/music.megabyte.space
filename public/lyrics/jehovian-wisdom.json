":173.787,"line":64},{"w":"soul,","s":173.787,"e":174.061,"line":64},{"w":"Not","s":174.061,"e":174.335,"line":65},{"w":"chasing","s":174.335,"e":174.883,"line":65},{"w":"chaos,","s":174.883,"e":175.157,"line":65},{"w":"not","s":175.157,"e":175.431,"line":65},{"w":"craving","s":175.431,"e":175.979,"line":65},{"w":"control.","s":175.979,"e":176.527,"line":65},{"w":"Through","s":176.527,"e":176.801,"line":66},{"w":"every","s":176.801,"e":177.623,"line":66},{"w":"triumph,","s":177.623,"e":177.897,"line":66},{"w":"through","s":177.897,"e":178.171,"line":66},{"w":"every","s":178.171,"e":178.993,"line":66},{"w":"collision—","s":178.993,"e":179.815,"line":66},{"w":"Give","s":179.815,"e":180.089,"line":67},{"w":"me","s":180.089,"e":180.363,"line":67},{"w":"the","s":180.363,"e":180.637,"line":67},{"w":"courage","s":180.637,"e":181.185,"line":67},{"w":"of","s":181.185,"e":181.459,"line":67},{"w":"**Jehovian","s":181.459,"e":182.281,"line":67},{"w":"wisdom**.","s":182.281,"e":182.829,"line":67},{"w":"**[Outro","s":182.829,"e":183.377,"line":68},{"w":"—","s":183.377,"e":183.651,"line":68},{"w":"Female","s":183.651,"e":184.199,"line":68},{"w":"Vocal","s":184.199,"e":184.747,"line":68},{"w":"/","s":184.747,"e":185.021,"line":68},{"w":"Piano]**","s":185.021,"e":185.569,"line":68},{"w":"Clear","s":185.569,"e":186.019,"line":69},{"w":"mind.","s":186.019,"e":186.469,"line":69},{"w":"Kind","s":186.469,"e":186.919,"line":70},{"w":"heart.","s":186.919,"e":187.369,"line":70},{"w":"Strong","s":187.369,"e":187.819,"line":71},{"w":"soul.","s":187.819,"e":188.269,"line":71},{"w":"Wise","s":188.269,"e":188.719,"line":72},{"w":"start.","s":188.719,"e":189.169,"line":72},{"w":"When","s":189.169,"e":189.442,"line":73},{"w":"I","s":189.442,"e":189.716,"line":73},{"w":"can't","s":189.716,"e":189.99,"line":73},{"w":"see","s":189.99,"e":190.264,"line":73},{"w":"the","s":190.264,"e":190.538,"line":73},{"w":"whole","s":190.538,"e":190.812,"line":73},{"w":"road","s":190.812,"e":191.086,"line":73},{"w":"ahead,","s":191.086,"e":191.634,"line":73},{"w":"Give","s":191.634,"e":191.908,"line":74},{"w":"me","s":191.908,"e":192.182,"line":74},{"w":"enough","s":192.182,"e":192.73,"line":74},{"w":"light","s":192.73,"e":193.004,"line":74},{"w":"For","s":193.004,"e":193.24,"line":75},{"w":"the","s":193.24,"e":193.32,"line":75},{"w":"next","s":193.24,"e":193.32,"line":75},{"w":"step","s":193.24,"e":193.32,"line":75},{"w":"instead.","s":193.24,"e":193.32,"line":75}],"lines":[{"s":12.96,"e":14.604,"text":"# **Jehovian Wisdom**"},{"s":14.604,"e":16.248,"text":"**[Intro — Soft Piano]**"},{"s":16.248,"e":18.44,"text":"Quiet in the chaos, calm in the crowd,"},{"s":18.44,"e":20.905,"text":"Truth don't need thunder just to speak loud."},{"s":20.905,"e":24.193,"text":"I asked for a sign, got a lesson instead—"},{"s":24.193,"e":27.207,"text":"“Watch where you walk, watch what you feed in your head.”"},{"s":27.207,"e":28.577,"text":"**[Verse 1 — Male Lead]**"},{"s":28.577,"e":31.317,"text":"Jehovian wisdom, I’m weighing my ways,"},{"s":31.317,"e":34.331,"text":"Not every bright fire deserves my gaze."},{"s":34.331,"e":37.07,"text":"Some doors look golden but open to grief,"},{"s":37.07,"e":40.358,"text":"Some losses are lessons disguised as relief."},{"s":40.358,"e":42.824,"text":"Slow with the judgment, swift with the grace,"},{"s":42.824,"e":46.112,"text":"Strength ain’t always putting somebody in place."},{"s":46.112,"e":49.674,"text":"Sometimes it’s silence, sometimes it’s speech,"},{"s":49.674,"e":52.961,"text":"Sometimes the mountain is there just to teach."},{"s":52.961,"e":56.797,"text":"I learned that my thoughts ain’t automatically true,"},{"s":56.797,"e":59.537,"text":"Fear paints a picture, but I choose the view."},{"s":59.537,"e":62.277,"text":"Separate fact from the feeling inside,"},{"s":62.277,"e":65.291,"text":"Let wisdom be lantern, let love be the guide."},{"s":65.291,"e":67.482,"text":"**[Pre-Chorus — Female Vocal]**"},{"s":67.482,"e":68.852,"text":"When the world gets loud,"},{"s":68.852,"e":70.222,"text":"I can still hear clear."},{"s":70.222,"e":72.414,"text":"I don't need every answer,"},{"s":72.414,"e":74.332,"text":"I just need the next step near."},{"s":74.332,"e":76.25,"text":"**[Chorus — Male + Female]**"},{"s":76.25,"e":78.716,"text":"Jehovian wisdom, light on my road,"},{"s":78.716,"e":81.181,"text":"Grace when it’s heavy, strength with the load."},{"s":81.181,"e":83.921,"text":"Eyes on tomorrow, feet planted today,"},{"s":83.921,"e":86.387,"text":"Love in my language, truth in my way."},{"s":86.387,"e":89.127,"text":"Jehovian wisdom, deep in my bones,"},{"s":89.127,"e":91.593,"text":"Peace when I’m crowded, peace when alone."},{"s":91.593,"e":94.333,"text":"I don't need vengeance, I don't need control—"},{"s":94.333,"e":96.798,"text":"Give me discernment and guard my soul."},{"s":96.798,"e":97.894,"text":"**[Verse 2 — Rap]**"},{"s":97.894,"e":100.36,"text":"Wise mind, wide eyes, watch what I water,"},{"s":100.36,"e":103.1,"text":"Plant peace now, let the future grow broader."},{"s":103.1,"e":105.566,"text":"Pride make promises wisdom won’t keep,"},{"s":105.566,"e":108.854,"text":"So I build on the rock, not applause in the street."},{"s":108.854,"e":111.593,"text":"I can accept what I cannot rewrite,"},{"s":111.593,"e":114.607,"text":"Still make a move toward the good and the right."},{"s":114.607,"e":117.347,"text":"Anger can knock, but it don’t get the keys,"},{"s":117.347,"e":120.087,"text":"Pain gets a chair, but it don't get to lead."},{"s":120.087,"e":122.827,"text":"Patience got power that panic can’t fake,"},{"s":122.827,"e":125.293,"text":"Every reaction ain’t mine to make."},{"s":125.293,"e":127.758,"text":"Mercy ain't weakness, restraint ain't fear,"},{"s":127.758,"e":131.046,"text":"Sometimes the strongest response disappears."},{"s":131.046,"e":134.334,"text":"Count every blessing, confront every lie,"},{"s":134.334,"e":137.074,"text":"Keep both my feet down while dreams touch the sky."},{"s":137.074,"e":140.362,"text":"If I lose direction, return to the mission:"},{"s":140.362,"e":143.375,"text":"Love with a backbone—Jehovian wisdom."},{"s":143.375,"e":145.019,"text":"**[Bridge — Piano Breakdown]**"},{"s":145.019,"e":146.389,"text":"Teach me when to speak."},{"s":146.389,"e":147.759,"text":"Teach me when to wait."},{"s":147.759,"e":149.129,"text":"Teach me what is mine"},{"s":149.129,"e":151.595,"text":"And what I should release from my weight."},{"s":151.595,"e":153.787,"text":"Give me courage without cruelty,"},{"s":153.787,"e":155.431,"text":"Confidence without pride,"},{"s":155.431,"e":157.622,"text":"A heart that stays compassionate,"},{"s":157.622,"e":159.814,"text":"And truth I never have to hide."},{"s":159.814,"e":161.458,"text":"**[Final Chorus — Huge]**"},{"s":161.458,"e":163.924,"text":"Jehovian wisdom, light on my road,"},{"s":163.924,"e":166.39,"text":"Grace when it’s heavy, strength with the load."},{"s":166.39,"e":169.13,"text":"Eyes on tomorrow, feet planted today,"},{"s":169.13,"e":171.595,"text":"Love in my language, truth in my way."},{"s":171.595,"e":174.061,"text":"Jehovian wisdom, steady my soul,"},{"s":174.061,"e":176.527,"text":"Not chasing chaos, not craving control."},{"s":176.527,"e":179.815,"text":"Through every triumph, through every collision—"},{"s":179.815,"e":182.829,"text":"Give me the courage of **Jehovian wisdom**."},{"s":182.829,"e":185.569,"text":"**[Outro — Female Vocal / Piano]**"},{"s":185.569,"e":186.469,"text":"Clear mind."},{"s":186.469,"e":187.369,"text":"Kind heart."},{"s":187.369,"e":188.269,"text":"Strong soul."},{"s":188.269,"e":189.169,"text":"Wise start."},{"s":189.169,"e":191.634,"text":"When I can't see the whole road ahead,"},{"s":191.634,"e":193.004,"text":"Give me enough light"},{"s":193.004,"e":193.32,"text":"For the next step instead."}],"duration":222.12,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.123Z","realignedFrom":"whisper-aligned","vocalStart":12.96,"vocalEnd":193.24}