65},{"w":"triumph,","s":170,"e":170.66,"line":65},{"w":"through","s":170.96,"e":171.22,"line":65},{"w":"every","s":171.22,"e":171.64,"line":65},{"w":"collision—","s":171.64,"e":172.36,"line":65},{"w":"Give","s":172.68,"e":173.24,"line":66},{"w":"me","s":173.24,"e":173.46,"line":66},{"w":"the","s":173.46,"e":173.74,"line":66},{"w":"courage","s":173.74,"e":174.42,"line":66},{"w":"of","s":174.42,"e":175.26,"line":66},{"w":"**Jehovian","s":176.94,"e":178.14,"line":66},{"w":"wisdom**.","s":178.14,"e":178.32,"line":66},{"w":"Clear","s":178.56,"e":179.46,"line":67},{"w":"mind.","s":179.46,"e":180.36,"line":67},{"w":"Kind","s":180.36,"e":181.24,"line":68},{"w":"heart.","s":181.24,"e":181.74,"line":68},{"w":"Strong","s":181.74,"e":182.92,"line":69},{"w":"soul.","s":183.18,"e":184.14,"line":69},{"w":"Wise","s":184.14,"e":184.94,"line":70},{"w":"start.","s":184.94,"e":185.24,"line":70},{"w":"When","s":185.54,"e":185.88,"line":71},{"w":"I","s":185.88,"e":186.28,"line":71},{"w":"can't","s":186.28,"e":186.62,"line":71},{"w":"see","s":186.96,"e":187.12,"line":71},{"w":"the","s":187.12,"e":187.56,"line":71},{"w":"whole","s":187.56,"e":187.82,"line":71},{"w":"road","s":187.82,"e":188.32,"line":71},{"w":"ahead,","s":188.32,"e":189.14,"line":71},{"w":"Give","s":189.16,"e":189.42,"line":72},{"w":"me","s":189.42,"e":189.68,"line":72},{"w":"enough","s":189.68,"e":190.22,"line":72},{"w":"light","s":190.22,"e":190.78,"line":72},{"w":"For","s":190.78,"e":191.24,"line":73},{"w":"the","s":191.24,"e":191.48,"line":73},{"w":"next","s":191.48,"e":191.92,"line":73},{"w":"step","s":191.92,"e":192.34,"line":73},{"w":"instead.","s":192.34,"e":193.24,"line":73}],"lines":[{"s":0,"e":0.5,"text":"**[Intro — Soft Piano]**"},{"s":12.96,"e":16.38,"text":"Quiet in the chaos, calm in the crowd,"},{"s":16.86,"e":20.14,"text":"Truth don't need thunder just to speak loud."},{"s":20.3,"e":23.82,"text":"I asked for a sign, got a lesson instead—"},{"s":24.36,"e":28.68,"text":"“Watch where you walk, watch what you feed in your head.”"},{"s":28.68,"e":29.18,"text":"**[Verse 1 — Male Lead]**"},{"s":29.22,"e":30.78,"text":"Jehovian wisdom, I’m weighing my ways,"},{"s":31.84,"e":34.6,"text":"Not every bright fire deserves my gaze."},{"s":35.56,"e":37.74,"text":"Some doors look golden but open to grief,"},{"s":39.16,"e":41.46,"text":"Some losses are lessons disguised as relief."},{"s":42.98,"e":45.12,"text":"Slow with the judgment, swift with the grace,"},{"s":46.16,"e":48.88,"text":"Strength ain’t always putting somebody in place."},{"s":49.78,"e":51.56,"text":"Sometimes it’s silence, sometimes it’s speech,"},{"s":51.68,"e":53.4,"text":"Sometimes the mountain is there just to teach."},{"s":53.36,"e":55.6,"text":"I learned that my thoughts ain’t automatically true,"},{"s":55.66,"e":57.42,"text":"Fear paints a picture, but I choose the view."},{"s":57.86,"e":59.46,"text":"Separate fact from the feeling inside,"},{"s":60.22,"e":63.22,"text":"Let wisdom be lantern, let love be the guide."},{"s":63.22,"e":63.72,"text":"**[Pre-Chorus — Female Vocal]**"},{"s":63.64,"e":65.46,"text":"When the world gets loud,"},{"s":65.54,"e":67.32,"text":"I can still hear clear."},{"s":67.4,"e":69.08,"text":"I don't need every answer,"},{"s":69.14,"e":72.18,"text":"I just need the next step near."},{"s":72.18,"e":72.68,"text":"**[Chorus — Male + Female]**"},{"s":73.68,"e":76.18,"text":"Jehovian wisdom, light on my road,"},{"s":76.86,"e":80.26,"text":"Grace when it’s heavy, strength with the load."},{"s":80.52,"e":83.94,"text":"Eyes on tomorrow, feet planted today,"},{"s":84.14,"e":87.82,"text":"Love in my language, truth in my way."},{"s":88.44,"e":91.66,"text":"Jehovian wisdom, deep in my bones,"},{"s":91.84,"e":95.16,"text":"Peace when I’m crowded, peace when alone."},{"s":95.16,"e":98.88,"text":"I don't need vengeance, I don't need control—"},{"s":99.04,"e":102.46,"text":"Give me discernment and guard my soul."},{"s":102.38,"e":102.88,"text":"**[Verse 2 — Rap]**"},{"s":102.46,"e":105,"text":"Wise mind, wide eyes, watch what I water,"},{"s":105.14,"e":106.84,"text":"Plant peace now, let the future grow broader."},{"s":106.92,"e":108.64,"text":"Pride make promises wisdom won’t keep,"},{"s":108.66,"e":110.5,"text":"So I build on the rock, not applause in the street."},{"s":110.54,"e":112.32,"text":"I can accept what I cannot rewrite,"},{"s":112.64,"e":114.34,"text":"Still make a move toward the good and the right."},{"s":114.52,"e":116.14,"text":"Anger can knock, but it don’t get the keys,"},{"s":116.3,"e":117.92,"text":"Pain gets a chair, but it don't get to lead."},{"s":117.98,"e":119.78,"text":"Patience got power that panic can’t fake,"},{"s":119.94,"e":121.7,"text":"Every reaction ain’t mine to make."},{"s":121.96,"e":123.58,"text":"Mercy ain't weakness, restraint ain't fear,"},{"s":123.6,"e":125.26,"text":"Sometimes the strongest response disappears."},{"s":125.36,"e":127.16,"text":"Count every blessing, confront every lie,"},{"s":127.2,"e":129.08,"text":"Keep both my feet down while dreams touch the sky."},{"s":129,"e":130.82,"text":"If I lose direction, return to the mission:"},{"s":130.88,"e":133.24,"text":"Love with a backbone—Jehovian wisdom."},{"s":133.24,"e":133.74,"text":"**[Bridge — Piano Breakdown]**"},{"s":133.7,"e":135.06,"text":"Teach me when to speak."},{"s":135.18,"e":137.06,"text":"Teach me when to wait."},{"s":137.06,"e":138.68,"text":"Teach me what is mine"},{"s":138.66,"e":141.22,"text":"And what I should release from my weight."},{"s":141.2,"e":142.6,"text":"Give me courage without cruelty,"},{"s":143.06,"e":144.3,"text":"Confidence without pride,"},{"s":144.44,"e":146.14,"text":"A heart that stays compassionate,"},{"s":146.42,"e":148.04,"text":"And truth I never have to hide."},{"s":147.86,"e":148.36,"text":"**[Final Chorus — Huge]**"},{"s":148.34,"e":150.08,"text":"Jehovian wisdom, light on my road,"},{"s":150.82,"e":154.02,"text":"Grace when it’s heavy, strength with the load."},{"s":154.46,"e":157.54,"text":"Eyes on tomorrow, feet planted today,"},{"s":158.5,"e":161.42,"text":"Love in my language, truth in my way."},{"s":162.2,"e":165.26,"text":"Jehovian wisdom, steady my soul,"},{"s":165.42,"e":168.92,"text":"Not chasing chaos, not craving control."},{"s":169.12,"e":172.36,"text":"Through every triumph, through every collision—"},{"s":172.68,"e":178.32,"text":"Give me the courage of **Jehovian wisdom**."},{"s":178.56,"e":180.36,"text":"Clear mind."},{"s":180.36,"e":181.74,"text":"Kind heart."},{"s":181.74,"e":184.14,"text":"Strong soul."},{"s":184.14,"e":185.24,"text":"Wise start."},{"s":185.54,"e":189.14,"text":"When I can't see the whole road ahead,"},{"s":189.16,"e":190.78,"text":"Give me enough light"},{"s":190.78,"e":193.24,"text":"For the next step instead."}],"duration":222.12,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.762Z","stats":{"whisperWords":482,"polishedWords":466,"matched":439,"matchRate":0.942}}