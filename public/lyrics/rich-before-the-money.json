44.18,"e":244.476,"line":90},{"w":"just","s":244.476,"e":244.772,"line":91},{"w":"being","s":244.772,"e":245.068,"line":91},{"w":"alive","s":245.068,"e":245.661,"line":91},{"w":"and","s":245.661,"e":245.957,"line":91},{"w":"awake","s":245.957,"e":246.55,"line":91},{"w":"enough","s":246.55,"e":247.142,"line":91},{"w":"to","s":247.142,"e":247.438,"line":91},{"w":"notice","s":247.438,"e":248.031,"line":91},{"w":"it","s":248.031,"e":248.327,"line":91},{"w":"now.","s":248.327,"e":248.623,"line":91},{"w":"**[Final","s":248.623,"e":249.216,"line":92},{"w":"Chorus]**","s":249.216,"e":249.808,"line":92},{"w":"I","s":249.808,"e":250.105,"line":93},{"w":"was","s":250.105,"e":250.401,"line":93},{"w":"**RICH","s":250.401,"e":250.697,"line":93},{"w":"BEFORE","s":250.697,"e":251.29,"line":93},{"w":"THE","s":251.29,"e":251.586,"line":93},{"w":"MONEY,**","s":251.586,"e":252.178,"line":93},{"w":"rich","s":252.178,"e":252.475,"line":94},{"w":"before","s":252.475,"e":253.067,"line":94},{"w":"the","s":253.067,"e":253.363,"line":94},{"w":"fame,","s":253.363,"e":253.66,"line":94},{"w":"rich","s":253.66,"e":253.956,"line":95},{"w":"when","s":253.956,"e":254.252,"line":95},{"w":"nobody","s":254.252,"e":255.141,"line":95},{"w":"knew","s":255.141,"e":255.437,"line":95},{"w":"me,","s":255.437,"e":255.733,"line":95},{"w":"still","s":255.733,"e":256.03,"line":96},{"w":"had","s":256.03,"e":256.326,"line":96},{"w":"love","s":256.326,"e":256.622,"line":96},{"w":"beside","s":256.622,"e":257.215,"line":96},{"w":"my","s":257.215,"e":257.511,"line":96},{"w":"name.","s":257.511,"e":257.807,"line":96},{"w":"Rich","s":257.807,"e":258.103,"line":97},{"w":"with","s":258.103,"e":258.4,"line":97},{"w":"the","s":258.4,"e":258.696,"line":97},{"w":"rain","s":258.696,"e":258.992,"line":97},{"w":"running,","s":258.992,"e":259.585,"line":97},{"w":"rich","s":259.585,"e":259.881,"line":98},{"w":"with","s":259.881,"e":260.177,"line":98},{"w":"the","s":260.177,"e":260.473,"line":98},{"w":"sun","s":260.473,"e":260.77,"line":98},{"w":"above","s":260.77,"e":261.362,"line":98},{"w":"me,","s":261.362,"e":261.658,"line":98},{"w":"rich","s":261.658,"e":261.955,"line":99},{"w":"with","s":261.955,"e":262.251,"line":99},{"w":"these","s":262.251,"e":262.547,"line":99},{"w":"scars,","s":262.547,"e":262.843,"line":99},{"w":"these","s":262.843,"e":263.14,"line":99},{"w":"stars,","s":263.14,"e":263.436,"line":99},{"w":"these","s":263.436,"e":263.732,"line":100},{"w":"arms","s":263.732,"e":264.029,"line":100},{"w":"around","s":264.029,"e":264.621,"line":100},{"w":"me.","s":264.621,"e":264.917,"line":100},{"w":"**RICH","s":264.917,"e":265.214,"line":101},{"w":"BEFORE","s":265.214,"e":265.806,"line":101},{"w":"THE","s":265.806,"e":266.102,"line":101},{"w":"MONEY,**","s":266.102,"e":266.695,"line":101},{"w":"before","s":266.695,"e":267.287,"line":102},{"w":"the","s":267.287,"e":267.584,"line":102},{"w":"gold,","s":267.584,"e":267.88,"line":102},{"w":"before","s":267.88,"e":268.472,"line":102},{"w":"the","s":268.472,"e":268.769,"line":102},{"w":"glory,","s":268.769,"e":269.361,"line":102},{"w":"before","s":269.361,"e":269.954,"line":103},{"w":"the","s":269.954,"e":270.25,"line":103},{"w":"whole","s":270.25,"e":270.546,"line":103},{"w":"world","s":270.546,"e":270.842,"line":103},{"w":"heard","s":270.842,"e":271.139,"line":103},{"w":"my","s":271.139,"e":271.435,"line":103},{"w":"story.","s":271.435,"e":272.027,"line":103},{"w":"I","s":272.027,"e":272.324,"line":104},{"w":"had","s":272.324,"e":272.62,"line":104},{"w":"breath,","s":272.62,"e":272.916,"line":104},{"w":"I","s":272.916,"e":273.212,"line":104},{"w":"had","s":273.212,"e":273.509,"line":104},{"w":"love,","s":273.509,"e":273.805,"line":104},{"w":"I","s":273.805,"e":274.101,"line":105},{"w":"had","s":274.101,"e":274.397,"line":105},{"w":"life","s":274.397,"e":274.694,"line":105},{"w":"pouring","s":274.694,"e":275.286,"line":105},{"w":"through","s":275.286,"e":275.582,"line":105},{"w":"me.","s":275.582,"e":275.879,"line":105},{"w":"And","s":275.879,"e":276.175,"line":106},{"w":"if","s":276.175,"e":276.471,"line":106},{"w":"the","s":276.471,"e":276.767,"line":106},{"w":"millions","s":276.767,"e":277.36,"line":106},{"w":"come","s":277.36,"e":277.656,"line":106},{"w":"tomorrow,","s":277.656,"e":278.545,"line":106},{"w":"I’ll","s":278.545,"e":278.841,"line":107},{"w":"thank","s":278.841,"e":279.137,"line":107},{"w":"God—but","s":279.137,"e":279.73,"line":107},{"w":"they","s":279.73,"e":280.026,"line":107},{"w":"won’t","s":280.026,"e":280.322,"line":107},{"w":"define","s":280.322,"e":280.915,"line":107},{"w":"me.","s":280.915,"e":281.211,"line":107},{"w":"**Rich","s":281.211,"e":281.507,"line":108},{"w":"before","s":281.507,"e":282.1,"line":108},{"w":"the","s":282.1,"e":282.396,"line":108},{"w":"money.","s":282.396,"e":282.989,"line":108},{"w":"Rich","s":282.989,"e":283.285,"line":109},{"w":"before","s":283.285,"e":283.877,"line":109},{"w":"the","s":283.877,"e":284.174,"line":109},{"w":"money.**","s":284.174,"e":284.766,"line":109},{"w":"Turns","s":284.766,"e":285.216,"line":110},{"w":"out—","s":285.216,"e":285.666,"line":110},{"w":"**I","s":284.38,"e":284.46,"line":111},{"w":"had","s":284.38,"e":284.46,"line":111},{"w":"plenty.**","s":284.38,"e":284.46,"line":111}],"lines":[{"s":2.94,"e":5.014,"text":"# Rich Before the Money"},{"s":5.014,"e":5.914,"text":"**[Intro]**"},{"s":5.914,"e":8.284,"text":"Before the bands, before the brand,"},{"s":8.284,"e":10.654,"text":"before the bright lights knew my name—"},{"s":10.654,"e":13.024,"text":"I had breath inside my body,"},{"s":13.024,"e":15.098,"text":"I had blood inside my veins."},{"s":15.098,"e":16.875,"text":"Turns out I had plenty."},{"s":16.875,"e":17.775,"text":"**[Verse 1]**"},{"s":17.775,"e":20.738,"text":"Sun spilling gold through a slit in the shade,"},{"s":20.738,"e":23.404,"text":"steam from the coffee, another day made,"},{"s":23.404,"e":26.366,"text":"feet on the floor and a roof overhead,"},{"s":26.366,"e":29.329,"text":"food in the fridge and a dream in my head."},{"s":29.329,"e":32.291,"text":"Phone full of people who pick up at two,"},{"s":32.291,"e":35.254,"text":"friends know my flaws and still follow me through,"},{"s":35.254,"e":38.217,"text":"family calling just checking I’m straight—"},{"s":38.217,"e":41.179,"text":"fortune was hiding in plain sight all day."},{"s":41.179,"e":44.142,"text":"Chasing the chain, chasing change, chasing cheers,"},{"s":44.142,"e":47.104,"text":"measuring miracles yearly in tiers,"},{"s":47.104,"e":50.659,"text":"while the wind through the window kept whispering clear:"},{"s":50.659,"e":54.807,"text":"“You got somebody who loves you—your treasure is here.”"},{"s":54.807,"e":57.473,"text":"Stars for a ceiling, songs for the stress,"},{"s":57.473,"e":61.324,"text":"scars saying somehow I survived every mess,"},{"s":61.324,"e":63.991,"text":"heart that could hurt, heal, hope and progress—"},{"s":63.991,"e":67.546,"text":"I was begging for more while already blessed."},{"s":67.546,"e":68.446,"text":"**[Pre-Chorus]**"},{"s":68.446,"e":72.001,"text":"Counted every dollar that I didn’t possess,"},{"s":72.001,"e":75.852,"text":"never counted every “call me if you’re stressed.”"},{"s":75.852,"e":79.407,"text":"Counted every door that slammed in my face,"},{"s":79.407,"e":83.554,"text":"never counted every morning arriving with grace."},{"s":83.554,"e":84.454,"text":"**[Chorus]**"},{"s":84.454,"e":86.824,"text":"I was **rich before the money,**"},{"s":86.824,"e":88.306,"text":"rich before the racks,"},{"s":88.306,"e":90.379,"text":"rich when all I had was hope"},{"s":90.379,"e":92.75,"text":"and a little gas in the tank."},{"s":92.75,"e":94.527,"text":"Rich with the rain running,"},{"s":94.527,"e":96.601,"text":"rich with the sun above me,"},{"s":96.601,"e":98.082,"text":"rich with a table"},{"s":98.082,"e":100.748,"text":"and somebody who loved me."},{"s":100.748,"e":102.526,"text":"**Rich before the money.**"},{"s":102.526,"e":105.192,"text":"Before the gold, before the glory,"},{"s":105.192,"e":107.858,"text":"before the whole world heard my story—"},{"s":107.858,"e":109.636,"text":"I had love, I had life,"},{"s":109.636,"e":112.006,"text":"I had more than enough for me."},{"s":112.006,"e":114.376,"text":"I was **rich before the money.**"},{"s":114.376,"e":115.276,"text":"**[Verse 2]**"},{"s":115.276,"e":117.942,"text":"Clean cold water—what’s richer than that?"},{"s":117.942,"e":120.905,"text":"Laugh so hard that you lean all the way back."},{"s":120.905,"e":123.275,"text":"Dog by the doorway, dusk going dark,"},{"s":123.275,"e":126.534,"text":"moon on the windshield and miles in the heart."},{"s":126.534,"e":129.496,"text":"Fresh pair of socks and a song hitting right,"},{"s":129.496,"e":132.162,"text":"safe trip home through the soft city lights,"},{"s":132.162,"e":135.421,"text":"somebody texting me, “Tell me you’re fine,”"},{"s":135.421,"e":138.68,"text":"all of these diamonds that never get mined."},{"s":138.68,"e":141.346,"text":"We want bigger, brighter, better, more—"},{"s":141.346,"e":144.012,"text":"more square feet, more seats, more keys, more doors,"},{"s":144.012,"e":147.567,"text":"but a mansion means nothing when peace packs its bags,"},{"s":147.567,"e":151.123,"text":"and a million means little when love never lasts."},{"s":151.123,"e":154.381,"text":"Give me good people and give me good purpose,"},{"s":154.381,"e":157.344,"text":"give me the grit when the work feels worthless,"},{"s":157.344,"e":160.603,"text":"give me the wisdom to notice what’s working—"},{"s":160.603,"e":163.565,"text":"wealth isn’t wealth if your spirit stays starving."},{"s":163.565,"e":164.465,"text":"**[Pre-Chorus]**"},{"s":164.465,"e":167.724,"text":"Count every kindness, count every call,"},{"s":167.724,"e":170.983,"text":"count every hand that reached when you’d fall."},{"s":170.983,"e":174.538,"text":"Count every breath you were never guaranteed—"},{"s":174.538,"e":178.389,"text":"suddenly enough starts looking like everything."},{"s":178.389,"e":179.289,"text":"**[Bridge]**"},{"s":179.289,"e":182.548,"text":"If all the glitter disappeared tonight,"},{"s":182.548,"e":184.325,"text":"leave me love, leave me light."},{"s":184.325,"e":187.288,"text":"Leave me laughter round a kitchen table,"},{"s":187.288,"e":190.25,"text":"leave me strength enough to know I’m able."},{"s":190.25,"e":192.62,"text":"Leave me stars when the streetlights fade,"},{"s":192.62,"e":194.99,"text":"leave me peace that a price can’t pay."},{"s":194.99,"e":197.657,"text":"Fortunes fall and fortunes flee,"},{"s":197.657,"e":200.323,"text":"but what is priceless stays with me."},{"s":200.323,"e":201.223,"text":"**[Rap Build]**"},{"s":201.223,"e":204.185,"text":"Big bank someday—beautiful, bring it,"},{"s":204.185,"e":208.037,"text":"but I won’t let a balance determine my spirit."},{"s":208.037,"e":210.407,"text":"Build big buildings, buy brilliant things,"},{"s":210.407,"e":214.554,"text":"still know breakfast with family can feel like a kingdom."},{"s":214.554,"e":217.813,"text":"Bread breaking, belly laughing, breeze in the trees,"},{"s":217.813,"e":219.887,"text":"bare feet, back porch, being at peace."},{"s":219.887,"e":223.146,"text":"Blessed with a breath and the freedom to breathe—"},{"s":223.146,"e":226.701,"text":"what billionaire buys one more heartbeat guaranteed?"},{"s":226.701,"e":228.478,"text":"No receipt for relief."},{"s":228.478,"e":229.959,"text":"No price tag on peace."},{"s":229.959,"e":232.033,"text":"No market for memories."},{"s":232.033,"e":233.514,"text":"No lease on belief."},{"s":233.514,"e":237.07,"text":"When success comes dressed in diamonds and drums,"},{"s":237.07,"e":240.921,"text":"I’ll remember exactly where all of this begun:"},{"s":240.921,"e":244.476,"text":"not a vault, not a yacht, not applause from a crowd—"},{"s":244.476,"e":248.623,"text":"just being alive and awake enough to notice it now."},{"s":248.623,"e":249.808,"text":"**[Final Chorus]**"},{"s":249.808,"e":252.178,"text":"I was **RICH BEFORE THE MONEY,**"},{"s":252.178,"e":253.66,"text":"rich before the fame,"},{"s":253.66,"e":255.733,"text":"rich when nobody knew me,"},{"s":255.733,"e":257.807,"text":"still had love beside my name."},{"s":257.807,"e":259.585,"text":"Rich with the rain running,"},{"s":259.585,"e":261.658,"text":"rich with the sun above me,"},{"s":261.658,"e":263.436,"text":"rich with these scars, these stars,"},{"s":263.436,"e":264.917,"text":"these arms around me."},{"s":264.917,"e":266.695,"text":"**RICH BEFORE THE MONEY,**"},{"s":266.695,"e":269.361,"text":"before the gold, before the glory,"},{"s":269.361,"e":272.027,"text":"before the whole world heard my story."},{"s":272.027,"e":273.805,"text":"I had breath, I had love,"},{"s":273.805,"e":275.879,"text":"I had life pouring through me."},{"s":275.879,"e":278.545,"text":"And if the millions come tomorrow,"},{"s":278.545,"e":281.211,"text":"I’ll thank God—but they won’t define me."},{"s":281.211,"e":282.989,"text":"**Rich before the money."},{"s":282.989,"e":284.766,"text":"Rich before the money.**"},{"s":284.766,"e":285.666,"text":"Turns out—"},{"s":284.38,"e":284.46,"text":"**I had plenty.**"}],"duration":287.16,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.143Z","realignedFrom":"whisper-aligned","vocalStart":2.94,"vocalEnd":284.38}