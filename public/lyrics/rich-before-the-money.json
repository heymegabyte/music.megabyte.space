37.76,"line":98},{"w":"rich","s":237.76,"e":238.22,"line":99},{"w":"with","s":238.7,"e":239.26,"line":99},{"w":"these","s":239.28,"e":239.64,"line":99},{"w":"scars,","s":239.64,"e":240.16,"line":99},{"w":"these","s":240.16,"e":240.94,"line":99},{"w":"stars,","s":240.94,"e":241.02,"line":99},{"w":"these","s":241.18,"e":241.94,"line":100},{"w":"arms","s":241.94,"e":242.7,"line":100},{"w":"around","s":242.7,"e":243.3,"line":100},{"w":"me.","s":243.3,"e":243.68,"line":100},{"w":"**RICH","s":244.62,"e":245.38,"line":101},{"w":"BEFORE","s":245.38,"e":245.76,"line":101},{"w":"THE","s":245.76,"e":246.12,"line":101},{"w":"MONEY,**","s":246.12,"e":246.5,"line":101},{"w":"before","s":246.72,"e":246.88,"line":102},{"w":"the","s":246.88,"e":247,"line":102},{"w":"gold,","s":247,"e":247.4,"line":102},{"w":"before","s":247.44,"e":247.74,"line":102},{"w":"the","s":247.74,"e":248,"line":102},{"w":"glory,","s":248,"e":248.36,"line":102},{"w":"before","s":248.36,"e":248.74,"line":103},{"w":"the","s":248.74,"e":248.92,"line":103},{"w":"whole","s":248.92,"e":249.36,"line":103},{"w":"world","s":249.36,"e":249.64,"line":103},{"w":"heard","s":249.64,"e":250.26,"line":103},{"w":"my","s":250.26,"e":251.82,"line":103},{"w":"story.","s":251.82,"e":251.9,"line":103},{"w":"I","s":251.82,"e":252.28,"line":104},{"w":"had","s":252.28,"e":252.56,"line":104},{"w":"breath,","s":252.56,"e":253,"line":104},{"w":"I","s":253.06,"e":253.28,"line":104},{"w":"had","s":253.28,"e":253.42,"line":104},{"w":"love,","s":253.42,"e":254.36,"line":104},{"w":"I","s":255.4,"e":256.32,"line":105},{"w":"had","s":256.32,"e":256.4,"line":105},{"w":"life","s":256.32,"e":256.66,"line":105},{"w":"pouring","s":256.66,"e":257.12,"line":105},{"w":"through","s":257.12,"e":257.66,"line":105},{"w":"me.","s":257.66,"e":258.36,"line":105},{"w":"And","s":259.12,"e":259.8,"line":106},{"w":"if","s":259.8,"e":259.9,"line":106},{"w":"the","s":259.9,"e":260.2,"line":106},{"w":"millions","s":260.2,"e":260.36,"line":106},{"w":"come","s":260.36,"e":260.88,"line":106},{"w":"tomorrow,","s":260.88,"e":261.62,"line":106},{"w":"I’ll","s":261.98,"e":262.21,"line":107},{"w":"thank","s":262.44,"e":262.8,"line":107},{"w":"God—but","s":263.22,"e":263.68,"line":107},{"w":"they","s":263.68,"e":264,"line":107},{"w":"won’t","s":264,"e":264.18,"line":107},{"w":"define","s":264.36,"e":265.1,"line":107},{"w":"me.","s":265.1,"e":266.46,"line":107},{"w":"**Rich","s":266.46,"e":266.9,"line":108},{"w":"before","s":266.9,"e":267.58,"line":108},{"w":"the","s":267.58,"e":268.4,"line":108},{"w":"money.","s":268.4,"e":269.3,"line":108},{"w":"Rich","s":278.16,"e":278.34,"line":109},{"w":"before","s":278.34,"e":279.28,"line":109},{"w":"the","s":279.28,"e":279.7,"line":109},{"w":"money.**","s":279.7,"e":280.3,"line":109},{"w":"Turns","s":281.93,"e":282.5,"line":110},{"w":"out—","s":282.5,"e":282.88,"line":110},{"w":"**I","s":282.88,"e":283.24,"line":111},{"w":"had","s":283.24,"e":283.84,"line":111},{"w":"plenty.**","s":283.84,"e":284.38,"line":111}],"lines":[{"s":0.882,"e":2.476,"text":"# Rich Before the Money"},{"s":2.476,"e":2.976,"text":"**[Intro]**"},{"s":2.94,"e":7.26,"text":"Before the bands, before the brand,"},{"s":7.78,"e":10.52,"text":"before the bright lights knew my name—"},{"s":11.72,"e":14.68,"text":"I had breath inside my body,"},{"s":14.86,"e":19.04,"text":"I had blood inside my veins."},{"s":19.06,"e":22.86,"text":"Turns out I had plenty."},{"s":22.86,"e":23.36,"text":"**[Verse 1]**"},{"s":37.36,"e":39.4,"text":"Sun spilling gold through a slit in the shade,"},{"s":39.4,"e":41.28,"text":"steam from the coffee, another day made,"},{"s":41.28,"e":43.22,"text":"feet on the floor and a roof overhead,"},{"s":43.22,"e":45.2,"text":"food in the fridge and a dream in my head."},{"s":45.2,"e":46.92,"text":"Phone full of people who pick up at two,"},{"s":46.92,"e":48.8,"text":"friends know my flaws and still follow me through,"},{"s":48.98,"e":50.68,"text":"family calling just checking I’m straight—"},{"s":50.68,"e":53.24,"text":"fortune was hiding in plain sight all day."},{"s":53.24,"e":55.12,"text":"Chasing the chain, chasing change, chasing cheers,"},{"s":55.12,"e":56.84,"text":"measuring miracles yearly in tiers,"},{"s":56.76,"e":58.78,"text":"while the wind through the window kept whispering clear:"},{"s":58.78,"e":65.06,"text":"“You got somebody who loves you—your treasure is here.”"},{"s":67.28,"e":69.56,"text":"Stars for a ceiling, songs for the stress,"},{"s":69.56,"e":71.92,"text":"scars saying somehow I survived every mess,"},{"s":71.92,"e":73.66,"text":"heart that could hurt, heal, hope and progress—"},{"s":73.66,"e":75.72,"text":"I was begging for more while already blessed."},{"s":75.72,"e":76.22,"text":"**[Pre-Chorus]**"},{"s":75.72,"e":77.48,"text":"Counted every dollar that I didn’t possess,"},{"s":77.48,"e":79.48,"text":"never counted every “call me if you’re stressed.”"},{"s":79.48,"e":81.24,"text":"Counted every door that slammed in my face,"},{"s":81.24,"e":83.16,"text":"never counted every morning arriving with grace."},{"s":83.16,"e":83.66,"text":"**[Chorus]**"},{"s":83.16,"e":86.9,"text":"I was **rich before the money,**"},{"s":87.3,"e":89,"text":"rich before the racks,"},{"s":89,"e":91.98,"text":"rich when all I had was hope"},{"s":93.04,"e":95.82,"text":"and a little gas in the tank."},{"s":97.64,"e":99.52,"text":"Rich with the rain running,"},{"s":99.52,"e":101.42,"text":"rich with the sun above me,"},{"s":101.34,"e":102.72,"text":"rich with a table"},{"s":102.72,"e":105.12,"text":"and somebody who loved me."},{"s":105.14,"e":106.44,"text":"**Rich before the money.**"},{"s":106.44,"e":108.36,"text":"Before the gold, before the glory,"},{"s":108.36,"e":111.62,"text":"before the whole world heard my story—"},{"s":111.62,"e":115.44,"text":"I had love, I had life,"},{"s":115.68,"e":119.4,"text":"I had more than enough for me."},{"s":119.4,"e":121.44,"text":"I was **rich before the money.**"},{"s":121.44,"e":121.94,"text":"**[Verse 2]**"},{"s":127.48,"e":129.36,"text":"Clean cold water—what’s richer than that?"},{"s":129.36,"e":131.68,"text":"Laugh so hard that you lean all the way back."},{"s":131.68,"e":133.52,"text":"Dog by the doorway, dusk going dark,"},{"s":133.52,"e":135.46,"text":"moon on the windshield and miles in the heart."},{"s":135.46,"e":137.26,"text":"Fresh pair of socks and a song hitting right,"},{"s":137.26,"e":139.12,"text":"safe trip home through the soft city lights,"},{"s":139.26,"e":141.16,"text":"somebody texting me, “Tell me you’re fine,”"},{"s":141.16,"e":143.06,"text":"all of these diamonds that never get mined."},{"s":143.06,"e":145.18,"text":"We want bigger, brighter, better, more—"},{"s":145.18,"e":147.5,"text":"more square feet, more seats, more keys, more doors,"},{"s":147.5,"e":149.42,"text":"but a mansion means nothing when peace packs its bags,"},{"s":149.42,"e":151.44,"text":"and a million means little when love never lasts."},{"s":151.44,"e":153.3,"text":"Give me good people and give me good purpose,"},{"s":153.3,"e":155.14,"text":"give me the grit when the work feels worthless,"},{"s":155.14,"e":157,"text":"give me the wisdom to notice what’s working—"},{"s":157,"e":158.92,"text":"wealth isn’t wealth if your spirit stays starving."},{"s":158.92,"e":159.42,"text":"**[Pre-Chorus]**"},{"s":158.92,"e":160.74,"text":"Count every kindness, count every call,"},{"s":160.74,"e":162.56,"text":"count every hand that reached when you’d fall."},{"s":162.56,"e":164.68,"text":"Count every breath you were never guaranteed—"},{"s":165.3,"e":171.82,"text":"suddenly enough starts looking like everything."},{"s":171.82,"e":172.32,"text":"**[Bridge]**"},{"s":172.7,"e":174.92,"text":"If all the glitter disappeared tonight,"},{"s":174.98,"e":176.82,"text":"leave me love, leave me light."},{"s":176.82,"e":178.78,"text":"Leave me laughter round a kitchen table,"},{"s":178.78,"e":180.64,"text":"leave me strength enough to know I’m able."},{"s":180.64,"e":182.72,"text":"Leave me stars when the streetlights fade,"},{"s":182.72,"e":184.58,"text":"leave me peace that a price can’t pay."},{"s":184.58,"e":186.3,"text":"Fortunes fall and fortunes flee,"},{"s":186.3,"e":188.62,"text":"but what is priceless stays with me."},{"s":188.62,"e":189.12,"text":"**[Rap Build]**"},{"s":188.62,"e":190.72,"text":"Big bank someday—beautiful, bring it,"},{"s":190.72,"e":193.8,"text":"but I won’t let a balance determine my spirit."},{"s":193.8,"e":195.54,"text":"Build big buildings, buy brilliant things,"},{"s":195.54,"e":197.52,"text":"still know breakfast with family can feel like a kingdom."},{"s":197.52,"e":199.8,"text":"Bread breaking, belly laughing, breeze in the trees,"},{"s":199.8,"e":201.72,"text":"bare feet, back porch, being at peace."},{"s":201.72,"e":203.58,"text":"Blessed with a breath and the freedom to breathe—"},{"s":203.58,"e":206.46,"text":"what billionaire buys one more heartbeat guaranteed?"},{"s":206.46,"e":207.76,"text":"No receipt for relief."},{"s":207.88,"e":209.78,"text":"No price tag on peace."},{"s":209.82,"e":211.54,"text":"No market for memories."},{"s":211.66,"e":213.38,"text":"No lease on belief."},{"s":213.44,"e":215.6,"text":"When success comes dressed in diamonds and drums,"},{"s":215.6,"e":217.46,"text":"I’ll remember exactly where all of this begun:"},{"s":217.46,"e":219.48,"text":"not a vault, not a yacht, not applause from a crowd—"},{"s":219.48,"e":222.8,"text":"just being alive and awake enough to notice it now."},{"s":222.8,"e":223.3,"text":"**[Final Chorus]**"},{"s":222.8,"e":225.56,"text":"I was **RICH BEFORE THE MONEY,**"},{"s":225.56,"e":227.42,"text":"rich before the fame,"},{"s":227.42,"e":229.76,"text":"rich when nobody knew me,"},{"s":229.76,"e":231.9,"text":"still had love beside my name."},{"s":231.9,"e":233.94,"text":"Rich with the rain running,"},{"s":233.94,"e":237.76,"text":"rich with the sun above me,"},{"s":237.76,"e":241.02,"text":"rich with these scars, these stars,"},{"s":241.18,"e":243.68,"text":"these arms around me."},{"s":244.62,"e":246.5,"text":"**RICH BEFORE THE MONEY,**"},{"s":246.72,"e":248.36,"text":"before the gold, before the glory,"},{"s":248.36,"e":251.9,"text":"before the whole world heard my story."},{"s":251.82,"e":254.36,"text":"I had breath, I had love,"},{"s":255.4,"e":258.36,"text":"I had life pouring through me."},{"s":259.12,"e":261.62,"text":"And if the millions come tomorrow,"},{"s":261.98,"e":266.46,"text":"I’ll thank God—but they won’t define me."},{"s":266.46,"e":269.3,"text":"**Rich before the money."},{"s":278.16,"e":280.3,"text":"Rich before the money.**"},{"s":281.93,"e":282.88,"text":"Turns out—"},{"s":282.88,"e":284.38,"text":"**I had plenty.**"}],"duration":287.16,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.623Z","stats":{"whisperWords":761,"polishedWords":709,"matched":654,"matchRate":0.922}}