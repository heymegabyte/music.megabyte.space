er","s":265.2,"e":265.4,"line":62},{"w":"each","s":265.4,"e":265.78,"line":62},{"w":"morning,","s":265.78,"e":266.34,"line":62},{"w":"I’m","s":266.4,"e":266.68,"line":62},{"w":"made","s":266.96,"e":267.04,"line":62},{"w":"for","s":266.96,"e":267.28,"line":62},{"w":"the","s":267.28,"e":267.46,"line":62},{"w":"fight,","s":267.46,"e":267.76,"line":62},{"w":"And","s":267.78,"e":268.14,"line":63},{"w":"the","s":268.14,"e":268.26,"line":63},{"w":"spirit","s":268.26,"e":268.84,"line":63},{"w":"keeps","s":268.84,"e":269.4,"line":63},{"w":"pushing","s":269.4,"e":269.74,"line":63},{"w":"me","s":269.74,"e":270.82,"line":63},{"w":"into","s":270.82,"e":271.28,"line":63},{"w":"the","s":271.28,"e":271.84,"line":63},{"w":"light.","s":271.84,"e":272.44,"line":63},{"w":"Outro","s":278.78,"e":283.32,"line":64},{"w":"One","s":285.3,"e":286.5,"line":65},{"w":"more","s":286.5,"e":286.82,"line":65},{"w":"step","s":286.82,"e":287.14,"line":65},{"w":"when","s":287.14,"e":295.98,"line":65},{"w":"my","s":295.98,"e":296.06,"line":65},{"w":"body","s":296,"e":298.12,"line":65},{"w":"says","s":298.12,"e":298.2,"line":65},{"w":"no,","s":298.12,"e":298.2,"line":65},{"w":"One","s":298.12,"e":298.2,"line":66},{"w":"more","s":298.12,"e":298.2,"line":66},{"w":"breath","s":298.12,"e":298.2,"line":66},{"w":"and","s":298.12,"e":298.2,"line":66},{"w":"I","s":298.12,"e":298.2,"line":66},{"w":"start","s":298.12,"e":298.2,"line":66},{"w":"to","s":298.12,"e":298.2,"line":66},{"w":"glow,","s":298.12,"e":298.2,"line":66},{"w":"Every","s":298.12,"e":298.2,"line":67},{"w":"day","s":298.12,"e":298.2,"line":67},{"w":"I","s":298.12,"e":298.2,"line":67},{"w":"touch","s":298.12,"e":298.2,"line":67},{"w":"the","s":298.12,"e":298.2,"line":67},{"w":"sky—","s":298.12,"e":298.68,"line":67},{"w":"No","s":298.68,"e":298.76,"line":68},{"w":"level","s":298.68,"e":299.2,"line":68},{"w":"can","s":299.2,"e":299.54,"line":68},{"w":"break","s":299.54,"e":299.88,"line":68},{"w":"me.","s":299.88,"e":300.28,"line":68},{"w":"I","s":304.26,"e":305.3,"line":69},{"w":"was","s":305.3,"e":305.76,"line":69},{"w":"born","s":305.76,"e":306.2,"line":69},{"w":"to","s":306.2,"e":307.06,"line":69},{"w":"climb","s":307.06,"e":307.14,"line":69}],"lines":[{"s":0,"e":0.14,"text":"Verse 1"},{"s":35.76,"e":45.36,"text":"I step on the stairs while the world’s still asleep,"},{"s":45.88,"e":49.08,"text":"A promise in my chest that I’m trying to keep,"},{"s":49.7,"e":52.54,"text":"Yesterday’s weakness is calling my name,"},{"s":52.54,"e":56.2,"text":"But today I rise higher through sweat and through flame."},{"s":56.48,"e":59.5,"text":"My legs start shaking, my breath gets thin,"},{"s":59.82,"e":63.04,"text":"That old little voice says, “You won’t win,”"},{"s":63.46,"e":66.6,"text":"Then something behind me says, “Not today,"},{"s":66.68,"e":70.8,"text":"You were born to climb, now lead the way.”"},{"s":70.8,"e":70.92,"text":"Pre-Chorus"},{"s":70.92,"e":73.88,"text":"It’s not just muscle, it’s not just pride,"},{"s":74.26,"e":77.38,"text":"It’s the mountain I’m building inside,"},{"s":77.74,"e":81.1,"text":"Every step is a prayer I make,"},{"s":81.76,"e":85.42,"text":"Every level is a chain I break."},{"s":85.42,"e":85.5,"text":"Chorus"},{"s":85.42,"e":89.22,"text":"I climb, I climb, I rise through the fire,"},{"s":89.72,"e":92.82,"text":"Every step takes my spirit higher,"},{"s":93.16,"e":96.1,"text":"I won’t quit, I won’t fall, I won’t run,"},{"s":96.76,"e":99.6,"text":"I’m becoming what I’ve already won."},{"s":99.66,"e":103.08,"text":"No level can break me, no pain can define me,"},{"s":103.2,"e":106.94,"text":"No shadow behind me can ever outshine me,"},{"s":106.94,"e":110.06,"text":"I’m stronger than fear, I’m alive in the fight,"},{"s":110.08,"e":114.8,"text":"And the spirit keeps pushing me into the light."},{"s":120.26,"e":123.9,"text":"Verse 2"},{"s":126.88,"e":130.62,"text":"Some days I’m tired, some days I’m lost,"},{"s":130.92,"e":134.1,"text":"Some dreams only bloom when you pay the cost,"},{"s":134.4,"e":137.56,"text":"But I hear that voice when my body gets weak,"},{"s":138.3,"e":141.36,"text":"“Keep climbing, child, there’s a summit to meet.”"},{"s":141.92,"e":144.62,"text":"Level by level, I bury my doubt,"},{"s":144.98,"e":148.04,"text":"Every excuse gets burned coming out,"},{"s":148.3,"e":151.44,"text":"I’m not chasing perfect, I’m chasing true,"},{"s":151.74,"e":155.96,"text":"The person I prayed for is finally breaking through."},{"s":155.96,"e":156.06,"text":"Pre-Chorus"},{"s":156.06,"e":158.7,"text":"This is discipline, this is grace,"},{"s":158.7,"e":162.56,"text":"This is heaven at a human pace,"},{"s":162.88,"e":165.76,"text":"Every drop of sweat that hits the ground"},{"s":165.76,"e":168.5,"text":"Is proof I’m still here, still glory-bound."},{"s":168.5,"e":170.16,"text":"Chorus"},{"s":170.22,"e":173.86,"text":"I climb, I climb, I rise through the fire,"},{"s":174.44,"e":177.52,"text":"Every step takes my spirit higher,"},{"s":177.92,"e":180.7,"text":"I won’t quit, I won’t fall, I won’t run,"},{"s":181.38,"e":183.82,"text":"I’m becoming what I’ve already won."},{"s":184.28,"e":187.78,"text":"No level can break me, no pain can define me,"},{"s":188.02,"e":191.52,"text":"No shadow behind me can ever outshine me,"},{"s":191.52,"e":194.54,"text":"I’m stronger than fear, I’m alive in the fight,"},{"s":194.6,"e":199.2,"text":"And the spirit keeps pushing me into the light."},{"s":205.54,"e":208.38,"text":"Bridge"},{"s":212.68,"e":215.88,"text":"Push me when I’m empty, push me when I’m low,"},{"s":216.4,"e":219.14,"text":"Push me through the places only warriors go,"},{"s":219.16,"e":222.98,"text":"When my heart is pounding like a drum in my chest,"},{"s":223.08,"e":226.36,"text":"Remind me that pressure is making me blessed."},{"s":226.42,"e":229.92,"text":"I’m not just climbing stairs, I’m climbing my fate,"},{"s":230.62,"e":233.12,"text":"Leaving behind every reason to wait,"},{"s":233.58,"e":236.6,"text":"The old me is gone with the sweat on the floor,"},{"s":237.02,"e":242.44,"text":"The new me is knocking down every door."},{"s":242.44,"e":243.16,"text":"Final Chorus"},{"s":243.52,"e":247.66,"text":"I climb, I climb, with fire in my veins,"},{"s":247.64,"e":250.58,"text":"Turning every struggle into strength from the pain,"},{"s":250.74,"e":253.18,"text":"I won’t quit, I won’t fold, I won’t hide,"},{"s":254.24,"e":257.64,"text":"There’s a lion waking up inside."},{"s":257.72,"e":261.14,"text":"No level can break me, no storm can deny me,"},{"s":261.18,"e":264.84,"text":"No fear in my body can ever confine me,"},{"s":264.86,"e":267.76,"text":"I’m stronger each morning, I’m made for the fight,"},{"s":267.78,"e":272.44,"text":"And the spirit keeps pushing me into the light."},{"s":278.78,"e":283.32,"text":"Outro"},{"s":285.3,"e":298.2,"text":"One more step when my body says no,"},{"s":298.12,"e":298.2,"text":"One more breath and I start to glow,"},{"s":298.12,"e":298.68,"text":"Every day I touch the sky—"},{"s":298.68,"e":300.28,"text":"No level can break me."},{"s":304.26,"e":307.14,"text":"I was born to climb"}],"duration":317.88,"source":"whisper-aligned","generatedAt":"2026-06-17T12:24:27.162Z","stats":{"whisperWords":524,"polishedWords":540,"matched":508,"matchRate":0.941}}