":"the","s":268.1,"e":268.42,"line":56},{"w":"spirit","s":268.42,"e":268.84,"line":56},{"w":"keeps","s":268.84,"e":269.38,"line":56},{"w":"pushing","s":269.38,"e":269.74,"line":56},{"w":"me","s":269.74,"e":270.8,"line":56},{"w":"into","s":277.3,"e":278.12,"line":56},{"w":"the","s":278.12,"e":278.78,"line":56},{"w":"light.","s":278.78,"e":281.8,"line":56},{"w":"One","s":285.66,"e":286.48,"line":57},{"w":"more","s":286.48,"e":286.78,"line":57},{"w":"step","s":286.78,"e":287.04,"line":57},{"w":"when","s":287.04,"e":287.38,"line":57},{"w":"my","s":287.38,"e":287.84,"line":57},{"w":"body","s":287.84,"e":287.92,"line":57},{"w":"says","s":287.92,"e":288.42,"line":57},{"w":"no,","s":288.42,"e":288.84,"line":57},{"w":"One","s":288.98,"e":289.84,"line":58},{"w":"more","s":289.84,"e":290.26,"line":58},{"w":"breath","s":290.26,"e":290.64,"line":58},{"w":"and","s":290.64,"e":290.94,"line":58},{"w":"I","s":290.94,"e":291.34,"line":58},{"w":"start","s":291.34,"e":291.66,"line":58},{"w":"to","s":291.66,"e":292.14,"line":58},{"w":"glow,","s":292.14,"e":292.28,"line":58},{"w":"Every","s":293.08,"e":293.52,"line":59},{"w":"day","s":293.52,"e":294.1,"line":59},{"w":"I","s":294.1,"e":294.54,"line":59},{"w":"touch","s":294.54,"e":294.88,"line":59},{"w":"the","s":294.88,"e":297.8,"line":59},{"w":"sky—","s":297.8,"e":298,"line":59},{"w":"No","s":298.44,"e":298.72,"line":60},{"w":"level","s":298.72,"e":299.2,"line":60},{"w":"can","s":299.2,"e":299.56,"line":60},{"w":"break","s":299.56,"e":299.88,"line":60},{"w":"me.","s":299.88,"e":300.24,"line":60},{"w":"I","s":305.04,"e":305.48,"line":61},{"w":"was","s":305.48,"e":305.76,"line":61},{"w":"born","s":305.76,"e":306.2,"line":61},{"w":"to","s":306.2,"e":307.04,"line":61},{"w":"climb","s":307.04,"e":307.12,"line":61}],"lines":[{"s":35.76,"e":45.36,"text":"I step on the stairs while the world’s still asleep,"},{"s":45.82,"e":49.26,"text":"A promise in my chest that I’m trying to keep,"},{"s":49.7,"e":52.56,"text":"Yesterday’s weakness is calling my name,"},{"s":52.56,"e":56.18,"text":"But today I rise higher through sweat and through flame."},{"s":56.18,"e":59.5,"text":"My legs start shaking, my breath gets thin,"},{"s":59.76,"e":63.06,"text":"That old little voice says, “You won’t win,”"},{"s":63.12,"e":66.62,"text":"Then something behind me says, “Not today,"},{"s":66.64,"e":70.8,"text":"You were born to climb, now lead the way.”"},{"s":70.94,"e":73.86,"text":"It’s not just muscle, it’s not just pride,"},{"s":74.46,"e":77.44,"text":"It’s the mountain I’m building inside,"},{"s":78.08,"e":81.1,"text":"Every step is a prayer I make,"},{"s":81.34,"e":84.84,"text":"Every level is a chain I break."},{"s":84.84,"e":89.3,"text":"I climb, I climb, I rise through the fire,"},{"s":89.6,"e":92.86,"text":"Every step takes my spirit higher,"},{"s":93.32,"e":96.1,"text":"I won’t quit, I won’t fall, I won’t run,"},{"s":96.74,"e":99.62,"text":"I’m becoming what I’ve already won."},{"s":99.66,"e":103.2,"text":"No level can break me, no pain can define me,"},{"s":103.22,"e":106.94,"text":"No shadow behind me can ever outshine me,"},{"s":106.94,"e":110.02,"text":"I’m stronger than fear, I’m alive in the fight,"},{"s":110.02,"e":121.94,"text":"And the spirit keeps pushing me into the light."},{"s":126.96,"e":130.58,"text":"Some days I’m tired, some days I’m lost,"},{"s":130.72,"e":134,"text":"Some dreams only bloom when you pay the cost,"},{"s":133.96,"e":137.62,"text":"But I hear that voice when my body gets weak,"},{"s":137.62,"e":141.06,"text":"“Keep climbing, child, there’s a summit to meet.”"},{"s":141.94,"e":144.62,"text":"Level by level, I bury my doubt,"},{"s":145,"e":148.04,"text":"Every excuse gets burned coming out,"},{"s":148.48,"e":151.58,"text":"I’m not chasing perfect, I’m chasing true,"},{"s":151.74,"e":155.96,"text":"The person I prayed for is finally breaking through."},{"s":156.16,"e":158.7,"text":"This is discipline, this is grace,"},{"s":159.48,"e":162.28,"text":"This is heaven at a human pace,"},{"s":162.28,"e":165.76,"text":"Every drop of sweat that hits the ground"},{"s":165.76,"e":170.16,"text":"Is proof I’m still here, still glory-bound."},{"s":170.26,"e":173.86,"text":"I climb, I climb, I rise through the fire,"},{"s":174.4,"e":177.5,"text":"Every step takes my spirit higher,"},{"s":177.94,"e":180.72,"text":"I won’t quit, I won’t fall, I won’t run,"},{"s":181.38,"e":184.22,"text":"I’m becoming what I’ve already won."},{"s":184.28,"e":187.82,"text":"No level can break me, no pain can define me,"},{"s":187.82,"e":191.48,"text":"No shadow behind me can ever outshine me,"},{"s":191.48,"e":194.5,"text":"I’m stronger than fear, I’m alive in the fight,"},{"s":194.5,"e":206.48,"text":"And the spirit keeps pushing me into the light."},{"s":212.62,"e":215.88,"text":"Push me when I’m empty, push me when I’m low,"},{"s":216.2,"e":219.1,"text":"Push me through the places only warriors go,"},{"s":219.1,"e":222.98,"text":"When my heart is pounding like a drum in my chest,"},{"s":223.08,"e":226.34,"text":"Remind me that pressure is making me blessed."},{"s":226.36,"e":229.98,"text":"I’m not just climbing stairs, I’m climbing my fate,"},{"s":230.28,"e":233.28,"text":"Leaving behind every reason to wait,"},{"s":233.46,"e":236.6,"text":"The old me is gone with the sweat on the floor,"},{"s":236.62,"e":241.64,"text":"The new me is knocking down every door."},{"s":241.64,"e":242.827,"text":"Final Chorus"},{"s":243.42,"e":247.66,"text":"I climb, I climb, with fire in my veins,"},{"s":247.66,"e":250.52,"text":"Turning every struggle into strength from the pain,"},{"s":250.6,"e":253.66,"text":"I won’t quit, I won’t fold, I won’t hide,"},{"s":253.94,"e":256.64,"text":"There’s a lion waking up inside."},{"s":257.7,"e":261.14,"text":"No level can break me, no storm can deny me,"},{"s":261.16,"e":264.8,"text":"No fear in my body can ever confine me,"},{"s":264.8,"e":267.76,"text":"I’m stronger each morning, I’m made for the fight,"},{"s":267.8,"e":281.8,"text":"And the spirit keeps pushing me into the light."},{"s":285.66,"e":288.84,"text":"One more step when my body says no,"},{"s":288.98,"e":292.28,"text":"One more breath and I start to glow,"},{"s":293.08,"e":298,"text":"Every day I touch the sky—"},{"s":298.44,"e":300.24,"text":"No level can break me."},{"s":305.04,"e":307.12,"text":"I was born to climb"}],"duration":317.88,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.407Z","stats":{"whisperWords":539,"polishedWords":530,"matched":525,"matchRate":0.991}}