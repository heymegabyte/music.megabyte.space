97.374,"e":297.862,"line":58},{"w":"Every","s":297.862,"e":299.327,"line":59},{"w":"day","s":299.327,"e":299.816,"line":59},{"w":"I","s":299.816,"e":300.304,"line":59},{"w":"touch","s":300.304,"e":300.792,"line":59},{"w":"the","s":300.792,"e":301.28,"line":59},{"w":"sky—","s":301.28,"e":301.769,"line":59},{"w":"No","s":301.769,"e":302.257,"line":60},{"w":"level","s":302.257,"e":303.234,"line":60},{"w":"can","s":303.234,"e":303.722,"line":60},{"w":"break","s":303.722,"e":304.21,"line":60},{"w":"me.","s":304.21,"e":304.699,"line":60},{"w":"I","s":304.699,"e":305.187,"line":61},{"w":"was","s":305.187,"e":305.675,"line":61},{"w":"born","s":305.675,"e":306.163,"line":61},{"w":"to","s":306.163,"e":306.652,"line":61},{"w":"climb","s":306.652,"e":307.14,"line":61}],"lines":[{"s":0,"e":5.371,"text":"I step on the stairs while the world’s still asleep,"},{"s":5.371,"e":10.743,"text":"A promise in my chest that I’m trying to keep,"},{"s":10.743,"e":15.626,"text":"Yesterday’s weakness is calling my name,"},{"s":15.626,"e":21.485,"text":"But today I rise higher through sweat and through flame."},{"s":21.485,"e":25.88,"text":"My legs start shaking, my breath gets thin,"},{"s":25.88,"e":30.275,"text":"That old little voice says, “You won’t win,”"},{"s":30.275,"e":35.646,"text":"Then something behind me says, “Not today,"},{"s":35.646,"e":40.041,"text":"You were born to climb, now lead the way.”"},{"s":40.041,"e":44.435,"text":"It’s not just muscle, it’s not just pride,"},{"s":44.435,"e":48.83,"text":"It’s the mountain I’m building inside,"},{"s":48.83,"e":53.225,"text":"Every step is a prayer I make,"},{"s":53.225,"e":58.108,"text":"Every level is a chain I break."},{"s":58.108,"e":62.502,"text":"I climb, I climb, I rise through the fire,"},{"s":62.502,"e":67.874,"text":"Every step takes my spirit higher,"},{"s":67.874,"e":72.268,"text":"I won’t quit, I won’t fall, I won’t run,"},{"s":72.268,"e":77.151,"text":"I’m becoming what I’ve already won."},{"s":77.151,"e":83.011,"text":"No level can break me, no pain can define me,"},{"s":83.011,"e":88.87,"text":"No shadow behind me can ever outshine me,"},{"s":88.87,"e":94.242,"text":"I’m stronger than fear, I’m alive in the fight,"},{"s":94.242,"e":100.101,"text":"And the spirit keeps pushing me into the light."},{"s":100.101,"e":104.496,"text":"Some days I’m tired, some days I’m lost,"},{"s":104.496,"e":109.379,"text":"Some dreams only bloom when you pay the cost,"},{"s":109.379,"e":114.75,"text":"But I hear that voice when my body gets weak,"},{"s":114.75,"e":120.122,"text":"“Keep climbing, child, there’s a summit to meet.”"},{"s":120.122,"e":125.005,"text":"Level by level, I bury my doubt,"},{"s":125.005,"e":130.376,"text":"Every excuse gets burned coming out,"},{"s":130.376,"e":135.259,"text":"I’m not chasing perfect, I’m chasing true,"},{"s":135.259,"e":141.607,"text":"The person I prayed for is finally breaking through."},{"s":141.607,"e":145.513,"text":"This is discipline, this is grace,"},{"s":145.513,"e":149.908,"text":"This is heaven at a human pace,"},{"s":149.908,"e":154.791,"text":"Every drop of sweat that hits the ground"},{"s":154.791,"e":159.185,"text":"Is proof I’m still here, still glory-bound."},{"s":159.185,"e":163.58,"text":"I climb, I climb, I rise through the fire,"},{"s":163.58,"e":168.951,"text":"Every step takes my spirit higher,"},{"s":168.951,"e":173.346,"text":"I won’t quit, I won’t fall, I won’t run,"},{"s":173.346,"e":178.229,"text":"I’m becoming what I’ve already won."},{"s":178.229,"e":184.089,"text":"No level can break me, no pain can define me,"},{"s":184.089,"e":189.948,"text":"No shadow behind me can ever outshine me,"},{"s":189.948,"e":195.32,"text":"I’m stronger than fear, I’m alive in the fight,"},{"s":195.32,"e":201.179,"text":"And the spirit keeps pushing me into the light."},{"s":201.179,"e":206.55,"text":"Push me when I’m empty, push me when I’m low,"},{"s":206.55,"e":211.922,"text":"Push me through the places only warriors go,"},{"s":211.922,"e":217.781,"text":"When my heart is pounding like a drum in my chest,"},{"s":217.781,"e":223.641,"text":"Remind me that pressure is making me blessed."},{"s":223.641,"e":229.012,"text":"I’m not just climbing stairs, I’m climbing my fate,"},{"s":229.012,"e":234.383,"text":"Leaving behind every reason to wait,"},{"s":234.383,"e":239.755,"text":"The old me is gone with the sweat on the floor,"},{"s":239.755,"e":245.126,"text":"The new me is knocking down every door."},{"s":245.126,"e":247.079,"text":"Final Chorus"},{"s":247.079,"e":251.474,"text":"I climb, I climb, with fire in my veins,"},{"s":251.474,"e":257.822,"text":"Turning every struggle into strength from the pain,"},{"s":257.822,"e":262.217,"text":"I won’t quit, I won’t fold, I won’t hide,"},{"s":262.217,"e":266.611,"text":"There’s a lion waking up inside."},{"s":266.611,"e":272.471,"text":"No level can break me, no storm can deny me,"},{"s":272.471,"e":278.33,"text":"No fear in my body can ever confine me,"},{"s":278.33,"e":283.702,"text":"I’m stronger each morning, I’m made for the fight,"},{"s":283.702,"e":289.561,"text":"And the spirit keeps pushing me into the light."},{"s":289.561,"e":293.956,"text":"One more step when my body says no,"},{"s":293.956,"e":297.862,"text":"One more breath and I start to glow,"},{"s":297.862,"e":301.769,"text":"Every day I touch the sky—"},{"s":301.769,"e":304.699,"text":"No level can break me."},{"s":304.699,"e":307.14,"text":"I was born to climb"}],"duration":317.88,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.858Z","realignedFrom":"whisper-aligned","vocalStart":0,"vocalEnd":307.14}