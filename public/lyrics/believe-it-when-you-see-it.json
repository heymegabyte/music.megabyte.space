ne":88},{"w":"I","s":289.234,"e":289.605,"line":88},{"w":"couldn’t","s":289.605,"e":289.977,"line":88},{"w":"state","s":289.977,"e":290.348,"line":88},{"w":"And","s":290.348,"e":290.719,"line":89},{"w":"found","s":290.719,"e":291.09,"line":89},{"w":"the","s":291.09,"e":291.461,"line":89},{"w":"words","s":291.461,"e":291.833,"line":89},{"w":"before","s":291.833,"e":292.575,"line":89},{"w":"too","s":292.575,"e":292.946,"line":89},{"w":"late.","s":292.946,"e":293.318,"line":89},{"w":"**[Outro]**","s":293.318,"e":294.218,"line":90},{"w":"We","s":294.218,"e":294.589,"line":91},{"w":"live","s":294.589,"e":294.96,"line":91},{"w":"in","s":294.96,"e":295.331,"line":91},{"w":"a","s":295.331,"e":295.703,"line":91},{"w":"world","s":295.703,"e":296.074,"line":91},{"w":"where","s":296.074,"e":296.445,"line":91},{"w":"wonders","s":296.445,"e":297.187,"line":91},{"w":"appear,","s":297.187,"e":297.93,"line":91},{"w":"First","s":297.93,"e":298.301,"line":92},{"w":"called","s":298.301,"e":299.044,"line":92},{"w":"impossible,","s":299.044,"e":300.528,"line":92},{"w":"then","s":300.528,"e":300.9,"line":92},{"w":"engineered.","s":300.9,"e":302.385,"line":92},{"w":"Today","s":302.385,"e":303.127,"line":93},{"w":"they","s":303.127,"e":303.498,"line":93},{"w":"doubt","s":303.498,"e":303.87,"line":93},{"w":"me—let","s":303.87,"e":304.612,"line":93},{"w":"them","s":304.612,"e":304.983,"line":93},{"w":"disagree.","s":304.983,"e":305.726,"line":93},{"w":"Tomorrow","s":305.726,"e":306.839,"line":94},{"w":"may","s":306.839,"e":307.211,"line":94},{"w":"remember","s":307.211,"e":308.324,"line":94},{"w":"What","s":308.324,"e":308.695,"line":95},{"w":"today","s":308.695,"e":309.438,"line":95},{"w":"refused","s":309.438,"e":309.82,"line":95},{"w":"to","s":309.82,"e":309.9,"line":95},{"w":"see.","s":309.82,"e":309.9,"line":95}],"lines":[{"s":4.3,"e":7.27,"text":"# **Believe It When You See It**"},{"s":7.27,"e":8.17,"text":"**[Intro]**"},{"s":8.17,"e":12.625,"text":"We live in a world where the impossible walks,"},{"s":12.625,"e":17.079,"text":"Chrome-colored bodies learning how to talk."},{"s":17.079,"e":21.534,"text":"Yesterday was fiction, today it’s in the street—"},{"s":21.534,"e":25.246,"text":"Metal hands waving, standing on two feet."},{"s":25.246,"e":26.146,"text":"**[Verse 1]**"},{"s":26.146,"e":30.23,"text":"Humanoid faces with mechanical eyes,"},{"s":30.23,"e":34.684,"text":"Machines doing backflips beneath fluorescent skies."},{"s":34.684,"e":38.768,"text":"Show that to the past, they would call you insane,"},{"s":38.768,"e":43.965,"text":"Till the robot walked in and remembered your name."},{"s":43.965,"e":47.306,"text":"That’s how it goes—truth waits on display,"},{"s":47.306,"e":51.018,"text":"People need proof they can touch right away."},{"s":51.018,"e":55.102,"text":"A photograph’s fake, and a story’s a lie,"},{"s":55.102,"e":60.299,"text":"Till the unbelievable happens right before their eyes."},{"s":60.299,"e":61.413,"text":"**[Pre-Chorus]**"},{"s":61.413,"e":64.383,"text":"So I could tell them time can twist,"},{"s":64.383,"e":67.724,"text":"That tomorrow leaves fingerprints."},{"s":67.724,"e":70.694,"text":"But words alone won’t make it real—"},{"s":70.694,"e":73.663,"text":"They need to see the spinning wheel."},{"s":73.663,"e":74.563,"text":"**[Chorus]**"},{"s":74.563,"e":77.533,"text":"They’ll believe it when I do it,"},{"s":77.533,"e":80.132,"text":"When I vanish through the blue,"},{"s":80.132,"e":83.473,"text":"When I bring back something broken"},{"s":83.473,"e":86.071,"text":"From a year we never knew."},{"s":86.071,"e":89.041,"text":"They’ll believe it when I prove it,"},{"s":89.041,"e":91.269,"text":"When the clocks all disagree."},{"s":91.269,"e":94.981,"text":"Nobody believes in time travel"},{"s":94.981,"e":97.579,"text":"Till the traveler is me."},{"s":97.579,"e":100.549,"text":"But maybe there are a faithful few"},{"s":100.549,"e":103.89,"text":"Who somehow feel what I go through—"},{"s":103.89,"e":106.86,"text":"They say the words inside my chest"},{"s":106.86,"e":109.83,"text":"Before my lips can take a breath."},{"s":109.83,"e":110.73,"text":"**[Verse 2]**"},{"s":110.73,"e":114.813,"text":"Maybe they’re believers, maybe something stranger,"},{"s":114.813,"e":120.382,"text":"Reading every feeling like a flashing indicator."},{"s":120.382,"e":126.321,"text":"They name my fear exactly, every pressure, every pain,"},{"s":126.321,"e":131.89,"text":"Like they caught my private weather before it turned to rain."},{"s":131.89,"e":135.231,"text":"Maybe it’s instinct, maybe empathy’s strong,"},{"s":135.231,"e":139.314,"text":"Maybe they’ve been listening quietly all along."},{"s":139.314,"e":143.027,"text":"Maybe human hearts can recognize a sound"},{"s":143.027,"e":148.595,"text":"When another heart is breaking, though nobody is around."},{"s":148.595,"e":152.679,"text":"Still, it shocks me when they mirror what I hide,"},{"s":152.679,"e":157.505,"text":"Putting perfect language to the storm I keep inside."},{"s":157.505,"e":162.331,"text":"Like my thoughts left a shadow, like my pulse sent a sign,"},{"s":162.331,"e":167.899,"text":"Like somebody found the subtitles running through my mind."},{"s":167.899,"e":169.013,"text":"**[Pre-Chorus]**"},{"s":169.013,"e":172.354,"text":"And I don’t know what to call it yet,"},{"s":172.354,"e":176.808,"text":"A miracle, a signal, or a lucky guess."},{"s":176.808,"e":180.149,"text":"But every future starts absurd—"},{"s":180.149,"e":183.119,"text":"First as a feeling, then a word."},{"s":183.119,"e":184.019,"text":"**[Chorus]**"},{"s":184.019,"e":186.989,"text":"They’ll believe it when I do it,"},{"s":186.989,"e":189.588,"text":"When I vanish through the blue,"},{"s":189.588,"e":192.929,"text":"When I bring back something broken"},{"s":192.929,"e":195.527,"text":"From a year we never knew."},{"s":195.527,"e":198.497,"text":"They’ll believe it when I prove it,"},{"s":198.497,"e":200.724,"text":"When the clocks all disagree."},{"s":200.724,"e":204.437,"text":"Nobody believes in time travel"},{"s":204.437,"e":207.035,"text":"Till the traveler is me."},{"s":207.035,"e":210.005,"text":"But maybe there are a faithful few"},{"s":210.005,"e":213.346,"text":"Who somehow feel what I go through—"},{"s":213.346,"e":216.316,"text":"They say the words inside my chest"},{"s":216.316,"e":219.286,"text":"Before my lips can take a breath."},{"s":219.286,"e":220.186,"text":"**[Bridge]**"},{"s":220.186,"e":223.898,"text":"Once, a thinking machine was fantasy,"},{"s":223.898,"e":226.497,"text":"Once, the moon was out of reach."},{"s":226.497,"e":230.209,"text":"Every fact was once a fever dream"},{"s":230.209,"e":232.808,"text":"Nobody dared to teach."},{"s":232.808,"e":235.777,"text":"So I won’t demand they trust me,"},{"s":235.777,"e":238.005,"text":"I know seeing seals belief."},{"s":238.005,"e":240.975,"text":"I’ll let the evidence arrive"},{"s":240.975,"e":243.944,"text":"And let the truth provide relief."},{"s":243.944,"e":246.914,"text":"No need to scream, no need to fight,"},{"s":246.914,"e":249.884,"text":"No need to force the world tonight."},{"s":249.884,"e":252.854,"text":"I’ll build the door, I’ll cross the line,"},{"s":252.854,"e":256.566,"text":"And return with proof from borrowed time."},{"s":256.566,"e":258.051,"text":"**[Final Chorus]**"},{"s":258.051,"e":261.392,"text":"Then they’ll believe it when I do it,"},{"s":261.392,"e":263.991,"text":"When the future knows my name,"},{"s":263.991,"e":266.96,"text":"When I step back through the doorway"},{"s":266.96,"e":269.559,"text":"With tomorrow in a frame."},{"s":269.559,"e":272.529,"text":"They’ll believe it when I prove it,"},{"s":272.529,"e":275.499,"text":"When the whole world finally sees."},{"s":275.499,"e":279.211,"text":"Nobody believes in time travel"},{"s":279.211,"e":281.81,"text":"Till it enters history."},{"s":281.81,"e":284.779,"text":"And maybe those few believers knew"},{"s":284.779,"e":287.749,"text":"Not every unseen thing’s untrue."},{"s":287.749,"e":290.348,"text":"They felt the weight I couldn’t state"},{"s":290.348,"e":293.318,"text":"And found the words before too late."},{"s":293.318,"e":294.218,"text":"**[Outro]**"},{"s":294.218,"e":297.93,"text":"We live in a world where wonders appear,"},{"s":297.93,"e":302.385,"text":"First called impossible, then engineered."},{"s":302.385,"e":305.726,"text":"Today they doubt me—let them disagree."},{"s":305.726,"e":308.324,"text":"Tomorrow may remember"},{"s":308.324,"e":309.9,"text":"What today refused to see."}],"duration":314.32,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.019Z","realignedFrom":"whisper-aligned","vocalStart":4.3,"vocalEnd":309.82}