I","s":209.75,"e":210.15,"line":63},{"w":"killed","s":210.15,"e":210.39,"line":63},{"w":"your","s":210.39,"e":210.81,"line":63},{"w":"dragon,","s":210.81,"e":211.15,"line":63},{"w":"now","s":211.15,"e":211.53,"line":63},{"w":"hear","s":211.53,"e":211.83,"line":63},{"w":"how","s":211.83,"e":212.17,"line":63},{"w":"I","s":212.17,"e":212.61,"line":63},{"w":"roar,","s":212.61,"e":212.69,"line":63},{"w":"I","s":212.69,"e":213.27,"line":64},{"w":"came","s":213.27,"e":213.53,"line":64},{"w":"as","s":213.53,"e":213.71,"line":64},{"w":"a","s":213.71,"e":214.29,"line":64},{"w":"soldier—I","s":214.55,"e":215.05,"line":64},{"w":"left","s":215.05,"e":215.15,"line":64},{"w":"as","s":215.15,"e":215.41,"line":64},{"w":"the","s":215.41,"e":216.03,"line":64},{"w":"war.","s":216.03,"e":216.11,"line":64},{"w":"You","s":216.11,"e":216.57,"line":65},{"w":"prayed","s":216.57,"e":216.89,"line":65},{"w":"for","s":216.89,"e":217.15,"line":65},{"w":"a","s":217.15,"e":217.91,"line":65},{"w":"savior,","s":217.91,"e":217.99,"line":65},{"w":"you","s":217.99,"e":218.41,"line":65},{"w":"summoned","s":218.41,"e":218.69,"line":65},{"w":"my","s":218.69,"e":219.07,"line":65},{"w":"fall—","s":219.07,"e":219.59,"line":65},{"w":"I","s":219.59,"e":220.33,"line":66},{"w":"killed","s":220.33,"e":220.57,"line":66},{"w":"your","s":220.57,"e":220.93,"line":66},{"w":"dragon.","s":220.93,"e":221.37,"line":66},{"w":"Now","s":222.19,"e":223.03,"line":67},{"w":"I’m","s":223.03,"e":223.29,"line":67},{"w":"feared","s":223.55,"e":223.67,"line":67},{"w":"by","s":223.67,"e":223.93,"line":67},{"w":"them","s":223.93,"e":224.17,"line":67},{"w":"all.","s":224.17,"e":225.09,"line":67},{"w":"The","s":232.77,"e":233.61,"line":69},{"w":"mountains","s":233.61,"e":233.97,"line":69},{"w":"went","s":233.97,"e":234.31,"line":69},{"w":"quiet.","s":234.31,"e":234.95,"line":69},{"w":"The","s":236.21,"e":237.05,"line":70},{"w":"sky","s":237.05,"e":237.25,"line":70},{"w":"became","s":237.25,"e":237.83,"line":70},{"w":"blue.","s":237.83,"e":238.43,"line":70},{"w":"I","s":239.93,"e":240.77,"line":71},{"w":"killed","s":240.77,"e":241.07,"line":71},{"w":"your","s":241.07,"e":241.97,"line":71},{"w":"dragon—","s":241.97,"e":242.15,"line":71},{"w":"But","s":242.65,"e":243.49,"line":72},{"w":"I","s":243.49,"e":243.95,"line":72},{"w":"did","s":243.95,"e":244.17,"line":72},{"w":"it","s":244.17,"e":244.41,"line":72},{"w":"for","s":244.41,"e":244.83,"line":72},{"w":"you.","s":244.83,"e":245.17,"line":72}],"lines":[{"s":8.48,"e":11.52,"text":"# **I Killed Your Dragon**"},{"s":11.52,"e":12.02,"text":"**[Verse 1]**"},{"s":18.67,"e":21.86,"text":"I walked through the wildfire, wrapped in the rain,"},{"s":21.86,"e":25.32,"text":"With smoke in my lungs and your name in my brain."},{"s":25.34,"e":28.5,"text":"The mountains were shaking, the moon turned red,"},{"s":28.5,"e":32.26,"text":"Your kingdom kept whispering, “The dragon’s not dead.”"},{"s":32.26,"e":35.4,"text":"It slept in the shadows, it fed on the fear,"},{"s":35.4,"e":38.92,"text":"It burned every banner that ever came near."},{"s":38.92,"e":42.22,"text":"You called it immortal, untouchable, grand—"},{"s":42.22,"e":45.8,"text":"I carried one sword and a scarred, steady hand."},{"s":45.8,"e":46.3,"text":"**[Pre-Chorus]**"},{"s":45.8,"e":48.8,"text":"No army behind me, no angel above,"},{"s":49.02,"e":52.52,"text":"Just fury for armor and vengeance for love."},{"s":52.52,"e":56,"text":"It opened its mouth and the whole world went black—"},{"s":56,"e":59.66,"text":"I stared through the fire and never stepped back."},{"s":59.66,"e":60.16,"text":"**[Chorus]**"},{"s":59.66,"e":62.84,"text":"I killed your dragon, I cut through the flame,"},{"s":62.84,"e":66.24,"text":"I stood in the ashes and shouted your name."},{"s":66.24,"e":69.54,"text":"Your monster was mighty, your legend was loud,"},{"s":69.54,"e":73.06,"text":"Now bones are its throne and its smoke is a shroud."},{"s":73.12,"e":76.44,"text":"I killed your dragon, your terror is gone,"},{"s":76.44,"e":79.82,"text":"The night lost its teeth at the edge of the dawn."},{"s":79.82,"e":83.08,"text":"You said it would break me, you swore I would fall—"},{"s":83.08,"e":85.52,"text":"I killed your dragon."},{"s":93.12,"e":95.44,"text":"I conquered it all."},{"s":95.44,"e":95.94,"text":"**[Verse 2]**"},{"s":99.88,"e":103.68,"text":"Its wings cracked the heavens, its claws carved the stone,"},{"s":103.68,"e":106.98,"text":"It guarded your secrets, your sins, and your throne."},{"s":106.98,"e":110.34,"text":"It laughed like an earthquake, it struck like a storm,"},{"s":110.26,"e":113.88,"text":"But rage made me reckless and grief kept me warm."},{"s":113.88,"e":117.02,"text":"I climbed up its spine while the valley below"},{"s":117.02,"e":120.4,"text":"Was glowing like gold in the volcanic glow."},{"s":120.4,"e":123.92,"text":"It begged without language, it bled without grace—"},{"s":123.92,"e":127.44,"text":"I drove my last blade through the crown of its face."},{"s":127.44,"e":127.94,"text":"**[Pre-Chorus]**"},{"s":127.44,"e":130.64,"text":"No prophecy saved me, no destiny knew"},{"s":130.64,"e":133.96,"text":"How deep I would dig just to finally get through."},{"s":133.96,"e":137.52,"text":"The fire went silent, the beast hit the ground,"},{"s":137.52,"e":141.5,"text":"And all of your kingdom woke up to the sound."},{"s":141.5,"e":142,"text":"**[Chorus]**"},{"s":141.5,"e":144.56,"text":"I killed your dragon, I cut through the flame,"},{"s":144.5,"e":147.9,"text":"I stood in the ashes and shouted your name."},{"s":147.9,"e":151.18,"text":"Your monster was mighty, your legend was loud,"},{"s":151.18,"e":154.7,"text":"Now bones are its throne and its smoke is a shroud."},{"s":154.74,"e":158.1,"text":"I killed your dragon, your terror is gone,"},{"s":158.1,"e":161.44,"text":"The night lost its teeth at the edge of the dawn."},{"s":161.44,"e":164.71,"text":"You said it would break me, you swore I would fall—"},{"s":164.71,"e":167.39,"text":"I killed your dragon."},{"s":167.97,"e":169.97,"text":"I conquered it all."},{"s":169.97,"e":170.47,"text":"**[Bridge]**"},{"s":171.87,"e":173.53,"text":"Was it your guardian?"},{"s":174.11,"e":175.15,"text":"Was it your curse?"},{"s":175.79,"e":176.91,"text":"Was I the hero—"},{"s":176.83,"e":178.51,"text":"Or something much worse?"},{"s":178.79,"e":181.89,"text":"You built your whole empire on scales and on smoke,"},{"s":181.89,"e":185.27,"text":"I shattered the spell and the silence it spoke."},{"s":185.19,"e":188.85,"text":"Now look at the skyline, no shadow remains—"},{"s":188.85,"e":196.13,"text":"Just me with its blood running dark through my veins."},{"s":196.13,"e":196.63,"text":"**[Final Chorus]**"},{"s":196.13,"e":199.19,"text":"I killed your dragon, but something survived,"},{"s":199.19,"e":202.59,"text":"A spark in my spirit, a beast still alive."},{"s":202.59,"e":205.99,"text":"Its fire is inside me, its fury is mine,"},{"s":205.99,"e":209.75,"text":"Its heart keeps on beating in rhythm with mine."},{"s":209.75,"e":212.69,"text":"I killed your dragon, now hear how I roar,"},{"s":212.69,"e":216.11,"text":"I came as a soldier—I left as the war."},{"s":216.11,"e":219.59,"text":"You prayed for a savior, you summoned my fall—"},{"s":219.59,"e":221.37,"text":"I killed your dragon."},{"s":222.19,"e":225.09,"text":"Now I’m feared by them all."},{"s":225.09,"e":225.59,"text":"**[Outro]**"},{"s":232.77,"e":234.95,"text":"The mountains went quiet."},{"s":236.21,"e":238.43,"text":"The sky became blue."},{"s":239.93,"e":242.15,"text":"I killed your dragon—"},{"s":242.65,"e":245.17,"text":"But I did it for you."}],"duration":254.6,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.460Z","stats":{"whisperWords":520,"polishedWords":511,"matched":508,"matchRate":0.994}}