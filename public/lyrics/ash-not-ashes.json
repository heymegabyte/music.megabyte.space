:223.884,"e":224.228,"line":63},{"w":"I","s":224.228,"e":224.572,"line":63},{"w":"leave","s":224.572,"e":224.917,"line":63},{"w":"the","s":224.917,"e":225.261,"line":63},{"w":"night,","s":225.261,"e":225.605,"line":63},{"w":"I","s":225.605,"e":225.95,"line":64},{"w":"rise","s":225.95,"e":226.294,"line":64},{"w":"with","s":226.294,"e":226.638,"line":64},{"w":"God,","s":226.638,"e":226.983,"line":64},{"w":"I","s":226.983,"e":227.327,"line":64},{"w":"rise","s":227.327,"e":227.671,"line":64},{"w":"with","s":227.671,"e":228.016,"line":64},{"w":"light","s":228.016,"e":228.36,"line":64}],"lines":[{"s":14.18,"e":17.968,"text":"Lord, I’m standing in the fire, but I’m not ash,"},{"s":17.968,"e":21.411,"text":"I’ve been hit by the storm, but I still flash."},{"s":21.411,"e":25.888,"text":"Every chain on my name, let it crack, let it break,"},{"s":25.888,"e":30.364,"text":"Every lie in my mind, let it drown in Your wake."},{"s":30.364,"e":34.496,"text":"I don’t need a whisper, I need heaven to roar,"},{"s":34.496,"e":38.284,"text":"Kick fear off the hinges, blow open the door."},{"s":38.284,"e":42.072,"text":"I’ve been carrying mountains nobody else sees,"},{"s":42.072,"e":46.548,"text":"But tonight I’m on my knees and I’m calling the King."},{"s":46.548,"e":48.27,"text":"Let the light come down,"},{"s":48.27,"e":49.991,"text":"Let the walls fall flat,"},{"s":49.991,"e":51.713,"text":"Let the dead things rise,"},{"s":51.713,"e":53.435,"text":"Let my strength come back."},{"s":53.435,"e":57.223,"text":"Blast me out of my problems, Lord, lift me high,"},{"s":57.223,"e":61.355,"text":"Put thunder in my chest and Your fire in my eyes."},{"s":61.355,"e":65.831,"text":"Break every curse, every trap, every chain,"},{"s":65.831,"e":68.93,"text":"Wash my soul clean in Your holy rain."},{"s":68.93,"e":73.062,"text":"I’m not buried, I’m planted, I’m rising through pain,"},{"s":73.062,"e":77.539,"text":"I’m not finished, I’m chosen, I’m called by name."},{"s":77.539,"e":81.326,"text":"Heaven come heavy, let the darkness divide,"},{"s":81.326,"e":85.459,"text":"Blast me out of my problems and into Your light."},{"s":85.459,"e":89.591,"text":"Send angels to the corners of my broken mind,"},{"s":89.591,"e":93.723,"text":"Sweep out every shadow that I left behind."},{"s":93.723,"e":97.855,"text":"Turn pressure into power, turn wounds into gold,"},{"s":97.855,"e":102.331,"text":"Turn the fear that held me into faith in my bones."},{"s":102.331,"e":107.152,"text":"Let my family be covered, let my friends be fed,"},{"s":107.152,"e":111.628,"text":"Let the lost find a table, let the hungry get bread."},{"s":111.628,"e":116.794,"text":"Let the homeless find shelter, let the lonely find peace,"},{"s":116.794,"e":121.27,"text":"Let the war in my spirit finally bow and cease."},{"s":121.27,"e":122.992,"text":"Let the light come down,"},{"s":122.992,"e":124.713,"text":"Let the walls fall flat,"},{"s":124.713,"e":126.435,"text":"Let the dead things rise,"},{"s":126.435,"e":128.157,"text":"Let my strength come back."},{"s":128.157,"e":131.945,"text":"Blast me out of my problems, Lord, lift me high,"},{"s":131.945,"e":136.077,"text":"Put thunder in my chest and Your fire in my eyes."},{"s":136.077,"e":140.553,"text":"Break every curse, every trap, every chain,"},{"s":140.553,"e":143.652,"text":"Wash my soul clean in Your holy rain."},{"s":143.652,"e":147.784,"text":"I’m not buried, I’m planted, I’m rising through pain,"},{"s":147.784,"e":152.261,"text":"I’m not finished, I’m chosen, I’m called by name."},{"s":152.261,"e":156.048,"text":"Heaven come heavy, let the darkness divide,"},{"s":156.048,"e":160.181,"text":"Blast me out of my problems and into Your light."},{"s":160.181,"e":162.591,"text":"I speak life over my breath,"},{"s":162.591,"e":165.001,"text":"I speak peace over my sleep,"},{"s":165.001,"e":167.412,"text":"I speak strength over my hands,"},{"s":167.412,"e":170.166,"text":"I speak victory over me."},{"s":170.166,"e":171.888,"text":"No weapon, no shame,"},{"s":171.888,"e":173.61,"text":"No sickness of soul,"},{"s":173.61,"e":175.332,"text":"No debt, no despair,"},{"s":175.332,"e":176.709,"text":"No pit, no hole."},{"s":176.709,"e":178.431,"text":"Can swallow the child"},{"s":178.431,"e":180.152,"text":"You lifted from dust,"},{"s":180.152,"e":181.874,"text":"I give You my fear,"},{"s":181.874,"e":183.596,"text":"You give me Your trust."},{"s":183.596,"e":184.973,"text":"Final Chorus"},{"s":184.973,"e":189.105,"text":"Blast me out of my problems, Lord, raise me anew,"},{"s":189.105,"e":192.204,"text":"Let my whole life become living proof."},{"s":192.204,"e":196.681,"text":"Break every curse, every trap, every chain,"},{"s":196.681,"e":200.468,"text":"Let mercy come roaring like a hurricane."},{"s":200.468,"e":204.6,"text":"I’m not buried, I’m planted, I’m rising through pain,"},{"s":204.6,"e":209.077,"text":"I’m not finished, I’m chosen, I’m called by name."},{"s":209.077,"e":212.865,"text":"Heaven come heavy, let the darkness divide,"},{"s":212.865,"e":216.997,"text":"Blast me out of my problems and into Your light."},{"s":216.997,"e":219.751,"text":"Into Your light, into Your flame,"},{"s":219.751,"e":222.851,"text":"Into Your purpose, into Your name."},{"s":222.851,"e":225.605,"text":"I leave the grave, I leave the night,"},{"s":225.605,"e":228.36,"text":"I rise with God, I rise with light"}],"duration":234.92,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.855Z","realignedFrom":"whisper-aligned","vocalStart":14.18,"vocalEnd":228.36}