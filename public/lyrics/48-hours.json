208.221,"e":208.542,"line":66},{"w":"sick","s":208.542,"e":208.864,"line":66},{"w":"to","s":208.864,"e":209.185,"line":66},{"w":"yell,","s":209.185,"e":209.506,"line":66},{"w":"Pull","s":209.506,"e":209.828,"line":67},{"w":"one","s":209.828,"e":210.149,"line":67},{"w":"more","s":210.149,"e":210.47,"line":67},{"w":"soul","s":210.47,"e":210.792,"line":67},{"w":"from","s":210.792,"e":211.113,"line":67},{"w":"the","s":211.113,"e":211.434,"line":67},{"w":"mouth","s":211.434,"e":211.756,"line":67},{"w":"of","s":211.756,"e":212.077,"line":67},{"w":"hell.","s":212.077,"e":212.398,"line":67},{"w":"Ayiti,","s":212.398,"e":213.041,"line":68},{"w":"leve.","s":213.041,"e":213.363,"line":68},{"w":"Haiti,","s":213.363,"e":214.005,"line":68},{"w":"rise.","s":214.005,"e":214.327,"line":68},{"w":"Nou","s":214.327,"e":214.648,"line":69},{"w":"pap","s":214.648,"e":214.969,"line":69},{"w":"bliye.","s":214.969,"e":215.291,"line":69},{"w":"We","s":215.291,"e":215.612,"line":69},{"w":"won’t","s":215.612,"e":215.933,"line":69},{"w":"forget.","s":215.933,"e":216.576,"line":69},{"w":"Behind","s":216.576,"e":217.219,"line":70},{"w":"those","s":217.219,"e":217.54,"line":70},{"w":"walls,","s":217.54,"e":217.861,"line":70},{"w":"somebody","s":217.861,"e":219.147,"line":70},{"w":"still","s":219.147,"e":219.468,"line":70},{"w":"sings—","s":219.468,"e":219.789,"line":70},{"w":"Open","s":219.789,"e":220.432,"line":71},{"w":"the","s":220.432,"e":220.753,"line":71},{"w":"door.","s":220.753,"e":221.075,"line":71},{"w":"Let","s":221.075,"e":221.396,"line":71},{"w":"mercy","s":221.396,"e":222.039,"line":71},{"w":"in","s":222.039,"e":222.36,"line":71}],"lines":[{"s":1.6,"e":3.849,"text":"Metal door, no morning bell,"},{"s":3.849,"e":7.705,"text":"Somebody’s brother breathing in a sick cell."},{"s":7.705,"e":10.276,"text":"Port-au-Prince, can you hear that cry?"},{"s":10.276,"e":13.168,"text":"Forty-eight hours became forty-eight lives."},{"s":13.168,"e":16.06,"text":"They said the law gives forty-eight hours,"},{"s":16.06,"e":19.916,"text":"But the clock got swallowed by broken powers."},{"s":19.916,"e":22.487,"text":"No judge, no bread, no water line,"},{"s":22.487,"e":26.022,"text":"Just bones in the dark doing borrowed time."},{"s":26.022,"e":28.914,"text":"Men sleep standing where the floor can’t hold,"},{"s":28.914,"e":31.806,"text":"Heat on the skin, hunger in the soul."},{"s":31.806,"e":34.377,"text":"Some were guilty, some never tried,"},{"s":34.377,"e":38.875,"text":"But nobody deserves to be left inside to die."},{"s":38.875,"e":41.767,"text":"Tanpri, tande nou — please, hear us now,"},{"s":41.767,"e":45.945,"text":"There’s a hell on earth behind those walls somehow."},{"s":45.945,"e":49.48,"text":"Dlo, manje, doktè — water, food, a doctor’s hand,"},{"s":49.48,"e":52.693,"text":"A little mercy in a ruined land."},{"s":52.693,"e":56.87,"text":"American senators, presidents, Congress, too,"},{"s":56.87,"e":60.084,"text":"Send more than speeches through the smoke and blue."},{"s":60.084,"e":64.261,"text":"End these acts of atrocity, open up the gate,"},{"s":64.261,"e":66.832,"text":"Forty-eight hours should not become fate."},{"s":66.832,"e":69.403,"text":"Help Haiti breathe, help Haiti stand,"},{"s":69.403,"e":72.616,"text":"Aid in the clinic, justice in the hand."},{"s":72.616,"e":76.793,"text":"For every brother in a cell too sick to yell,"},{"s":76.793,"e":79.685,"text":"Pull one more soul from the mouth of hell."},{"s":79.685,"e":82.256,"text":"This ain’t a song for saints only,"},{"s":82.256,"e":86.434,"text":"It’s for the lost, the charged, the poor, the lonely."},{"s":86.434,"e":89.326,"text":"Misguided brothers, forgotten sons,"},{"s":89.326,"e":91.896,"text":"Still human when the daylight runs."},{"s":91.896,"e":95.11,"text":"If a man did wrong, let the court speak clear,"},{"s":95.11,"e":98.644,"text":"But don’t bury him alive where no one hears."},{"s":98.644,"e":101.536,"text":"No trial, no medicine, no clean cup,"},{"s":101.536,"e":104.429,"text":"That’s not justice — that’s giving up."},{"s":104.429,"e":107.321,"text":"Nou se moun — we are human, too,"},{"s":107.321,"e":109.891,"text":"Not shadows for the world to lose."},{"s":109.891,"e":113.105,"text":"Pa kite yo mouri — don’t let them die,"},{"s":113.105,"e":115.997,"text":"There’s still a God under this sky."},{"s":115.997,"e":120.174,"text":"American senators, presidents, Congress, too,"},{"s":120.174,"e":123.388,"text":"Send more than speeches through the smoke and blue."},{"s":123.388,"e":127.565,"text":"End these acts of atrocity, open up the gate,"},{"s":127.565,"e":130.136,"text":"Forty-eight hours should not become fate."},{"s":130.136,"e":132.706,"text":"Help Haiti breathe, help Haiti stand,"},{"s":132.706,"e":135.92,"text":"Aid in the clinic, justice in the hand."},{"s":135.92,"e":140.097,"text":"For every brother in a cell too sick to yell,"},{"s":140.097,"e":142.989,"text":"Pull one more soul from the mouth of hell."},{"s":142.989,"e":146.524,"text":"No empire is holy if it looks away,"},{"s":146.524,"e":149.095,"text":"No flag is clean when children pray"},{"s":149.095,"e":152.951,"text":"For fathers behind bars with no bread in their hands,"},{"s":152.951,"e":156.485,"text":"While the world debates another rescue plan."},{"s":156.485,"e":159.378,"text":"Send doctors. Send food. Send courts that move."},{"s":159.378,"e":161.627,"text":"Send water. Send light. Send proof."},{"s":161.627,"e":165.804,"text":"Not another photo, not another prayer alone,"},{"s":165.804,"e":169.66,"text":"Make human dignity policy, flesh, and bone."},{"s":169.66,"e":170.946,"text":"Dlo! — water."},{"s":170.946,"e":171.91,"text":"Manje! — food."},{"s":171.91,"e":173.195,"text":"Doktè! — doctors."},{"s":173.195,"e":174.802,"text":"Jistis! — justice."},{"s":174.802,"e":177.373,"text":"Forty-eight hours, not forty-eight graves."},{"s":177.373,"e":180.265,"text":"Forty-eight hours, let somebody save."},{"s":180.265,"e":182.835,"text":"Forty-eight hours, hear the prison bell."},{"s":182.835,"e":184.442,"text":"Forty-eight hours from hell."},{"s":184.442,"e":188.619,"text":"American senators, presidents, Congress, too,"},{"s":188.619,"e":192.154,"text":"There are things only power can choose to do."},{"s":192.154,"e":196.01,"text":"End these acts of atrocity, answer the call,"},{"s":196.01,"e":199.545,"text":"A nation is judged by the least of all."},{"s":199.545,"e":202.116,"text":"Help Haiti breathe, help Haiti stand,"},{"s":202.116,"e":205.329,"text":"Aid in the clinic, justice in the hand."},{"s":205.329,"e":209.506,"text":"For every brother in a cell too sick to yell,"},{"s":209.506,"e":212.398,"text":"Pull one more soul from the mouth of hell."},{"s":212.398,"e":214.327,"text":"Ayiti, leve. Haiti, rise."},{"s":214.327,"e":216.576,"text":"Nou pap bliye. We won’t forget."},{"s":216.576,"e":219.789,"text":"Behind those walls, somebody still sings—"},{"s":219.789,"e":222.36,"text":"Open the door. Let mercy in"}],"duration":227.96,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.872Z","realignedFrom":"whisper-aligned","vocalStart":1.6,"vocalEnd":222.36}