215.18,"e":215.26,"line":71},{"w":"Let","s":215.18,"e":217.5,"line":71},{"w":"mercy","s":217.5,"e":217.98,"line":71},{"w":"in","s":217.98,"e":218.72,"line":71}],"lines":[{"s":1.6,"e":6.36,"text":"Metal door, no morning bell,"},{"s":6.36,"e":11.84,"text":"Somebody’s brother breathing in a sick cell."},{"s":13.78,"e":16.42,"text":"Port-au-Prince, can you hear that cry?"},{"s":19.16,"e":23.62,"text":"Forty-eight hours became forty-eight lives."},{"s":36.52,"e":39.32,"text":"They said the law gives forty-eight hours,"},{"s":39.32,"e":42.34,"text":"But the clock got swallowed by broken powers."},{"s":42.34,"e":44.56,"text":"No judge, no bread, no water line,"},{"s":44.56,"e":47.3,"text":"Just bones in the dark doing borrowed time."},{"s":47.3,"e":49.5,"text":"Men sleep standing where the floor can’t hold,"},{"s":49.5,"e":52.44,"text":"Heat on the skin, hunger in the soul."},{"s":52.44,"e":54.66,"text":"Some were guilty, some never tried,"},{"s":54.66,"e":57.16,"text":"But nobody deserves to be left inside to die."},{"s":57.08,"e":60.14,"text":"Tanpri, tande nou — please, hear us now,"},{"s":60.14,"e":62.92,"text":"There’s a hell on earth behind those walls somehow."},{"s":63.62,"e":65.98,"text":"Dlo, manje, doktè — water, food, a doctor’s hand,"},{"s":66.06,"e":68.24,"text":"A little mercy in a ruined land."},{"s":68.42,"e":71.58,"text":"American senators, presidents, Congress, too,"},{"s":71.58,"e":73.9,"text":"Send more than speeches through the smoke and blue."},{"s":73.9,"e":76.7,"text":"End these acts of atrocity, open up the gate,"},{"s":76.7,"e":79.08,"text":"Forty-eight hours should not become fate."},{"s":79.08,"e":81.66,"text":"Help Haiti breathe, help Haiti stand,"},{"s":81.66,"e":84.02,"text":"Aid in the clinic, justice in the hand."},{"s":84.02,"e":86.8,"text":"For every brother in a cell too sick to yell,"},{"s":86.76,"e":89.62,"text":"Pull one more soul from the mouth of hell."},{"s":89.62,"e":91.82,"text":"This ain’t a song for saints only,"},{"s":91.82,"e":94.76,"text":"It’s for the lost, the charged, the poor, the lonely."},{"s":94.96,"e":97.14,"text":"Misguided brothers, forgotten sons,"},{"s":97.14,"e":99.72,"text":"Still human when the daylight runs."},{"s":99.72,"e":102.2,"text":"If a man did wrong, let the court speak clear,"},{"s":102.2,"e":104.82,"text":"But don’t bury him alive where no one hears."},{"s":104.82,"e":107.4,"text":"No trial, no medicine, no clean cup,"},{"s":107.4,"e":109.66,"text":"That’s not justice — that’s giving up."},{"s":109.66,"e":112.24,"text":"Nou se moun — we are human, too,"},{"s":112.24,"e":114.7,"text":"Not shadows for the world to lose."},{"s":114.66,"e":117.4,"text":"Pa kite yo mouri — don’t let them die,"},{"s":117.44,"e":119.84,"text":"There’s still a God under this sky."},{"s":120.04,"e":123.2,"text":"American senators, presidents, Congress, too,"},{"s":123.2,"e":125.48,"text":"Send more than speeches through the smoke and blue."},{"s":125.48,"e":128.3,"text":"End these acts of atrocity, open up the gate,"},{"s":128.3,"e":130.64,"text":"Forty-eight hours should not become fate."},{"s":130.64,"e":133.26,"text":"Help Haiti breathe, help Haiti stand,"},{"s":133.26,"e":135.64,"text":"Aid in the clinic, justice in the hand."},{"s":135.64,"e":138.38,"text":"For every brother in a cell too sick to yell,"},{"s":138.36,"e":141.16,"text":"Pull one more soul from the mouth of hell."},{"s":141.1,"e":143.58,"text":"No empire is holy if it looks away,"},{"s":143.58,"e":146.24,"text":"No flag is clean when children pray"},{"s":146.24,"e":148.92,"text":"For fathers behind bars with no bread in their hands,"},{"s":148.92,"e":151.32,"text":"While the world debates another rescue plan."},{"s":151.32,"e":154.14,"text":"Send doctors. Send food. Send courts that move."},{"s":154.14,"e":156.46,"text":"Send water. Send light. Send proof."},{"s":156.46,"e":159.1,"text":"Not another photo, not another prayer alone,"},{"s":159.1,"e":162.04,"text":"Make human dignity policy, flesh, and bone."},{"s":162.96,"e":163.84,"text":"Dlo! — water."},{"s":163.9,"e":164.94,"text":"Manje! — food."},{"s":164.94,"e":166.52,"text":"Doktè! — doctors."},{"s":168.5,"e":169.74,"text":"Jistis! — justice."},{"s":171.78,"e":174.72,"text":"Forty-eight hours, not forty-eight graves."},{"s":174.72,"e":177.42,"text":"Forty-eight hours, let somebody save."},{"s":177.42,"e":179.9,"text":"Forty-eight hours, hear the prison bell."},{"s":179.9,"e":181.8,"text":"Forty-eight hours from hell."},{"s":181.8,"e":184.84,"text":"American senators, presidents, Congress, too,"},{"s":184.84,"e":187.46,"text":"There are things only power can choose to do."},{"s":187.46,"e":190.18,"text":"End these acts of atrocity, answer the call,"},{"s":190.18,"e":192.64,"text":"A nation is judged by the least of all."},{"s":192.6,"e":195.3,"text":"Help Haiti breathe, help Haiti stand,"},{"s":195.22,"e":197.58,"text":"Aid in the clinic, justice in the hand."},{"s":197.58,"e":200.34,"text":"For every brother in a cell too sick to yell,"},{"s":200.34,"e":203.22,"text":"Pull one more soul from the mouth of hell."},{"s":203.14,"e":207.12,"text":"Ayiti, leve. Haiti, rise."},{"s":207.12,"e":209.72,"text":"Nou pap bliye. We won’t forget."},{"s":209.72,"e":212.9,"text":"Behind those walls, somebody still sings—"},{"s":212.9,"e":218.72,"text":"Open the door. Let mercy in"}],"duration":227.96,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.432Z","stats":{"whisperWords":516,"polishedWords":511,"matched":433,"matchRate":0.847}}