74,"line":79},{"w":"Let","s":278.274,"e":278.629,"line":80},{"w":"starless","s":278.629,"e":279.337,"line":80},{"w":"spaces","s":279.337,"e":280.046,"line":80},{"w":"seed","s":280.046,"e":280.401,"line":80},{"w":"a","s":280.401,"e":280.755,"line":80},{"w":"softer","s":280.755,"e":281.464,"line":80},{"w":"glow.","s":281.464,"e":281.818,"line":80},{"w":"Let","s":281.818,"e":282.172,"line":81},{"w":"peace","s":282.172,"e":282.527,"line":81},{"w":"pass","s":282.527,"e":282.881,"line":81},{"w":"person,","s":282.881,"e":283.59,"line":81},{"w":"planet,","s":283.59,"e":284.299,"line":81},{"w":"pulse,","s":284.299,"e":284.653,"line":81},{"w":"and","s":284.653,"e":285.007,"line":81},{"w":"skin;","s":285.007,"e":285.362,"line":81},{"w":"Let","s":285.362,"e":285.716,"line":82},{"w":"living","s":285.716,"e":286.425,"line":82},{"w":"love","s":286.425,"e":286.779,"line":82},{"w":"and","s":286.779,"e":287.133,"line":82},{"w":"harmony","s":287.133,"e":288.197,"line":82},{"w":"begin.","s":288.197,"e":288.905,"line":82},{"w":"To","s":288.905,"e":289.26,"line":83},{"w":"star,","s":289.26,"e":289.614,"line":83},{"w":"to","s":289.614,"e":289.968,"line":83},{"w":"Source,","s":289.968,"e":290.323,"line":83},{"w":"to","s":290.323,"e":290.677,"line":83},{"w":"soul,","s":290.677,"e":291.032,"line":83},{"w":"to","s":291.032,"e":291.386,"line":83},{"w":"sacred","s":291.386,"e":292.095,"line":83},{"w":"breath,","s":292.095,"e":292.449,"line":83},{"w":"Bring","s":292.449,"e":292.803,"line":84},{"w":"life","s":292.803,"e":293.158,"line":84},{"w":"from","s":293.158,"e":293.512,"line":84},{"w":"life,","s":293.512,"e":293.866,"line":84},{"w":"not","s":293.866,"e":294.221,"line":84},{"w":"victory","s":294.221,"e":295.284,"line":84},{"w":"through","s":295.284,"e":295.638,"line":84},{"w":"death.","s":295.638,"e":295.993,"line":84},{"w":"O","s":295.993,"e":296.347,"line":85},{"w":"living","s":296.347,"e":297.056,"line":85},{"w":"God,","s":297.056,"e":297.41,"line":85},{"w":"let","s":297.41,"e":297.764,"line":85},{"w":"peace","s":297.764,"e":298.119,"line":85},{"w":"begin","s":298.119,"e":298.828,"line":85},{"w":"within;","s":298.828,"e":299.536,"line":85},{"w":"Algenib,","s":299.536,"e":300.599,"line":86},{"w":"let","s":300.599,"e":300.954,"line":86},{"w":"harmony","s":300.954,"e":302.017,"line":86},{"w":"now","s":302.017,"e":302.371,"line":86},{"w":"begin.","s":302.371,"e":303.08,"line":86}],"lines":[{"s":3.64,"e":6.829,"text":"Beyond the stars, a silent signal streams,"},{"s":6.829,"e":10.727,"text":"Through dust and dark, through scars and shattered dreams."},{"s":10.727,"e":14.271,"text":"No throne we seek, no crown we claim tonight;"},{"s":14.271,"e":17.815,"text":"We call for calm, for harmony, for light."},{"s":17.815,"e":21.358,"text":"To Algenib, blue beacon bent in night,"},{"s":21.358,"e":24.902,"text":"We plead: release a peace of living light."},{"s":24.902,"e":28.446,"text":"To forms behind the forms, to fields that feel,"},{"s":28.446,"e":31.989,"text":"To truths beneath the truth of what seems real."},{"s":31.989,"e":35.179,"text":"Actual living God, awake and near,"},{"s":35.179,"e":38.722,"text":"Make meaning move through mourning, rage, and fear."},{"s":38.722,"e":42.266,"text":"Let rigid rage release its bitter reign;"},{"s":42.266,"e":46.164,"text":"Let healing rain through every heated brain."},{"s":46.164,"e":50.062,"text":"Come through the code that curves beneath the sky,"},{"s":50.062,"e":53.606,"text":"Come through the soul no telescope can spy."},{"s":53.606,"e":57.149,"text":"Come through the law beneath each lucid flame,"},{"s":57.149,"e":60.693,"text":"Come through these lungs; let love outlast the shame."},{"s":60.693,"e":64.237,"text":"O Algenib, bend blackness; blaze and hear,"},{"s":64.237,"e":68.135,"text":"The maddened world is drowning deep in fear."},{"s":68.135,"e":71.324,"text":"Actual living God, through breath and flame,"},{"s":71.324,"e":74.868,"text":"Through life and death, we call Your sacred name."},{"s":74.868,"e":78.766,"text":"All forms of good, all forces formed for peace,"},{"s":78.766,"e":82.309,"text":"Come calm the storm and make the madness cease."},{"s":82.309,"e":85.853,"text":"Let justice join with mercy, hand in hand;"},{"s":85.853,"e":89.397,"text":"Make us the answer—teach us how to stand."},{"s":89.397,"e":92.94,"text":"Let harmony begin within, begin,"},{"s":92.94,"e":96.484,"text":"Let harmony begin beneath the skin."},{"s":96.484,"e":100.028,"text":"Let harmony begin where hate has been;"},{"s":100.028,"e":103.217,"text":"Algenib, let harmony begin."},{"s":103.217,"e":106.761,"text":"Cities split; sirens slice the sheets of rain,"},{"s":106.761,"e":110.304,"text":"While children dream through thunder, dust, and pain."},{"s":110.304,"e":113.848,"text":"Let rifles rust; let rockets rot to red;"},{"s":113.848,"e":117.392,"text":"Let bread be broken where the blood was shed."},{"s":117.392,"e":120.935,"text":"Let greed release its grip on grain and gold;"},{"s":120.935,"e":124.479,"text":"Let warm hands hold the hungry from the cold."},{"s":124.479,"e":128.023,"text":"Let conscience catch the hand before the blade;"},{"s":128.023,"e":131.566,"text":"Let kindness crown the choices we have made."},{"s":131.566,"e":135.11,"text":"Let justice judge, yet mercy mend the scar,"},{"s":135.11,"e":138.654,"text":"For peace is more than silence after war."},{"s":138.654,"e":142.197,"text":"Let truth confront the cruel without revenge,"},{"s":142.197,"e":146.095,"text":"Then let forgiveness flourish at the edge."},{"s":146.095,"e":149.639,"text":"To quantum choirs that quiver under form,"},{"s":149.639,"e":153.183,"text":"Converge with care and calm each common storm."},{"s":153.183,"e":156.726,"text":"To starless seas where sleeping signals spin,"},{"s":156.726,"e":160.27,"text":"Send sacred stillness through the static din."},{"s":160.27,"e":163.814,"text":"To minds that shine where mortal sight grows dim,"},{"s":163.814,"e":168.066,"text":"To living structures stationed past the rim:"},{"s":168.066,"e":171.61,"text":"Come only bearing mercy, truth, and grace;"},{"s":171.61,"e":175.154,"text":"Bring no dominion near the human race."},{"s":175.154,"e":177.988,"text":"Actual living God beyond all form,"},{"s":177.988,"e":181.532,"text":"Bring peace through us; transform the human storm."},{"s":181.532,"e":185.076,"text":"Do not descend with terror, sword, or rod;"},{"s":185.076,"e":188.62,"text":"Make love our proof that we have heard from God."},{"s":188.62,"e":190.037,"text":"Who hears the hurt?"},{"s":190.037,"e":191.809,"text":"The Heart beyond the night."},{"s":191.809,"e":193.226,"text":"Who heals the hate?"},{"s":193.226,"e":195.352,"text":"The hands that harbor light."},{"s":195.352,"e":196.77,"text":"Who brings the peace?"},{"s":196.77,"e":198.896,"text":"The people made aware."},{"s":198.896,"e":202.44,"text":"Then make us brave enough to be the prayer."},{"s":202.44,"e":205.983,"text":"O archetype of mercy, move and mend;"},{"s":205.983,"e":209.882,"text":"Let separated selves see self as friend."},{"s":209.882,"e":213.78,"text":"Form of forgiveness, flow through field and frame;"},{"s":213.78,"e":217.678,"text":"Let each face shine with one shared sacred flame."},{"s":217.678,"e":221.221,"text":"Pattern of patience, pulse through pride and pain;"},{"s":221.221,"e":225.119,"text":"Turn fevered fury into fertile rain."},{"s":225.119,"e":228.663,"text":"Spirit of stillness, settle all the din,"},{"s":228.663,"e":232.207,"text":"And let the living harmony begin."},{"s":232.207,"e":235.75,"text":"No distant star can do what we refuse;"},{"s":235.75,"e":239.294,"text":"No sacred spark can choose what humans choose."},{"s":239.294,"e":242.838,"text":"So move our feet and fortify our hands;"},{"s":242.838,"e":246.381,"text":"Make peace a practice spreading through the lands."},{"s":246.381,"e":249.925,"text":"O Algenib, bend blackness; blaze and hear,"},{"s":249.925,"e":253.823,"text":"The maddened world is drowning deep in fear."},{"s":253.823,"e":257.012,"text":"Actual living God, through breath and flame,"},{"s":257.012,"e":260.556,"text":"Through life and death, we call Your sacred name."},{"s":260.556,"e":264.454,"text":"All forms of good, all forces formed for peace,"},{"s":264.454,"e":267.998,"text":"Come calm the storm and make the madness cease."},{"s":267.998,"e":271.541,"text":"Let justice join with mercy, hand in hand;"},{"s":271.541,"e":275.085,"text":"Make us the answer—teach us how to stand."},{"s":275.085,"e":278.274,"text":"Let quasars quiet; let the war drums slow;"},{"s":278.274,"e":281.818,"text":"Let starless spaces seed a softer glow."},{"s":281.818,"e":285.362,"text":"Let peace pass person, planet, pulse, and skin;"},{"s":285.362,"e":288.905,"text":"Let living love and harmony begin."},{"s":288.905,"e":292.449,"text":"To star, to Source, to soul, to sacred breath,"},{"s":292.449,"e":295.993,"text":"Bring life from life, not victory through death."},{"s":295.993,"e":299.536,"text":"O living God, let peace begin within;"},{"s":299.536,"e":303.08,"text":"Algenib, let harmony now begin."}],"duration":314.23,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.998Z","realignedFrom":"whisper-aligned","vocalStart":3.64,"vocalEnd":303.08}