87.52,"line":83},{"w":"breath,","s":287.52,"e":287.98,"line":83},{"w":"Bring","s":287.98,"e":288.44,"line":84},{"w":"life","s":288.44,"e":288.86,"line":84},{"w":"from","s":288.86,"e":289.22,"line":84},{"w":"life,","s":289.22,"e":289.6,"line":84},{"w":"not","s":289.6,"e":290.02,"line":84},{"w":"victory","s":290.02,"e":290.66,"line":84},{"w":"through","s":290.66,"e":291.3,"line":84},{"w":"death.","s":291.3,"e":291.86,"line":84},{"w":"O","s":291.86,"e":292.32,"line":85},{"w":"living","s":292.32,"e":292.76,"line":85},{"w":"God,","s":292.76,"e":294.06,"line":85},{"w":"let","s":294.06,"e":294.5,"line":85},{"w":"peace","s":294.5,"e":295.06,"line":85},{"w":"begin","s":295.06,"e":295.8,"line":85},{"w":"within;","s":295.8,"e":296.88,"line":85},{"w":"Algenib,","s":297.98,"e":298.46,"line":86},{"w":"let","s":298.46,"e":299.22,"line":86},{"w":"harmony","s":299.22,"e":300.62,"line":86},{"w":"now","s":300.62,"e":302.18,"line":86},{"w":"begin.","s":302.18,"e":303.08,"line":86}],"lines":[{"s":3.64,"e":9.88,"text":"Beyond the stars, a silent signal streams,"},{"s":9.88,"e":16.04,"text":"Through dust and dark, through scars and shattered dreams."},{"s":16.04,"e":21.58,"text":"No throne we seek, no crown we claim tonight;"},{"s":22.5,"e":30,"text":"We call for calm, for harmony, for light."},{"s":40.68,"e":43.34,"text":"To Algenib, blue beacon bent in night,"},{"s":43.34,"e":46.28,"text":"We plead: release a peace of living light."},{"s":46.28,"e":49.3,"text":"To forms behind the forms, to fields that feel,"},{"s":49.3,"e":52.26,"text":"To truths beneath the truth of what seems real."},{"s":52.26,"e":54.8,"text":"Actual living God, awake and near,"},{"s":54.8,"e":57.8,"text":"Make meaning move through mourning, rage, and fear."},{"s":57.8,"e":60.96,"text":"Let rigid rage release its bitter reign;"},{"s":60.96,"e":63.86,"text":"Let healing rain through every heated brain."},{"s":63.86,"e":67.4,"text":"Come through the code that curves beneath the sky,"},{"s":67.4,"e":70.32,"text":"Come through the soul no telescope can spy."},{"s":70.32,"e":73.28,"text":"Come through the law beneath each lucid flame,"},{"s":73.28,"e":76.4,"text":"Come through these lungs; let love outlast the shame."},{"s":76.4,"e":79.3,"text":"O Algenib, bend blackness; blaze and hear,"},{"s":79.3,"e":82.22,"text":"The maddened world is drowning deep in fear."},{"s":82.22,"e":84.7,"text":"Actual living God, through breath and flame,"},{"s":84.7,"e":87.78,"text":"Through life and death, we call Your sacred name."},{"s":87.78,"e":90.76,"text":"All forms of good, all forces formed for peace,"},{"s":90.76,"e":93.7,"text":"Come calm the storm and make the madness cease."},{"s":93.7,"e":96.76,"text":"Let justice join with mercy, hand in hand;"},{"s":96.76,"e":101.1,"text":"Make us the answer—teach us how to stand."},{"s":101.1,"e":104.5,"text":"Let harmony begin within, begin,"},{"s":104.5,"e":107.46,"text":"Let harmony begin beneath the skin."},{"s":107.38,"e":110.66,"text":"Let harmony begin where hate has been;"},{"s":111.18,"e":112.86,"text":"Algenib, let harmony begin."},{"s":112.86,"e":115.16,"text":"Cities split; sirens slice the sheets of rain,"},{"s":115.16,"e":118.16,"text":"While children dream through thunder, dust, and pain."},{"s":118.16,"e":121.08,"text":"Let rifles rust; let rockets rot to red;"},{"s":121.08,"e":124.1,"text":"Let bread be broken where the blood was shed."},{"s":124.1,"e":126.86,"text":"Let greed release its grip on grain and gold;"},{"s":126.86,"e":129.88,"text":"Let warm hands hold the hungry from the cold."},{"s":129.8,"e":132.26,"text":"Let conscience catch the hand before the blade;"},{"s":132.3,"e":135.4,"text":"Let kindness crown the choices we have made."},{"s":135.4,"e":138.74,"text":"Let justice judge, yet mercy mend the scar,"},{"s":138.7,"e":141.68,"text":"For peace is more than silence after war."},{"s":141.68,"e":144.62,"text":"Let truth confront the cruel without revenge,"},{"s":144.62,"e":148,"text":"Then let forgiveness flourish at the edge."},{"s":147.94,"e":150.42,"text":"To quantum choirs that quiver under form,"},{"s":150.42,"e":153.46,"text":"Converge with care and calm each common storm."},{"s":153.46,"e":156.28,"text":"To starless seas where sleeping signals spin,"},{"s":156.28,"e":159.24,"text":"Send sacred stillness through the static din."},{"s":159.24,"e":162.42,"text":"To minds that shine where mortal sight grows dim,"},{"s":162.42,"e":165.3,"text":"To living structures stationed past the rim:"},{"s":165.26,"e":168.02,"text":"Come only bearing mercy, truth, and grace;"},{"s":168.02,"e":171.98,"text":"Bring no dominion near the human race."},{"s":171.98,"e":174.66,"text":"Actual living God beyond all form,"},{"s":174.66,"e":177.58,"text":"Bring peace through us; transform the human storm."},{"s":177.58,"e":180.4,"text":"Do not descend with terror, sword, or rod;"},{"s":180.4,"e":184.3,"text":"Make love our proof that we have heard from God."},{"s":184.3,"e":186.58,"text":"Who hears the hurt?"},{"s":186.64,"e":188.76,"text":"The Heart beyond the night."},{"s":188.74,"e":190.36,"text":"Who heals the hate?"},{"s":190.76,"e":193.38,"text":"The hands that harbor light."},{"s":193.38,"e":195.1,"text":"Who brings the peace?"},{"s":195.12,"e":200.98,"text":"The people made aware."},{"s":200.98,"e":208.2,"text":"Then make us brave enough to be the prayer."},{"s":208.12,"e":210.98,"text":"O archetype of mercy, move and mend;"},{"s":210.98,"e":213.96,"text":"Let separated selves see self as friend."},{"s":213.96,"e":217.08,"text":"Form of forgiveness, flow through field and frame;"},{"s":217.08,"e":220.38,"text":"Let each face shine with one shared sacred flame."},{"s":220.38,"e":223.08,"text":"Pattern of patience, pulse through pride and pain;"},{"s":223.02,"e":226.08,"text":"Turn fevered fury into fertile rain."},{"s":226.08,"e":229.1,"text":"Spirit of stillness, settle all the din,"},{"s":229.06,"e":232.38,"text":"And let the living harmony begin."},{"s":232.38,"e":235.06,"text":"No distant star can do what we refuse;"},{"s":235.08,"e":238.16,"text":"No sacred spark can choose what humans choose."},{"s":238.16,"e":241.54,"text":"So move our feet and fortify our hands;"},{"s":241.48,"e":247.98,"text":"Make peace a practice spreading through the lands."},{"s":247.98,"e":250.14,"text":"O Algenib, bend blackness; blaze and hear,"},{"s":250.14,"e":253.06,"text":"The maddened world is drowning deep in fear."},{"s":253.06,"e":255.68,"text":"Actual living God, through breath and flame,"},{"s":255.68,"e":258.84,"text":"Through life and death, we call Your sacred name."},{"s":258.84,"e":261.82,"text":"All forms of good, all forces formed for peace,"},{"s":261.82,"e":264.94,"text":"Come calm the storm and make the madness cease."},{"s":264.94,"e":267.56,"text":"Let justice join with mercy, hand in hand;"},{"s":267.56,"e":272.34,"text":"Make us the answer—teach us how to stand."},{"s":272.34,"e":275.36,"text":"Let quasars quiet; let the war drums slow;"},{"s":275.36,"e":278.24,"text":"Let starless spaces seed a softer glow."},{"s":278.24,"e":281.14,"text":"Let peace pass person, planet, pulse, and skin;"},{"s":281.14,"e":284.06,"text":"Let living love and harmony begin."},{"s":284.06,"e":287.98,"text":"To star, to Source, to soul, to sacred breath,"},{"s":287.98,"e":291.86,"text":"Bring life from life, not victory through death."},{"s":291.86,"e":296.88,"text":"O living God, let peace begin within;"},{"s":297.98,"e":303.08,"text":"Algenib, let harmony now begin."}],"duration":314.23,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.477Z","stats":{"whisperWords":656,"polishedWords":651,"matched":613,"matchRate":0.942}}