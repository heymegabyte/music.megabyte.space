e":68},{"w":"—","s":275.79,"e":276.188,"line":68},{"w":"Female,","s":276.188,"e":276.984,"line":68},{"w":"solo","s":276.984,"e":277.78,"line":68},{"w":"piano]**","s":277.78,"e":278.576,"line":68},{"w":"One","s":278.576,"e":278.974,"line":69},{"w":"hand","s":278.974,"e":279.372,"line":69},{"w":"shook.","s":279.372,"e":279.77,"line":69},{"w":"One","s":279.77,"e":280.168,"line":70},{"w":"rifle","s":280.168,"e":280.964,"line":70},{"w":"dropped.","s":280.964,"e":281.76,"line":70},{"w":"One","s":281.76,"e":282.158,"line":71},{"w":"human","s":282.158,"e":282.954,"line":71},{"w":"chose…","s":282.954,"e":283.352,"line":71},{"w":"And","s":283.352,"e":283.75,"line":72},{"w":"the","s":283.75,"e":284.148,"line":72},{"w":"killing","s":284.148,"e":284.944,"line":72},{"w":"stopped.","s":284.944,"e":285.74,"line":72}],"lines":[{"s":9.12,"e":13.1,"text":"**[Intro — Female, intimate piano]**"},{"s":13.1,"e":16.284,"text":"One hand shook, one rifle dropped,"},{"s":16.284,"e":19.07,"text":"One heart said, “This has to stop.”"},{"s":19.07,"e":22.652,"text":"No thunder came, no heavens moved—"},{"s":22.652,"e":26.235,"text":"Just one last soldier who refused."},{"s":26.235,"e":29.419,"text":"**[Verse 1 — Male, melodic rap]**"},{"s":29.419,"e":32.603,"text":"Boots in the mud, blood in the news,"},{"s":32.603,"e":36.185,"text":"Young men dying for somebody’s views,"},{"s":36.185,"e":39.767,"text":"Flags in the wind, families bruised,"},{"s":39.767,"e":44.941,"text":"Everybody winning till somebody lose."},{"s":44.941,"e":48.523,"text":"Orders came cold through a crackling line,"},{"s":48.523,"e":51.708,"text":"“Advance right now, this is your time.”"},{"s":51.708,"e":56.086,"text":"But he saw one kid on the opposite side,"},{"s":56.086,"e":59.668,"text":"Same scared stare, same fear in his eyes."},{"s":59.668,"e":62.852,"text":"Same mama praying he make it back,"},{"s":62.852,"e":67.628,"text":"Same little sister with his name on her backpack,"},{"s":67.628,"e":71.21,"text":"Same dreams packed in a combat sack—"},{"s":71.21,"e":75.19,"text":"Tell me why we gotta turn all that black?"},{"s":75.19,"e":79.967,"text":"So he dropped that rifle right into the dirt,"},{"s":79.967,"e":83.947,"text":"Said, “I won’t make another mother hurt.”"},{"s":83.947,"e":87.927,"text":"Commander screaming, “Soldier, do your work!”"},{"s":87.927,"e":93.101,"text":"He said, “Saving a life is what a soldier is worth.”"},{"s":93.101,"e":95.489,"text":"**[Pre-Chorus — Female]**"},{"s":95.489,"e":96.683,"text":"One hand down…"},{"s":96.683,"e":98.275,"text":"Then two hands down…"},{"s":98.275,"e":102.255,"text":"Then ten thousand weapons touched the ground."},{"s":102.255,"e":106.634,"text":"**[Chorus — Female lead / Male harmonies]**"},{"s":106.634,"e":110.216,"text":"The last soldier refused to fight,"},{"s":110.216,"e":114.196,"text":"Put down the darkness, picked up the light,"},{"s":114.196,"e":118.574,"text":"One little “no” became millions overnight,"},{"s":118.574,"e":123.35,"text":"And the whole damn world remembered what was right."},{"s":123.35,"e":126.932,"text":"No more mothers getting midnight news,"},{"s":126.932,"e":130.116,"text":"No more children paying leaders’ dues,"},{"s":130.116,"e":134.495,"text":"Peace started small with somebody who chose—"},{"s":134.495,"e":139.271,"text":"**“You can order the war, but I still can refuse.”**"},{"s":139.271,"e":142.455,"text":"**[Verse 2 — Male rap, heavier 808s]**"},{"s":142.455,"e":146.435,"text":"Other side watching like, “What does this mean?”"},{"s":146.435,"e":150.813,"text":"One soldier stepped from behind the machine,"},{"s":150.813,"e":154.395,"text":"Hands held high where the rifles had been,"},{"s":154.395,"e":159.967,"text":"Then another walked out, then another joined in."},{"s":159.967,"e":163.948,"text":"No surrender flag, no victory chant,"},{"s":163.948,"e":167.928,"text":"Just humans deciding what humans can’t—"},{"s":167.928,"e":172.704,"text":"Can’t make me hate somebody I never met,"},{"s":172.704,"e":176.684,"text":"Can’t make revenge pay another man’s debt."},{"s":176.684,"e":181.062,"text":"Generals yelling, politicians calling,"},{"s":181.062,"e":186.634,"text":"But the dominoes started and the weapons kept falling,"},{"s":186.634,"e":190.615,"text":"Click-clack, steel stacking all across the earth,"},{"s":190.615,"e":196.187,"text":"For once we measured courage by somebody’s worth."},{"s":196.187,"e":199.371,"text":"No red team, blue team, east or west,"},{"s":199.371,"e":203.749,"text":"Just beating hearts underneath every chest,"},{"s":203.749,"e":208.525,"text":"And history wrote what the powerful feared:"},{"s":208.525,"e":213.699,"text":"The war disappeared when the soldiers stopped here."},{"s":213.699,"e":217.68,"text":"**[Bridge — Female, almost only piano]**"},{"s":217.68,"e":221.262,"text":"Maybe courage isn’t pulling the trigger."},{"s":221.262,"e":224.844,"text":"Maybe strength is believing we’re bigger."},{"s":224.844,"e":228.426,"text":"Bigger than borders, vengeance, and pride,"},{"s":228.426,"e":232.406,"text":"Bigger than speeches that send us to die."},{"s":232.406,"e":235.988,"text":"And maybe peace isn’t something we find—"},{"s":235.988,"e":239.172,"text":"Maybe it starts when we change our minds."},{"s":239.172,"e":242.356,"text":"**[Final Chorus — Massive duet]**"},{"s":242.356,"e":245.939,"text":"The last soldier refused to fight,"},{"s":245.939,"e":250.317,"text":"Then a million more stepped into the light,"},{"s":250.317,"e":254.695,"text":"Every battlefield went silent that night,"},{"s":254.695,"e":259.073,"text":"No winner, no loser—just people alive."},{"s":259.073,"e":262.655,"text":"No more mothers getting midnight news,"},{"s":262.655,"e":265.839,"text":"No more children paying leaders’ dues,"},{"s":265.839,"e":270.217,"text":"Peace started small with somebody who chose—"},{"s":270.217,"e":274.994,"text":"**“You can order the war, but I still can refuse.”**"},{"s":274.994,"e":278.576,"text":"**[Outro — Female, solo piano]**"},{"s":278.576,"e":279.77,"text":"One hand shook."},{"s":279.77,"e":281.76,"text":"One rifle dropped."},{"s":281.76,"e":283.352,"text":"One human chose…"},{"s":283.352,"e":285.74,"text":"And the killing stopped."}],"duration":292.2,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.131Z","realignedFrom":"whisper-aligned","vocalStart":9.12,"vocalEnd":285.74}