7.12,"e":227.52,"line":77},{"w":"down—","s":227.52,"e":228.4,"line":77},{"w":"Then","s":228.4,"e":228.74,"line":78},{"w":"weapons","s":228.74,"e":229.14,"line":78},{"w":"worldwide.","s":229.14,"e":230.18,"line":78},{"w":"The","s":237.56,"e":237.64,"line":80},{"w":"last","s":237.56,"e":238.08,"line":80},{"w":"soldier","s":238.08,"e":238.58,"line":80},{"w":"refused","s":238.58,"e":239.44,"line":80},{"w":"to","s":239.44,"e":239.98,"line":80},{"w":"fight,","s":239.98,"e":240.12,"line":80},{"w":"Then","s":240.12,"e":240.56,"line":81},{"w":"millions","s":240.56,"e":240.94,"line":81},{"w":"marched","s":240.94,"e":241.42,"line":81},{"w":"toward","s":241.42,"e":242.12,"line":81},{"w":"mercy","s":242.32,"e":243.32,"line":81},{"w":"and","s":243.32,"e":243.78,"line":81},{"w":"light.","s":243.78,"e":244.2,"line":81},{"w":"Every","s":244.2,"e":244.94,"line":82},{"w":"battlefield","s":244.94,"e":245.74,"line":82},{"w":"fell","s":245.74,"e":246.4,"line":82},{"w":"silent","s":246.4,"e":247.4,"line":82},{"w":"that","s":247.4,"e":247.72,"line":82},{"w":"night—","s":247.72,"e":248.08,"line":82},{"w":"Nobody","s":248.08,"e":248.74,"line":83},{"w":"conquered,","s":248.74,"e":249.58,"line":83},{"w":"but","s":249.58,"e":250.06,"line":84},{"w":"everybody","s":250.06,"e":251.22,"line":84},{"w":"survived.","s":251.22,"e":252.72,"line":84},{"w":"No","s":252.72,"e":253.4,"line":85},{"w":"more","s":253.4,"e":253.84,"line":85},{"w":"mothers","s":253.84,"e":254.28,"line":85},{"w":"with","s":254.28,"e":254.82,"line":85},{"w":"midnight","s":254.82,"e":255.28,"line":85},{"w":"news,","s":255.28,"e":255.86,"line":85},{"w":"No","s":256.72,"e":257.34,"line":86},{"w":"more","s":257.34,"e":257.78,"line":86},{"w":"children","s":257.78,"e":258.2,"line":86},{"w":"paying","s":258.2,"e":258.68,"line":86},{"w":"powerful","s":258.68,"e":259.46,"line":86},{"w":"dues.","s":259.46,"e":260.28,"line":86},{"w":"Peace","s":260.28,"e":261.14,"line":87},{"w":"began","s":261.14,"e":262.12,"line":87},{"w":"when","s":262.12,"e":262.48,"line":87},{"w":"somebody","s":262.48,"e":263.06,"line":87},{"w":"chose:","s":263.06,"e":263.72,"line":87},{"w":"“You","s":263.72,"e":264.4,"line":88},{"w":"can","s":264.4,"e":264.72,"line":88},{"w":"order","s":264.72,"e":265.08,"line":88},{"w":"the","s":265.08,"e":265.44,"line":88},{"w":"war—","s":265.44,"e":265.9,"line":88},{"w":"but","s":266.12,"e":267.12,"line":89},{"w":"my","s":267.12,"e":267.64,"line":89},{"w":"soul","s":267.64,"e":268.06,"line":89},{"w":"can","s":268.06,"e":268.9,"line":89},{"w":"refuse.”","s":268.9,"e":270.24,"line":89},{"w":"One","s":276.54,"e":277,"line":91},{"w":"hand","s":277,"e":277.56,"line":91},{"w":"shook.","s":277.56,"e":278.02,"line":91},{"w":"One","s":278.02,"e":278.94,"line":92},{"w":"rifle","s":278.94,"e":279.4,"line":92},{"w":"dropped.","s":279.4,"e":279.86,"line":92},{"w":"One","s":280,"e":281,"line":93},{"w":"brave","s":281,"e":281.44,"line":93},{"w":"“no”…","s":281.44,"e":281.92,"line":93},{"w":"And","s":281.92,"e":282.04,"line":94},{"w":"the","s":282.04,"e":283.6,"line":94},{"w":"battle","s":283.6,"e":284.78,"line":94},{"w":"stopped.","s":284.78,"e":285.74,"line":94}],"lines":[{"s":0,"e":0.5,"text":"[INTRO — FEMALE, SOLO PIANO]"},{"s":9.12,"e":13.64,"text":"One hand shook, one rifle fell,"},{"s":13.64,"e":17.62,"text":"One soul stepped from a living hell."},{"s":17.62,"e":21.52,"text":"No booming sky, no blazing fuse—"},{"s":21.46,"e":28.82,"text":"Just one brave soldier who refused."},{"s":28.82,"e":29.32,"text":"[VERSE 1 — MALE, MELODIC RAP]"},{"s":43.26,"e":45.62,"text":"Boots in the mud, blood on the boots,"},{"s":45.54,"e":48.96,"text":"Truth getting buried beneath the salutes."},{"s":50.68,"e":53.2,"text":"Young boys boxed into battles and blues,"},{"s":53.12,"e":57.4,"text":"Born with a future, then forced to choose."},{"s":58.36,"e":60.88,"text":"Cold commands crack through a crooked connection:"},{"s":60.88,"e":64.82,"text":"“March toward the smoke in the enemy’s direction.”"},{"s":65.66,"e":68.76,"text":"But across that field through the ash and aggression,"},{"s":68.76,"e":73.84,"text":"He caught one kid’s eyes—and caught his reflection."},{"s":74.86,"e":76.98,"text":"Same mama praying, pacing the floor,"},{"s":76.98,"e":78.96,"text":"Same father waiting beside the front door,"},{"s":78.96,"e":81.58,"text":"Same baby sister saying, “Come home from the war,”"},{"s":81.58,"e":88.8,"text":"Same dreams that deserve to be something more."},{"s":89.94,"e":93.32,"text":"Same shaking hands, same sweat, same stress,"},{"s":93.32,"e":95.16,"text":"Same heart hammering hard in his chest."},{"s":95.16,"e":97.36,"text":"So he lowered the barrel, let bravery bloom:"},{"s":97.36,"e":99.24,"text":"“I won’t turn somebody’s baby to news.”"},{"s":99.24,"e":101.32,"text":"Commander came crashing: “Do what you’re told!”"},{"s":101.24,"e":103.22,"text":"But courage gets clearer when conscience gets bold."},{"s":103.22,"e":105.14,"text":"He dropped that rifle, let mercy take hold:"},{"s":105.14,"e":107.64,"text":"“I’d rather save souls than surrender my soul.”"},{"s":107.64,"e":108.14,"text":"[PRE-CHORUS — FEMALE]"},{"s":107.64,"e":109.74,"text":"One gun down…"},{"s":109.78,"e":111.72,"text":"Then two touched ground…"},{"s":111.72,"e":113.68,"text":"Then ten, then ten thousand—"},{"s":114.06,"e":116.92,"text":"No thunder, no sound."},{"s":116.92,"e":117.42,"text":"[CHORUS — FEMALE LEAD / MALE HARMONIES]"},{"s":116.92,"e":119.88,"text":"The last soldier refused to fight,"},{"s":119.88,"e":123.66,"text":"Dropped all the darkness, defended the light."},{"s":123.66,"e":127.64,"text":"One little “no” multiplied overnight,"},{"s":127.64,"e":131.96,"text":"Till millions stood still and remembered what’s right."},{"s":132.42,"e":135.54,"text":"No more mothers with midnight news,"},{"s":135.54,"e":140,"text":"No more children paying powerful dues."},{"s":140.6,"e":143.54,"text":"Peace began when somebody chose:"},{"s":143.54,"e":146.06,"text":"“You can order the war—"},{"s":146.3,"e":149.22,"text":"but my soul can refuse.”"},{"s":149.22,"e":149.72,"text":"[VERSE 2 — MALE RAP, DEEPER 808s]"},{"s":149.22,"e":151.12,"text":"Other side staring through smoke and surprise,"},{"s":151.12,"e":153.04,"text":"One soldier stood with his hands to the skies."},{"s":152.96,"e":155.04,"text":"Then another stepped forward, then five, then fifty,"},{"s":155.04,"e":156.96,"text":"Fear got fragile when mercy got risky."},{"s":156.96,"e":159.02,"text":"Steel started stacking in shimmering rows,"},{"s":159.02,"e":160.86,"text":"Rifles lay resting where red rivers flowed."},{"s":160.86,"e":162.84,"text":"No victory screaming, no vengeance to prove,"},{"s":162.84,"e":164.96,"text":"Just people with pulses refusing to lose."},{"s":164.96,"e":166.8,"text":"Lose their love, lose their light,"},{"s":166.8,"e":168.86,"text":"Lose one more brother to somebody’s fight."},{"s":168.78,"e":170.74,"text":"Can’t make me hate who I never have met,"},{"s":170.74,"e":172.84,"text":"Can’t make his children inherit our debt."},{"s":172.84,"e":174.64,"text":"Presidents pleading, generals grieving"},{"s":174.64,"e":176.8,"text":"For power that vanished when people stopped believing."},{"s":177.1,"e":178.66,"text":"Orders mean nothing when millions decide"},{"s":178.66,"e":181.26,"text":"That courage is choosing to keep someone alive."},{"s":181.26,"e":183.04,"text":"East and west, every emblem erased,"},{"s":183.04,"e":185.14,"text":"Every enemy finally given a face."},{"s":185.14,"e":187.52,"text":"And history wrote what the powerful knew:"},{"s":187.52,"e":189.48,"text":"A war needs soldiers—"},{"s":190.24,"e":192.46,"text":"and the soldiers withdrew."},{"s":192.46,"e":192.96,"text":"[BRIDGE — FEMALE, SOLO PIANO]"},{"s":192.94,"e":195.8,"text":"Maybe bravery isn’t a bullet or blade."},{"s":195.8,"e":200.6,"text":"Maybe strength is the life that you save."},{"s":200.8,"e":203.68,"text":"Maybe winning is walking away"},{"s":203.68,"e":207.42,"text":"From hatred handed from yesterday."},{"s":208.68,"e":210.78,"text":"Maybe peace isn’t passive or weak."},{"s":210.78,"e":212.82,"text":"Maybe peace is the bravest we speak."},{"s":212.82,"e":217.68,"text":"Maybe one voice, when honest and true,"},{"s":217.6,"e":222.76,"text":"Can give ten million permission to choose."},{"s":222.76,"e":223.26,"text":"[BUILD — MALE]"},{"s":222.76,"e":223.68,"text":"One step."},{"s":223.78,"e":224.72,"text":"One stand."},{"s":224.72,"e":225.7,"text":"One heart."},{"s":225.8,"e":226.72,"text":"One hand."},{"s":226.72,"e":228.4,"text":"One weapon down—"},{"s":228.4,"e":230.18,"text":"Then weapons worldwide."},{"s":230.18,"e":230.68,"text":"[FINAL CHORUS — MASSIVE DUET]"},{"s":237.56,"e":240.12,"text":"The last soldier refused to fight,"},{"s":240.12,"e":244.2,"text":"Then millions marched toward mercy and light."},{"s":244.2,"e":248.08,"text":"Every battlefield fell silent that night—"},{"s":248.08,"e":249.58,"text":"Nobody conquered,"},{"s":249.58,"e":252.72,"text":"but everybody survived."},{"s":252.72,"e":255.86,"text":"No more mothers with midnight news,"},{"s":256.72,"e":260.28,"text":"No more children paying powerful dues."},{"s":260.28,"e":263.72,"text":"Peace began when somebody chose:"},{"s":263.72,"e":265.9,"text":"“You can order the war—"},{"s":266.12,"e":270.24,"text":"but my soul can refuse.”"},{"s":270.24,"e":270.74,"text":"[OUTRO — FEMALE, SOLO PIANO]"},{"s":276.54,"e":278.02,"text":"One hand shook."},{"s":278.02,"e":279.86,"text":"One rifle dropped."},{"s":280,"e":281.92,"text":"One brave “no”…"},{"s":281.92,"e":285.74,"text":"And the battle stopped."}],"duration":292.2,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.779Z","stats":{"whisperWords":598,"polishedWords":523,"matched":488,"matchRate":0.933}}