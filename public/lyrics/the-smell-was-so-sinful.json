,"s":259.702,"e":260.685,"line":82},{"w":"ignite.","s":260.685,"e":261.34,"line":82},{"w":"One","s":261.34,"e":261.668,"line":83},{"w":"song","s":261.668,"e":261.995,"line":83},{"w":"cuts","s":261.995,"e":262.323,"line":83},{"w":"through","s":262.323,"e":262.65,"line":83},{"w":"the","s":262.65,"e":262.978,"line":83},{"w":"chemical","s":262.978,"e":263.961,"line":83},{"w":"night.","s":263.961,"e":264.288,"line":83},{"w":"The","s":264.288,"e":264.616,"line":84},{"w":"future","s":264.616,"e":265.271,"line":84},{"w":"came","s":265.271,"e":265.599,"line":84},{"w":"back—but","s":265.599,"e":266.254,"line":84},{"w":"it","s":266.254,"e":266.582,"line":84},{"w":"won’t","s":266.582,"e":266.909,"line":84},{"w":"come","s":266.909,"e":267.237,"line":84},{"w":"twice.","s":267.237,"e":267.565,"line":84},{"w":"Clean","s":267.565,"e":267.892,"line":85},{"w":"air","s":267.892,"e":268.22,"line":85},{"w":"is","s":268.22,"e":268.548,"line":85},{"w":"a","s":268.548,"e":268.875,"line":85},{"w":"right.","s":268.875,"e":269.203,"line":85},{"w":"Silence","s":268.8,"e":268.88,"line":86},{"w":"has","s":268.8,"e":268.88,"line":86},{"w":"a","s":268.8,"e":268.88,"line":86},{"w":"price.","s":268.8,"e":268.88,"line":86}],"lines":[{"s":12.6,"e":15.221,"text":"Future rockstar, black-star bastard,"},{"s":15.221,"e":18.497,"text":"Antichrist grin with a six-string blaster."},{"s":18.497,"e":21.773,"text":"Outside Guadalajara, midnight heat—"},{"s":21.773,"e":24.722,"text":"Jet-fuel breath rolling over the street."},{"s":24.722,"e":25.622,"text":"**[Verse 1]**"},{"s":25.622,"e":29.553,"text":"I landed where the runway bled smoke in the rain,"},{"s":29.553,"e":32.83,"text":"Chemical clouds putting rust in my brain."},{"s":32.83,"e":36.761,"text":"That sewage-sweet stench had a poisonous punch,"},{"s":36.761,"e":40.365,"text":"Like the whole damn future got left out to rot."},{"s":40.365,"e":43.969,"text":"I pulled out Suno, made the sirens sing,"},{"s":43.969,"e":47.573,"text":"Put the smell in a spell with a stadium swing."},{"s":47.573,"e":52.159,"text":"Every kick screamed, “Look what the silence allowed,”"},{"s":52.159,"e":56.091,"text":"Every snare struck shame through the face of the crowd."},{"s":56.091,"e":57.074,"text":"**[Pre-Chorus]**"},{"s":57.074,"e":58.384,"text":"Don’t scroll. Don’t shrug."},{"s":58.384,"e":61.005,"text":"Don’t call it someone else’s blood."},{"s":61.005,"e":63.954,"text":"When the poison fills the air we share,"},{"s":63.954,"e":66.902,"text":"Doing nothing is a choice—beware."},{"s":66.902,"e":67.802,"text":"**[Chorus]**"},{"s":67.802,"e":71.406,"text":"The smell was so sinful it fractured time,"},{"s":71.406,"e":75.01,"text":"Aliens came back from twenty ninety-nine."},{"s":75.01,"e":78.614,"text":"Silver ships split the Guadalajara night,"},{"s":78.614,"e":82.873,"text":"Cleaning every gutter in ultraviolet light."},{"s":82.873,"e":87.132,"text":"They said, “We crossed centuries following this song—"},{"s":87.132,"e":90.736,"text":"The warning was clear, but you waited too long.”"},{"s":90.736,"e":94.012,"text":"Future rockstar with the Antichrist sound:"},{"s":94.012,"e":97.616,"text":"“If you heard this truth and did nothing, you’re bound.”"},{"s":97.616,"e":98.516,"text":"**[Verse 2]**"},{"s":98.516,"e":101.792,"text":"They wore mirror masks and magnetic boots,"},{"s":101.792,"e":105.396,"text":"With cosmic filters growing crystalline roots."},{"s":105.396,"e":109,"text":"They drank down the toxins, dismantled the haze,"},{"s":109,"e":113.259,"text":"Then projected our apathy across the skyways."},{"s":113.259,"e":117.518,"text":"Every listener’s face in a hologram flame,"},{"s":117.518,"e":122.432,"text":"Every silent official with a timestamped name."},{"s":122.432,"e":126.036,"text":"Not guilty for breathing, not guilty for fear—"},{"s":126.036,"e":130.623,"text":"Guilty when the evidence screams and you refuse to hear."},{"s":130.623,"e":134.554,"text":"I’m the bad-ass omen with the black leather wings,"},{"s":134.554,"e":138.486,"text":"Not here for worship—I’m here to make alarms ring."},{"s":138.486,"e":142.417,"text":"Call me Antichrist because I challenge your calm,"},{"s":142.417,"e":146.349,"text":"While the air chokes children beneath airport palms."},{"s":146.349,"e":147.331,"text":"**[Pre-Chorus]**"},{"s":147.331,"e":148.642,"text":"Don’t scroll. Don’t shrug."},{"s":148.642,"e":151.591,"text":"Don’t let convenience become the drug."},{"s":151.591,"e":153.556,"text":"Make the call. Raise the proof."},{"s":153.556,"e":156.505,"text":"Make the powerful produce the truth."},{"s":156.505,"e":157.405,"text":"**[Chorus]**"},{"s":157.405,"e":161.009,"text":"The smell was so sinful it fractured time,"},{"s":161.009,"e":164.613,"text":"Aliens came back from twenty ninety-nine."},{"s":164.613,"e":168.216,"text":"Silver ships split the Guadalajara night,"},{"s":168.216,"e":172.475,"text":"Cleaning every gutter in ultraviolet light."},{"s":172.475,"e":176.735,"text":"They said, “We crossed centuries following this song—"},{"s":176.735,"e":180.338,"text":"The warning was clear, but you waited too long.”"},{"s":180.338,"e":183.615,"text":"Future rockstar with the Antichrist sound:"},{"s":183.615,"e":187.218,"text":"“If you heard this truth and did nothing, you’re bound.”"},{"s":187.218,"e":188.118,"text":"**[Bridge]**"},{"s":188.118,"e":190.412,"text":"Test the water. Trace the waste."},{"s":190.412,"e":192.705,"text":"Name the source and make them face"},{"s":192.705,"e":197.292,"text":"Every breath, every burn, every bitter cloud—"},{"s":197.292,"e":201.223,"text":"Justice gets louder when the witnesses get loud."},{"s":201.223,"e":203.517,"text":"Post the proof. Protect the poor."},{"s":203.517,"e":206.793,"text":"Demand clean air outside every door."},{"s":206.793,"e":210.069,"text":"The aliens shouldn’t have to travel through time"},{"s":210.069,"e":213.345,"text":"To clean up yesterday’s corporate crime."},{"s":213.345,"e":214.245,"text":"**[Breakdown]**"},{"s":214.245,"e":215.556,"text":"No savior ships."},{"s":215.556,"e":216.866,"text":"No future fix."},{"s":216.866,"e":218.177,"text":"No cosmic crew"},{"s":218.177,"e":219.815,"text":"Should do this for you."},{"s":219.815,"e":221.781,"text":"The song is the siren."},{"s":221.781,"e":224.074,"text":"The listener decides:"},{"s":224.074,"e":225.712,"text":"Stand with the living—"},{"s":225.712,"e":227.35,"text":"Or stand with the lies."},{"s":227.35,"e":228.661,"text":"**[Final Chorus]**"},{"s":228.661,"e":232.264,"text":"The smell was so sinful it fractured time,"},{"s":232.264,"e":235.868,"text":"Aliens came back from twenty ninety-nine."},{"s":235.868,"e":239.8,"text":"But they left us the tools and erased their light—"},{"s":239.8,"e":243.731,"text":"Said, “Now clean your world. Make the poisoned air right.”"},{"s":243.731,"e":246.352,"text":"Future rockstar, black-star broadcast,"},{"s":246.352,"e":249.628,"text":"Antichrist anthem from the runway blast."},{"s":249.628,"e":252.577,"text":"Once you know, you can’t hide underground—"},{"s":252.577,"e":256.508,"text":"Hear the truth, take action, turn the whole thing around."},{"s":256.508,"e":257.408,"text":"**[Outro]**"},{"s":257.408,"e":261.34,"text":"Outside Guadalajara, engines ignite."},{"s":261.34,"e":264.288,"text":"One song cuts through the chemical night."},{"s":264.288,"e":267.565,"text":"The future came back—but it won’t come twice."},{"s":267.565,"e":269.203,"text":"Clean air is a right."},{"s":268.8,"e":268.88,"text":"Silence has a price."}],"duration":269.96,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.000Z","realignedFrom":"whisper-aligned","vocalStart":12.6,"vocalEnd":268.8}