6,"line":97},{"w":"Outside","s":256.86,"e":257.5,"line":100},{"w":"Guadalajara,","s":257.5,"e":258.14,"line":100},{"w":"engines","s":258.22,"e":258.58,"line":100},{"w":"ignite.","s":258.58,"e":259.08,"line":100},{"w":"One","s":259.08,"e":259.98,"line":101},{"w":"song","s":259.98,"e":260.4,"line":101},{"w":"cuts","s":260.4,"e":260.72,"line":101},{"w":"through","s":260.72,"e":261,"line":101},{"w":"the","s":261,"e":261.4,"line":101},{"w":"chemical","s":261.4,"e":261.64,"line":101},{"w":"night.","s":261.64,"e":262.16,"line":101},{"w":"The","s":262.18,"e":262.82,"line":102},{"w":"future","s":262.82,"e":263.06,"line":102},{"w":"came","s":263.06,"e":263.58,"line":102},{"w":"back—but","s":263.96,"e":264.18,"line":102},{"w":"it","s":264.18,"e":264.54,"line":102},{"w":"won’t","s":264.54,"e":264.68,"line":102},{"w":"come","s":264.68,"e":265.14,"line":102},{"w":"twice.","s":265.14,"e":265.54,"line":102},{"w":"Clean","s":265.54,"e":266,"line":103},{"w":"air","s":266,"e":266.26,"line":103},{"w":"is","s":266.36,"e":266.46,"line":103},{"w":"a","s":266.46,"e":266.68,"line":103},{"w":"right.","s":266.68,"e":267,"line":103},{"w":"Silence","s":267.62,"e":267.94,"line":104},{"w":"has","s":267.94,"e":268.22,"line":104},{"w":"a","s":268.22,"e":268.44,"line":104},{"w":"price.","s":268.44,"e":268.8,"line":104}],"lines":[{"s":12.6,"e":16.16,"text":"Future rockstar, black-star bastard,"},{"s":16.16,"e":19.3,"text":"Antichrist grin with a six-string blaster."},{"s":19.72,"e":22.38,"text":"Outside Guadalajara, midnight heat—"},{"s":23.14,"e":25.54,"text":"Jet-fuel breath rolling over the street."},{"s":25.54,"e":26.04,"text":""},{"s":26.04,"e":26.54,"text":"**[Verse 1]**"},{"s":25.54,"e":28.74,"text":"I landed where the runway bled smoke in the rain,"},{"s":28.74,"e":31.86,"text":"Chemical clouds putting rust in my brain."},{"s":31.78,"e":34.96,"text":"That sewage-sweet stench had a poisonous punch,"},{"s":34.96,"e":38.94,"text":"Like the whole damn future got left out to rot."},{"s":38.76,"e":39.26,"text":""},{"s":41.34,"e":44.56,"text":"I pulled out Suno, made the sirens sing,"},{"s":44.56,"e":47.78,"text":"Put the smell in a spell with a stadium swing."},{"s":47.78,"e":50.96,"text":"Every kick screamed, “Look what the silence allowed,”"},{"s":50.96,"e":54.4,"text":"Every snare struck shame through the face of the crowd."},{"s":54.4,"e":54.9,"text":""},{"s":54.9,"e":55.4,"text":"**[Pre-Chorus]**"},{"s":55.04,"e":57.86,"text":"Don’t scroll. Don’t shrug."},{"s":57.86,"e":61.02,"text":"Don’t call it someone else’s blood."},{"s":61.02,"e":63.92,"text":"When the poison fills the air we share,"},{"s":63.92,"e":66.52,"text":"Doing nothing is a choice—beware."},{"s":66.52,"e":67.02,"text":""},{"s":67.02,"e":67.52,"text":"**[Chorus]**"},{"s":66.52,"e":70.02,"text":"The smell was so sinful it fractured time,"},{"s":70.02,"e":73,"text":"Aliens came back from twenty ninety-nine."},{"s":73,"e":76.34,"text":"Silver ships split the Guadalajara night,"},{"s":76.34,"e":79.52,"text":"Cleaning every gutter in ultraviolet light."},{"s":79.52,"e":80.02,"text":""},{"s":79.52,"e":83.34,"text":"They said, “We crossed centuries following this song—"},{"s":83.34,"e":86.5,"text":"The warning was clear, but you waited too long.”"},{"s":86.5,"e":89.58,"text":"Future rockstar with the Antichrist sound:"},{"s":89.58,"e":94.06,"text":"“If you heard this truth and did nothing, you’re bound.”"},{"s":94.06,"e":94.56,"text":""},{"s":94.56,"e":95.06,"text":"**[Verse 2]**"},{"s":95.52,"e":98.94,"text":"They wore mirror masks and magnetic boots,"},{"s":98.94,"e":102.28,"text":"With cosmic filters growing crystalline roots."},{"s":102.28,"e":105.36,"text":"They drank down the toxins, dismantled the haze,"},{"s":105.36,"e":108.78,"text":"Then projected our apathy across the skyways."},{"s":108.78,"e":109.28,"text":""},{"s":108.78,"e":112,"text":"Every listener’s face in a hologram flame,"},{"s":112,"e":115,"text":"Every silent official with a timestamped name."},{"s":115,"e":118.08,"text":"Not guilty for breathing, not guilty for fear—"},{"s":118.08,"e":121.92,"text":"Guilty when the evidence screams and you refuse to hear."},{"s":121.92,"e":122.42,"text":""},{"s":121.92,"e":124.76,"text":"I’m the bad-ass omen with the black leather wings,"},{"s":124.76,"e":127.92,"text":"Not here for worship—I’m here to make alarms ring."},{"s":127.92,"e":131,"text":"Call me Antichrist because I challenge your calm,"},{"s":131,"e":134.82,"text":"While the air chokes children beneath airport palms."},{"s":134.82,"e":135.32,"text":""},{"s":135.32,"e":135.82,"text":"**[Pre-Chorus]**"},{"s":134.82,"e":137.8,"text":"Don’t scroll. Don’t shrug."},{"s":137.8,"e":141.08,"text":"Don’t let convenience become the drug."},{"s":141.04,"e":144.32,"text":"Make the call. Raise the proof."},{"s":144.32,"e":146.7,"text":"Make the powerful produce the truth."},{"s":146.62,"e":147.12,"text":""},{"s":147.12,"e":147.62,"text":"**[Chorus]**"},{"s":146.62,"e":150.02,"text":"The smell was so sinful it fractured time,"},{"s":150.02,"e":153.04,"text":"Aliens came back from twenty ninety-nine."},{"s":153.04,"e":156.34,"text":"Silver ships split the Guadalajara night,"},{"s":156.34,"e":159.54,"text":"Cleaning every gutter in ultraviolet light."},{"s":159.54,"e":160.04,"text":""},{"s":159.54,"e":163.34,"text":"They said, “We crossed centuries following this song—"},{"s":163.34,"e":166.52,"text":"The warning was clear, but you waited too long.”"},{"s":166.52,"e":169.58,"text":"Future rockstar with the Antichrist sound:"},{"s":169.58,"e":173.4,"text":"“If you heard this truth and did nothing, you’re bound.”"},{"s":173.4,"e":173.9,"text":""},{"s":173.9,"e":174.4,"text":"**[Bridge]**"},{"s":173.4,"e":176.08,"text":"Test the water. Trace the waste."},{"s":176.08,"e":179.2,"text":"Name the source and make them face"},{"s":179.2,"e":182.2,"text":"Every breath, every burn, every bitter cloud—"},{"s":182.2,"e":185.66,"text":"Justice gets louder when the witnesses get loud."},{"s":185.66,"e":186.16,"text":""},{"s":185.66,"e":188.68,"text":"Post the proof. Protect the poor."},{"s":188.68,"e":191.72,"text":"Demand clean air outside every door."},{"s":191.72,"e":194.98,"text":"The aliens shouldn’t have to travel through time"},{"s":194.98,"e":198.8,"text":"To clean up yesterday’s corporate crime."},{"s":198.8,"e":199.3,"text":""},{"s":199.3,"e":199.8,"text":"**[Breakdown]**"},{"s":203.12,"e":206.72,"text":"No savior ships."},{"s":207.02,"e":210.06,"text":"No future fix."},{"s":210.06,"e":213.04,"text":"No cosmic crew"},{"s":213.04,"e":217.64,"text":"Should do this for you."},{"s":217.64,"e":218.14,"text":""},{"s":217.64,"e":219.2,"text":"The song is the siren."},{"s":219.12,"e":222.58,"text":"The listener decides:"},{"s":223.98,"e":225.48,"text":"Stand with the living—"},{"s":225.4,"e":228.72,"text":"Or stand with the lies."},{"s":228.72,"e":229.22,"text":""},{"s":229.22,"e":229.72,"text":"**[Final Chorus]**"},{"s":229.28,"e":233.22,"text":"The smell was so sinful it fractured time,"},{"s":233.22,"e":236.1,"text":"Aliens came back from twenty ninety-nine."},{"s":236.1,"e":239.58,"text":"But they left us the tools and erased their light—"},{"s":239.58,"e":242.64,"text":"Said, “Now clean your world. Make the poisoned air right.”"},{"s":242.64,"e":243.14,"text":""},{"s":242.64,"e":245.94,"text":"Future rockstar, black-star broadcast,"},{"s":245.94,"e":248.72,"text":"Antichrist anthem from the runway blast."},{"s":248.72,"e":251.88,"text":"Once you know, you can’t hide underground—"},{"s":251.98,"e":256.36,"text":"Hear the truth, take action, turn the whole thing around."},{"s":256.36,"e":256.86,"text":""},{"s":256.86,"e":257.36,"text":"**[Outro]**"},{"s":256.86,"e":259.08,"text":"Outside Guadalajara, engines ignite."},{"s":259.08,"e":262.16,"text":"One song cuts through the chemical night."},{"s":262.18,"e":265.54,"text":"The future came back—but it won’t come twice."},{"s":265.54,"e":267,"text":"Clean air is a right."},{"s":267.62,"e":268.8,"text":"Silence has a price."}],"duration":269.96,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.439Z","stats":{"whisperWords":546,"polishedWords":533,"matched":502,"matchRate":0.942}}