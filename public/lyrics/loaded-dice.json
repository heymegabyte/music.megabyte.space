holy","s":227.158,"e":228.14,"line":49},{"w":"stones,","s":228.14,"e":229.122,"line":49},{"w":"throne","s":229.122,"e":229.612,"line":49},{"w":"unknown,","s":229.612,"e":230.594,"line":49},{"w":"soul","s":230.594,"e":231.085,"line":49},{"w":"grown.","s":231.085,"e":231.576,"line":49},{"w":"Bad","s":231.576,"e":232.067,"line":50},{"w":"odds,","s":232.067,"e":232.558,"line":50},{"w":"deep","s":232.558,"e":233.049,"line":50},{"w":"rods,","s":233.049,"e":233.539,"line":50},{"w":"struck","s":233.539,"e":234.03,"line":50},{"w":"by","s":234.03,"e":234.521,"line":50},{"w":"God,","s":234.521,"e":235.012,"line":50},{"w":"still","s":235.012,"e":235.503,"line":50},{"w":"I","s":235.503,"e":235.994,"line":50},{"w":"nod.","s":235.994,"e":236.485,"line":50},{"w":"They","s":236.485,"e":236.976,"line":51},{"w":"never","s":236.976,"e":237.957,"line":51},{"w":"favored","s":237.957,"e":239.43,"line":51},{"w":"winning,","s":239.43,"e":240.412,"line":51},{"w":"they","s":240.412,"e":240.903,"line":51},{"w":"favored","s":240.903,"e":242.375,"line":51},{"w":"becoming.","s":242.375,"e":243.848,"line":51},{"w":"They","s":243.848,"e":244.339,"line":52},{"w":"never","s":244.339,"e":245.32,"line":52},{"w":"favored","s":245.32,"e":246.793,"line":52},{"w":"luck,","s":246.793,"e":247.284,"line":52},{"w":"they","s":247.284,"e":247.775,"line":52},{"w":"favored","s":247.775,"e":249.247,"line":52},{"w":"getting","s":249.247,"e":250.229,"line":52},{"w":"up.","s":250.229,"e":250.72,"line":52}],"lines":[{"s":9.21,"e":13.137,"text":"Cold bones roll, soul knows, low blows."},{"s":13.137,"e":16.082,"text":"Gold glows, hope goes, crow crows."},{"s":16.082,"e":19.027,"text":"Dice slide, eyes wide, pride died."},{"s":19.027,"e":23.445,"text":"Night lied, tides tried, I survived."},{"s":23.445,"e":26.391,"text":"Bad chance, sad dance, last stance."},{"s":26.391,"e":30.318,"text":"Black hands, cracked plans, trapped lands."},{"s":30.318,"e":33.263,"text":"Snake eyes, fake skies, great lies."},{"s":33.263,"e":37.19,"text":"Pain flies, faith rises, fate replies."},{"s":37.19,"e":40.135,"text":"No win, slow spin, soul grin."},{"s":40.135,"e":43.571,"text":"Thrown thin, grown in, shown within."},{"s":43.571,"e":46.516,"text":"Wrong way, long day, strong clay."},{"s":46.516,"e":49.953,"text":"Lost play, cross-shaped, God-made."},{"s":49.953,"e":55.843,"text":"Loaded dice, frozen nights, broken lights, chosen fights."},{"s":55.843,"e":62.224,"text":"Never right, never mine, every time, still I shine."},{"s":62.224,"e":67.133,"text":"They don’t favor me, but they’re raising me."},{"s":67.133,"e":72.042,"text":"They keep breaking me, but they’re making me."},{"s":72.042,"e":77.932,"text":"Crooked roll, holy toll, forge my soul, make me whole."},{"s":77.932,"e":81.859,"text":"Bad luck, hard struck, still stuck, still up."},{"s":81.859,"e":87.75,"text":"They don’t favor winning, they favor beginning."},{"s":87.75,"e":92.168,"text":"They don’t favor ease, they favor knees."},{"s":92.168,"e":96.586,"text":"House smiles, false aisles, lost miles."},{"s":96.586,"e":101.003,"text":"Dealer grins, sinner wins, thunder spins."},{"s":101.003,"e":103.949,"text":"Cards burn, scars learn, stars turn."},{"s":103.949,"e":107.385,"text":"Tables shake, prayers wake, chains break."},{"s":107.385,"e":110.33,"text":"Low roll, no gold, cold road."},{"s":110.33,"e":113.275,"text":"Deep debt, steep steps, wept sweat."},{"s":113.275,"e":116.221,"text":"No crown, thrown down, ghost town."},{"s":116.221,"e":119.657,"text":"Still found, still sound, still around."},{"s":119.657,"e":122.602,"text":"No prize, wise eyes, skies rise."},{"s":122.602,"e":125.547,"text":"Tears dry, fears die, I fly."},{"s":125.547,"e":128.492,"text":"Hard ground, heart pound, grace found."},{"s":128.492,"e":133.892,"text":"Turned around, glory crowned, mercy sounds."},{"s":133.892,"e":139.782,"text":"Loaded dice, frozen nights, broken lights, chosen fights."},{"s":139.782,"e":146.164,"text":"Never right, never mine, every time, still I shine."},{"s":146.164,"e":151.073,"text":"They don’t favor me, but they’re raising me."},{"s":151.073,"e":155.981,"text":"They keep breaking me, but they’re making me."},{"s":155.981,"e":161.872,"text":"Crooked roll, holy toll, forge my soul, make me whole."},{"s":161.872,"e":165.799,"text":"Bad luck, hard struck, still stuck, still up."},{"s":165.799,"e":171.689,"text":"They don’t favor winning, they favor beginning."},{"s":171.689,"e":176.107,"text":"They don’t favor ease, they favor knees."},{"s":176.107,"e":181.507,"text":"Let them roll, let them lie, let them die, I rise."},{"s":181.507,"e":186.906,"text":"Let them cheat, let them sneer, let them fear my fire."},{"s":186.906,"e":194.269,"text":"Every curse, every hearse, every worse reversed."},{"s":194.269,"e":200.16,"text":"Every scar, every bar, made me star-burst."},{"s":200.16,"e":202.123,"text":"Final Chorus"},{"s":202.123,"e":208.014,"text":"Loaded dice, sacred price, sacrifice, paradise."},{"s":208.014,"e":214.395,"text":"Never fair, never spared, still prepared, still there."},{"s":214.395,"e":219.795,"text":"They don’t favor treasure, they favor pressure."},{"s":219.795,"e":225.195,"text":"They don’t favor pleasure, they favor measure."},{"s":225.195,"e":231.576,"text":"Crooked bones, holy stones, throne unknown, soul grown."},{"s":231.576,"e":236.485,"text":"Bad odds, deep rods, struck by God, still I nod."},{"s":236.485,"e":243.848,"text":"They never favored winning, they favored becoming."},{"s":243.848,"e":250.72,"text":"They never favored luck, they favored getting up."}],"duration":269.92,"source":"curated-realigned","generatedAt":"2026-08-21T01:15:14.850Z","realignedFrom":"curated-realigned","vocalStart":9.21,"vocalEnd":250.72}