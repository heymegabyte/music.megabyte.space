1},{"w":"No","s":224.93,"e":225.248,"line":62},{"w":"more","s":225.248,"e":225.566,"line":62},{"w":"hell","s":225.566,"e":225.884,"line":62},{"w":"in","s":225.884,"e":226.203,"line":62},{"w":"the","s":226.203,"e":226.521,"line":62},{"w":"lungs,","s":226.521,"e":226.839,"line":62},{"w":"no","s":226.839,"e":227.157,"line":62},{"w":"more","s":227.157,"e":227.476,"line":62},{"w":"hell","s":227.476,"e":227.794,"line":62},{"w":"in","s":227.794,"e":228.112,"line":62},{"w":"the","s":228.112,"e":228.43,"line":62},{"w":"breeze—","s":228.43,"e":228.749,"line":62},{"w":"Río","s":228.749,"e":229.067,"line":63},{"w":"Santiago,","s":229.067,"e":230.022,"line":63},{"w":"breathe","s":230.022,"e":230.34,"line":63}],"lines":[{"s":14.24,"e":18.377,"text":"Five miles from the runway, the windows roll up tight,"},{"s":18.377,"e":22.515,"text":"Guadalajara morning with a chemical bite."},{"s":22.515,"e":25.379,"text":"Not smoke, not rain, not dust in the sun—"},{"s":25.379,"e":28.244,"text":"It’s the river saying, look what they’ve done."},{"s":28.244,"e":31.744,"text":"El Ahogado coughs by the airport road,"},{"s":31.744,"e":34.927,"text":"A black-water prayer with a dead-weight load."},{"s":34.927,"e":38.11,"text":"El Salto, Juanacatlán, living downwind,"},{"s":38.11,"e":41.292,"text":"Where the poor breathe proof of the rich man’s sin."},{"s":41.292,"e":43.838,"text":"Ya basta, no más veneno,"},{"s":43.838,"e":46.066,"text":"No more poison in the air."},{"s":46.066,"e":48.294,"text":"Agua limpia, aire digno,"},{"s":48.294,"e":50.204,"text":"Make the companies care."},{"s":50.204,"e":53.386,"text":"Fix the smell now, let Río Santiago breathe,"},{"s":53.386,"e":57.205,"text":"Not another child coughing by the factories."},{"s":57.205,"e":60.388,"text":"IBM, Hershey’s, every name on the line—"},{"s":60.388,"e":64.207,"text":"Open the pipes, show the permits, pay the fine."},{"s":64.207,"e":68.345,"text":"Fix the smell now, this is not “business as usual,”"},{"s":68.345,"e":72.482,"text":"It’s hell through the nose, it’s a human-rights funeral."},{"s":72.482,"e":75.665,"text":"Río Santiago, respira otra vez,"},{"s":75.665,"e":79.484,"text":"Clean the water, clean the air, confess what you did."},{"s":79.484,"e":82.985,"text":"They counted a thousand-plus ghosts in the flow,"},{"s":82.985,"e":86.804,"text":"Metals and toxins where the clean water should go."},{"s":86.804,"e":90.305,"text":"Arsenic, lead, mercury, cadmium names,"},{"s":90.305,"e":94.124,"text":"The periodic table playing funeral games."},{"s":94.124,"e":97.306,"text":"They said “progress,” they said “jobs,” they said “growth,”"},{"s":97.306,"e":101.444,"text":"But nobody signed up to choke in their own home."},{"s":101.444,"e":105.263,"text":"If the money got made while the neighborhood bled,"},{"s":105.263,"e":109.719,"text":"Then the cleanup gets paid before another one’s dead."},{"s":109.719,"e":112.265,"text":"Ya basta, no más veneno,"},{"s":112.265,"e":114.174,"text":"No more foam in the breeze."},{"s":114.174,"e":116.402,"text":"Agua limpia, aire digno,"},{"s":116.402,"e":117.993,"text":"Let the people breathe."},{"s":117.993,"e":121.176,"text":"Fix the smell now, let Río Santiago breathe,"},{"s":121.176,"e":124.995,"text":"Not another child coughing by the factories."},{"s":124.995,"e":128.178,"text":"IBM, Hershey’s, every name on the line—"},{"s":128.178,"e":131.997,"text":"Open the pipes, show the permits, pay the fine."},{"s":131.997,"e":136.134,"text":"Fix the smell now, this is not “business as usual,”"},{"s":136.134,"e":140.272,"text":"It’s hell through the nose, it’s a human-rights funeral."},{"s":140.272,"e":143.454,"text":"Río Santiago, respira otra vez,"},{"s":143.454,"e":147.274,"text":"Clean the water, clean the air, confess what you did."},{"s":147.274,"e":151.093,"text":"I came through the highway and smelled the abyss,"},{"s":151.093,"e":154.594,"text":"Closest thing to hell with a passport stamp kiss."},{"s":154.594,"e":158.731,"text":"Self-proclaimed Antichrist, but I’m asking for grace:"},{"s":158.731,"e":162.232,"text":"Clean up the river, put a mask on no face."},{"s":162.232,"e":165.733,"text":"This is not a threat, this is witness and sound,"},{"s":165.733,"e":169.552,"text":"A trumpet for the towns where the truth is drowned."},{"s":169.552,"e":173.689,"text":"Audit every outflow, publish every test,"},{"s":173.689,"e":177.508,"text":"If your profit touched poison, then pay the rest."},{"s":177.508,"e":180.373,"text":"¿Quién paga? — The ones who knew."},{"s":180.373,"e":182.919,"text":"¿Quién sana? — The people do."},{"s":182.919,"e":185.465,"text":"¿Quién firma? — The state, the brand."},{"s":185.465,"e":188.966,"text":"¿Quién vive? — The ones downstream, hand in hand."},{"s":188.966,"e":192.149,"text":"Fix the smell now, let Río Santiago breathe,"},{"s":192.149,"e":196.922,"text":"From El Ahogado to El Salto, set the water free."},{"s":196.922,"e":200.105,"text":"IBM, Hershey’s, every plant in the zone—"},{"s":200.105,"e":204.243,"text":"If your waste touched the river, you don’t walk alone."},{"s":204.243,"e":207.743,"text":"Fix the smell now, por la vida, por la gente,"},{"s":207.743,"e":211.881,"text":"No more sickness hidden underneath development."},{"s":211.881,"e":215.063,"text":"Río Santiago, respira otra vez,"},{"s":215.063,"e":218.883,"text":"Clean the water, clean the air, let Jalisco live."},{"s":218.883,"e":221.747,"text":"No más espuma, no más dolor,"},{"s":221.747,"e":224.93,"text":"Que vuelva el río, que vuelva la flor."},{"s":224.93,"e":228.749,"text":"No more hell in the lungs, no more hell in the breeze—"},{"s":228.749,"e":230.34,"text":"Río Santiago, breathe"}],"duration":230.72,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.865Z","realignedFrom":"whisper-aligned","vocalStart":14.24,"vocalEnd":230.34}