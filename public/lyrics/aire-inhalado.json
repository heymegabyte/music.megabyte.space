line":59},{"w":"Jalisco","s":201.2,"e":202.2,"line":59},{"w":"live.","s":202.2,"e":203.72,"line":59},{"w":"No","s":205.72,"e":206.1,"line":60},{"w":"más","s":206.1,"e":206.38,"line":60},{"w":"espuma,","s":206.38,"e":207.04,"line":60},{"w":"no","s":207.32,"e":207.56,"line":60},{"w":"más","s":207.56,"e":207.74,"line":60},{"w":"dolor,","s":207.74,"e":208.4,"line":60},{"w":"Que","s":208.4,"e":208.84,"line":61},{"w":"vuelva","s":208.84,"e":209.18,"line":61},{"w":"el","s":209.18,"e":209.72,"line":61},{"w":"río,","s":209.72,"e":209.88,"line":61},{"w":"que","s":209.88,"e":210.3,"line":61},{"w":"vuelva","s":210.3,"e":210.38,"line":61},{"w":"la","s":210.3,"e":210.8,"line":61},{"w":"flor.","s":210.8,"e":211.18,"line":61},{"w":"No","s":211.18,"e":211.72,"line":62},{"w":"more","s":211.72,"e":212.14,"line":62},{"w":"hell","s":212.14,"e":212.52,"line":62},{"w":"in","s":212.52,"e":213.14,"line":62},{"w":"the","s":213.14,"e":213.54,"line":62},{"w":"lungs,","s":213.54,"e":214.04,"line":62},{"w":"no","s":214.04,"e":214.46,"line":62},{"w":"more","s":214.46,"e":214.68,"line":62},{"w":"hell","s":214.68,"e":215.28,"line":62},{"w":"in","s":215.28,"e":215.88,"line":62},{"w":"the","s":215.88,"e":216.3,"line":62},{"w":"breeze—","s":216.3,"e":216.96,"line":62},{"w":"Río","s":229.3,"e":230.7,"line":63},{"w":"Santiago,","s":230.7,"e":230.78,"line":63},{"w":"breathe","s":230.7,"e":230.78,"line":63}],"lines":[{"s":14.56,"e":18.84,"text":"Five miles from the runway, the windows roll up tight,"},{"s":21.02,"e":23.92,"text":"Guadalajara morning with a chemical bite."},{"s":24.5,"e":27.76,"text":"Not smoke, not rain, not dust in the sun—"},{"s":28.76,"e":35.32,"text":"It’s the river saying, look what they’ve done."},{"s":35.32,"e":38.7,"text":"El Ahogado coughs by the airport road,"},{"s":38.7,"e":41.54,"text":"A black-water prayer with a dead-weight load."},{"s":41.54,"e":44.24,"text":"El Salto, Juanacatlán, living downwind,"},{"s":44.24,"e":47.28,"text":"Where the poor breathe proof of the rich man’s sin."},{"s":47.3,"e":49.92,"text":"Ya basta, no más veneno,"},{"s":50.26,"e":53.34,"text":"No more poison in the air."},{"s":53.34,"e":56.2,"text":"Agua limpia, aire digno,"},{"s":56.2,"e":59.04,"text":"Make the companies care."},{"s":59.04,"e":62.22,"text":"Fix the smell now, let Río Santiago breathe,"},{"s":62.22,"e":64.92,"text":"Not another child coughing by the factories."},{"s":65.06,"e":67.74,"text":"IBM, Hershey’s, every name on the line—"},{"s":67.92,"e":70.5,"text":"Open the pipes, show the permits, pay the fine."},{"s":70.5,"e":73.3,"text":"Fix the smell now, this is not “business as usual,”"},{"s":73.32,"e":76.16,"text":"It’s hell through the nose, it’s a human-rights funeral."},{"s":76.18,"e":78.68,"text":"Río Santiago, respira otra vez,"},{"s":78.68,"e":81.6,"text":"Clean the water, clean the air, confess what you did."},{"s":81.6,"e":83.9,"text":"They counted a thousand-plus ghosts in the flow,"},{"s":83.9,"e":86.96,"text":"Metals and toxins where the clean water should go."},{"s":86.96,"e":89.74,"text":"Arsenic, lead, mercury, cadmium names,"},{"s":89.74,"e":92.32,"text":"The periodic table playing funeral games."},{"s":92.32,"e":94.62,"text":"They said “progress,” they said “jobs,” they said “growth,”"},{"s":94.62,"e":97.98,"text":"But nobody signed up to choke in their own home."},{"s":97.98,"e":100.74,"text":"If the money got made while the neighborhood bled,"},{"s":100.74,"e":103.52,"text":"Then the cleanup gets paid before another one’s dead."},{"s":103.52,"e":105.74,"text":"Ya basta, no más veneno,"},{"s":105.74,"e":108.52,"text":"No more foam in the breeze."},{"s":108.78,"e":111.46,"text":"Agua limpia, aire digno,"},{"s":111.46,"e":113.46,"text":"Let the people breathe."},{"s":114.22,"e":117.38,"text":"Fix the smell now, let Río Santiago breathe,"},{"s":117.38,"e":120.08,"text":"Not another child coughing by the factories."},{"s":120.2,"e":122.86,"text":"IBM, Hershey’s, every name on the line—"},{"s":123.08,"e":125.62,"text":"Open the pipes, show the permits, pay the fine."},{"s":125.62,"e":128.5,"text":"Fix the smell now, this is not “business as usual,”"},{"s":128.54,"e":131.3,"text":"It’s hell through the nose, it’s a human-rights funeral."},{"s":131.4,"e":133.8,"text":"Río Santiago, respira otra vez,"},{"s":133.8,"e":136.74,"text":"Clean the water, clean the air, confess what you did."},{"s":136.74,"e":139.34,"text":"I came through the highway and smelled the abyss,"},{"s":139.34,"e":143.16,"text":"Closest thing to hell with a passport stamp kiss."},{"s":143.16,"e":145.22,"text":"Self-proclaimed Antichrist, but I’m asking for grace:"},{"s":145.22,"e":147.96,"text":"Clean up the river, put a mask on no face."},{"s":147.96,"e":150.56,"text":"This is not a threat, this is witness and sound,"},{"s":150.56,"e":153.12,"text":"A trumpet for the towns where the truth is drowned."},{"s":153.48,"e":155.64,"text":"Audit every outflow, publish every test,"},{"s":155.64,"e":158.4,"text":"If your profit touched poison, then pay the rest."},{"s":159.14,"e":161.78,"text":"¿Quién paga? — The ones who knew."},{"s":161.9,"e":164.6,"text":"¿Quién sana? — The people do."},{"s":164.62,"e":166.98,"text":"¿Quién firma? — The state, the brand."},{"s":166.96,"e":172.06,"text":"¿Quién vive? — The ones downstream, hand in hand."},{"s":172.06,"e":174.96,"text":"Fix the smell now, let Río Santiago breathe,"},{"s":176.66,"e":182.78,"text":"From El Ahogado to El Salto, set the water free."},{"s":183.18,"e":186.24,"text":"IBM, Hershey’s, every plant in the zone—"},{"s":186.24,"e":189.22,"text":"If your waste touched the river, you don’t walk alone."},{"s":189.22,"e":191.84,"text":"Fix the smell now, por la vida, por la gente,"},{"s":191.84,"e":194.72,"text":"No more sickness hidden underneath development."},{"s":194.72,"e":197.01,"text":"Río Santiago, respira otra vez,"},{"s":197.34,"e":203.72,"text":"Clean the water, clean the air, let Jalisco live."},{"s":205.72,"e":208.4,"text":"No más espuma, no más dolor,"},{"s":208.4,"e":211.18,"text":"Que vuelva el río, que vuelva la flor."},{"s":211.18,"e":216.96,"text":"No more hell in the lungs, no more hell in the breeze—"},{"s":229.3,"e":230.78,"text":"Río Santiago, breathe"}],"duration":230.72,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.416Z","stats":{"whisperWords":512,"polishedWords":492,"matched":456,"matchRate":0.927}}