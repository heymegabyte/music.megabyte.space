"w":"ghetto","s":297.551,"e":298.168,"line":96},{"w":"with","s":298.168,"e":298.476,"line":96},{"w":"a","s":298.476,"e":298.785,"line":96},{"w":"soul","s":298.785,"e":299.093,"line":96},{"w":"made","s":299.093,"e":299.402,"line":96},{"w":"gold","s":299.402,"e":299.71,"line":96},{"w":"Met","s":299.71,"e":300.019,"line":97},{"w":"the","s":300.019,"e":300.328,"line":97},{"w":"real","s":300.328,"e":300.636,"line":97},{"w":"Jesus","s":300.636,"e":301.253,"line":97},{"w":"where","s":301.253,"e":301.562,"line":97},{"w":"the","s":301.562,"e":301.87,"line":97},{"w":"timelines","s":301.87,"e":303.104,"line":97},{"w":"fold","s":303.104,"e":303.413,"line":97},{"w":"What’s","s":303.413,"e":303.721,"line":98},{"w":"the","s":303.721,"e":304.03,"line":98},{"w":"metaphor?","s":304.03,"e":304.955,"line":98},{"w":"Maybe","s":304.955,"e":305.264,"line":99},{"w":"the","s":305.264,"e":305.573,"line":99},{"w":"poor","s":305.573,"e":305.881,"line":99},{"w":"kid","s":305.881,"e":306.19,"line":99},{"w":"survives","s":306.19,"e":307.115,"line":99},{"w":"the","s":307.115,"e":307.424,"line":99},{"w":"war","s":307.424,"e":307.732,"line":99},{"w":"What’s","s":307.732,"e":308.041,"line":100},{"w":"the","s":308.041,"e":308.349,"line":100},{"w":"metaphor?","s":308.349,"e":309.275,"line":100},{"w":"Maybe","s":309.275,"e":309.583,"line":101},{"w":"God","s":309.583,"e":309.892,"line":101},{"w":"was","s":309.892,"e":310.201,"line":101},{"w":"driving","s":310.201,"e":310.818,"line":101},{"w":"the","s":310.818,"e":311.126,"line":101},{"w":"bus","s":311.126,"e":311.435,"line":101},{"w":"all","s":311.435,"e":311.743,"line":101},{"w":"along","s":311.743,"e":312.36,"line":101},{"w":"Yuh,","s":312.36,"e":312.669,"line":102},{"w":"baby","s":312.669,"e":313.286,"line":102},{"w":"believe","s":313.286,"e":313.903,"line":102},{"w":"this,","s":313.903,"e":314.211,"line":102},{"w":"yuh","s":314.211,"e":314.52,"line":102}],"lines":[{"s":1.668,"e":3.828,"text":"Yuh, baby believe this, yuh"},{"s":3.828,"e":6.913,"text":"Bus full of saints with the windows cracked"},{"s":6.913,"e":10.307,"text":"Bible in the backpack, thunder in the map"},{"s":10.307,"e":14.318,"text":"Sixteen in the ghetto with a halo and a past"},{"s":14.318,"e":19.254,"text":"Headed toward the water where the timelines overlap"},{"s":19.254,"e":22.957,"text":"I was sixteen, sirens singing through the screen door"},{"s":22.957,"e":26.968,"text":"Mama said, “Pray before you step across the green floor”"},{"s":26.968,"e":29.744,"text":"Concrete cracked like the Red Sea split"},{"s":29.744,"e":34.99,"text":"Everybody had a secret, everybody had a script"},{"s":34.99,"e":39,"text":"They said the world was normal, said the ads were just ads"},{"s":39,"e":43.628,"text":"But the billboards knew my name and the cameras looked sad"},{"s":43.628,"e":47.331,"text":"Tooltips in the corner of my eyesight blink fast"},{"s":47.331,"e":51.033,"text":"Like, “What’s the metaphor?” while the whole sky laughed"},{"s":51.033,"e":54.736,"text":"Opposing forces pulling strings in the choir loft"},{"s":54.736,"e":59.055,"text":"Hands in every hand like the handshake never wore off"},{"s":59.055,"e":62.757,"text":"Surveillance state saints with a sermon and a drone"},{"s":62.757,"e":66.151,"text":"But I kept one psalm saved deep in my phone"},{"s":66.151,"e":69.545,"text":"Pastor said, “Child, there’s a storm in your blood”"},{"s":69.545,"e":72.63,"text":"Deacon said, “Boy, don’t you run from the flood”"},{"s":72.63,"e":76.024,"text":"Bus driver whispered, “This route ain’t planned”"},{"s":76.024,"e":80.344,"text":"Then the compass started spinning in the palm of my hand"},{"s":80.344,"e":82.812,"text":"We rode through the Bermuda rain"},{"s":82.812,"e":85.897,"text":"On a gospel bus with a holy flame"},{"s":85.897,"e":88.366,"text":"Time bent back when the thunder came"},{"s":88.366,"e":91.142,"text":"And Jesus called me by my name"},{"s":91.142,"e":92.994,"text":"Baby believe this, yuh"},{"s":92.994,"e":94.845,"text":"Baby believe this, yuh"},{"s":94.845,"e":97.313,"text":"If you scream and the tooltips flash"},{"s":97.313,"e":100.09,"text":"Ask heaven what the metaphor has"},{"s":100.09,"e":101.941,"text":"Baby believe this, yuh"},{"s":101.941,"e":103.792,"text":"Baby believe this, yuh"},{"s":103.792,"e":107.495,"text":"Sixteen with a prophecy stitched in my soul"},{"s":107.495,"e":110.58,"text":"Through the triangle where the bright gates glow"},{"s":110.58,"e":114.282,"text":"It was a Baptist CCD trip, don’t ask how it fit"},{"s":114.282,"e":117.368,"text":"Some kids had rosaries, some kids had grit"},{"s":117.368,"e":120.453,"text":"Some kids had trauma they could not explain"},{"s":120.453,"e":123.538,"text":"Some kids saw angels in the hurricane"},{"s":123.538,"e":126.932,"text":"We passed three ships from three different years"},{"s":126.932,"e":130.018,"text":"One full of soldiers, one full of mirrors"},{"s":130.018,"e":133.103,"text":"One had a billboard selling fear as truth"},{"s":133.103,"e":136.805,"text":"And every ad looked exactly like proof"},{"s":136.805,"e":140.199,"text":"A girl in the back started humming old hymns"},{"s":140.199,"e":143.284,"text":"The windows went white and the lights went dim"},{"s":143.284,"e":147.604,"text":"The preacher grabbed the aisle like Moses with a staff"},{"s":147.604,"e":150.998,"text":"While the clock on the dashboard broke clean in half"},{"s":150.998,"e":154.392,"text":"Then I saw the city where no poor kids bleed"},{"s":154.392,"e":157.785,"text":"Where no landlord laughs and no hungry mouths plead"},{"s":157.785,"e":161.179,"text":"Where the last become first and the first kneel low"},{"s":161.179,"e":164.573,"text":"Where the real Jesus walks where the warm winds blow"},{"s":164.573,"e":167.967,"text":"He wasn’t on a billboard, wasn’t dressed like gold"},{"s":167.967,"e":171.669,"text":"He had dust on His sandals and fire in His soul"},{"s":171.669,"e":175.372,"text":"He said, “Child, they can watch, they can plot, they can lie"},{"s":175.372,"e":179.383,"text":"But they can’t own the truth that I placed in your eyes”"},{"s":179.383,"e":181.851,"text":"We rode through the Bermuda rain"},{"s":181.851,"e":184.936,"text":"On a gospel bus with a holy flame"},{"s":184.936,"e":187.405,"text":"Time bent back when the thunder came"},{"s":187.405,"e":190.181,"text":"And Jesus called me by my name"},{"s":190.181,"e":192.033,"text":"Baby believe this, yuh"},{"s":192.033,"e":193.884,"text":"Baby believe this, yuh"},{"s":193.884,"e":196.352,"text":"If you scream and the tooltips flash"},{"s":196.352,"e":199.129,"text":"Ask heaven what the metaphor has"},{"s":199.129,"e":200.98,"text":"Baby believe this, yuh"},{"s":200.98,"e":202.831,"text":"Baby believe this, yuh"},{"s":202.831,"e":206.534,"text":"Sixteen with a prophecy stitched in my soul"},{"s":206.534,"e":209.619,"text":"Through the triangle where the bright gates glow"},{"s":209.619,"e":211.162,"text":"What’s the metaphor?"},{"s":211.162,"e":214.555,"text":"A kid from the block with a key to the door"},{"s":214.555,"e":216.098,"text":"What’s the metaphor?"},{"s":216.098,"e":218.875,"text":"A lie gets loud when the truth gets poor"},{"s":218.875,"e":220.418,"text":"What’s the metaphor?"},{"s":220.418,"e":223.811,"text":"A camera can stare but it can’t restore"},{"s":223.811,"e":225.354,"text":"What’s the metaphor?"},{"s":225.354,"e":228.131,"text":"Jesus in the storm saying, “You are more”"},{"s":228.131,"e":231.833,"text":"He showed me my life like stained glass breaking"},{"s":231.833,"e":236.153,"text":"Every secret war, every fake awakening"},{"s":236.153,"e":239.855,"text":"Every hidden hand, every fear campaign"},{"s":239.855,"e":243.558,"text":"Every rich man drinking from a poor boy’s pain"},{"s":243.558,"e":246.951,"text":"Then He washed my face in the triangle tide"},{"s":246.951,"e":250.037,"text":"Said, “You don’t have to prove what burns inside"},{"s":250.037,"e":253.122,"text":"Prophecy ain’t panic, power ain’t rage"},{"s":253.122,"e":256.207,"text":"Write love like lightning on the end-time page”"},{"s":256.207,"e":260.218,"text":"So I came back different when the bus touched land"},{"s":260.218,"e":264.229,"text":"With a gospel in my throat and a scar on my hand"},{"s":264.229,"e":267.623,"text":"The city still watched, but it couldn’t hold me"},{"s":267.623,"e":271.634,"text":"I had bread for the hungry and a God who knows me"},{"s":271.634,"e":272.868,"text":"Final Chorus"},{"s":272.868,"e":275.336,"text":"We rode through the Bermuda rain"},{"s":275.336,"e":278.422,"text":"On a gospel bus with a holy flame"},{"s":278.422,"e":280.89,"text":"Time bent back when the thunder came"},{"s":280.89,"e":283.667,"text":"And Jesus called me by my name"},{"s":283.667,"e":285.518,"text":"Baby believe this, yuh"},{"s":285.518,"e":287.369,"text":"Baby believe this, yuh"},{"s":287.369,"e":289.837,"text":"If you scream and the tooltips flash"},{"s":289.837,"e":292.614,"text":"Ask heaven what the metaphor has"},{"s":292.614,"e":294.465,"text":"Baby believe this, yuh"},{"s":294.465,"e":296.317,"text":"Baby believe this, yuh"},{"s":296.317,"e":299.71,"text":"Sixteen from the ghetto with a soul made gold"},{"s":299.71,"e":303.413,"text":"Met the real Jesus where the timelines fold"},{"s":303.413,"e":304.955,"text":"What’s the metaphor?"},{"s":304.955,"e":307.732,"text":"Maybe the poor kid survives the war"},{"s":307.732,"e":309.275,"text":"What’s the metaphor?"},{"s":309.275,"e":312.36,"text":"Maybe God was driving the bus all along"},{"s":312.36,"e":314.52,"text":"Yuh, baby believe this, yuh"}],"duration":314.52,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.990Z","realignedFrom":"whisper-aligned","vocalStart":1.668,"vocalEnd":314.52}