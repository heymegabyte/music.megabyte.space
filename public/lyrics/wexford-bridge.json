44.552,"line":67},{"w":"not","s":144.552,"e":144.715,"line":67},{"w":"quiet,","s":144.715,"e":144.878,"line":67},{"w":"not","s":144.878,"e":145.041,"line":67},{"w":"conquered,","s":145.041,"e":145.53,"line":67},{"w":"not","s":145.53,"e":145.693,"line":67},{"w":"gone,","s":145.693,"e":145.856,"line":67},{"w":"The","s":145.856,"e":146.019,"line":68},{"w":"river","s":146.019,"e":146.345,"line":68},{"w":"remembers,","s":146.345,"e":146.834,"line":68},{"w":"and","s":146.834,"e":146.996,"line":68},{"w":"the","s":146.996,"e":147.159,"line":68},{"w":"blood","s":147.159,"e":147.322,"line":68},{"w":"sings","s":147.322,"e":147.4,"line":68},{"w":"on.","s":147.4,"e":147.48,"line":68}],"lines":[{"s":26.66,"e":28.452,"text":"Matthew Keogh, Keugh, Keough, name carved through the rain,"},{"s":28.452,"e":30.245,"text":"From Wexford’s wet stones to the wildfire flame,"},{"s":30.245,"e":32.037,"text":"Born by the barley, by the blackthorn and brine,"},{"s":32.037,"e":34.155,"text":"A soldier in scarlet, then a rebel by design."},{"s":34.155,"e":36.274,"text":"He marched North America, musket smoke and mud,"},{"s":36.274,"e":37.903,"text":"Rose rank by rank through the regiment’s blood,"},{"s":37.903,"e":39.858,"text":"From private to officer, from crown to the crowd,"},{"s":39.858,"e":41.814,"text":"Then back to old Wexford where the war drums got loud."},{"s":41.814,"e":43.443,"text":"Justice was jagged, the gallows were grim,"},{"s":43.443,"e":45.398,"text":"The river ran red and the sky swallowed him,"},{"s":45.398,"e":47.191,"text":"He tried to hold order when the old world split,"},{"s":47.191,"e":48.983,"text":"But thunder doesn’t ask where the lightning will hit."},{"s":48.983,"e":50.775,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":50.775,"e":52.894,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":52.894,"e":54.034,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":54.034,"e":55.664,"text":"My great-great-great in the grief and the grain."},{"s":55.664,"e":57.456,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":57.456,"e":59.574,"text":"Of a town turned to tempest when the crown came down,"},{"s":59.574,"e":61.204,"text":"He stood in the storm while the steel bells rang,"},{"s":61.204,"e":62.833,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":62.833,"e":64.463,"text":"Freeman of Wexford, fierce fire in his chest,"},{"s":64.463,"e":66.418,"text":"Stripped from the bench when they called him unrest,"},{"s":66.418,"e":68.047,"text":"Justice of peace, then a piece on the board,"},{"s":68.047,"e":70.003,"text":"Caught between the people and the point of the sword."},{"s":70.003,"e":71.795,"text":"Thirty-first of May, when the town gates gave,"},{"s":71.795,"e":73.75,"text":"The United men rose like a tide from the grave,"},{"s":73.75,"e":75.543,"text":"A Council of People, a cause and a cry,"},{"s":75.543,"e":77.498,"text":"And Matthew was lifted where the bullets could fly."},{"s":77.498,"e":79.127,"text":"Cathaoirleach, captain, governor in gray,"},{"s":79.127,"e":80.594,"text":"Trying to steer night into breaking day,"},{"s":80.594,"e":82.223,"text":"But mobs move madly when mercy grows thin,"},{"s":82.223,"e":84.341,"text":"And the bridge became burdened by blood and by sin."},{"s":84.341,"e":86.134,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":86.134,"e":88.252,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":88.252,"e":89.393,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":89.393,"e":91.022,"text":"My great-great-great in the grief and the grain."},{"s":91.022,"e":92.814,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":92.814,"e":94.933,"text":"Of a town turned to tempest when the crown came down,"},{"s":94.933,"e":96.562,"text":"He stood in the storm while the steel bells rang,"},{"s":96.562,"e":98.192,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":98.192,"e":99.821,"text":"Not saint, not serpent, not simple, not clean,"},{"s":99.821,"e":101.939,"text":"A man in the middle of a murderous machine,"},{"s":101.939,"e":104.057,"text":"Good intentions tangled where the pikes pushed through,"},{"s":104.057,"e":106.013,"text":"And history’s hands are never gentle or true."},{"s":106.013,"e":107.153,"text":"Mock trials, wild cries, loyalists slain,"},{"s":107.153,"e":108.946,"text":"Almost a hundred in the horror and rain,"},{"s":108.946,"e":110.575,"text":"He couldn’t command what the chaos had crowned,"},{"s":110.575,"e":112.042,"text":"Then the Crown came back and cut him down."},{"s":112.042,"e":113.834,"text":"Twenty-fifth of June, seventeen ninety-eight,"},{"s":113.834,"e":115.626,"text":"The verdict came cold and the sentence came straight,"},{"s":115.626,"e":117.582,"text":"Hanged on the bridge where the broken were tossed,"},{"s":117.582,"e":119.537,"text":"Into Slaney’s dark arms with the rebels and lost."},{"s":119.537,"e":121.329,"text":"His body was taken, his head raised high,"},{"s":121.329,"e":123.285,"text":"A warning to Wexford beneath a bruised sky,"},{"s":123.285,"e":125.24,"text":"But names have a way of refusing the grave,"},{"s":125.24,"e":127.032,"text":"They roll through the bloodline, rebellious and brave."},{"s":127.032,"e":127.932,"text":"Final Chorus"},{"s":127.932,"e":129.725,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":129.725,"e":131.843,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":131.843,"e":132.983,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":132.983,"e":134.613,"text":"My great-great-great in the grief and the grain."},{"s":134.613,"e":136.405,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":136.405,"e":138.523,"text":"Of a town turned to tempest when the crown came down,"},{"s":138.523,"e":140.153,"text":"He stood in the storm while the steel bells rang,"},{"s":140.153,"e":141.782,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":141.782,"e":142.923,"text":"Keogh, Keugh, Keough, carried through me,"},{"s":142.923,"e":144.226,"text":"From Wexford Bridge to memory,"},{"s":144.226,"e":145.856,"text":"Not clean, not quiet, not conquered, not gone,"},{"s":145.856,"e":147.48,"text":"The river remembers, and the blood sings on."}],"duration":293.12,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.873Z","realignedFrom":"whisper","vocalStart":26.66,"vocalEnd":147.4}