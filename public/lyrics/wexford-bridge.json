,"line":63},{"w":"steel","s":254.64,"e":255.14,"line":63},{"w":"bells","s":255.14,"e":255.5,"line":63},{"w":"rang,","s":255.5,"e":256,"line":63},{"w":"Then","s":256,"e":256.76,"line":64},{"w":"Wexford","s":256.76,"e":257.58,"line":64},{"w":"Bridge","s":257.58,"e":258.24,"line":64},{"w":"heard","s":258.52,"e":259.52,"line":64},{"w":"the","s":259.52,"e":259.84,"line":64},{"w":"rope","s":259.84,"e":260.18,"line":64},{"w":"snap","s":260.18,"e":260.58,"line":64},{"w":"and","s":260.58,"e":263.88,"line":64},{"w":"sang.","s":263.88,"e":264.06,"line":64},{"w":"Keogh,","s":264.84,"e":265.34,"line":65},{"w":"Keugh,","s":266.04,"e":266.22,"line":65},{"w":"Keough,","s":266.8,"e":266.88,"line":65},{"w":"carried","s":266.8,"e":267.52,"line":65},{"w":"through","s":267.52,"e":267.84,"line":65},{"w":"me,","s":267.84,"e":268.4,"line":65},{"w":"From","s":269.3,"e":270.3,"line":66},{"w":"Wexford","s":270.3,"e":271,"line":66},{"w":"Bridge","s":271,"e":271.66,"line":66},{"w":"to","s":271.66,"e":272.32,"line":66},{"w":"memory,","s":272.32,"e":272.84,"line":66},{"w":"Not","s":272.84,"e":273.28,"line":67},{"w":"clean,","s":273.28,"e":273.74,"line":67},{"w":"not","s":273.9,"e":274.38,"line":67},{"w":"quiet,","s":274.38,"e":274.86,"line":67},{"w":"not","s":274.86,"e":275.42,"line":67},{"w":"conquered,","s":275.42,"e":276.08,"line":67},{"w":"not","s":276.22,"e":276.48,"line":67},{"w":"gone,","s":276.48,"e":276.88,"line":67},{"w":"The","s":277.6,"e":278.6,"line":68},{"w":"river","s":278.6,"e":279.02,"line":68},{"w":"remembers,","s":279.02,"e":280.14,"line":68},{"w":"and","s":281.92,"e":282.76,"line":68},{"w":"the","s":282.76,"e":283.08,"line":68},{"w":"blood","s":283.08,"e":283.52,"line":68},{"w":"sings","s":283.52,"e":284.28,"line":68},{"w":"on.","s":284.28,"e":287.14,"line":68}],"lines":[{"s":6.99,"e":15.245,"text":"Matthew Keogh, Keugh, Keough, name carved through the rain,"},{"s":15.245,"e":24.7,"text":"From Wexford’s wet stones to the wildfire flame,"},{"s":31.98,"e":36.72,"text":"Born by the barley, by the blackthorn and brine,"},{"s":36.64,"e":40.88,"text":"A soldier in scarlet, then a rebel by design."},{"s":40.88,"e":45.28,"text":"He marched North America, musket smoke and mud,"},{"s":45.2,"e":49.3,"text":"Rose rank by rank through the regiment’s blood,"},{"s":49.3,"e":53.7,"text":"From private to officer, from crown to the crowd,"},{"s":53.68,"e":58.12,"text":"Then back to old Wexford where the war drums got loud."},{"s":58.12,"e":62.4,"text":"Justice was jagged, the gallows were grim,"},{"s":62.34,"e":66.58,"text":"The river ran red and the sky swallowed him,"},{"s":66.58,"e":70.62,"text":"He tried to hold order when the old world split,"},{"s":70.92,"e":75.24,"text":"But thunder doesn’t ask where the lightning will hit."},{"s":75.42,"e":79.54,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":79.84,"e":83.82,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":83.82,"e":88.28,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":89.56,"e":92.42,"text":"My great-great-great in the grief and the grain."},{"s":92.34,"e":96.58,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":96.58,"e":100.76,"text":"Of a town turned to tempest when the crown came down,"},{"s":100.76,"e":104.86,"text":"He stood in the storm while the steel bells rang,"},{"s":104.86,"e":110.36,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":113.82,"e":117.46,"text":"Freeman of Wexford, fierce fire in his chest,"},{"s":118.02,"e":121.56,"text":"Stripped from the bench when they called him unrest,"},{"s":122.34,"e":125.94,"text":"Justice of peace, then a piece on the board,"},{"s":126.28,"e":130.46,"text":"Caught between the people and the point of the sword."},{"s":130.62,"e":132.72,"text":"Thirty-first of May, when the town gates gave,"},{"s":132.8,"e":134.8,"text":"The United men rose like a tide from the grave,"},{"s":134.8,"e":136.92,"text":"A Council of People, a cause and a cry,"},{"s":136.92,"e":138.98,"text":"And Matthew was lifted where the bullets could fly."},{"s":139.6,"e":141.16,"text":"Cathaoirleach, captain, governor in gray,"},{"s":141.16,"e":143.2,"text":"Trying to steer night into breaking day,"},{"s":143.2,"e":145.32,"text":"But mobs move madly when mercy grows thin,"},{"s":145.32,"e":148.88,"text":"And the bridge became burdened by blood and by sin."},{"s":149.34,"e":153.36,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":153.76,"e":157.64,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":157.92,"e":162.04,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":163.26,"e":166.14,"text":"My great-great-great in the grief and the grain."},{"s":166.12,"e":170.28,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":170.34,"e":174.44,"text":"Of a town turned to tempest when the crown came down,"},{"s":174.44,"e":178.54,"text":"He stood in the storm while the steel bells rang,"},{"s":179,"e":184.06,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":186.98,"e":189.46,"text":"Not saint, not serpent, not simple, not clean,"},{"s":189.46,"e":191.48,"text":"A man in the middle of a murderous machine,"},{"s":191.48,"e":193.66,"text":"Good intentions tangled where the pikes pushed through,"},{"s":193.66,"e":195.72,"text":"And history’s hands are never gentle or true."},{"s":195.72,"e":197.96,"text":"Mock trials, wild cries, loyalists slain,"},{"s":197.96,"e":199.94,"text":"Almost a hundred in the horror and rain,"},{"s":199.94,"e":202.08,"text":"He couldn’t command what the chaos had crowned,"},{"s":202.08,"e":205.48,"text":"Then the Crown came back and cut him down."},{"s":206.5,"e":208.26,"text":"Twenty-fifth of June, seventeen ninety-eight,"},{"s":208.26,"e":210.56,"text":"The verdict came cold and the sentence came straight,"},{"s":210.56,"e":212.52,"text":"Hanged on the bridge where the broken were tossed,"},{"s":212.52,"e":214.64,"text":"Into Slaney’s dark arms with the rebels and lost."},{"s":214.64,"e":216.74,"text":"His body was taken, his head raised high,"},{"s":216.74,"e":218.76,"text":"A warning to Wexford beneath a bruised sky,"},{"s":218.76,"e":220.92,"text":"But names have a way of refusing the grave,"},{"s":220.92,"e":225.96,"text":"They roll through the bloodline, rebellious and brave."},{"s":225.96,"e":226.627,"text":"Final Chorus"},{"s":226.96,"e":231,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":231.24,"e":235.22,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":235.32,"e":239.6,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":239.6,"e":243.7,"text":"My great-great-great in the grief and the grain."},{"s":243.64,"e":247.78,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":247.78,"e":251.92,"text":"Of a town turned to tempest when the crown came down,"},{"s":251.92,"e":256,"text":"He stood in the storm while the steel bells rang,"},{"s":256,"e":264.06,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":264.84,"e":268.4,"text":"Keogh, Keugh, Keough, carried through me,"},{"s":269.3,"e":272.84,"text":"From Wexford Bridge to memory,"},{"s":272.84,"e":276.88,"text":"Not clean, not quiet, not conquered, not gone,"},{"s":277.6,"e":287.14,"text":"The river remembers, and the blood sings on."}],"duration":293.12,"source":"whisper-aligned","generatedAt":"2026-08-29T02:45:58.455Z","stats":{"whisperWords":567,"polishedWords":581,"matched":529,"matchRate":0.91}}