:"through","s":281.953,"e":282.313,"line":65},{"w":"me,","s":282.313,"e":282.673,"line":65},{"w":"From","s":282.673,"e":283.032,"line":66},{"w":"Wexford","s":283.032,"e":283.751,"line":66},{"w":"Bridge","s":283.751,"e":284.111,"line":66},{"w":"to","s":284.111,"e":284.47,"line":66},{"w":"memory,","s":284.47,"e":285.549,"line":66},{"w":"Not","s":285.549,"e":285.909,"line":67},{"w":"clean,","s":285.909,"e":286.268,"line":67},{"w":"not","s":286.268,"e":286.628,"line":67},{"w":"quiet,","s":286.628,"e":286.987,"line":67},{"w":"not","s":286.987,"e":287.347,"line":67},{"w":"conquered,","s":287.347,"e":288.426,"line":67},{"w":"not","s":288.426,"e":288.785,"line":67},{"w":"gone,","s":288.785,"e":289.145,"line":67},{"w":"The","s":289.145,"e":289.504,"line":68},{"w":"river","s":289.504,"e":290.223,"line":68},{"w":"remembers,","s":290.223,"e":291.302,"line":68},{"w":"and","s":291.302,"e":291.662,"line":68},{"w":"the","s":291.662,"e":292.021,"line":68},{"w":"blood","s":292.021,"e":292.381,"line":68},{"w":"sings","s":292.381,"e":292.74,"line":68},{"w":"on.","s":292.74,"e":293.1,"line":68}],"lines":[{"s":26.66,"e":30.615,"text":"Matthew Keogh, Keugh, Keough, name carved through the rain,"},{"s":30.615,"e":34.57,"text":"From Wexford’s wet stones to the wildfire flame,"},{"s":34.57,"e":38.526,"text":"Born by the barley, by the blackthorn and brine,"},{"s":38.526,"e":43.2,"text":"A soldier in scarlet, then a rebel by design."},{"s":43.2,"e":47.875,"text":"He marched North America, musket smoke and mud,"},{"s":47.875,"e":51.47,"text":"Rose rank by rank through the regiment’s blood,"},{"s":51.47,"e":55.785,"text":"From private to officer, from crown to the crowd,"},{"s":55.785,"e":60.1,"text":"Then back to old Wexford where the war drums got loud."},{"s":60.1,"e":63.696,"text":"Justice was jagged, the gallows were grim,"},{"s":63.696,"e":68.01,"text":"The river ran red and the sky swallowed him,"},{"s":68.01,"e":71.966,"text":"He tried to hold order when the old world split,"},{"s":71.966,"e":75.921,"text":"But thunder doesn’t ask where the lightning will hit."},{"s":75.921,"e":79.876,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":79.876,"e":84.55,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":84.55,"e":87.067,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":87.067,"e":90.663,"text":"My great-great-great in the grief and the grain."},{"s":90.663,"e":94.618,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":94.618,"e":99.293,"text":"Of a town turned to tempest when the crown came down,"},{"s":99.293,"e":102.888,"text":"He stood in the storm while the steel bells rang,"},{"s":102.888,"e":106.484,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":106.484,"e":110.08,"text":"Freeman of Wexford, fierce fire in his chest,"},{"s":110.08,"e":114.395,"text":"Stripped from the bench when they called him unrest,"},{"s":114.395,"e":117.99,"text":"Justice of peace, then a piece on the board,"},{"s":117.99,"e":122.305,"text":"Caught between the people and the point of the sword."},{"s":122.305,"e":126.26,"text":"Thirty-first of May, when the town gates gave,"},{"s":126.26,"e":130.575,"text":"The United men rose like a tide from the grave,"},{"s":130.575,"e":134.53,"text":"A Council of People, a cause and a cry,"},{"s":134.53,"e":138.845,"text":"And Matthew was lifted where the bullets could fly."},{"s":138.845,"e":142.441,"text":"Cathaoirleach, captain, governor in gray,"},{"s":142.441,"e":145.677,"text":"Trying to steer night into breaking day,"},{"s":145.677,"e":149.273,"text":"But mobs move madly when mercy grows thin,"},{"s":149.273,"e":153.947,"text":"And the bridge became burdened by blood and by sin."},{"s":153.947,"e":157.902,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":157.902,"e":162.577,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":162.577,"e":165.094,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":165.094,"e":168.689,"text":"My great-great-great in the grief and the grain."},{"s":168.689,"e":172.645,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":172.645,"e":177.319,"text":"Of a town turned to tempest when the crown came down,"},{"s":177.319,"e":180.915,"text":"He stood in the storm while the steel bells rang,"},{"s":180.915,"e":184.51,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":184.51,"e":188.106,"text":"Not saint, not serpent, not simple, not clean,"},{"s":188.106,"e":192.78,"text":"A man in the middle of a murderous machine,"},{"s":192.78,"e":197.455,"text":"Good intentions tangled where the pikes pushed through,"},{"s":197.455,"e":201.77,"text":"And history’s hands are never gentle or true."},{"s":201.77,"e":204.287,"text":"Mock trials, wild cries, loyalists slain,"},{"s":204.287,"e":208.242,"text":"Almost a hundred in the horror and rain,"},{"s":208.242,"e":211.838,"text":"He couldn’t command what the chaos had crowned,"},{"s":211.838,"e":215.074,"text":"Then the Crown came back and cut him down."},{"s":215.074,"e":219.029,"text":"Twenty-fifth of June, seventeen ninety-eight,"},{"s":219.029,"e":222.984,"text":"The verdict came cold and the sentence came straight,"},{"s":222.984,"e":227.299,"text":"Hanged on the bridge where the broken were tossed,"},{"s":227.299,"e":231.614,"text":"Into Slaney’s dark arms with the rebels and lost."},{"s":231.614,"e":235.569,"text":"His body was taken, his head raised high,"},{"s":235.569,"e":239.884,"text":"A warning to Wexford beneath a bruised sky,"},{"s":239.884,"e":244.199,"text":"But names have a way of refusing the grave,"},{"s":244.199,"e":248.154,"text":"They roll through the bloodline, rebellious and brave."},{"s":248.154,"e":249.592,"text":"Final Chorus"},{"s":249.592,"e":253.548,"text":"Oh, Wexford Bridge, Wexford Bridge, whisper his name,"},{"s":253.548,"e":258.222,"text":"Matthew of the many spellings, man of smoke and flame,"},{"s":258.222,"e":260.739,"text":"Keogh, Keugh, Keough, blood in the rain,"},{"s":260.739,"e":264.335,"text":"My great-great-great in the grief and the grain."},{"s":264.335,"e":268.29,"text":"Oh, Slaney, keep singing, keep carrying the sound,"},{"s":268.29,"e":272.964,"text":"Of a town turned to tempest when the crown came down,"},{"s":272.964,"e":276.56,"text":"He stood in the storm while the steel bells rang,"},{"s":276.56,"e":280.156,"text":"Then Wexford Bridge heard the rope snap and sang."},{"s":280.156,"e":282.673,"text":"Keogh, Keugh, Keough, carried through me,"},{"s":282.673,"e":285.549,"text":"From Wexford Bridge to memory,"},{"s":285.549,"e":289.145,"text":"Not clean, not quiet, not conquered, not gone,"},{"s":289.145,"e":293.1,"text":"The river remembers, and the blood sings on."}],"duration":293.12,"source":"curated-realigned","generatedAt":"2026-08-29T02:35:17.407Z","realignedFrom":"curated-realigned","vocalStart":26.66,"vocalEnd":293.1}