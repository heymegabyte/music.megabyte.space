:73},{"w":"down,","s":256.21,"e":256.63,"line":73},{"w":"but","s":256.87,"e":257.87,"line":73},{"w":"the","s":257.87,"e":257.95,"line":73},{"w":"sunrise","s":257.87,"e":257.95,"line":73},{"w":"came","s":257.87,"e":258.31,"line":73},{"w":"through,","s":258.31,"e":258.95,"line":73},{"w":"“Zombie”","s":259.27,"e":259.57,"line":74},{"w":"stopped","s":259.57,"e":260.13,"line":74},{"w":"spinning","s":260.13,"e":260.63,"line":74},{"w":"when","s":260.63,"e":261.17,"line":74},{"w":"he","s":261.17,"e":261.45,"line":74},{"w":"finally","s":261.45,"e":262.01,"line":74},{"w":"knew:","s":262.01,"e":262.53,"line":74},{"w":"God","s":262.53,"e":263.07,"line":75},{"w":"may","s":263.07,"e":263.51,"line":75},{"w":"carry","s":263.51,"e":263.91,"line":75},{"w":"the","s":263.91,"e":264.93,"line":75},{"w":"cosmos,","s":264.93,"e":265.01,"line":75},{"w":"but","s":264.93,"e":265.43,"line":75},{"w":"the","s":265.43,"e":265.51,"line":75},{"w":"calling","s":265.43,"e":265.93,"line":75},{"w":"is","s":265.93,"e":266.19,"line":75},{"w":"ours—","s":266.19,"e":266.99,"line":75},{"w":"Put","s":266.99,"e":267.07,"line":76},{"w":"peace","s":266.99,"e":267.83,"line":76},{"w":"in","s":267.83,"e":268.23,"line":76},{"w":"our","s":268.23,"e":268.43,"line":76},{"w":"practice,","s":268.43,"e":269.01,"line":76},{"w":"put","s":269.01,"e":269.47,"line":76},{"w":"love","s":269.47,"e":269.81,"line":76},{"w":"in","s":269.81,"e":270.35,"line":76},{"w":"the","s":270.35,"e":270.85,"line":76},{"w":"stars.","s":270.85,"e":271.33,"line":76}],"lines":[{"s":1.86,"e":7.16,"text":"# **Peace in the Picture**"},{"s":7.16,"e":7.66,"text":"**[Intro — Soulful Piano]**"},{"s":9.92,"e":13.3,"text":"Two packs deep by a white-columned place,"},{"s":15.74,"e":19.8,"text":"Red ember, cold weather, war in his face."},{"s":22.04,"e":25.94,"text":"“Zombie” on repeat while the whole world bleeds,"},{"s":28.26,"e":45.35,"text":"Asking God for a cure while we manufacture needs."},{"s":45.35,"e":45.85,"text":"**[Verse 1 — Melodic Trap]**"},{"s":50.51,"e":53.91,"text":"Marlboro Twenty-Sevens, smoke swimming in spirals,"},{"s":54.45,"e":57.53,"text":"Problems piled high like a stack of old Bibles."},{"s":57.91,"e":61.11,"text":"Static in his skull, every shadow looks rival,"},{"s":61.11,"e":65.21,"text":"Says God can fix all, but he’s dreaming survival."},{"s":66.09,"e":68.21,"text":"Hallucinating helicopters, hearing hatred in the hall,"},{"s":68.21,"e":70.99,"text":"Building battlefield beliefs where there ain’t one at all."},{"s":70.97,"e":72.33,"text":"White-house-looking home, but there’s war on the lawn,"},{"s":72.25,"e":79.17,"text":"Dolores in the speakers singing sorrow till dawn."},{"s":80.59,"e":82.59,"text":"What’s in your head? Is it dread, is it debt?"},{"s":82.59,"e":84.35,"text":"Is it every little wound that the world won’t forget?"},{"s":84.35,"e":86.23,"text":"We attract what we act, what we ask, what we aim,"},{"s":86.23,"e":88.09,"text":"So quit feeding the fear, quit repeating the flame."},{"s":88.09,"e":90.57,"text":"We do reckless little rituals from morning to night,"},{"s":90.49,"e":94.87,"text":"Fight ourselves, spite ourselves, then swear that we’re right."},{"s":95.09,"e":98.09,"text":"Every figuring-out self needs a philosophy first:"},{"s":98.65,"e":102.177,"text":"Does it water world peace—or make misery worse?"},{"s":102.177,"e":102.677,"text":"**[Pre-Chorus — Rising Female Vocal]**"},{"s":102.177,"e":106.61,"text":"Put peace in the picture, put love in the lens,"},{"s":106.61,"e":110.41,"text":"Let mercy be the message that we send to our friends."},{"s":110.41,"e":114.01,"text":"When the mind makes a monster and the news makes it grow,"},{"s":114.19,"e":117.89,"text":"We can choose not to use every stone that we hold."},{"s":117.81,"e":118.31,"text":"**[Chorus — Piano, Choir and Deep Bass]**"},{"s":117.81,"e":121.59,"text":"Stop the war, start the work, put the peace in the plan,"},{"s":121.59,"e":125.13,"text":"From the heart of the child to the hand of the man."},{"s":125.41,"e":128.79,"text":"From the Middle East streets to the stars up above,"},{"s":128.79,"e":133.01,"text":"We don’t conquer through fear—we get free through love."},{"s":133.11,"e":135.85,"text":"Pitch in for the win, let the healing begin,"},{"s":136.13,"e":139.55,"text":"Turn the drums into bread, let the refugees in."},{"s":139.93,"e":142.97,"text":"They say peace is impossible—tell ’em, “Not anymore,”"},{"s":143.45,"e":146.65,"text":"Every soul is a soldier when we’re stopping a war."},{"s":146.65,"e":147.15,"text":"**[Verse 2 — Faster Flow]**"},{"s":147.53,"e":149.33,"text":"Afghanistan aching, Iran under strain,"},{"s":149.33,"e":151.51,"text":"Yemen needs a sunrise after years in the rain."},{"s":151.51,"e":153.41,"text":"South Sudan standing where the suffering stays,"},{"s":153.41,"e":155.29,"text":"While the comfortable scroll through their comfortable days."},{"s":155.29,"e":157.17,"text":"If we call that their hell, then we’re headed there too,"},{"s":157.17,"e":159.01,"text":"’Cause the borders don’t block what indifference can do."},{"s":159.01,"e":161.09,"text":"Every bomb has a budget, every bullet got bought,"},{"s":161.09,"e":163.15,"text":"Every famine had funding that somebody forgot."},{"s":163.15,"e":165.25,"text":"So fund food, fund futures, fund farms, fund peace,"},{"s":165.25,"e":167.23,"text":"Fund doctors and daughters till the dying days cease."},{"s":167.15,"e":169.77,"text":"Let diplomacy deepen, let the dialogue breathe,"},{"s":169.77,"e":175.75,"text":"Let the powerful practice what they claim to believe."},{"s":177.69,"e":179.59,"text":"Lower-energy voices say the hatred won’t end,"},{"s":179.59,"e":181.99,"text":"But a stranger is a neighbor we ain’t spoken to yet."},{"s":181.99,"e":184.57,"text":"Law of attraction ain’t wishing alone—"},{"s":184.57,"e":191.05,"text":"It’s aligning every action with the world that we want."},{"s":191.05,"e":191.55,"text":"**[Bridge — Stripped Piano and Vocal]**"},{"s":191.05,"e":196.27,"text":"God, fix the fear before we fire the gun."},{"s":196.19,"e":200.17,"text":"Fix the belief that there’s only one winner when it’s done."},{"s":200.17,"e":203.45,"text":"Fix every leader who confuses pride with power."},{"s":203.45,"e":207.29,"text":"Give the hungry bread before another final hour."},{"s":207.29,"e":210.87,"text":"And if heaven needs hands, then our hands better move."},{"s":210.87,"e":214.65,"text":"If faith needs facts, let compassion be proof."},{"s":214.65,"e":218.57,"text":"We can pray for the peace, but the prayer must proceed"},{"s":218.99,"e":223.33,"text":"Into medicine, mercy, clean water and seed."},{"s":223.33,"e":223.83,"text":"**[Final Chorus — Huge Choir]**"},{"s":223.91,"e":227.07,"text":"Stop the war, start the work, put the peace in the plan,"},{"s":227.07,"e":230.93,"text":"From Jerusalem’s stones to the sands of Iran."},{"s":230.93,"e":234.49,"text":"Let Gaza breathe freely, let the hostages home,"},{"s":234.49,"e":239.11,"text":"Let the children grow old where the olive trees grow."},{"s":239.11,"e":242.23,"text":"Pitch in for the win, let the healing begin,"},{"s":242.45,"e":246.21,"text":"Turn the tanks into tractors, let tomorrow come in."},{"s":246.21,"e":249.89,"text":"They say peace is impossible—we answer, “We’ll see,”"},{"s":249.89,"e":254.61,"text":"Then we build it with bread, brave belief and relief."},{"s":254.61,"e":255.11,"text":"**[Outro]**"},{"s":254.61,"e":258.95,"text":"Two packs burned down, but the sunrise came through,"},{"s":259.27,"e":262.53,"text":"“Zombie” stopped spinning when he finally knew:"},{"s":262.53,"e":266.99,"text":"God may carry the cosmos, but the calling is ours—"},{"s":266.99,"e":271.33,"text":"Put peace in our practice, put love in the stars."}],"duration":289.68,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.489Z","stats":{"whisperWords":644,"polishedWords":628,"matched":525,"matchRate":0.836}}