":252.869,"line":70},{"w":"“We’ll","s":252.869,"e":253.167,"line":70},{"w":"see,”","s":253.167,"e":253.465,"line":70},{"w":"Then","s":253.465,"e":253.762,"line":71},{"w":"we","s":253.762,"e":254.06,"line":71},{"w":"build","s":254.06,"e":254.358,"line":71},{"w":"it","s":254.358,"e":254.656,"line":71},{"w":"with","s":254.656,"e":254.953,"line":71},{"w":"bread,","s":254.953,"e":255.251,"line":71},{"w":"brave","s":255.251,"e":255.549,"line":71},{"w":"belief","s":255.549,"e":256.144,"line":71},{"w":"and","s":256.144,"e":256.442,"line":71},{"w":"relief.","s":256.442,"e":257.038,"line":71},{"w":"**[Outro]**","s":257.038,"e":257.938,"line":72},{"w":"Two","s":257.938,"e":258.235,"line":73},{"w":"packs","s":258.235,"e":258.533,"line":73},{"w":"burned","s":258.533,"e":259.129,"line":73},{"w":"down,","s":259.129,"e":259.426,"line":73},{"w":"but","s":259.426,"e":259.724,"line":73},{"w":"the","s":259.724,"e":260.022,"line":73},{"w":"sunrise","s":260.022,"e":260.617,"line":73},{"w":"came","s":260.617,"e":260.915,"line":73},{"w":"through,","s":260.915,"e":261.213,"line":73},{"w":"“Zombie”","s":261.213,"e":261.511,"line":74},{"w":"stopped","s":261.511,"e":262.106,"line":74},{"w":"spinning","s":262.106,"e":262.702,"line":74},{"w":"when","s":262.702,"e":263,"line":74},{"w":"he","s":263,"e":263.297,"line":74},{"w":"finally","s":263.297,"e":264.191,"line":74},{"w":"knew:","s":264.191,"e":264.488,"line":74},{"w":"God","s":264.488,"e":264.786,"line":75},{"w":"may","s":264.786,"e":265.084,"line":75},{"w":"carry","s":265.084,"e":265.679,"line":75},{"w":"the","s":265.679,"e":265.977,"line":75},{"w":"cosmos,","s":265.977,"e":266.573,"line":75},{"w":"but","s":266.573,"e":266.87,"line":75},{"w":"the","s":266.87,"e":267.168,"line":75},{"w":"calling","s":267.168,"e":267.764,"line":75},{"w":"is","s":267.764,"e":268.061,"line":75},{"w":"ours—","s":268.061,"e":268.359,"line":75},{"w":"Put","s":268.359,"e":268.657,"line":76},{"w":"peace","s":268.657,"e":268.955,"line":76},{"w":"in","s":268.955,"e":269.252,"line":76},{"w":"our","s":269.252,"e":269.55,"line":76},{"w":"practice,","s":269.55,"e":270.146,"line":76},{"w":"put","s":270.146,"e":270.443,"line":76},{"w":"love","s":270.443,"e":270.741,"line":76},{"w":"in","s":270.741,"e":271.039,"line":76},{"w":"the","s":271.039,"e":271.33,"line":76},{"w":"stars.","s":271.33,"e":271.41,"line":76}],"lines":[{"s":1.86,"e":3.647,"text":"# **Peace in the Picture**"},{"s":3.647,"e":5.731,"text":"**[Intro — Soulful Piano]**"},{"s":5.731,"e":9.006,"text":"Two packs deep by a white-columned place,"},{"s":9.006,"e":11.984,"text":"Red ember, cold weather, war in his face."},{"s":11.984,"e":14.664,"text":"“Zombie” on repeat while the whole world bleeds,"},{"s":14.664,"e":18.534,"text":"Asking God for a cure while we manufacture needs."},{"s":18.534,"e":20.619,"text":"**[Verse 1 — Melodic Trap]**"},{"s":20.619,"e":24.49,"text":"Marlboro Twenty-Sevens, smoke swimming in spirals,"},{"s":24.49,"e":28.063,"text":"Problems piled high like a stack of old Bibles."},{"s":28.063,"e":31.933,"text":"Static in his skull, every shadow looks rival,"},{"s":31.933,"e":35.507,"text":"Says God can fix all, but he’s dreaming survival."},{"s":35.507,"e":40.271,"text":"Hallucinating helicopters, hearing hatred in the hall,"},{"s":40.271,"e":44.141,"text":"Building battlefield beliefs where there ain’t one at all."},{"s":44.141,"e":48.31,"text":"White-house-looking home, but there’s war on the lawn,"},{"s":48.31,"e":52.181,"text":"Dolores in the speakers singing sorrow till dawn."},{"s":52.181,"e":55.158,"text":"What’s in your head? Is it dread, is it debt?"},{"s":55.158,"e":59.327,"text":"Is it every little wound that the world won’t forget?"},{"s":59.327,"e":62.9,"text":"We attract what we act, what we ask, what we aim,"},{"s":62.9,"e":66.473,"text":"So quit feeding the fear, quit repeating the flame."},{"s":66.473,"e":70.344,"text":"We do reckless little rituals from morning to night,"},{"s":70.344,"e":74.215,"text":"Fight ourselves, spite ourselves, then swear that we’re right."},{"s":74.215,"e":78.681,"text":"Every figuring-out self needs a philosophy first:"},{"s":78.681,"e":82.254,"text":"Does it water world peace—or make misery worse?"},{"s":82.254,"e":85.232,"text":"**[Pre-Chorus — Rising Female Vocal]**"},{"s":85.232,"e":88.507,"text":"Put peace in the picture, put love in the lens,"},{"s":88.507,"e":92.378,"text":"Let mercy be the message that we send to our friends."},{"s":92.378,"e":96.844,"text":"When the mind makes a monster and the news makes it grow,"},{"s":96.844,"e":100.715,"text":"We can choose not to use every stone that we hold."},{"s":100.715,"e":103.395,"text":"**[Chorus — Piano, Choir and Deep Bass]**"},{"s":103.395,"e":106.968,"text":"Stop the war, start the work, put the peace in the plan,"},{"s":106.968,"e":110.541,"text":"From the heart of the child to the hand of the man."},{"s":110.541,"e":114.114,"text":"From the Middle East streets to the stars up above,"},{"s":114.114,"e":117.092,"text":"We don’t conquer through fear—we get free through love."},{"s":117.092,"e":120.367,"text":"Pitch in for the win, let the healing begin,"},{"s":120.367,"e":123.94,"text":"Turn the drums into bread, let the refugees in."},{"s":123.94,"e":128.109,"text":"They say peace is impossible—tell ’em, “Not anymore,”"},{"s":128.109,"e":132.278,"text":"Every soul is a soldier when we’re stopping a war."},{"s":132.278,"e":134.064,"text":"**[Verse 2 — Faster Flow]**"},{"s":134.064,"e":137.339,"text":"Afghanistan aching, Iran under strain,"},{"s":137.339,"e":140.912,"text":"Yemen needs a sunrise after years in the rain."},{"s":140.912,"e":144.188,"text":"South Sudan standing where the suffering stays,"},{"s":144.188,"e":148.356,"text":"While the comfortable scroll through their comfortable days."},{"s":148.356,"e":151.929,"text":"If we call that their hell, then we’re headed there too,"},{"s":151.929,"e":155.8,"text":"’Cause the borders don’t block what indifference can do."},{"s":155.8,"e":160.267,"text":"Every bomb has a budget, every bullet got bought,"},{"s":160.267,"e":164.733,"text":"Every famine had funding that somebody forgot."},{"s":164.733,"e":168.008,"text":"So fund food, fund futures, fund farms, fund peace,"},{"s":168.008,"e":171.284,"text":"Fund doctors and daughters till the dying days cease."},{"s":171.284,"e":174.857,"text":"Let diplomacy deepen, let the dialogue breathe,"},{"s":174.857,"e":178.728,"text":"Let the powerful practice what they claim to believe."},{"s":178.728,"e":182.598,"text":"Lower-energy voices say the hatred won’t end,"},{"s":182.598,"e":186.767,"text":"But a stranger is a neighbor we ain’t spoken to yet."},{"s":186.767,"e":189.745,"text":"Law of attraction ain’t wishing alone—"},{"s":189.745,"e":194.211,"text":"It’s aligning every action with the world that we want."},{"s":194.211,"e":196.891,"text":"**[Bridge — Stripped Piano and Vocal]**"},{"s":196.891,"e":199.868,"text":"God, fix the fear before we fire the gun."},{"s":199.868,"e":204.335,"text":"Fix the belief that there’s only one winner when it’s done."},{"s":204.335,"e":208.503,"text":"Fix every leader who confuses pride with power."},{"s":208.503,"e":212.374,"text":"Give the hungry bread before another final hour."},{"s":212.374,"e":215.947,"text":"And if heaven needs hands, then our hands better move."},{"s":215.947,"e":218.925,"text":"If faith needs facts, let compassion be proof."},{"s":218.925,"e":222.498,"text":"We can pray for the peace, but the prayer must proceed"},{"s":222.498,"e":226.071,"text":"Into medicine, mercy, clean water and seed."},{"s":226.071,"e":228.155,"text":"**[Final Chorus — Huge Choir]**"},{"s":228.155,"e":231.728,"text":"Stop the war, start the work, put the peace in the plan,"},{"s":231.728,"e":235.599,"text":"From Jerusalem’s stones to the sands of Iran."},{"s":235.599,"e":239.172,"text":"Let Gaza breathe freely, let the hostages home,"},{"s":239.172,"e":242.745,"text":"Let the children grow old where the olive trees grow."},{"s":242.745,"e":246.021,"text":"Pitch in for the win, let the healing begin,"},{"s":246.021,"e":249.892,"text":"Turn the tanks into tractors, let tomorrow come in."},{"s":249.892,"e":253.465,"text":"They say peace is impossible—we answer, “We’ll see,”"},{"s":253.465,"e":257.038,"text":"Then we build it with bread, brave belief and relief."},{"s":257.038,"e":257.938,"text":"**[Outro]**"},{"s":257.938,"e":261.213,"text":"Two packs burned down, but the sunrise came through,"},{"s":261.213,"e":264.488,"text":"“Zombie” stopped spinning when he finally knew:"},{"s":264.488,"e":268.359,"text":"God may carry the cosmos, but the calling is ours—"},{"s":268.359,"e":271.41,"text":"Put peace in our practice, put love in the stars."}],"duration":289.68,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.002Z","realignedFrom":"whisper-aligned","vocalStart":1.86,"vocalEnd":271.33}