":231.96,"line":60},{"w":"eyes.","s":231.96,"e":232.06,"line":60},{"w":"If","s":232.06,"e":232.46,"line":61},{"w":"the","s":232.46,"e":232.78,"line":61},{"w":"cross","s":232.78,"e":233.1,"line":61},{"w":"means","s":233.1,"e":233.6,"line":61},{"w":"anything,","s":233.6,"e":234.36,"line":61},{"w":"let","s":234.36,"e":234.82,"line":61},{"w":"the","s":234.82,"e":235.04,"line":61},{"w":"meaning","s":235.04,"e":235.26,"line":61},{"w":"be","s":235.26,"e":235.66,"line":61},{"w":"clear:","s":235.66,"e":235.96,"line":61},{"w":"No","s":235.96,"e":236.28,"line":62},{"w":"child","s":236.28,"e":236.56,"line":62},{"w":"becomes","s":236.56,"e":237,"line":62},{"w":"expendable","s":237,"e":237.8,"line":62},{"w":"because","s":237.8,"e":238.5,"line":62},{"w":"they’re","s":238.5,"e":238.66,"line":62},{"w":"born","s":238.82,"e":239.1,"line":62},{"w":"over","s":239.1,"e":239.9,"line":62},{"w":"there.","s":239.9,"e":240.34,"line":62},{"w":"Prince","s":240.34,"e":240.56,"line":63},{"w":"of","s":240.56,"e":240.84,"line":63},{"w":"Peace,","s":240.84,"e":241.16,"line":63},{"w":"wake","s":241.24,"e":241.46,"line":63},{"w":"the","s":241.46,"e":241.68,"line":63},{"w":"sleeping","s":241.68,"e":241.98,"line":63},{"w":"somehow—","s":241.98,"e":242.9,"line":63},{"w":"If","s":242.9,"e":243.28,"line":64},{"w":"we","s":243.28,"e":243.48,"line":64},{"w":"really","s":243.48,"e":243.96,"line":64},{"w":"follow","s":243.96,"e":244.4,"line":64},{"w":"Jesus,","s":244.4,"e":245.2,"line":64},{"w":"then","s":245.92,"e":246.42,"line":65},{"w":"we","s":246.42,"e":246.66,"line":65},{"w":"have","s":246.66,"e":246.9,"line":65},{"w":"to","s":246.9,"e":247.34,"line":65},{"w":"follow","s":247.34,"e":247.8,"line":65},{"w":"**now**.","s":247.8,"e":249.06,"line":65},{"w":"No","s":250,"e":250.8,"line":66},{"w":"halo","s":250.8,"e":251.42,"line":66},{"w":"without","s":251.42,"e":252.28,"line":66},{"w":"mercy.","s":252.28,"e":253.2,"line":66},{"w":"No","s":253.28,"e":254.08,"line":67},{"w":"gospel","s":254.08,"e":254.62,"line":67},{"w":"without","s":254.62,"e":255.44,"line":67},{"w":"grief.","s":255.44,"e":256.32,"line":67},{"w":"No","s":257,"e":257.62,"line":68},{"w":"worship","s":257.62,"e":258.3,"line":68},{"w":"worth","s":258.3,"e":258.7,"line":68},{"w":"the","s":258.7,"e":259.26,"line":68},{"w":"singing","s":259.26,"e":259.6,"line":68},{"w":"if","s":260.64,"e":261.26,"line":69},{"w":"it","s":261.26,"e":261.68,"line":69},{"w":"never","s":261.68,"e":261.92,"line":69},{"w":"becomes","s":261.92,"e":262.68,"line":69},{"w":"peace.","s":262.68,"e":263.48,"line":69}],"lines":[{"s":11.08,"e":26.14,"text":"**THE HALO AND THE HORROR**"},{"s":27.04,"e":30.38,"text":"Gold cross swinging while the whole world burns,"},{"s":30.58,"e":34.02,"text":"Sunday sermon, Monday no concern,"},{"s":34.2,"e":37.66,"text":"Hands to heaven, eyes turned away,"},{"s":37.66,"e":41.12,"text":"Children under rubble while the choirs still pray."},{"s":41.12,"e":44.34,"text":"Everybody saying, “Jesus got the wheel,”"},{"s":44.34,"e":47.58,"text":"But nobody asking what the wounded feel,"},{"s":47.58,"e":51.02,"text":"Scripture on the screen, supper on the plate,"},{"s":51,"e":54.76,"text":"While another mother learns the language of a grave."},{"s":54.76,"e":58.44,"text":"Blessed be the comfortable, safe inside the spell,"},{"s":58.54,"e":62.2,"text":"Calling silence “peace” while somebody lives through hell,"},{"s":62.22,"e":65.36,"text":"Candles in the chapel, cameras catch the glow,"},{"s":65.28,"e":69.36,"text":"But when the bombs start falling, everybody gotta go."},{"s":69.36,"e":73.18,"text":"Is it faith if mercy stops at the border?"},{"s":73.44,"e":76.1,"text":"Is it love if profit gives the order?"},{"s":76.4,"e":80.24,"text":"If Christ walked in with blood on His feet,"},{"s":80.26,"e":83.62,"text":"Would we recognize Him—or cross the street?"},{"s":83.62,"e":86.66,"text":"Everybody under Jesus Christ’s spell,"},{"s":87.1,"e":91.1,"text":"Singing “all is well, all is well,”"},{"s":91.1,"e":94.56,"text":"While the smoke climbs high and the headlines fade,"},{"s":94.56,"e":98.16,"text":"And innocence gets buried beneath what we paid."},{"s":98.38,"e":101.06,"text":"Everybody wearing heaven like a shield,"},{"s":101.06,"e":104.78,"text":"While the bodies overseas become numbers on a field."},{"s":104.9,"e":109,"text":"If you follow the Prince of Peace, then prove it somehow—"},{"s":109,"e":112.72,"text":"Don’t praise love on Sunday and abandon it now."},{"s":112.72,"e":115.06,"text":"Cross on the necklace, flag on the wall,"},{"s":115.04,"e":116.78,"text":"“God bless us” loud while the missiles fall,"},{"s":116.84,"e":118.62,"text":"Politicians pray before they sign the page,"},{"s":118.54,"e":120.52,"text":"Then send another generation straight into the cage."},{"s":120.52,"e":122.3,"text":"We call it complicated, call it foreign affairs,"},{"s":122.3,"e":124.14,"text":"Anything but children gasping desperate for air,"},{"s":124.1,"e":125.94,"text":"Scroll past suffering, swipe into a joke,"},{"s":125.9,"e":127.68,"text":"Sip another coffee while another city smokes."},{"s":127.68,"e":131.38,"text":"Maybe the spell ain’t Jesus—maybe Jesus would scream,"},{"s":131.44,"e":134.7,"text":"Flip every table built on somebody’s grief,"},{"s":134.62,"e":138,"text":"Maybe we confused the Christ with comfort and control,"},{"s":138,"e":141.98,"text":"Put His name on an empire and forgot about the soul."},{"s":141.9,"e":145.18,"text":"He said blessed are the peacemakers—remember?"},{"s":145.26,"e":148.92,"text":"Not blessed are the buyers feeding fire forever."},{"s":148.92,"e":152.18,"text":"If every human life is sacred in His sight,"},{"s":152.18,"e":156.48,"text":"Why do we need permission to say slaughter isn’t right?"},{"s":156.54,"e":159.24,"text":"Everybody under Jesus Christ’s spell,"},{"s":159.66,"e":163.64,"text":"Singing “all is well, all is well,”"},{"s":163.64,"e":167.1,"text":"While the smoke climbs high and the headlines fade,"},{"s":167.1,"e":170.68,"text":"And innocence gets buried beneath what we paid."},{"s":170.68,"e":173.64,"text":"Everybody wearing heaven like a shield,"},{"s":173.56,"e":177.22,"text":"While the bodies overseas become numbers on a field."},{"s":177.4,"e":181.44,"text":"If you follow the Prince of Peace, then prove it somehow—"},{"s":181.44,"e":185.16,"text":"Don’t praise love on Sunday and abandon it now."},{"s":185.16,"e":188.9,"text":"No, I don’t want another holy alibi,"},{"s":189,"e":192.5,"text":"Another folded hand beneath a burning sky,"},{"s":192.5,"e":196.14,"text":"Give me faith with feet, give me mercy with a spine,"},{"s":196.14,"e":199.78,"text":"Give me people brave enough to draw a human line."},{"s":199.78,"e":203.42,"text":"No more “thoughts and prayers” with the volume turned low,"},{"s":203.42,"e":207.02,"text":"Love should move your body when you know what you know."},{"s":207.02,"e":210.62,"text":"Feed them, shield them, speak when silence pays—"},{"s":210.62,"e":216.38,"text":"What good is resurrection if compassion stays in graves?"},{"s":217.76,"e":221.24,"text":"Everybody says they’re under Jesus Christ’s spell—"},{"s":221.24,"e":225.06,"text":"Then let the spell break hatred, let it empty out hell."},{"s":225.06,"e":228.38,"text":"Let it stop the cheering when the warplanes rise,"},{"s":228.38,"e":232.06,"text":"Let it put a human face back behind our enemy’s eyes."},{"s":232.06,"e":235.96,"text":"If the cross means anything, let the meaning be clear:"},{"s":235.96,"e":240.34,"text":"No child becomes expendable because they’re born over there."},{"s":240.34,"e":242.9,"text":"Prince of Peace, wake the sleeping somehow—"},{"s":242.9,"e":245.2,"text":"If we really follow Jesus,"},{"s":245.92,"e":249.06,"text":"then we have to follow **now**."},{"s":250,"e":253.2,"text":"No halo without mercy."},{"s":253.28,"e":256.32,"text":"No gospel without grief."},{"s":257,"e":259.6,"text":"No worship worth the singing"},{"s":260.64,"e":263.48,"text":"if it never becomes peace."}],"duration":266.68,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.573Z","stats":{"whisperWords":581,"polishedWords":558,"matched":524,"matchRate":0.939}}