46.464,"e":246.779,"line":62},{"w":"Prince","s":246.779,"e":247.094,"line":63},{"w":"of","s":247.094,"e":247.41,"line":63},{"w":"Peace,","s":247.41,"e":247.725,"line":63},{"w":"wake","s":247.725,"e":248.04,"line":63},{"w":"the","s":248.04,"e":248.355,"line":63},{"w":"sleeping","s":248.355,"e":248.985,"line":63},{"w":"somehow—","s":248.985,"e":249.93,"line":63},{"w":"If","s":249.93,"e":250.246,"line":64},{"w":"we","s":250.246,"e":250.561,"line":64},{"w":"really","s":250.561,"e":251.191,"line":64},{"w":"follow","s":251.191,"e":251.821,"line":64},{"w":"Jesus,","s":251.821,"e":252.451,"line":64},{"w":"then","s":252.451,"e":252.766,"line":65},{"w":"we","s":252.766,"e":253.081,"line":65},{"w":"have","s":253.081,"e":253.397,"line":65},{"w":"to","s":253.397,"e":253.712,"line":65},{"w":"follow","s":253.712,"e":254.342,"line":65},{"w":"**now**.","s":254.342,"e":254.657,"line":65},{"w":"No","s":254.657,"e":254.972,"line":66},{"w":"halo","s":254.972,"e":255.602,"line":66},{"w":"without","s":255.602,"e":256.233,"line":66},{"w":"mercy.","s":256.233,"e":256.863,"line":66},{"w":"No","s":256.863,"e":257.178,"line":67},{"w":"gospel","s":257.178,"e":257.808,"line":67},{"w":"without","s":257.808,"e":258.438,"line":67},{"w":"grief.","s":258.438,"e":258.753,"line":67},{"w":"No","s":258.753,"e":259.069,"line":68},{"w":"worship","s":259.069,"e":259.699,"line":68},{"w":"worth","s":259.699,"e":260.014,"line":68},{"w":"the","s":260.014,"e":260.329,"line":68},{"w":"singing","s":260.329,"e":260.959,"line":68},{"w":"if","s":260.959,"e":261.274,"line":69},{"w":"it","s":261.274,"e":261.589,"line":69},{"w":"never","s":261.589,"e":262.22,"line":69},{"w":"becomes","s":262.22,"e":263.165,"line":69},{"w":"peace.","s":263.165,"e":263.48,"line":69}],"lines":[{"s":11.08,"e":13.286,"text":"**THE HALO AND THE HORROR**"},{"s":13.286,"e":16.122,"text":"Gold cross swinging while the whole world burns,"},{"s":16.122,"e":18.958,"text":"Sunday sermon, Monday no concern,"},{"s":18.958,"e":21.794,"text":"Hands to heaven, eyes turned away,"},{"s":21.794,"e":25.26,"text":"Children under rubble while the choirs still pray."},{"s":25.26,"e":28.726,"text":"Everybody saying, “Jesus got the wheel,”"},{"s":28.726,"e":32.192,"text":"But nobody asking what the wounded feel,"},{"s":32.192,"e":35.343,"text":"Scripture on the screen, supper on the plate,"},{"s":35.343,"e":39.44,"text":"While another mother learns the language of a grave."},{"s":39.44,"e":43.536,"text":"Blessed be the comfortable, safe inside the spell,"},{"s":43.536,"e":47.947,"text":"Calling silence “peace” while somebody lives through hell,"},{"s":47.947,"e":51.729,"text":"Candles in the chapel, cameras catch the glow,"},{"s":51.729,"e":56.455,"text":"But when the bombs start falling, everybody gotta go."},{"s":56.455,"e":59.921,"text":"Is it faith if mercy stops at the border?"},{"s":59.921,"e":63.388,"text":"Is it love if profit gives the order?"},{"s":63.388,"e":66.539,"text":"If Christ walked in with blood on His feet,"},{"s":66.539,"e":69.69,"text":"Would we recognize Him—or cross the street?"},{"s":69.69,"e":73.156,"text":"Everybody under Jesus Christ’s spell,"},{"s":73.156,"e":75.677,"text":"Singing “all is well, all is well,”"},{"s":75.677,"e":79.143,"text":"While the smoke climbs high and the headlines fade,"},{"s":79.143,"e":82.924,"text":"And innocence gets buried beneath what we paid."},{"s":82.924,"e":86.705,"text":"Everybody wearing heaven like a shield,"},{"s":86.705,"e":91.117,"text":"While the bodies overseas become numbers on a field."},{"s":91.117,"e":95.528,"text":"If you follow the Prince of Peace, then prove it somehow—"},{"s":95.528,"e":99.31,"text":"Don’t praise love on Sunday and abandon it now."},{"s":99.31,"e":102.146,"text":"Cross on the necklace, flag on the wall,"},{"s":102.146,"e":105.297,"text":"“God bless us” loud while the missiles fall,"},{"s":105.297,"e":108.763,"text":"Politicians pray before they sign the page,"},{"s":108.763,"e":113.174,"text":"Then send another generation straight into the cage."},{"s":113.174,"e":117.271,"text":"We call it complicated, call it foreign affairs,"},{"s":117.271,"e":121.367,"text":"Anything but children gasping desperate for air,"},{"s":121.367,"e":124.518,"text":"Scroll past suffering, swipe into a joke,"},{"s":124.518,"e":128.615,"text":"Sip another coffee while another city smokes."},{"s":128.615,"e":132.081,"text":"Maybe the spell ain’t Jesus—maybe Jesus would scream,"},{"s":132.081,"e":136.177,"text":"Flip every table built on somebody’s grief,"},{"s":136.177,"e":140.274,"text":"Maybe we confused the Christ with comfort and control,"},{"s":140.274,"e":144.685,"text":"Put His name on an empire and forgot about the soul."},{"s":144.685,"e":148.781,"text":"He said blessed are the peacemakers—remember?"},{"s":148.781,"e":152.563,"text":"Not blessed are the buyers feeding fire forever."},{"s":152.563,"e":156.659,"text":"If every human life is sacred in His sight,"},{"s":156.659,"e":160.755,"text":"Why do we need permission to say slaughter isn’t right?"},{"s":160.755,"e":164.222,"text":"Everybody under Jesus Christ’s spell,"},{"s":164.222,"e":166.742,"text":"Singing “all is well, all is well,”"},{"s":166.742,"e":170.209,"text":"While the smoke climbs high and the headlines fade,"},{"s":170.209,"e":173.99,"text":"And innocence gets buried beneath what we paid."},{"s":173.99,"e":177.771,"text":"Everybody wearing heaven like a shield,"},{"s":177.771,"e":182.183,"text":"While the bodies overseas become numbers on a field."},{"s":182.183,"e":186.594,"text":"If you follow the Prince of Peace, then prove it somehow—"},{"s":186.594,"e":190.375,"text":"Don’t praise love on Sunday and abandon it now."},{"s":190.375,"e":194.157,"text":"No, I don’t want another holy alibi,"},{"s":194.157,"e":197.938,"text":"Another folded hand beneath a burning sky,"},{"s":197.938,"e":201.719,"text":"Give me faith with feet, give me mercy with a spine,"},{"s":201.719,"e":205.816,"text":"Give me people brave enough to draw a human line."},{"s":205.816,"e":209.597,"text":"No more “thoughts and prayers” with the volume turned low,"},{"s":209.597,"e":213.378,"text":"Love should move your body when you know what you know."},{"s":213.378,"e":216.214,"text":"Feed them, shield them, speak when silence pays—"},{"s":216.214,"e":220.941,"text":"What good is resurrection if compassion stays in graves?"},{"s":220.941,"e":225.037,"text":"Everybody says they’re under Jesus Christ’s spell—"},{"s":225.037,"e":229.133,"text":"Then let the spell break hatred, let it empty out hell."},{"s":229.133,"e":232.915,"text":"Let it stop the cheering when the warplanes rise,"},{"s":232.915,"e":237.641,"text":"Let it put a human face back behind our enemy’s eyes."},{"s":237.641,"e":241.738,"text":"If the cross means anything, let the meaning be clear:"},{"s":241.738,"e":246.779,"text":"No child becomes expendable because they’re born over there."},{"s":246.779,"e":249.93,"text":"Prince of Peace, wake the sleeping somehow—"},{"s":249.93,"e":252.451,"text":"If we really follow Jesus,"},{"s":252.451,"e":254.657,"text":"then we have to follow **now**."},{"s":254.657,"e":256.863,"text":"No halo without mercy."},{"s":256.863,"e":258.753,"text":"No gospel without grief."},{"s":258.753,"e":260.959,"text":"No worship worth the singing"},{"s":260.959,"e":263.48,"text":"if it never becomes peace."}],"duration":266.68,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.125Z","realignedFrom":"whisper-aligned","vocalStart":11.08,"vocalEnd":263.48}