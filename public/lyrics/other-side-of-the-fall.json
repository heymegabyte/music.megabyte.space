s":220.177,"e":220.838,"line":75},{"w":"No","s":220.838,"e":221.168,"line":76},{"w":"last","s":221.168,"e":221.498,"line":76},{"w":"ending,","s":221.498,"e":222.159,"line":76},{"w":"no","s":222.159,"e":222.49,"line":76},{"w":"first","s":222.49,"e":222.82,"line":76},{"w":"dividing,","s":222.82,"e":223.811,"line":76},{"w":"Just","s":223.811,"e":224.142,"line":77},{"w":"forever","s":224.142,"e":224.78,"line":77},{"w":"folding,","s":224.78,"e":224.86,"line":77},{"w":"finding,","s":224.78,"e":224.86,"line":77},{"w":"flying.","s":224.78,"e":224.86,"line":77}],"lines":[{"s":4.074,"e":6.056,"text":"**“Other Side of the Fall”**"},{"s":6.056,"e":6.956,"text":"**Intro**"},{"s":6.956,"e":8.278,"text":"Maybe it don’t end"},{"s":8.278,"e":9.6,"text":"Maybe it just turns"},{"s":9.6,"e":11.582,"text":"Maybe every black hole"},{"s":11.582,"e":13.564,"text":"Is where a new sky burns"},{"s":13.564,"e":14.464,"text":"**Chorus**"},{"s":14.464,"e":17.768,"text":"What if the Big Bang is the other side,"},{"s":17.768,"e":21.403,"text":"Of every black hole where the stars go hide?"},{"s":21.403,"e":24.707,"text":"Everything falls, then it blooms in light,"},{"s":24.707,"e":27.68,"text":"Dark on the left, new dawn on the right."},{"s":27.68,"e":30.654,"text":"What if the whole sky came from a fall,"},{"s":30.654,"e":33.958,"text":"One little point holding all of it all?"},{"s":33.958,"e":37.592,"text":"Every end bends, every night gets wide,"},{"s":37.592,"e":40.235,"text":"Maybe we came from the other side."},{"s":40.235,"e":41.135,"text":"**Verse 1**"},{"s":41.135,"e":44.439,"text":"Black hole spinning like a secret in space,"},{"s":44.439,"e":47.743,"text":"Pulling in planets with a silent face,"},{"s":47.743,"e":50.387,"text":"Starlight slips where the clocks can’t chase,"},{"s":50.387,"e":54.021,"text":"Then somewhere else, there’s a newborn place."},{"s":54.021,"e":56.995,"text":"Gravity gathers what time can’t save,"},{"s":56.995,"e":60.299,"text":"Matter gets folded in a midnight wave,"},{"s":60.299,"e":62.942,"text":"Deep down low where the laws behave"},{"s":62.942,"e":66.576,"text":"Like the womb of a world in a cosmic cave."},{"s":66.576,"e":69.88,"text":"Maybe the dark don’t destroy what it takes,"},{"s":69.88,"e":72.523,"text":"Maybe it shapes, maybe it wakes,"},{"s":72.523,"e":75.497,"text":"Maybe it breaks just to make more shapes,"},{"s":75.497,"e":78.801,"text":"Maybe creation is the echo it makes."},{"s":78.801,"e":79.792,"text":"**Pre-Chorus**"},{"s":79.792,"e":84.087,"text":"Every star that fades, every sun that dies,"},{"s":84.087,"e":87.722,"text":"Every world that falls through the final sky,"},{"s":87.722,"e":91.026,"text":"Could be the spark where another one flies,"},{"s":91.026,"e":94.66,"text":"Could be the flash in another life’s eyes."},{"s":94.66,"e":95.56,"text":"**Chorus**"},{"s":95.56,"e":98.864,"text":"What if the Big Bang is the other side,"},{"s":98.864,"e":102.498,"text":"Of every black hole where the stars go hide?"},{"s":102.498,"e":105.802,"text":"Everything falls, then it blooms in light,"},{"s":105.802,"e":108.776,"text":"Dark on the left, new dawn on the right."},{"s":108.776,"e":111.749,"text":"What if the whole sky came from a fall,"},{"s":111.749,"e":115.053,"text":"One little point holding all of it all?"},{"s":115.053,"e":118.688,"text":"Every end bends, every night gets wide,"},{"s":118.688,"e":121.331,"text":"Maybe we came from the other side."},{"s":121.331,"e":122.231,"text":"**Verse 2**"},{"s":122.231,"e":125.865,"text":"Maybe time ain’t a line, it’s a ring, it’s a rhyme,"},{"s":125.865,"e":129.83,"text":"Every final moment finds a first-time shine,"},{"s":129.83,"e":133.795,"text":"Every black hole hums with a hidden design,"},{"s":133.795,"e":137.429,"text":"Swallowing the past just to let new light climb."},{"s":137.429,"e":141.394,"text":"No before, no after, just a breath in between,"},{"s":141.394,"e":144.037,"text":"One side unseen, one side serene,"},{"s":144.037,"e":146.68,"text":"One side black where the old stars lean,"},{"s":146.68,"e":149.324,"text":"One side bright where the new stars dream."},{"s":149.324,"e":152.297,"text":"Maybe the universe never began,"},{"s":152.297,"e":154.61,"text":"Maybe it turns like sand through hands,"},{"s":154.61,"e":157.584,"text":"Falls through the deep, then expands again,"},{"s":157.584,"e":160.557,"text":"Born from the place where the old light ends."},{"s":160.557,"e":161.457,"text":"**Bridge**"},{"s":161.457,"e":164.761,"text":"If the night folds in, let it fold me too,"},{"s":164.761,"e":168.065,"text":"If the stars fall down, they may rise brand new,"},{"s":168.065,"e":172.03,"text":"If the dark gets deep, there’s a dawn somewhere,"},{"s":172.03,"e":175.334,"text":"A billion new suns in another air."},{"s":175.334,"e":178.307,"text":"So I don’t fear when the heavens slide,"},{"s":178.307,"e":180.951,"text":"I don’t fear what the shadows hide,"},{"s":180.951,"e":184.585,"text":"Every lost light, every star that died,"},{"s":184.585,"e":187.559,"text":"Might be singing from the other side."},{"s":187.559,"e":188.88,"text":"**Final Chorus**"},{"s":188.88,"e":192.184,"text":"What if the Big Bang is the other side,"},{"s":192.184,"e":195.819,"text":"Of every black hole where the stars go hide?"},{"s":195.819,"e":199.123,"text":"Everything falls, then it blooms in light,"},{"s":199.123,"e":202.096,"text":"Dark on the left, new dawn on the right."},{"s":202.096,"e":205.07,"text":"What if the whole sky came from a fall,"},{"s":205.07,"e":208.374,"text":"One little point holding all of it all?"},{"s":208.374,"e":212.008,"text":"Every end bends, every night gets wide,"},{"s":212.008,"e":214.651,"text":"Maybe we came from the other side."},{"s":214.651,"e":215.551,"text":"**Outro**"},{"s":215.551,"e":218.194,"text":"Black hole falling, Big Bang rising,"},{"s":218.194,"e":220.838,"text":"Old stars fading, new stars shining,"},{"s":220.838,"e":223.811,"text":"No last ending, no first dividing,"},{"s":223.811,"e":224.86,"text":"Just forever folding, finding, flying."}],"duration":229.6,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.993Z","realignedFrom":"whisper-aligned","vocalStart":4.074,"vocalEnd":224.78}