.02,"line":65},{"w":"Old","s":214.02,"e":214.86,"line":66},{"w":"stars","s":214.86,"e":215.12,"line":66},{"w":"fading,","s":215.76,"e":216.14,"line":66},{"w":"new","s":216.14,"e":216.6,"line":66},{"w":"stars","s":216.6,"e":216.94,"line":66},{"w":"shining,","s":216.94,"e":217.54,"line":66},{"w":"No","s":217.54,"e":218.26,"line":67},{"w":"last","s":218.26,"e":218.86,"line":67},{"w":"ending,","s":218.86,"e":219.48,"line":67},{"w":"no","s":219.5,"e":220.22,"line":67},{"w":"first","s":220.22,"e":220.46,"line":67},{"w":"dividing,","s":220.7,"e":221.16,"line":67},{"w":"Just","s":221.16,"e":221.78,"line":68},{"w":"forever","s":221.78,"e":222.36,"line":68},{"w":"folding,","s":222.36,"e":223.02,"line":68},{"w":"finding,","s":223.82,"e":224.24,"line":68},{"w":"flying.","s":224.24,"e":224.78,"line":68}],"lines":[{"s":4.074,"e":11.719,"text":"“Other Side of the Fall”"},{"s":13.58,"e":18.58,"text":"Maybe it don’t end"},{"s":18.72,"e":21.46,"text":"Maybe it just turns"},{"s":21.46,"e":25.02,"text":"Maybe every black hole"},{"s":25.02,"e":28.43,"text":"Is where a new sky burns"},{"s":28.88,"e":32.16,"text":"What if the Big Bang is the other side,"},{"s":32.16,"e":35.68,"text":"Of every black hole where the stars go hide?"},{"s":36.5,"e":39.28,"text":"Everything falls, then it blooms in light,"},{"s":39.28,"e":43.02,"text":"Dark on the left, new dawn on the right."},{"s":43.02,"e":46.34,"text":"What if the whole sky came from a fall,"},{"s":47.68,"e":50.46,"text":"One little point holding all of it all?"},{"s":50.58,"e":53.42,"text":"Every end bends, every night gets wide,"},{"s":53.52,"e":56.54,"text":"Maybe we came from the other side."},{"s":56.54,"e":58.28,"text":"Black hole spinning like a secret in space,"},{"s":58.26,"e":60.02,"text":"Pulling in planets with a silent face,"},{"s":60.12,"e":61.74,"text":"Starlight slips where the clocks can’t chase,"},{"s":61.74,"e":63.62,"text":"Then somewhere else, there’s a newborn place."},{"s":63.62,"e":65.4,"text":"Gravity gathers what time can’t save,"},{"s":65.4,"e":67.24,"text":"Matter gets folded in a midnight wave,"},{"s":67.24,"e":68.8,"text":"Deep down low where the laws behave"},{"s":68.8,"e":70.78,"text":"Like the womb of a world in a cosmic cave."},{"s":70.78,"e":72.66,"text":"Maybe the dark don’t destroy what it takes,"},{"s":72.58,"e":74.4,"text":"Maybe it shapes, maybe it wakes,"},{"s":74.32,"e":76.16,"text":"Maybe it breaks just to make more shapes,"},{"s":76.16,"e":77.92,"text":"Maybe creation is the echo it makes."},{"s":77.92,"e":81.66,"text":"Every star that fades, every sun that dies,"},{"s":81.58,"e":84.9,"text":"Every world that falls through the final sky,"},{"s":86.1,"e":89.72,"text":"Could be the spark where another one flies,"},{"s":89.72,"e":96.74,"text":"Could be the flash in another life’s eyes."},{"s":100.1,"e":103.4,"text":"What if the Big Bang is the other side,"},{"s":103.4,"e":106.96,"text":"Of every black hole where the stars go hide?"},{"s":108.14,"e":111.24,"text":"Everything falls, then it blooms in light,"},{"s":111.24,"e":114.46,"text":"Dark on the left, new dawn on the right."},{"s":114.46,"e":117.58,"text":"What if the whole sky came from a fall,"},{"s":118.98,"e":121.88,"text":"One little point holding all of it all?"},{"s":122.1,"e":124.8,"text":"Every end bends, every night gets wide,"},{"s":124.86,"e":127.68,"text":"Maybe we came from the other side."},{"s":127.68,"e":129.54,"text":"Maybe time ain’t a line, it’s a ring, it’s a rhyme,"},{"s":129.46,"e":131.26,"text":"Every final moment finds a first-time shine,"},{"s":131.26,"e":133.08,"text":"Every black hole hums with a hidden design,"},{"s":133.08,"e":134.8,"text":"Swallowing the past just to let new light climb."},{"s":134.8,"e":136.64,"text":"No before, no after, just a breath in between,"},{"s":136.64,"e":138.4,"text":"One side unseen, one side serene,"},{"s":138.4,"e":140.26,"text":"One side black where the old stars lean,"},{"s":140.26,"e":142.1,"text":"One side bright where the new stars dream."},{"s":142.1,"e":143.86,"text":"Maybe the universe never began,"},{"s":143.86,"e":145.66,"text":"Maybe it turns like sand through hands,"},{"s":145.66,"e":147.44,"text":"Falls through the deep, then expands again,"},{"s":147.44,"e":149.32,"text":"Born from the place where the old light ends."},{"s":149.32,"e":152.8,"text":"If the night folds in, let it fold me too,"},{"s":152.8,"e":156.36,"text":"If the stars fall down, they may rise brand new,"},{"s":156.36,"e":159.9,"text":"If the dark gets deep, there’s a dawn somewhere,"},{"s":159.9,"e":163.48,"text":"A billion new suns in another air."},{"s":163.48,"e":167.5,"text":"So I don’t fear when the heavens slide,"},{"s":167.5,"e":171.6,"text":"I don’t fear what the shadows hide,"},{"s":171.6,"e":175.12,"text":"Every lost light, every star that died,"},{"s":175.12,"e":181.8,"text":"Might be singing from the other side."},{"s":181.8,"e":185.44,"text":"What if the Big Bang is the other side,"},{"s":185.44,"e":189.04,"text":"Of every black hole where the stars go hide?"},{"s":189.76,"e":192.66,"text":"Everything falls, then it blooms in light,"},{"s":192.66,"e":196.74,"text":"Dark on the left, new dawn on the right."},{"s":196.74,"e":199.82,"text":"What if the whole sky came from a fall,"},{"s":199.82,"e":203.9,"text":"One little point holding all of it all?"},{"s":203.9,"e":206.8,"text":"Every end bends, every night gets wide,"},{"s":206.8,"e":210.22,"text":"Maybe we came from the other side."},{"s":210.5,"e":214.02,"text":"Black hole falling, Big Bang rising,"},{"s":214.02,"e":217.54,"text":"Old stars fading, new stars shining,"},{"s":217.54,"e":221.16,"text":"No last ending, no first dividing,"},{"s":221.16,"e":224.78,"text":"Just forever folding, finding, flying."}],"duration":229.6,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.413Z","stats":{"whisperWords":526,"polishedWords":531,"matched":481,"matchRate":0.906}}