"line":92},{"w":"the","s":348.527,"e":348.857,"line":92},{"w":"very","s":348.857,"e":349.518,"line":92},{"w":"day","s":349.518,"e":349.848,"line":92},{"w":"that","s":349.848,"e":350.179,"line":92},{"w":"Mike","s":350.179,"e":350.509,"line":92},{"w":"could","s":350.509,"e":350.839,"line":92},{"w":"also","s":350.839,"e":351.5,"line":92},{"w":"call","s":351.5,"e":351.83,"line":92},{"w":"his","s":351.83,"e":352.161,"line":92},{"w":"special","s":352.161,"e":352.822,"line":92},{"w":"time.","s":352.822,"e":353.152,"line":92},{"w":"So","s":353.152,"e":353.482,"line":93},{"w":"cut","s":353.482,"e":353.813,"line":93},{"w":"the","s":353.813,"e":354.143,"line":93},{"w":"cakes","s":354.143,"e":354.804,"line":93},{"w":"and","s":354.804,"e":355.134,"line":93},{"w":"make","s":355.134,"e":355.464,"line":93},{"w":"a","s":355.464,"e":355.795,"line":93},{"w":"wish","s":355.795,"e":356.125,"line":93},{"w":"beneath","s":356.125,"e":356.786,"line":93},{"w":"the","s":356.786,"e":357.116,"line":93},{"w":"summer","s":357.116,"e":357.777,"line":93},{"w":"sky—","s":357.777,"e":358.107,"line":93},{"w":"Happy","s":358.107,"e":358.768,"line":94},{"w":"birthday,","s":358.768,"e":359.429,"line":94},{"w":"Mike","s":359.429,"e":359.759,"line":94},{"w":"and","s":359.759,"e":360.09,"line":94},{"w":"Laura—","s":360.09,"e":360.75,"line":94},{"w":"Happy","s":360.75,"e":361.411,"line":95},{"w":"seventh","s":361.411,"e":362.072,"line":95},{"w":"of","s":362.072,"e":362.402,"line":95},{"w":"July—","s":362.402,"e":363.063,"line":95},{"w":"Wait!","s":363.063,"e":363.393,"line":96},{"w":"Not","s":363.393,"e":363.724,"line":96},{"w":"the","s":363.724,"e":364.054,"line":96},{"w":"seventh—","s":364.054,"e":364.715,"line":96},{"w":"**Seven-eleven!","s":364.715,"e":366.367,"line":97},{"w":"That’s","s":366.367,"e":366.697,"line":97},{"w":"July","s":366.697,"e":367.358,"line":97},{"w":"eleven,","s":367.358,"e":368.349,"line":97},{"w":"right!**","s":368.349,"e":368.679,"line":97},{"w":"Now","s":368.679,"e":369.01,"line":98},{"w":"bring","s":369.01,"e":369.34,"line":98},{"w":"back","s":369.34,"e":369.67,"line":98},{"w":"those","s":369.67,"e":370.001,"line":98},{"w":"berry","s":370.001,"e":370.661,"line":98},{"w":"cakes","s":370.661,"e":371.322,"line":98},{"w":"And","s":371.06,"e":371.14,"line":99},{"w":"party","s":371.06,"e":371.14,"line":99},{"w":"through","s":371.06,"e":371.14,"line":99},{"w":"the","s":371.06,"e":371.14,"line":99},{"w":"night!","s":371.06,"e":371.14,"line":99}],"lines":[{"s":4.68,"e":7.984,"text":"# **The Seven-Eleven Birthday Song**"},{"s":7.984,"e":8.884,"text":"**[Intro]**"},{"s":8.884,"e":13.839,"text":"Seven-eleven, make a wish, let the birthday bells begin,"},{"s":13.839,"e":18.134,"text":"For Laura and for Mike—let the double-day win!"},{"s":18.134,"e":21.768,"text":"Two cakes, one date, one family delight,"},{"s":21.768,"e":25.733,"text":"A blueberry morning and a strawberry night!"},{"s":25.733,"e":26.633,"text":"**[Verse 1]**"},{"s":26.633,"e":30.927,"text":"Mike was working, wheels were turning, earning through the day,"},{"s":30.927,"e":35.553,"text":"Then he clocked out, rocked out, and hurried right away."},{"s":35.553,"e":40.178,"text":"He took Mom to the hospital, hopeful, holding tight,"},{"s":40.178,"e":44.473,"text":"While the summer sun was shining with that July light."},{"s":44.473,"e":48.767,"text":"Then Mike made a mission through the busy city streets,"},{"s":48.767,"e":52.732,"text":"Picked up little Brian from preschool in his seat."},{"s":52.732,"e":57.357,"text":"Back to the hospital, with excitement in the air,"},{"s":57.357,"e":61.982,"text":"A growing glow of love and hope was waiting for them there."},{"s":61.982,"e":62.973,"text":"**[Pre-Chorus]**"},{"s":62.973,"e":66.938,"text":"But Mom had a long labor—longer than a song,"},{"s":66.938,"e":69.581,"text":"Breathing, believing, brave and strong."},{"s":69.581,"e":73.875,"text":"The minutes moved slowly, then suddenly—bam!"},{"s":73.875,"e":79.161,"text":"At eleven in the morning, little Laura said, “Here I am!”"},{"s":79.161,"e":80.061,"text":"**[Chorus]**"},{"s":80.061,"e":83.695,"text":"Happy birthday, Laura! Happy birthday, Mike!"},{"s":83.695,"e":87.66,"text":"Born on the same day—now how wild is that alike?"},{"s":87.66,"e":92.285,"text":"Seven-eleven heaven, let the candles come alive,"},{"s":92.285,"e":96.91,"text":"Father and daughter sharing one sensational July!"},{"s":96.91,"e":100.875,"text":"Everybody says, “Hey! You stole my birthday!”"},{"s":100.875,"e":104.509,"text":"“Give it back! That date was mine first anyway!”"},{"s":104.509,"e":108.473,"text":"But when a dad and daughter share that birthday cheer,"},{"s":108.473,"e":112.438,"text":"Nobody stole a thing—they brought each other here!"},{"s":112.438,"e":113.338,"text":"**[Verse 2]**"},{"s":113.338,"e":117.963,"text":"Laura arrived at eleven, eleven A.M. bright,"},{"s":117.963,"e":122.258,"text":"A little bundle bubbling with laughter, love, and light."},{"s":122.258,"e":126.552,"text":"Mike had his birthday, but he gained a gift that day,"},{"s":126.552,"e":131.508,"text":"The greatest present possible in every single way."},{"s":131.508,"e":135.142,"text":"No ribbon, no wrapping, no box and no bow,"},{"s":135.142,"e":139.106,"text":"Just a beautiful baby with a radiant glow."},{"s":139.106,"e":143.732,"text":"From that moment every seventh month, eleventh day,"},{"s":143.732,"e":147.696,"text":"They could split the candles—but not the love away."},{"s":147.696,"e":148.596,"text":"**[Chorus]**"},{"s":148.596,"e":152.23,"text":"Happy birthday, Laura! Happy birthday, Mike!"},{"s":152.23,"e":156.195,"text":"Born on the same day—now how wild is that alike?"},{"s":156.195,"e":160.82,"text":"Seven-eleven heaven, let the candles come alive,"},{"s":160.82,"e":165.445,"text":"Father and daughter sharing one sensational July!"},{"s":165.445,"e":169.409,"text":"Everybody says, “Hey! You stole my birthday!”"},{"s":169.409,"e":173.043,"text":"“Give it back! That date was mine first anyway!”"},{"s":173.043,"e":177.008,"text":"But when a dad and daughter share that birthday cheer,"},{"s":177.008,"e":180.972,"text":"Nobody stole a thing—they brought each other here!"},{"s":180.972,"e":182.294,"text":"**[Verse 3 — 2026]**"},{"s":182.294,"e":186.258,"text":"Then came twenty-twenty-six, with frosting flying free,"},{"s":186.258,"e":191.214,"text":"A double-cake celebration for the birthday family."},{"s":191.214,"e":195.178,"text":"Dad had strawberry—sweet, scarlet, stacked up high,"},{"s":195.178,"e":199.803,"text":"Laura had blueberry, blue as a brilliant July sky."},{"s":199.803,"e":203.437,"text":"Strawberry for Mike with a bright berry crown,"},{"s":203.437,"e":208.063,"text":"Blueberry for Laura—pass the party plates around!"},{"s":208.063,"e":211.036,"text":"Red cake, blue cake, candles sparkling gold,"},{"s":211.036,"e":215.661,"text":"Another shared birthday and another story told."},{"s":215.661,"e":216.561,"text":"**[Bridge]**"},{"s":216.561,"e":220.856,"text":"Then Chris, Laura’s husband, said, “You won’t believe this twist—"},{"s":220.856,"e":224.82,"text":"I’ve got a friend whose birthday’s also on the list!”"},{"s":224.82,"e":229.776,"text":"Seven-eleven strikes again—another candle crew,"},{"s":229.776,"e":234.071,"text":"How can one July day hold so many birthdays too?"},{"s":234.071,"e":236.053,"text":"One says, “That’s my birthday!”"},{"s":236.053,"e":237.705,"text":"One says, “No, it’s mine!”"},{"s":237.705,"e":243.321,"text":"Everybody’s claiming ownership of seven-eleven time!"},{"s":243.321,"e":248.607,"text":"“It was stolen!” “It was borrowed!” “It was taken in the night!”"},{"s":248.607,"e":253.562,"text":"While the cakes keep disappearing with each delicious bite."},{"s":253.562,"e":254.462,"text":"**[Breakdown]**"},{"s":254.462,"e":259.748,"text":"But birthdays aren’t belongings, and dates cannot be owned,"},{"s":259.748,"e":264.043,"text":"They’re little lights of love through every year we’ve grown."},{"s":264.043,"e":268.338,"text":"Still, it’s fun to fuss and fight and make the playful claim:"},{"s":268.338,"e":270.32,"text":"“You copied my birthday!”"},{"s":270.32,"e":272.302,"text":"“You stole my special name!”"},{"s":272.302,"e":276.597,"text":"Yet father and daughter get the sweetest exception,"},{"s":276.597,"e":281.222,"text":"A shared celebration with a perfect connection."},{"s":281.222,"e":285.187,"text":"Mike didn’t lose his birthday when Laura came to stay—"},{"s":285.187,"e":290.142,"text":"She made his birthday brighter in the most miraculous way."},{"s":290.142,"e":291.464,"text":"**[Final Chorus]**"},{"s":291.464,"e":295.098,"text":"Happy birthday, Laura! Happy birthday, Mike!"},{"s":295.098,"e":299.062,"text":"Raise the roof with rhythm, make the birthday candles strike!"},{"s":299.062,"e":303.688,"text":"Seven-eleven heaven, double laughter, double light,"},{"s":303.688,"e":307.982,"text":"Blueberry and strawberry—what a beautiful sight!"},{"s":307.982,"e":311.616,"text":"Happy birthday, Laura! Happy birthday, Dad!"},{"s":311.616,"e":316.242,"text":"Celebrate the memories and every year you’ve had!"},{"s":316.242,"e":320.206,"text":"Chris and Brian, Mom and friends—come sing with all your might:"},{"s":320.206,"e":324.17,"text":"“Seven-eleven birthdays make the whole world bright!”"},{"s":324.17,"e":328.135,"text":"Everybody says, “Hey! You stole my birthday!”"},{"s":328.135,"e":332.76,"text":"But love just laughs and answers, “There is plenty anyway!”"},{"s":332.76,"e":337.385,"text":"And when a dad and daughter share the date from year to year,"},{"s":337.385,"e":339.698,"text":"Nobody stole the birthday—"},{"s":339.698,"e":341.68,"text":"They doubled all the cheer!"},{"s":341.68,"e":342.58,"text":"**[Outro]**"},{"s":342.58,"e":348.196,"text":"At eleven in the morning, Laura joined the family line,"},{"s":348.196,"e":353.152,"text":"On the very day that Mike could also call his special time."},{"s":353.152,"e":358.107,"text":"So cut the cakes and make a wish beneath the summer sky—"},{"s":358.107,"e":360.75,"text":"Happy birthday, Mike and Laura—"},{"s":360.75,"e":363.063,"text":"Happy seventh of July—"},{"s":363.063,"e":364.715,"text":"Wait! Not the seventh—"},{"s":364.715,"e":368.679,"text":"**Seven-eleven! That’s July eleven, right!**"},{"s":368.679,"e":371.322,"text":"Now bring back those berry cakes"},{"s":371.06,"e":371.14,"text":"And party through the night!"}],"duration":375.76,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.008Z","realignedFrom":"whisper-aligned","vocalStart":4.68,"vocalEnd":371.06}