,"s":296.28,"e":296.44,"line":98},{"w":"I","s":296.44,"e":297.22,"line":98},{"w":"dwelled—","s":297.22,"e":297.3,"line":98},{"w":"Holy","s":297.22,"e":297.74,"line":99},{"w":"shit,","s":297.74,"e":298.26,"line":99},{"w":"whoa,","s":298.28,"e":298.78,"line":99},{"w":"bro—that","s":299.36,"e":300.28,"line":99},{"w":"was","s":300.28,"e":300.64,"line":99},{"w":"creepy","s":300.64,"e":301.08,"line":99},{"w":"as","s":301.08,"e":301.84,"line":99},{"w":"hell.","s":301.84,"e":301.92,"line":99},{"w":"Stop","s":301.86,"e":302.32,"line":100},{"w":"hurting","s":302.32,"e":302.82,"line":100},{"w":"people.","s":302.82,"e":303.3,"line":100},{"w":"Start","s":303.3,"e":303.76,"line":100},{"w":"doing","s":303.76,"e":304.3,"line":100},{"w":"right.","s":304.3,"e":304.6,"line":100},{"w":"Protect","s":304.6,"e":305.06,"line":101},{"w":"every","s":305.06,"e":305.7,"line":101},{"w":"child,","s":305.7,"e":306.1,"line":101},{"w":"every","s":306.16,"e":306.6,"line":101},{"w":"day,","s":306.6,"e":306.98,"line":101},{"w":"every","s":307,"e":307.56,"line":101},{"w":"night.","s":307.56,"e":307.86,"line":101},{"w":"The","s":307.86,"e":308.48,"line":102},{"w":"answer","s":308.48,"e":308.88,"line":102},{"w":"is","s":308.88,"e":309.38,"line":102},{"w":"simple;","s":309.38,"e":309.74,"line":102},{"w":"there’s","s":309.74,"e":310,"line":102},{"w":"nothing","s":310.26,"e":310.7,"line":102},{"w":"to","s":310.7,"e":311.2,"line":102},{"w":"sell:","s":311.2,"e":311.66,"line":102},{"w":"Showing","s":311.66,"e":312.56,"line":103},{"w":"up","s":312.56,"e":313,"line":103},{"w":"like","s":313.46,"e":313.92,"line":103},{"w":"that","s":313.92,"e":314.18,"line":103},{"w":"was","s":314.18,"e":314.9,"line":103},{"w":"creepy","s":314.9,"e":315.82,"line":103},{"w":"as","s":315.82,"e":316.46,"line":103},{"w":"hell.","s":316.46,"e":317.2,"line":103}],"lines":[{"s":0.75,"e":1.983,"text":"# **Creepy as Hell**"},{"s":1.983,"e":2.483,"text":"**[Intro]**"},{"s":2.5,"e":6.8,"text":"I was fourteen years old in the monitor glow,"},{"s":6.86,"e":10.68,"text":"Playing AVATAR MUD in a text-based world."},{"s":10.88,"e":14.66,"text":"Typing commands, fighting monsters for spells,"},{"s":14.84,"e":21.16,"text":"Then the players came to my town—creepy as hell."},{"s":21.16,"e":21.66,"text":"**[Verse 1]**"},{"s":28.9,"e":32.02,"text":"AVATAR MUD, fourteen, minding my business,"},{"s":32.38,"e":35.78,"text":"Playing through the night, never asking for this."},{"s":36.1,"e":39.34,"text":"Then UberCon 2003 came rolling around,"},{"s":39.34,"e":42.98,"text":"To the Sheraton in Parsippany—my own hometown."},{"s":42.98,"e":45.26,"text":"A whole convention of AVATAR players showed,"},{"s":45.26,"e":49.56,"text":"Right where a fourteen-year-old lived down the road."},{"s":49.48,"e":52.94,"text":"Holy shit, whoa, bro—how else would that feel?"},{"s":53.58,"e":56.58,"text":"The names from the screen had appeared somewhere real."},{"s":57.5,"e":60.28,"text":"I was a kid with a keyboard, a character, a quest,"},{"s":60.82,"e":63.76,"text":"Not expecting the game to arrive where I slept."},{"s":64.4,"e":67.36,"text":"Call it whatever you want, but remember as well:"},{"s":67.36,"e":71.26,"text":"To a fourteen-year-old, that was creepy as hell."},{"s":71.26,"e":71.76,"text":"**[Pre-Chorus]**"},{"s":72.04,"e":75.4,"text":"Adults might laugh and say, “What’s the big deal?”"},{"s":75.8,"e":79.32,"text":"They weren’t the young person deciding what’s real."},{"s":79.32,"e":82.82,"text":"They didn’t feel the shock when the screen crossed the line,"},{"s":82.82,"e":86.76,"text":"And a world from the computer appeared outside."},{"s":86.76,"e":87.26,"text":"**[Chorus]**"},{"s":86.76,"e":89.98,"text":"Creepy as hell—say exactly what it was,"},{"s":89.98,"e":93.82,"text":"AVATAR players showing up where a young player was."},{"s":93.82,"e":96.28,"text":"UberCon, Sheraton, 2003,"},{"s":97,"e":100.6,"text":"Parsippany, New Jersey—too close to me."},{"s":100.6,"e":103.56,"text":"When people do wrong, more wrong gets made,"},{"s":103.56,"e":107.08,"text":"Pain becomes pressure that never quite fades."},{"s":107.08,"e":111,"text":"So do the right thing already, God—"},{"s":111.02,"e":115.26,"text":"Stop every monster who thinks fear is a job."},{"s":115.16,"e":115.66,"text":"**[Verse 2]**"},{"s":115.6,"e":117.3,"text":"Fast-forward years and the future just sucks,"},{"s":117.3,"e":119.6,"text":"Too many people put cruelty over trust."},{"s":119.6,"e":121.28,"text":"People hurt people, then cover their tracks,"},{"s":121.28,"e":123.12,"text":"Then act so surprised when the pain circles back."},{"s":123.12,"e":124.94,"text":"Bad things happen when people choose bad,"},{"s":124.94,"e":128.2,"text":"One sick little action leaves a lifetime of damage."},{"s":129.16,"e":131.14,"text":"The answer is simple, no mystery involved:"},{"s":131.62,"e":135,"text":"Do not scare children—get the problem resolved."},{"s":136,"e":139.02,"text":"Do not stalk, intimidate, manipulate minds,"},{"s":139.02,"e":143.04,"text":"Do not make a young person keep looking behind."},{"s":143.04,"e":146.58,"text":"When something feels wrong, do not tell them they’re weak;"},{"s":146.66,"e":150.18,"text":"Protect them, respect them, and let them speak."},{"s":150.18,"e":150.68,"text":"**[Pre-Chorus]**"},{"s":150.7,"e":154.6,"text":"It should not take scripture, a sign or a flood"},{"s":154.6,"e":158.58,"text":"To know you don’t frighten somebody that young."},{"s":158.58,"e":162,"text":"You don’t need a sermon to tell dark from light—"},{"s":162,"e":166.04,"text":"Leave children alone and start doing what’s right."},{"s":166.04,"e":166.54,"text":"**[Chorus]**"},{"s":166.04,"e":169.2,"text":"Creepy as hell—say exactly what it was,"},{"s":169.2,"e":173,"text":"AVATAR players showing up where a young player was."},{"s":173,"e":175.52,"text":"UberCon, Sheraton, 2003,"},{"s":176.16,"e":179.82,"text":"Parsippany, New Jersey—too close to me."},{"s":179.82,"e":182.82,"text":"When people do wrong, more wrong gets made,"},{"s":182.82,"e":186.32,"text":"Pain becomes pressure that never quite fades."},{"s":186.32,"e":190.2,"text":"So do the right thing already, God—"},{"s":190.2,"e":194.4,"text":"Stop every monster who thinks fear is a job."},{"s":194.4,"e":194.9,"text":"**[Bridge]**"},{"s":194.74,"e":196.14,"text":"AVATAR MUD—that was the game."},{"s":196.14,"e":198.4,"text":"UberCon 2003—that was the name."},{"s":198.4,"e":200.68,"text":"Sheraton Parsippany—that was the place."},{"s":200.68,"e":204.38,"text":"I was fourteen years old—remember my age."},{"s":204.52,"e":206.74,"text":"A convention of players came into my town,"},{"s":206.7,"e":208.8,"text":"From the game I was playing when no one was around."},{"s":208.8,"e":212,"text":"Holy shit, whoa, bro—tell it yourself:"},{"s":212.1,"e":216.06,"text":"For a fourteen-year-old, that’s creepy as hell."},{"s":216,"e":218.2,"text":"Do not soften the story or bury the fear."},{"s":218.2,"e":222.22,"text":"Do not act like the details suddenly disappear."},{"s":222.68,"e":226.08,"text":"A kid should not wonder why grown people came near"},{"s":226.32,"e":230.6,"text":"From the world on his screen that very same year."},{"s":230.6,"e":231.1,"text":"**[Breakdown]**"},{"s":230.6,"e":231.64,"text":"Protect kids."},{"s":231.64,"e":232.44,"text":"Stop harm."},{"s":232.44,"e":233.16,"text":"No fear."},{"s":233.16,"e":234.02,"text":"Sound alarms."},{"s":234.02,"e":234.98,"text":"No stalking."},{"s":234.98,"e":235.86,"text":"No games."},{"s":235.86,"e":237.64,"text":"No terror for fun."},{"s":237.64,"e":241.26,"text":"No targeting somebody because they are young."},{"s":241.26,"e":244.94,"text":"If you know something’s wrong, then make it stop."},{"s":244.94,"e":248.52,"text":"Justice takes action—it does not just watch."},{"s":248.52,"e":251.1,"text":"End the cruelty, the power and lies;"},{"s":251.52,"e":257.86,"text":"Do the right thing already, God—open Your eyes."},{"s":257.86,"e":258.36,"text":"**[Final Chorus]**"},{"s":257.86,"e":261,"text":"Creepy as hell—say exactly what it was,"},{"s":261.52,"e":265.1,"text":"AVATAR players showing up where a young player was."},{"s":265.1,"e":267.4,"text":"UberCon, Sheraton, 2003,"},{"s":268.26,"e":271.78,"text":"Parsippany, New Jersey—too close to me."},{"s":271.78,"e":274.2,"text":"When people do evil, the consequences spread"},{"s":275.02,"e":278.22,"text":"Through families, futures, hearts and heads."},{"s":278.22,"e":281.92,"text":"Take away the power of anyone causing that fear—"},{"s":282.08,"e":287.04,"text":"Do the right thing already and make it clear."},{"s":287.04,"e":287.54,"text":"**[Outro]**"},{"s":287.04,"e":290.44,"text":"Fourteen years old in a text-based MMO,"},{"s":290.48,"e":293.48,"text":"AVATAR MUD in the monitor glow."},{"s":293.48,"e":297.3,"text":"Then UberCon came to the town where I dwelled—"},{"s":297.22,"e":301.92,"text":"Holy shit, whoa, bro—that was creepy as hell."},{"s":301.86,"e":304.6,"text":"Stop hurting people. Start doing right."},{"s":304.6,"e":307.86,"text":"Protect every child, every day, every night."},{"s":307.86,"e":311.66,"text":"The answer is simple; there’s nothing to sell:"},{"s":311.66,"e":317.2,"text":"Showing up like that was creepy as hell."}],"duration":321.2,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.546Z","stats":{"whisperWords":703,"polishedWords":677,"matched":624,"matchRate":0.922}}