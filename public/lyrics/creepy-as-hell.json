00.239,"line":98},{"w":"came","s":300.239,"e":300.555,"line":98},{"w":"to","s":300.555,"e":300.872,"line":98},{"w":"the","s":300.872,"e":301.189,"line":98},{"w":"town","s":301.189,"e":301.505,"line":98},{"w":"where","s":301.505,"e":301.822,"line":98},{"w":"I","s":301.822,"e":302.138,"line":98},{"w":"dwelled—","s":302.138,"e":302.772,"line":98},{"w":"Holy","s":302.772,"e":303.405,"line":99},{"w":"shit,","s":303.405,"e":303.721,"line":99},{"w":"whoa,","s":303.721,"e":304.038,"line":99},{"w":"bro—that","s":304.038,"e":304.671,"line":99},{"w":"was","s":304.671,"e":304.988,"line":99},{"w":"creepy","s":304.988,"e":305.621,"line":99},{"w":"as","s":305.621,"e":305.938,"line":99},{"w":"hell.","s":305.938,"e":306.254,"line":99},{"w":"Stop","s":306.254,"e":306.571,"line":100},{"w":"hurting","s":306.571,"e":307.204,"line":100},{"w":"people.","s":307.204,"e":307.837,"line":100},{"w":"Start","s":307.837,"e":308.154,"line":100},{"w":"doing","s":308.154,"e":308.47,"line":100},{"w":"right.","s":308.47,"e":308.787,"line":100},{"w":"Protect","s":308.787,"e":309.42,"line":101},{"w":"every","s":309.42,"e":310.37,"line":101},{"w":"child,","s":310.37,"e":310.687,"line":101},{"w":"every","s":310.687,"e":311.636,"line":101},{"w":"day,","s":311.636,"e":311.953,"line":101},{"w":"every","s":311.953,"e":312.903,"line":101},{"w":"night.","s":312.903,"e":313.219,"line":101},{"w":"The","s":313.219,"e":313.536,"line":102},{"w":"answer","s":313.536,"e":314.169,"line":102},{"w":"is","s":314.169,"e":314.486,"line":102},{"w":"simple;","s":314.486,"e":315.119,"line":102},{"w":"there’s","s":315.119,"e":315.752,"line":102},{"w":"nothing","s":315.752,"e":316.385,"line":102},{"w":"to","s":316.385,"e":316.702,"line":102},{"w":"sell:","s":316.702,"e":317.019,"line":102},{"w":"Showing","s":317.019,"e":317.2,"line":103},{"w":"up","s":317.2,"e":317.28,"line":103},{"w":"like","s":317.2,"e":317.28,"line":103},{"w":"that","s":317.2,"e":317.28,"line":103},{"w":"was","s":317.2,"e":317.28,"line":103},{"w":"creepy","s":317.2,"e":317.28,"line":103},{"w":"as","s":317.2,"e":317.28,"line":103},{"w":"hell.","s":317.2,"e":317.28,"line":103}],"lines":[{"s":2.5,"e":4.083,"text":"# **Creepy as Hell**"},{"s":4.083,"e":4.983,"text":"**[Intro]**"},{"s":4.983,"e":8.782,"text":"I was fourteen years old in the monitor glow,"},{"s":8.782,"e":12.265,"text":"Playing AVATAR MUD in a text-based world."},{"s":12.265,"e":15.431,"text":"Typing commands, fighting monsters for spells,"},{"s":15.431,"e":18.913,"text":"Then the players came to my town—creepy as hell."},{"s":18.913,"e":19.813,"text":"**[Verse 1]**"},{"s":19.813,"e":23.613,"text":"AVATAR MUD, fourteen, minding my business,"},{"s":23.613,"e":26.779,"text":"Playing through the night, never asking for this."},{"s":26.779,"e":29.945,"text":"Then UberCon 2003 came rolling around,"},{"s":29.945,"e":34.694,"text":"To the Sheraton in Parsippany—my own hometown."},{"s":34.694,"e":38.493,"text":"A whole convention of AVATAR players showed,"},{"s":38.493,"e":42.292,"text":"Right where a fourteen-year-old lived down the road."},{"s":42.292,"e":45.458,"text":"Holy shit, whoa, bro—how else would that feel?"},{"s":45.458,"e":49.89,"text":"The names from the screen had appeared somewhere real."},{"s":49.89,"e":54.323,"text":"I was a kid with a keyboard, a character, a quest,"},{"s":54.323,"e":58.122,"text":"Not expecting the game to arrive where I slept."},{"s":58.122,"e":62.238,"text":"Call it whatever you want, but remember as well:"},{"s":62.238,"e":66.037,"text":"To a fourteen-year-old, that was creepy as hell."},{"s":66.037,"e":66.987,"text":"**[Pre-Chorus]**"},{"s":66.987,"e":70.153,"text":"Adults might laugh and say, “What’s the big deal?”"},{"s":70.153,"e":73.952,"text":"They weren’t the young person deciding what’s real."},{"s":73.952,"e":77.751,"text":"They didn’t feel the shock when the screen crossed the line,"},{"s":77.751,"e":81.867,"text":"And a world from the computer appeared outside."},{"s":81.867,"e":82.767,"text":"**[Chorus]**"},{"s":82.767,"e":86.249,"text":"Creepy as hell—say exactly what it was,"},{"s":86.249,"e":90.049,"text":"AVATAR players showing up where a young player was."},{"s":90.049,"e":92.265,"text":"UberCon, Sheraton, 2003,"},{"s":92.265,"e":95.747,"text":"Parsippany, New Jersey—too close to me."},{"s":95.747,"e":98.597,"text":"When people do wrong, more wrong gets made,"},{"s":98.597,"e":102.396,"text":"Pain becomes pressure that never quite fades."},{"s":102.396,"e":105.245,"text":"So do the right thing already, God—"},{"s":105.245,"e":109.045,"text":"Stop every monster who thinks fear is a job."},{"s":109.045,"e":109.945,"text":"**[Verse 2]**"},{"s":109.945,"e":113.111,"text":"Fast-forward years and the future just sucks,"},{"s":113.111,"e":116.593,"text":"Too many people put cruelty over trust."},{"s":116.593,"e":119.759,"text":"People hurt people, then cover their tracks,"},{"s":119.759,"e":123.558,"text":"Then act so surprised when the pain circles back."},{"s":123.558,"e":126.408,"text":"Bad things happen when people choose bad,"},{"s":126.408,"e":131.157,"text":"One sick little action leaves a lifetime of damage."},{"s":131.157,"e":135.273,"text":"The answer is simple, no mystery involved:"},{"s":135.273,"e":139.072,"text":"Do not scare children—get the problem resolved."},{"s":139.072,"e":142.871,"text":"Do not stalk, intimidate, manipulate minds,"},{"s":142.871,"e":146.67,"text":"Do not make a young person keep looking behind."},{"s":146.67,"e":150.469,"text":"When something feels wrong, do not tell them they’re weak;"},{"s":150.469,"e":153.635,"text":"Protect them, respect them, and let them speak."},{"s":153.635,"e":154.585,"text":"**[Pre-Chorus]**"},{"s":154.585,"e":158.068,"text":"It should not take scripture, a sign or a flood"},{"s":158.068,"e":161.867,"text":"To know you don’t frighten somebody that young."},{"s":161.867,"e":165.35,"text":"You don’t need a sermon to tell dark from light—"},{"s":165.35,"e":168.516,"text":"Leave children alone and start doing what’s right."},{"s":168.516,"e":169.416,"text":"**[Chorus]**"},{"s":169.416,"e":172.898,"text":"Creepy as hell—say exactly what it was,"},{"s":172.898,"e":176.697,"text":"AVATAR players showing up where a young player was."},{"s":176.697,"e":178.914,"text":"UberCon, Sheraton, 2003,"},{"s":178.914,"e":182.396,"text":"Parsippany, New Jersey—too close to me."},{"s":182.396,"e":185.246,"text":"When people do wrong, more wrong gets made,"},{"s":185.246,"e":189.045,"text":"Pain becomes pressure that never quite fades."},{"s":189.045,"e":191.894,"text":"So do the right thing already, God—"},{"s":191.894,"e":195.693,"text":"Stop every monster who thinks fear is a job."},{"s":195.693,"e":196.593,"text":"**[Bridge]**"},{"s":196.593,"e":199.126,"text":"AVATAR MUD—that was the game."},{"s":199.126,"e":201.342,"text":"UberCon 2003—that was the name."},{"s":201.342,"e":204.825,"text":"Sheraton Parsippany—that was the place."},{"s":204.825,"e":208.308,"text":"I was fourteen years old—remember my age."},{"s":208.308,"e":211.79,"text":"A convention of players came into my town,"},{"s":211.79,"e":215.589,"text":"From the game I was playing when no one was around."},{"s":215.589,"e":218.439,"text":"Holy shit, whoa, bro—tell it yourself:"},{"s":218.439,"e":221.921,"text":"For a fourteen-year-old, that’s creepy as hell."},{"s":221.921,"e":225.721,"text":"Do not soften the story or bury the fear."},{"s":225.721,"e":229.836,"text":"Do not act like the details suddenly disappear."},{"s":229.836,"e":233.636,"text":"A kid should not wonder why grown people came near"},{"s":233.636,"e":237.118,"text":"From the world on his screen that very same year."},{"s":237.118,"e":238.018,"text":"**[Breakdown]**"},{"s":238.018,"e":238.968,"text":"Protect kids."},{"s":238.968,"e":239.868,"text":"Stop harm."},{"s":239.868,"e":240.768,"text":"No fear."},{"s":240.768,"e":241.718,"text":"Sound alarms."},{"s":241.718,"e":242.668,"text":"No stalking."},{"s":242.668,"e":243.617,"text":"No games."},{"s":243.617,"e":245.2,"text":"No terror for fun."},{"s":245.2,"e":249.316,"text":"No targeting somebody because they are young."},{"s":249.316,"e":252.799,"text":"If you know something’s wrong, then make it stop."},{"s":252.799,"e":256.281,"text":"Justice takes action—it does not just watch."},{"s":256.281,"e":259.131,"text":"End the cruelty, the power and lies;"},{"s":259.131,"e":262.93,"text":"Do the right thing already, God—open Your eyes."},{"s":262.93,"e":264.196,"text":"**[Final Chorus]**"},{"s":264.196,"e":267.679,"text":"Creepy as hell—say exactly what it was,"},{"s":267.679,"e":271.478,"text":"AVATAR players showing up where a young player was."},{"s":271.478,"e":273.694,"text":"UberCon, Sheraton, 2003,"},{"s":273.694,"e":277.177,"text":"Parsippany, New Jersey—too close to me."},{"s":277.177,"e":280.976,"text":"When people do evil, the consequences spread"},{"s":280.976,"e":284.142,"text":"Through families, futures, hearts and heads."},{"s":284.142,"e":288.258,"text":"Take away the power of anyone causing that fear—"},{"s":288.258,"e":291.74,"text":"Do the right thing already and make it clear."},{"s":291.74,"e":292.64,"text":"**[Outro]**"},{"s":292.64,"e":295.806,"text":"Fourteen years old in a text-based MMO,"},{"s":295.806,"e":298.972,"text":"AVATAR MUD in the monitor glow."},{"s":298.972,"e":302.772,"text":"Then UberCon came to the town where I dwelled—"},{"s":302.772,"e":306.254,"text":"Holy shit, whoa, bro—that was creepy as hell."},{"s":306.254,"e":308.787,"text":"Stop hurting people. Start doing right."},{"s":308.787,"e":313.219,"text":"Protect every child, every day, every night."},{"s":313.219,"e":317.019,"text":"The answer is simple; there’s nothing to sell:"},{"s":317.019,"e":317.28,"text":"Showing up like that was creepy as hell."}],"duration":321.2,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.021Z","realignedFrom":"whisper-aligned","vocalStart":2.5,"vocalEnd":317.2}