"w":"Become","s":203.9,"e":204.56,"line":67},{"w":"every","s":204.56,"e":205.04,"line":67},{"w":"beautiful","s":205.04,"e":205.64,"line":67},{"w":"thing","s":205.64,"e":206.34,"line":67},{"w":"you","s":206.34,"e":206.6,"line":67},{"w":"can","s":206.6,"e":207.04,"line":67},{"w":"be.","s":207.04,"e":207.66,"line":67},{"w":"Strong","s":207.66,"e":208.4,"line":68},{"w":"in","s":208.4,"e":208.62,"line":68},{"w":"your","s":208.62,"e":208.98,"line":68},{"w":"spirit,","s":208.98,"e":209.44,"line":68},{"w":"proud","s":209.78,"e":210.14,"line":68},{"w":"in","s":210.14,"e":210.4,"line":68},{"w":"your","s":210.4,"e":210.76,"line":68},{"w":"name—","s":210.76,"e":211.26,"line":68},{"w":"Beautiful","s":211.26,"e":212.64,"line":69},{"w":"Myla,","s":212.64,"e":213.56,"line":69},{"w":"keep","s":213.56,"e":214.38,"line":69},{"w":"lighting","s":214.38,"e":214.8,"line":69},{"w":"the","s":214.8,"e":215.16,"line":69},{"w":"flame.","s":215.16,"e":217.1,"line":69},{"w":"Two","s":217.3,"e":218.7,"line":71},{"w":"little","s":218.7,"e":219.14,"line":71},{"w":"candles…","s":219.14,"e":219.96,"line":71},{"w":"A","s":220.32,"e":221.72,"line":72},{"w":"lifetime","s":221.72,"e":222.32,"line":72},{"w":"to","s":222.32,"e":223.42,"line":72},{"w":"go.","s":223.42,"e":224.16,"line":72},{"w":"Myla,","s":224.16,"e":225.26,"line":73},{"w":"keep","s":225.66,"e":225.76,"line":73},{"w":"shining—","s":225.76,"e":226.58,"line":73},{"w":"And","s":227.2,"e":228.6,"line":74},{"w":"watch","s":228.6,"e":228.68,"line":74},{"w":"how","s":228.68,"e":229.48,"line":74},{"w":"you","s":229.48,"e":230.24,"line":74},{"w":"grow.","s":230.24,"e":230.76,"line":74}],"lines":[{"s":0.78,"e":2.06,"text":"**MYLA, SHINE ON**"},{"s":2.06,"e":2.56,"text":"[Intro — Soft Piano, Warm Female Vocal]"},{"s":2.6,"e":6.42,"text":"Two little candles, a whole sky ahead,"},{"s":6.42,"e":10,"text":"Gold in her smile, little curls on her head."},{"s":10.48,"e":13.42,"text":"Jason’s birthday, everybody could see—"},{"s":13.8,"e":18.34,"text":"Myla walked in like a small sunrise free."},{"s":18.34,"e":18.84,"text":"[Verse 1]"},{"s":31.3,"e":34.64,"text":"Beautiful baby with a bright little glow,"},{"s":34.66,"e":38.42,"text":"Two years young with a whole world to know."},{"s":38.42,"e":42,"text":"Tiny shoes tapping, big dreams in her eyes,"},{"s":42,"e":45.66,"text":"Laughing like daylight under summer-blue skies."},{"s":45.66,"e":49.1,"text":"She doesn’t know yet how far she can fly,"},{"s":49.16,"e":52.8,"text":"How many mountains will melt when she tries."},{"s":52.8,"e":56.34,"text":"How many moments will make her stand tall,"},{"s":56.34,"e":59.96,"text":"How getting back up means more than the fall."},{"s":59.96,"e":60.46,"text":"[Pre-Chorus]"},{"s":60.32,"e":63.48,"text":"May she learn that her voice has a place,"},{"s":63.48,"e":67.22,"text":"That strength can be gentle, and pride can be grace."},{"s":67.22,"e":70.64,"text":"May she know beauty is more than a face—"},{"s":70.64,"e":74.02,"text":"It’s courage and kindness no time can erase."},{"s":74.02,"e":74.52,"text":"[Chorus — Big, Emotional]"},{"s":74.02,"e":78.74,"text":"**Myla, shine on, shine strong, shine bright,**"},{"s":78.74,"e":82.4,"text":"Walk with your head high, heart full of light."},{"s":82.4,"e":85.96,"text":"Grow into everything you’re dreaming to be,"},{"s":85.96,"e":89.88,"text":"Proud of your soul, proud to be free."},{"s":90.26,"e":93.86,"text":"**Myla, stand tall when the hard days arrive,**"},{"s":93.86,"e":97.12,"text":"Love who you are and let your spirit thrive."},{"s":97.12,"e":100.18,"text":"Beautiful now, but the best part will be"},{"s":100.18,"e":103.68,"text":"The strong, proud woman that someday we’ll see."},{"s":103.68,"e":104.18,"text":"[Verse 2]"},{"s":103.68,"e":105.9,"text":"May she chase questions and challenge the doubt,"},{"s":105.9,"e":107.7,"text":"Learn when to listen, learn when to speak out."},{"s":107.7,"e":109.54,"text":"May she build bridges but guard what she loves,"},{"s":109.54,"e":111.38,"text":"Know she deserves every dream she dreams of."},{"s":111.38,"e":113.08,"text":"May she be fearless enough to be kind,"},{"s":113.08,"e":114.9,"text":"Strong enough still to keep changing her mind."},{"s":114.9,"e":116.7,"text":"Proud without needing to push others down,"},{"s":116.7,"e":118.44,"text":"Wearing her character just like a crown."},{"s":118.4,"e":118.9,"text":"[Pre-Chorus]"},{"s":118.4,"e":120.1,"text":"When somebody tells her she can’t, may she grin,"},{"s":120.1,"e":122.02,"text":"Take one little step and then start again."},{"s":122.02,"e":123.8,"text":"Not every battle needs fighting to win—"},{"s":123.8,"e":126.48,"text":"Sometimes the strongest strength starts from within."},{"s":126.48,"e":126.98,"text":"[Chorus]"},{"s":127.32,"e":130.64,"text":"**Myla, shine on, shine strong, shine bright,**"},{"s":130.64,"e":134.32,"text":"Walk with your head high, heart full of light."},{"s":134.32,"e":137.82,"text":"Grow into everything you’re dreaming to be,"},{"s":137.82,"e":141.54,"text":"Proud of your soul, proud to be free."},{"s":142.06,"e":145.7,"text":"**Myla, stand tall when the hard days arrive,**"},{"s":145.7,"e":148.98,"text":"Love who you are and let your spirit thrive."},{"s":148.98,"e":152.02,"text":"Beautiful now, but the best part will be"},{"s":152.02,"e":155.6,"text":"The strong, proud woman that someday we’ll see."},{"s":155.6,"e":156.1,"text":"[Bridge — Piano Drops, Intimate Vocal]"},{"s":155.6,"e":158.94,"text":"Two years old—she can’t see it today,"},{"s":158.94,"e":162.76,"text":"All of the wonderful waiting her way."},{"s":162.76,"e":166.18,"text":"First days of school, first dreams she’ll pursue,"},{"s":166.18,"e":169.72,"text":"First time she learns, *“I can make it through.”*"},{"s":169.72,"e":173.56,"text":"And years from this birthday, wherever she goes,"},{"s":173.56,"e":177.42,"text":"May she remember the love where she rose."},{"s":177.42,"e":180.98,"text":"A little girl glowing, surrounded by smiles—"},{"s":180.98,"e":185.34,"text":"With a whole life of wonder stretching for miles."},{"s":185.34,"e":185.84,"text":"[Final Chorus — Huge Harmonies]"},{"s":185.34,"e":189.78,"text":"**Myla, shine on, shine strong, shine bright,**"},{"s":189.9,"e":193.66,"text":"Carry your courage straight into the night."},{"s":193.66,"e":196.92,"text":"Dream without shrinking, love without fear,"},{"s":196.92,"e":200.52,"text":"Know you are wanted, know you are dear."},{"s":200.52,"e":203.9,"text":"**Myla, grow wild, grow wise, grow free,**"},{"s":203.9,"e":207.66,"text":"Become every beautiful thing you can be."},{"s":207.66,"e":211.26,"text":"Strong in your spirit, proud in your name—"},{"s":211.26,"e":217.1,"text":"Beautiful Myla, keep lighting the flame."},{"s":217.1,"e":217.6,"text":"[Outro — Soft Piano]"},{"s":217.3,"e":219.96,"text":"Two little candles…"},{"s":220.32,"e":224.16,"text":"A lifetime to go."},{"s":224.16,"e":226.58,"text":"Myla, keep shining—"},{"s":227.2,"e":230.76,"text":"And watch how you grow."}],"duration":231.84,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.782Z","stats":{"whisperWords":500,"polishedWords":497,"matched":473,"matchRate":0.952}}