5},{"w":"without","s":202.472,"e":203.206,"line":55},{"w":"shrinking,","s":203.206,"e":203.941,"line":55},{"w":"love","s":203.941,"e":204.309,"line":55},{"w":"without","s":204.309,"e":205.043,"line":55},{"w":"fear,","s":205.043,"e":205.411,"line":55},{"w":"Know","s":205.411,"e":205.778,"line":56},{"w":"you","s":205.778,"e":206.146,"line":56},{"w":"are","s":206.146,"e":206.513,"line":56},{"w":"wanted,","s":206.513,"e":207.248,"line":56},{"w":"know","s":207.248,"e":207.615,"line":56},{"w":"you","s":207.615,"e":207.982,"line":56},{"w":"are","s":207.982,"e":208.35,"line":56},{"w":"dear.","s":208.35,"e":208.717,"line":56},{"w":"**Myla,","s":208.717,"e":209.452,"line":57},{"w":"grow","s":209.452,"e":209.819,"line":57},{"w":"wild,","s":209.819,"e":210.187,"line":57},{"w":"grow","s":210.187,"e":210.554,"line":57},{"w":"wise,","s":210.554,"e":210.921,"line":57},{"w":"grow","s":210.921,"e":211.289,"line":57},{"w":"free,**","s":211.289,"e":211.656,"line":57},{"w":"Become","s":211.656,"e":212.391,"line":58},{"w":"every","s":212.391,"e":213.493,"line":58},{"w":"beautiful","s":213.493,"e":214.595,"line":58},{"w":"thing","s":214.595,"e":214.963,"line":58},{"w":"you","s":214.963,"e":215.33,"line":58},{"w":"can","s":215.33,"e":215.697,"line":58},{"w":"be.","s":215.697,"e":216.065,"line":58},{"w":"Strong","s":216.065,"e":216.432,"line":59},{"w":"in","s":216.432,"e":216.8,"line":59},{"w":"your","s":216.8,"e":217.167,"line":59},{"w":"spirit,","s":217.167,"e":217.902,"line":59},{"w":"proud","s":217.902,"e":218.269,"line":59},{"w":"in","s":218.269,"e":218.636,"line":59},{"w":"your","s":218.636,"e":219.004,"line":59},{"w":"name—","s":219.004,"e":219.371,"line":59},{"w":"Beautiful","s":219.371,"e":220.473,"line":60},{"w":"Myla,","s":220.473,"e":221.208,"line":60},{"w":"keep","s":221.208,"e":221.575,"line":60},{"w":"lighting","s":221.575,"e":222.31,"line":60},{"w":"the","s":222.31,"e":222.678,"line":60},{"w":"flame.","s":222.678,"e":223.045,"line":60},{"w":"Two","s":223.045,"e":223.412,"line":61},{"w":"little","s":223.412,"e":224.147,"line":61},{"w":"candles…","s":224.147,"e":224.882,"line":61},{"w":"A","s":224.882,"e":225.249,"line":62},{"w":"lifetime","s":225.249,"e":226.351,"line":62},{"w":"to","s":226.351,"e":226.719,"line":62},{"w":"go.","s":226.719,"e":227.086,"line":62},{"w":"Myla,","s":227.086,"e":227.821,"line":63},{"w":"keep","s":227.821,"e":228.188,"line":63},{"w":"shining—","s":228.188,"e":228.923,"line":63},{"w":"And","s":228.923,"e":229.29,"line":64},{"w":"watch","s":229.29,"e":229.658,"line":64},{"w":"how","s":229.658,"e":230.025,"line":64},{"w":"you","s":230.025,"e":230.393,"line":64},{"w":"grow.","s":230.393,"e":230.76,"line":64}],"lines":[{"s":0.78,"e":2.25,"text":"**MYLA, SHINE ON**"},{"s":2.25,"e":5.923,"text":"Two little candles, a whole sky ahead,"},{"s":5.923,"e":9.597,"text":"Gold in her smile, little curls on her head."},{"s":9.597,"e":13.638,"text":"Jason’s birthday, everybody could see—"},{"s":13.638,"e":17.679,"text":"Myla walked in like a small sunrise free."},{"s":17.679,"e":21.721,"text":"Beautiful baby with a bright little glow,"},{"s":21.721,"e":25.027,"text":"Two years young with a whole world to know."},{"s":25.027,"e":28.701,"text":"Tiny shoes tapping, big dreams in her eyes,"},{"s":28.701,"e":32.375,"text":"Laughing like daylight under summer-blue skies."},{"s":32.375,"e":35.681,"text":"She doesn’t know yet how far she can fly,"},{"s":35.681,"e":39.355,"text":"How many mountains will melt when she tries."},{"s":39.355,"e":43.029,"text":"How many moments will make her stand tall,"},{"s":43.029,"e":46.703,"text":"How getting back up means more than the fall."},{"s":46.703,"e":50.009,"text":"May she learn that her voice has a place,"},{"s":50.009,"e":54.05,"text":"That strength can be gentle, and pride can be grace."},{"s":54.05,"e":57.724,"text":"May she know beauty is more than a face—"},{"s":57.724,"e":61.765,"text":"It’s courage and kindness no time can erase."},{"s":61.765,"e":64.704,"text":"**Myla, shine on, shine strong, shine bright,**"},{"s":64.704,"e":68.011,"text":"Walk with your head high, heart full of light."},{"s":68.011,"e":72.419,"text":"Grow into everything you’re dreaming to be,"},{"s":72.419,"e":75.358,"text":"Proud of your soul, proud to be free."},{"s":75.358,"e":79.032,"text":"**Myla, stand tall when the hard days arrive,**"},{"s":79.032,"e":82.706,"text":"Love who you are and let your spirit thrive."},{"s":82.706,"e":86.38,"text":"Beautiful now, but the best part will be"},{"s":86.38,"e":90.421,"text":"The strong, proud woman that someday we’ll see."},{"s":90.421,"e":94.095,"text":"May she chase questions and challenge the doubt,"},{"s":94.095,"e":97.768,"text":"Learn when to listen, learn when to speak out."},{"s":97.768,"e":101.81,"text":"May she build bridges but guard what she loves,"},{"s":101.81,"e":106.218,"text":"Know she deserves every dream she dreams of."},{"s":106.218,"e":109.892,"text":"May she be fearless enough to be kind,"},{"s":109.892,"e":113.566,"text":"Strong enough still to keep changing her mind."},{"s":113.566,"e":117.24,"text":"Proud without needing to push others down,"},{"s":117.24,"e":120.913,"text":"Wearing her character just like a crown."},{"s":120.913,"e":125.322,"text":"When somebody tells her she can’t, may she grin,"},{"s":125.322,"e":128.996,"text":"Take one little step and then start again."},{"s":128.996,"e":133.037,"text":"Not every battle needs fighting to win—"},{"s":133.037,"e":137.445,"text":"Sometimes the strongest strength starts from within."},{"s":137.445,"e":140.384,"text":"**Myla, shine on, shine strong, shine bright,**"},{"s":140.384,"e":143.691,"text":"Walk with your head high, heart full of light."},{"s":143.691,"e":148.099,"text":"Grow into everything you’re dreaming to be,"},{"s":148.099,"e":151.038,"text":"Proud of your soul, proud to be free."},{"s":151.038,"e":154.712,"text":"**Myla, stand tall when the hard days arrive,**"},{"s":154.712,"e":158.386,"text":"Love who you are and let your spirit thrive."},{"s":158.386,"e":162.06,"text":"Beautiful now, but the best part will be"},{"s":162.06,"e":166.101,"text":"The strong, proud woman that someday we’ll see."},{"s":166.101,"e":169.04,"text":"Two years old—she can’t see it today,"},{"s":169.04,"e":172.714,"text":"All of the wonderful waiting her way."},{"s":172.714,"e":175.653,"text":"First days of school, first dreams she’ll pursue,"},{"s":175.653,"e":178.959,"text":"First time she learns, *“I can make it through.”*"},{"s":178.959,"e":183.001,"text":"And years from this birthday, wherever she goes,"},{"s":183.001,"e":186.674,"text":"May she remember the love where she rose."},{"s":186.674,"e":191.083,"text":"A little girl glowing, surrounded by smiles—"},{"s":191.083,"e":195.492,"text":"With a whole life of wonder stretching for miles."},{"s":195.492,"e":198.431,"text":"**Myla, shine on, shine strong, shine bright,**"},{"s":198.431,"e":202.104,"text":"Carry your courage straight into the night."},{"s":202.104,"e":205.411,"text":"Dream without shrinking, love without fear,"},{"s":205.411,"e":208.717,"text":"Know you are wanted, know you are dear."},{"s":208.717,"e":211.656,"text":"**Myla, grow wild, grow wise, grow free,**"},{"s":211.656,"e":216.065,"text":"Become every beautiful thing you can be."},{"s":216.065,"e":219.371,"text":"Strong in your spirit, proud in your name—"},{"s":219.371,"e":223.045,"text":"Beautiful Myla, keep lighting the flame."},{"s":223.045,"e":224.882,"text":"Two little candles…"},{"s":224.882,"e":227.086,"text":"A lifetime to go."},{"s":227.086,"e":228.923,"text":"Myla, keep shining—"},{"s":228.923,"e":230.76,"text":"And watch how you grow."}],"duration":231.84,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.132Z","realignedFrom":"whisper-aligned","vocalStart":0.78,"vocalEnd":230.76}