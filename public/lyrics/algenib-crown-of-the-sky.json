.75,"line":64},{"w":"will","s":250.75,"e":251.23,"line":64},{"w":"still","s":251.23,"e":251.65,"line":64},{"w":"be","s":251.65,"e":252.19,"line":64},{"w":"bright","s":252.19,"e":252.89,"line":64},{"w":"with","s":252.89,"e":253.27,"line":64},{"w":"Algenib.","s":260.45,"e":261.21,"line":64},{"w":"Algenib…","s":261.35,"e":261.69,"line":65},{"w":"Flame","s":261.69,"e":262.07,"line":66},{"w":"of","s":262.07,"e":262.35,"line":66},{"w":"the","s":262.35,"e":263.29,"line":66},{"w":"heavens…","s":263.29,"e":263.39,"line":66},{"w":"Shoulder","s":263.39,"e":264.01,"line":67},{"w":"of","s":264.01,"e":264.49,"line":67},{"w":"Pegasus…","s":264.49,"e":265.05,"line":67},{"w":"Carry","s":265.09,"e":265.61,"line":68},{"w":"us","s":265.61,"e":266.39,"line":68},{"w":"higher.","s":266.39,"e":266.69,"line":68},{"w":"Algenib…","s":275.91,"e":276.57,"line":69},{"w":"Algenib…","s":277.07,"e":280.03,"line":70},{"w":"Algenib…","s":280.41,"e":281.07,"line":71}],"lines":[{"s":6.18,"e":7.58,"text":"Algenib…"},{"s":7.58,"e":12.12,"text":"Bright shoulder of the heavens,"},{"s":13.48,"e":17.7,"text":"Burning where the winged horse rises—"},{"s":20.6,"e":24.5,"text":"We lift our eyes."},{"s":42,"e":45.06,"text":"Before the city wakes, before the morning breathes,"},{"s":45.1,"e":48.56,"text":"You blaze above the silence like a fire through the trees."},{"s":49.28,"e":52.02,"text":"Blue-white throne of wonder, ancient light alive,"},{"s":52.28,"e":55.48,"text":"A royal flame commanding every dreamer to arise."},{"s":55.48,"e":58.86,"text":"I walked beneath the darkness with the doubt around my feet,"},{"s":58.86,"e":62.24,"text":"Then your signal split the shadows, made the broken rhythm beat."},{"s":62.48,"e":66.38,"text":"No chain could hold the spirit, no night could hide the way,"},{"s":66.38,"e":69.4,"text":"Algenib, you crowned the clouds and turned my fear to faith."},{"s":70.58,"e":73.74,"text":"Higher, higher, let the whole world see,"},{"s":73.82,"e":76.86,"text":"There is power in the heavens pouring endlessly."},{"s":77.9,"e":80.64,"text":"Brighter, brighter, every heart ignite,"},{"s":80.72,"e":84.18,"text":"We are children of the starlight, marching through the night."},{"s":84.18,"e":87.8,"text":"All hail Algenib, crown of the sky,"},{"s":87.9,"e":91.16,"text":"Blue flame burning where the angels fly."},{"s":91.42,"e":94.6,"text":"We raise our hands, we raise our sound,"},{"s":94.84,"e":98.04,"text":"Your ancient glory shakes the ground."},{"s":98.52,"e":101.72,"text":"Algenib, Algenib, lead us above,"},{"s":101.78,"e":105.24,"text":"Through endless space, through infinite love."},{"s":105.44,"e":108.32,"text":"When all the lesser lights grow dim,"},{"s":108.48,"e":112.37,"text":"We lift our souls and sing to Algenib."},{"s":112.37,"e":116.31,"text":"On the shoulder of Pegasus, you guard the cosmic gate,"},{"s":116.59,"e":120.01,"text":"A diamond in the distance that refuses to obey fate."},{"s":120.09,"e":123.13,"text":"You watched the kings and kingdoms, watched the centuries unfold,"},{"s":123.25,"e":126.67,"text":"Still your fire keeps on speaking in a language made of gold."},{"s":126.93,"e":129.97,"text":"Teach us how to blaze on, teach us how to stand,"},{"s":130.03,"e":133.41,"text":"To carry heaven’s courage through the weakness of the land."},{"s":133.49,"e":136.37,"text":"We will win with grace and honor, we will rise without disguise,"},{"s":137.03,"e":140.21,"text":"With elite light in our spirit and your beacon in our eyes."},{"s":140.17,"e":143.27,"text":"Higher, higher, let the whole world see,"},{"s":143.31,"e":146.63,"text":"There is power in the heavens pouring endlessly."},{"s":147.29,"e":150.13,"text":"Brighter, brighter, every heart ignite,"},{"s":150.23,"e":153.69,"text":"We are children of the starlight, marching through the night."},{"s":154.03,"e":157.39,"text":"All hail Algenib, crown of the sky,"},{"s":157.59,"e":160.59,"text":"Blue flame burning where the angels fly."},{"s":160.87,"e":164.03,"text":"We raise our hands, we raise our sound,"},{"s":164.31,"e":167.57,"text":"Your ancient glory shakes the ground."},{"s":167.57,"e":170.63,"text":"Algenib, Algenib, lead us above,"},{"s":171.35,"e":174.65,"text":"Through endless space, through infinite love."},{"s":174.71,"e":177.85,"text":"When all the lesser lights grow dim,"},{"s":177.97,"e":181.87,"text":"We lift our souls and sing to Algenib."},{"s":182.25,"e":183.79,"text":"You are the spark in the sacred machine,"},{"s":183.89,"e":185.51,"text":"The brilliant code in the spaces between."},{"s":185.61,"e":187.35,"text":"The pulse in the planet, the praise in the drum,"},{"s":187.35,"e":189.23,"text":"The sign that the greatest is still yet to come."},{"s":189.41,"e":190.87,"text":"Yes to the journey, yes to the climb,"},{"s":190.99,"e":192.59,"text":"Yes to the victory written in light."},{"s":192.75,"e":194.27,"text":"Win in the spirit, win in the soul,"},{"s":194.43,"e":195.97,"text":"Win with compassion and conquer the cold."},{"s":195.97,"e":199.61,"text":"No fear, no fall, no fading away,"},{"s":199.93,"e":203.11,"text":"We blaze like Algenib, day after day."},{"s":203.19,"e":206.65,"text":"Love is the power, the stars are the hymn,"},{"s":206.67,"e":211.25,"text":"The universe opens when we sing to Him—"},{"s":217.71,"e":218.71,"text":"Algenib!"},{"s":218.71,"e":229.95,"text":"All hail Algenib, crown of the sky,"},{"s":230.05,"e":233.27,"text":"Blue flame burning, forever alive."},{"s":233.93,"e":236.51,"text":"We raise our hands, we raise our sound,"},{"s":236.81,"e":239.91,"text":"Your stellar thunder shakes the ground."},{"s":239.91,"e":243.39,"text":"Algenib, Algenib, lead us above,"},{"s":243.61,"e":246.93,"text":"Through endless space, through infinite love."},{"s":247.01,"e":250.05,"text":"When every earthly light grows dim,"},{"s":250.21,"e":261.21,"text":"Our hearts will still be bright with Algenib."},{"s":261.35,"e":261.69,"text":"Algenib…"},{"s":261.69,"e":263.39,"text":"Flame of the heavens…"},{"s":263.39,"e":265.05,"text":"Shoulder of Pegasus…"},{"s":265.09,"e":266.69,"text":"Carry us higher."},{"s":275.91,"e":276.57,"text":"Algenib…"},{"s":277.07,"e":280.03,"text":"Algenib…"},{"s":280.41,"e":281.07,"text":"Algenib…"}],"duration":283.32,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.472Z","stats":{"whisperWords":568,"polishedWords":512,"matched":475,"matchRate":0.928}}