"e":252.16,"line":79},{"w":"bright","s":252.16,"e":252.92,"line":79},{"w":"with","s":260.06,"e":261.02,"line":79},{"w":"Algenib.","s":261.02,"e":261.22,"line":79},{"w":"Algenib…","s":261.3,"e":261.66,"line":81},{"w":"Flame","s":261.66,"e":262.06,"line":82},{"w":"of","s":262.06,"e":262.38,"line":82},{"w":"the","s":262.38,"e":263.24,"line":82},{"w":"heavens…","s":263.24,"e":263.32,"line":82},{"w":"Shoulder","s":263.24,"e":264.14,"line":83},{"w":"of","s":264.14,"e":264.34,"line":83},{"w":"Pegasus…","s":264.34,"e":265.08,"line":83},{"w":"Carry","s":265.14,"e":265.7,"line":84},{"w":"us","s":265.7,"e":266.06,"line":84},{"w":"higher.","s":266.06,"e":266.78,"line":84},{"w":"Algenib…","s":275.16,"e":276.94,"line":86},{"w":"Algenib…","s":278.7,"e":280.1,"line":87},{"w":"Algenib…","s":280.88,"e":281.78,"line":88}],"lines":[{"s":6.18,"e":7.58,"text":"Algenib…"},{"s":7.58,"e":12.12,"text":"Bright shoulder of the heavens,"},{"s":12.22,"e":17.7,"text":"Burning where the winged horse rises—"},{"s":41.38,"e":42.2,"text":"We lift our eyes."},{"s":42.12,"e":42.62,"text":""},{"s":42.12,"e":45.06,"text":"Before the city wakes, before the morning breathes,"},{"s":45.06,"e":48.54,"text":"You blaze above the silence like a fire through the trees."},{"s":48.96,"e":52.02,"text":"Blue-white throne of wonder, ancient light alive,"},{"s":52.02,"e":55.46,"text":"A royal flame commanding every dreamer to arise."},{"s":55.46,"e":55.96,"text":""},{"s":55.46,"e":58.82,"text":"I walked beneath the darkness with the doubt around my feet,"},{"s":58.74,"e":62.26,"text":"Then your signal split the shadows, made the broken rhythm beat."},{"s":62.26,"e":65.96,"text":"No chain could hold the spirit, no night could hide the way,"},{"s":65.88,"e":69.68,"text":"Algenib, you crowned the clouds and turned my fear to faith."},{"s":69.68,"e":70.18,"text":""},{"s":70.48,"e":73.74,"text":"Higher, higher, let the whole world see,"},{"s":73.74,"e":77.04,"text":"There is power in the heavens pouring endlessly."},{"s":77.66,"e":80.64,"text":"Brighter, brighter, every heart ignite,"},{"s":80.64,"e":84.18,"text":"We are children of the starlight, marching through the night."},{"s":84.18,"e":84.68,"text":""},{"s":84.44,"e":87.76,"text":"All hail Algenib, crown of the sky,"},{"s":87.76,"e":90.94,"text":"Blue flame burning where the angels fly."},{"s":91.36,"e":94.62,"text":"We raise our hands, we raise our sound,"},{"s":94.62,"e":98.06,"text":"Your ancient glory shakes the ground."},{"s":98.06,"e":98.56,"text":""},{"s":98.06,"e":101.72,"text":"Algenib, Algenib, lead us above,"},{"s":101.72,"e":105.26,"text":"Through endless space, through infinite love."},{"s":105.26,"e":108.3,"text":"When all the lesser lights grow dim,"},{"s":108.3,"e":112.84,"text":"We lift our souls and sing to Algenib."},{"s":112.84,"e":113.34,"text":""},{"s":112.84,"e":116.18,"text":"On the shoulder of Pegasus, you guard the cosmic gate,"},{"s":116.18,"e":120.02,"text":"A diamond in the distance that refuses to obey fate."},{"s":120.02,"e":123.16,"text":"You watched the kings and kingdoms, watched the centuries unfold,"},{"s":123.16,"e":126.7,"text":"Still your fire keeps on speaking in a language made of gold."},{"s":126.7,"e":127.2,"text":""},{"s":126.7,"e":129.98,"text":"Teach us how to blaze on, teach us how to stand,"},{"s":129.98,"e":133.44,"text":"To carry heaven's courage through the weakness of the land."},{"s":133.44,"e":136.38,"text":"We will win with grace and honor, we will rise without disguise,"},{"s":136.92,"e":140.22,"text":"With elite light in our spirit and your beacon in our eyes."},{"s":140.22,"e":140.72,"text":""},{"s":140.22,"e":143.26,"text":"Higher, higher, let the whole world see,"},{"s":143.26,"e":146.26,"text":"There is power in the heavens pouring endlessly."},{"s":146.88,"e":150.14,"text":"Brighter, brighter, every heart ignite,"},{"s":150.14,"e":153.68,"text":"We are children of the starlight, marching through the night."},{"s":153.68,"e":154.18,"text":""},{"s":153.68,"e":157.4,"text":"All hail Algenib, crown of the sky,"},{"s":157.4,"e":160.66,"text":"Blue flame burning where the angels fly."},{"s":160.66,"e":164.02,"text":"We raise our hands, we raise our sound,"},{"s":164.02,"e":167.56,"text":"Your ancient glory shakes the ground."},{"s":167.56,"e":168.06,"text":""},{"s":167.56,"e":171.16,"text":"Algenib, Algenib, lead us above,"},{"s":171.16,"e":174.64,"text":"Through endless space, through infinite love."},{"s":174.64,"e":177.86,"text":"When all the lesser lights grow dim,"},{"s":177.86,"e":181.88,"text":"We lift our souls and sing to Algenib."},{"s":181.88,"e":182.38,"text":""},{"s":181.92,"e":183.78,"text":"You are the spark in the sacred machine,"},{"s":183.78,"e":185.52,"text":"The brilliant code in the spaces between."},{"s":185.52,"e":187.34,"text":"The pulse in the planet, the praise in the drum,"},{"s":187.26,"e":189.14,"text":"The sign that the greatest is still yet to come."},{"s":189.12,"e":189.62,"text":""},{"s":189.12,"e":190.88,"text":"Yes to the journey, yes to the climb,"},{"s":190.88,"e":192.6,"text":"Yes to the victory written in light."},{"s":192.6,"e":194.28,"text":"Win in the spirit, win in the soul,"},{"s":194.28,"e":196,"text":"Win with compassion and conquer the cold."},{"s":196,"e":196.5,"text":""},{"s":196,"e":199.56,"text":"No fear, no fall, no fading away,"},{"s":199.56,"e":202.91,"text":"We blaze like Algenib, day after day."},{"s":203.1,"e":206.52,"text":"Love is the power, the stars are the hymn,"},{"s":206.48,"e":211.96,"text":"The universe opens when we sing to Him—"},{"s":221.2,"e":221.28,"text":"Algenib!"},{"s":221.26,"e":221.76,"text":""},{"s":221.26,"e":229.83,"text":"All hail Algenib, crown of the sky,"},{"s":229.94,"e":232.77,"text":"Blue flame burning, forever alive."},{"s":233.26,"e":236.52,"text":"We raise our hands, we raise our sound,"},{"s":236.52,"e":239.92,"text":"Your stellar thunder shakes the ground."},{"s":239.92,"e":240.42,"text":""},{"s":239.92,"e":243.38,"text":"Algenib, Algenib, lead us above,"},{"s":243.38,"e":246.88,"text":"Through endless space, through infinite love."},{"s":246.88,"e":250.06,"text":"When every earthly light grows dim,"},{"s":250.06,"e":261.22,"text":"Our hearts will still be bright with Algenib."},{"s":261.22,"e":261.72,"text":""},{"s":261.3,"e":261.66,"text":"Algenib…"},{"s":261.66,"e":263.32,"text":"Flame of the heavens…"},{"s":263.24,"e":265.08,"text":"Shoulder of Pegasus…"},{"s":265.14,"e":266.78,"text":"Carry us higher."},{"s":266.78,"e":267.28,"text":""},{"s":275.16,"e":276.94,"text":"Algenib…"},{"s":278.7,"e":280.1,"text":"Algenib…"},{"s":280.88,"e":281.78,"text":"Algenib…"}],"duration":283.32,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.432Z","stats":{"whisperWords":535,"polishedWords":512,"matched":474,"matchRate":0.926}}