do","s":206.24,"e":206.658,"line":54},{"w":"Is","s":206.658,"e":207.076,"line":55},{"w":"live","s":207.076,"e":207.494,"line":55},{"w":"like","s":207.494,"e":207.912,"line":55},{"w":"tomorrow","s":207.912,"e":209.166,"line":55},{"w":"is","s":209.166,"e":209.584,"line":55},{"w":"watching","s":209.584,"e":210.42,"line":55},{"w":"you.","s":210.42,"e":210.838,"line":55},{"w":"Small","s":210.838,"e":211.256,"line":56},{"w":"steps,","s":211.256,"e":211.674,"line":56},{"w":"bright","s":211.674,"e":212.092,"line":56},{"w":"flame,","s":212.092,"e":212.51,"line":56},{"w":"Real","s":212.51,"e":212.928,"line":57},{"w":"love,","s":212.928,"e":213.346,"line":57},{"w":"good","s":213.346,"e":213.764,"line":57},{"w":"name.","s":213.764,"e":214.182,"line":57},{"w":"One","s":214.182,"e":214.6,"line":58},{"w":"life,","s":214.6,"e":215.018,"line":58},{"w":"made","s":215.018,"e":215.436,"line":58},{"w":"new—","s":215.436,"e":215.854,"line":58},{"w":"Tomorrow","s":215.854,"e":217.108,"line":59},{"w":"is","s":217.108,"e":217.526,"line":59},{"w":"watching","s":217.526,"e":218.362,"line":59},{"w":"you.","s":218.362,"e":218.78,"line":59}],"lines":[{"s":9.36,"e":12.704,"text":"Wake up slow, put the phone on mute,"},{"s":12.704,"e":16.466,"text":"Sun in the window, tie up your shoes."},{"s":16.466,"e":20.646,"text":"Walk like your future is calling your name,"},{"s":20.646,"e":24.408,"text":"Lift what is heavy, let weakness change."},{"s":24.408,"e":27.752,"text":"Drink clean water, eat from the earth,"},{"s":27.752,"e":31.096,"text":"Count real friends like infinite worth."},{"s":31.096,"e":35.276,"text":"Less poison, more peace, less noise in the room,"},{"s":35.276,"e":38.62,"text":"Plant good habits and watch them bloom."},{"s":38.62,"e":41.128,"text":"The smartest thing ain’t loud,"},{"s":41.128,"e":44.472,"text":"It’s a little thing repeated."},{"s":44.472,"e":46.98,"text":"A quiet seed in the ground,"},{"s":46.98,"e":50.324,"text":"Till the whole life gets completed."},{"s":50.324,"e":53.668,"text":"Sleep like a king, move like you’re free,"},{"s":53.668,"e":57.848,"text":"Love like the wealth is the people you see."},{"s":57.848,"e":61.192,"text":"Save what you can, learn what you don’t,"},{"s":61.192,"e":64.955,"text":"Say what you mean, let go what you won’t."},{"s":64.955,"e":68.717,"text":"Give to the poor, forgive what you can,"},{"s":68.717,"e":72.897,"text":"Build with your hands, become a better man."},{"s":72.897,"e":76.241,"text":"The smartest thing you’ll ever do"},{"s":76.241,"e":80.421,"text":"Is live like tomorrow is watching you."},{"s":80.421,"e":85.019,"text":"Stack up the dollars before they are needed,"},{"s":85.019,"e":89.617,"text":"Compound the good till the dark is defeated."},{"s":89.617,"e":92.543,"text":"Read one page, then write one line,"},{"s":92.543,"e":95.469,"text":"Skill by skill, you sharpen time."},{"s":95.469,"e":98.813,"text":"Don’t chase every shiny thing,"},{"s":98.813,"e":102.575,"text":"Guard your focus like a wedding ring."},{"s":102.575,"e":105.501,"text":"One clean task, one honest prayer,"},{"s":105.501,"e":108.845,"text":"One deep breath in the midnight air."},{"s":108.845,"e":111.353,"text":"The smartest thing ain’t fast,"},{"s":111.353,"e":114.279,"text":"It’s steady through the weather."},{"s":114.279,"e":116.787,"text":"You don’t outrun the past,"},{"s":116.787,"e":119.713,"text":"You build a road that’s better."},{"s":119.713,"e":123.057,"text":"Sleep like a king, move like you’re free,"},{"s":123.057,"e":127.237,"text":"Love like the wealth is the people you see."},{"s":127.237,"e":130.581,"text":"Save what you can, learn what you don’t,"},{"s":130.581,"e":134.343,"text":"Say what you mean, let go what you won’t."},{"s":134.343,"e":138.105,"text":"Give to the poor, forgive what you can,"},{"s":138.105,"e":142.285,"text":"Build with your hands, become a better man."},{"s":142.285,"e":145.629,"text":"The smartest thing you’ll ever do"},{"s":145.629,"e":149.809,"text":"Is live like tomorrow is watching you."},{"s":149.809,"e":153.153,"text":"Call your mother, feed a stranger,"},{"s":153.153,"e":156.497,"text":"Know your limits, sense the danger."},{"s":156.497,"e":159.423,"text":"Choose your circle, choose your aim,"},{"s":159.423,"e":162.349,"text":"Choose the fire, not just the flame."},{"s":162.349,"e":167.784,"text":"Gratitude in a notebook, silence in the storm,"},{"s":167.784,"e":172.382,"text":"Purpose in the service, shelter in the warm."},{"s":172.382,"e":175.726,"text":"Every day you practice peace,"},{"s":175.726,"e":180.742,"text":"Another chain falls, another soul released."},{"s":180.742,"e":184.086,"text":"Sleep like a king, move like you’re free,"},{"s":184.086,"e":188.266,"text":"Love like the wealth is the people you see."},{"s":188.266,"e":191.61,"text":"Save what you can, learn what you don’t,"},{"s":191.61,"e":195.372,"text":"Say what you mean, let go what you won’t."},{"s":195.372,"e":199.134,"text":"Give to the poor, forgive what you can,"},{"s":199.134,"e":203.314,"text":"Build with your hands, become a better man."},{"s":203.314,"e":206.658,"text":"The smartest thing you’ll ever do"},{"s":206.658,"e":210.838,"text":"Is live like tomorrow is watching you."},{"s":210.838,"e":212.51,"text":"Small steps, bright flame,"},{"s":212.51,"e":214.182,"text":"Real love, good name."},{"s":214.182,"e":215.854,"text":"One life, made new—"},{"s":215.854,"e":218.78,"text":"Tomorrow is watching you."}],"duration":219.92,"source":"curated-realigned","generatedAt":"2026-08-21T01:15:14.853Z","realignedFrom":"curated-realigned","vocalStart":9.36,"vocalEnd":218.78}