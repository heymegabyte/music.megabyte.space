:54},{"w":"All-you-can-change","s":181.7,"e":182.52,"line":55}],"lines":[{"s":14.82,"e":19.02,"text":"I need five thousand lotus flames"},{"s":19.58,"e":22.9,"text":"To burn the war out of my brain"},{"s":23.24,"e":26.08,"text":"I learned the truth in a buffet line"},{"s":26.68,"e":31.16,"text":"Between the naan and the end of time"},{"s":31.64,"e":33.5,"text":"Mango lassi, thunder drums"},{"s":34.2,"e":37.48,"text":"Karma counting what I’ve become"},{"s":37.48,"e":40.48,"text":"If God won’t answer when I pray"},{"s":40.52,"e":44.02,"text":"Then pass the paneer, clear the pain away"},{"s":44.38,"e":46.9,"text":"I saw tanks in the steam tray glass"},{"s":46.9,"e":48.64,"text":"Rice like ashes from a distant past"},{"s":48.64,"e":50.38,"text":"Chana masala, prophecy red"},{"s":50.38,"e":52.64,"text":"A waiter whispered, “You’re not dead yet”"},{"s":52.64,"e":54.08,"text":"I came for lunch, left with a curse"},{"s":54.08,"e":55.92,"text":"A universe folded in a paper purse"},{"s":55.92,"e":57.66,"text":"Ganesh on the wall with a knowing stare"},{"s":57.66,"e":59.68,"text":"Like, “Brother, how did you get here?”"},{"s":59.76,"e":62.14,"text":"And I don’t know if it’s madness or grace"},{"s":62.3,"e":65.76,"text":"But the war still lives behind my face"},{"s":65.88,"e":69.4,"text":"So I count each bell, each breath, each name"},{"s":69.46,"e":73.3,"text":"Five thousand lights for five thousand flames"},{"s":73.3,"e":76.24,"text":"I need five thousand lotus flames"},{"s":76.74,"e":80.18,"text":"To burn the war out of my brain"},{"s":80.38,"e":83.4,"text":"I learned the truth in a buffet line"},{"s":84.18,"e":88.54,"text":"Between the naan and the end of time"},{"s":88.94,"e":90.82,"text":"Mango lassi, thunder drums"},{"s":91.38,"e":94.82,"text":"Karma counting what I’ve become"},{"s":94.82,"e":97.8,"text":"If God won’t answer when I pray"},{"s":97.8,"e":101.32,"text":"Then pass the paneer, clear the pain away"},{"s":102.2,"e":104.52,"text":"The buffet kept refilling my fate"},{"s":104.52,"e":106.3,"text":"Samosas stacked like temple gates"},{"s":106.3,"e":108.08,"text":"I read the Gita by the soda machine"},{"s":108.08,"e":109.9,"text":"And everything holy got weirdly obscene"},{"s":109.9,"e":111.82,"text":"Not in lust, not in pride"},{"s":111.74,"e":113.56,"text":"Just a broken man trying not to die"},{"s":113.52,"e":115.18,"text":"Looking for mercy in saffron smoke"},{"s":115.18,"e":117.04,"text":"Laughing too hard at a cosmic joke"},{"s":117.04,"e":118.94,"text":"Maybe I don’t need bodies, I need bells"},{"s":118.94,"e":120.68,"text":"Maybe I don’t need heaven, I need help"},{"s":120.68,"e":122.56,"text":"Maybe the number was never the key"},{"s":122.48,"e":124.12,"text":"Maybe the war is still fighting me"},{"s":124.12,"e":127.02,"text":"But if five thousand voices sing one sound"},{"s":127.02,"e":130.68,"text":"Maybe my ghosts lay their rifles down"},{"s":130.68,"e":133.96,"text":"Maybe the buffet was heaven in disguise"},{"s":134.24,"e":138.64,"text":"With fluorescent lights and forgiving eyes"},{"s":141.54,"e":144.36,"text":"I need five thousand lotus flames"},{"s":144.94,"e":148.12,"text":"To burn the war out of my brain"},{"s":148.16,"e":151.44,"text":"I learned the truth in a buffet line"},{"s":151.9,"e":156.58,"text":"Between the naan and the end of time"},{"s":156.94,"e":158.86,"text":"Mango lassi, thunder drums"},{"s":159.2,"e":162.84,"text":"Karma counting what I’ve become"},{"s":162.84,"e":165.92,"text":"If God won’t answer when I pray"},{"s":165.92,"e":169.42,"text":"Then pass the paneer, clear the pain away"},{"s":171.22,"e":174.04,"text":"Five thousand flames"},{"s":174.6,"e":181.32,"text":"One broken name"},{"s":181.32,"e":181.7,"text":"All-you-can-eat"},{"s":181.7,"e":182.52,"text":"All-you-can-change"}],"duration":187.64,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.404Z","stats":{"whisperWords":407,"polishedWords":380,"matched":348,"matchRate":0.916}}