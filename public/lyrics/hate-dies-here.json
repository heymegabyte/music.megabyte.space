80.12,"line":122},{"w":"chain","s":280.12,"e":280.9,"line":123},{"w":"breaks,","s":280.9,"e":281.32,"line":123},{"w":"hearts","s":281.54,"e":282.14,"line":123},{"w":"change—","s":282.14,"e":283.14,"line":123},{"w":"Not","s":283.8,"e":284.02,"line":124},{"w":"tomorrow.","s":284.02,"e":284.56,"line":124},{"w":"Not","s":284.82,"e":285.46,"line":125},{"w":"someday.","s":285.46,"e":286.16,"line":125},{"w":"Right","s":286.98,"e":287.46,"line":126},{"w":"here.","s":287.46,"e":287.7,"line":126},{"w":"No","s":287.74,"e":288.06,"line":127},{"w":"forwarding","s":288.06,"e":288.72,"line":127},{"w":"address.","s":288.72,"e":289.24,"line":127},{"w":"No","s":289.38,"e":289.9,"line":128},{"w":"next","s":289.9,"e":290.36,"line":128},{"w":"generation.","s":290.36,"e":291.14,"line":128},{"w":"No","s":291.36,"e":292.06,"line":129},{"w":"encore.","s":292.06,"e":292.94,"line":129},{"w":"Let","s":293.62,"e":294.28,"line":130},{"w":"that","s":294.28,"e":294.62,"line":130},{"w":"hatred","s":294.62,"e":294.76,"line":130},{"w":"hit","s":294.76,"e":295.04,"line":130},{"w":"the","s":295.04,"e":295.52,"line":130},{"w":"floor—","s":295.52,"e":295.6,"line":130},{"w":"**and","s":295.52,"e":296.6,"line":131},{"w":"die","s":296.6,"e":297.02,"line":131},{"w":"here.**","s":303.14,"e":303.46,"line":131}],"lines":[{"s":0,"e":2,"text":"# HATE DIES HERE"},{"s":2,"e":2.5,"text":"**[Intro]**"},{"s":2.02,"e":4.28,"text":"Yeah—"},{"s":7.78,"e":9.38,"text":"Bring that bitterness to the border,"},{"s":10.92,"e":13.38,"text":"bring that venom to the venue,"},{"s":14.88,"e":18.5,"text":"bring that poison to the pavement—"},{"s":18.68,"e":21.7,"text":"it ain’t passin’ through."},{"s":30.96,"e":33.16,"text":"**Hate dies here.**"},{"s":33.16,"e":33.66,"text":"**[Verse 1]**"},{"s":36.32,"e":39.08,"text":"They been passin’ down pain like a family name,"},{"s":39.24,"e":41.66,"text":"same small spite in a brand-new frame,"},{"s":41.9,"e":44.26,"text":"same cheap shots, same blame-game flame,"},{"s":44.32,"e":46.96,"text":"whole bloodline burnin’ and nobody changed."},{"s":47.06,"e":49.5,"text":"Nah, not me—I’m breakin’ that chain,"},{"s":49.6,"e":52.1,"text":"cut that cord, let compassion reign,"},{"s":52.1,"e":54.72,"text":"you can bark that bias, broadcast blame,"},{"s":54.72,"e":57.56,"text":"I won’t let your poison get packed in my veins."},{"s":58,"e":60.02,"text":"Big-mouth bully with a bargain-bin grudge,"},{"s":60.28,"e":62.66,"text":"talkin’ real tough but your heart won’t budge,"},{"s":62.74,"e":65.12,"text":"judgin’ whole lives off a look and a label,"},{"s":65.12,"e":67.72,"text":"bro, that weak little worldview barely stays stable."},{"s":67.78,"e":70.14,"text":"You can spit that slick disrespect for clout,"},{"s":70.48,"e":72.7,"text":"hate gets hungry when you hand it a route."},{"s":72.8,"e":75.46,"text":"So I shut that shit down, no scenic detour—"},{"s":75.52,"e":76.86,"text":"you brought hate to my gate?"},{"s":76.86,"e":78.48,"text":"It don’t leave here anymore."},{"s":78.48,"e":78.98,"text":"**[Pre-Chorus]**"},{"s":78.58,"e":81.48,"text":"No pass, no platform, no place in my crew,"},{"s":81.48,"e":84.06,"text":"no recycled rage gettin’ routed on through."},{"s":84.06,"e":86.76,"text":"If somebody taught you everybody’s your foe,"},{"s":86.76,"e":88.16,"text":"you can unlearn that garbage—"},{"s":88.3,"e":88.88,"text":"we grow."},{"s":88.88,"e":89.38,"text":"**[Chorus]**"},{"s":89.08,"e":89.94,"text":"**HATE DIES HERE.**"},{"s":90.1,"e":91.9,"text":"Yeah, the line gets drawn right here."},{"s":91.9,"e":94.52,"text":"All that fear dressed tough disappears right here."},{"s":94.88,"e":97.04,"text":"Bring that venom, that vicious veneer—"},{"s":97.04,"e":98.64,"text":"but the buck stops, bruh—"},{"s":98.74,"e":100.38,"text":"**HATE DIES HERE.**"},{"s":100.32,"e":102.94,"text":"No hand-me-down hatred, no heirloom fear,"},{"s":102.94,"e":105.56,"text":"no “my people versus yours” in another kid’s ear."},{"s":105.52,"e":108.16,"text":"We ain’t sendin’ that sickness to another damn year—"},{"s":108.2,"e":109.7,"text":"chain breaks, game changes—"},{"s":109.7,"e":109.78,"text":"**HATE DIES HERE.**"},{"s":109.7,"e":110.2,"text":"**[Verse 2]**"},{"s":109.7,"e":113.42,"text":"Hate loves hype, hashtags, heat,"},{"s":113.42,"e":115.48,"text":"half-truth headlines on a hundred feeds,"},{"s":115.94,"e":118.02,"text":"quick-click conflict, comment-section carnage,"},{"s":118.08,"e":120.58,"text":"everybody actin’ savage like compassion ain’t solid."},{"s":120.68,"e":123.22,"text":"Nah, fam—kindness got backbone too,"},{"s":123.26,"e":126.3,"text":"mercy ain’t soft when the mob wants blood from you."},{"s":126.3,"e":129.08,"text":"Takes guts to go, “Nah, I ain’t hatin’ that dude"},{"s":129.08,"e":131.54,"text":"just ’cause somebody viral said that’s what we do.”"},{"s":131.54,"e":134.5,"text":"I seen slick little slurs turn friends into factions,"},{"s":134.62,"e":137.16,"text":"one dumb word turn hurt into actions."},{"s":137.38,"e":139.68,"text":"Words got weight, every phrase got traction—"},{"s":139.76,"e":142.26,"text":"mouth move first, then the whole world fractures."},{"s":142.34,"e":144.6,"text":"So check that chatter before chatter checks you,"},{"s":144.62,"e":147.32,"text":"before disrespect becomes what they expect you to do."},{"s":147.32,"e":149.92,"text":"You ain’t gotta inherit every ignorant view—"},{"s":150.28,"e":150.88,"text":"old-school hatred?"},{"s":150.94,"e":152.6,"text":"We makin’ that obsolete too."},{"s":152.6,"e":154.48,"text":"Yeah, the line gets drawn right here."},{"s":154.48,"e":157.18,"text":"All that fear dressed tough disappears right here."},{"s":157.76,"e":159.64,"text":"Bring that venom, that vicious veneer—"},{"s":159.64,"e":161.38,"text":"but the buck stops, bruh—"},{"s":161.36,"e":162.98,"text":"**HATE DIES HERE.**"},{"s":163,"e":165.56,"text":"No hand-me-down hatred, no heirloom fear,"},{"s":165.56,"e":168.18,"text":"no “my people versus yours” in another kid’s ear."},{"s":168.2,"e":170.74,"text":"We ain’t sendin’ that sickness to another damn year—"},{"s":170.82,"e":172.32,"text":"chain breaks, game changes—"},{"s":172.32,"e":173.38,"text":"**HATE DIES HERE.**"},{"s":173.38,"e":173.88,"text":"**[Verse 3]**"},{"s":173.44,"e":175.32,"text":"I don’t need everybody thinkin’ like me,"},{"s":175.48,"e":178.12,"text":"same faith, same face, same flag, same scene."},{"s":178.18,"e":180.58,"text":"Difference ain’t danger, disagreement ain’t beef,"},{"s":180.6,"e":183.08,"text":"we can clash on the facts without crushin’ somebody’s peace."},{"s":183.08,"e":185.82,"text":"That’s grown-man energy, grown-woman grace,"},{"s":185.86,"e":188.44,"text":"say what you mean without dehumanizin’ a face."},{"s":188.8,"e":191.04,"text":"Real ones reason, weak ones rage—"},{"s":191.1,"e":193.84,"text":"I’d rather build one bridge than burn ten stages."},{"s":194.04,"e":196.5,"text":"Black, white, brown, rich, broke, strange,"},{"s":196.7,"e":199.14,"text":"pray different prayers, talk different slang—"},{"s":199.2,"e":201.48,"text":"everybody got somebody they’d die to defend,"},{"s":201.6,"e":204.08,"text":"everybody been shattered, everybody gotta mend."},{"s":204.08,"e":206.66,"text":"So miss me with the “us versus them” gimmick,"},{"s":206.66,"e":209.24,"text":"that dusty division got a tired-ass limit."},{"s":209.26,"e":212.42,"text":"We can disagree heavy and still keep dignity in it—"},{"s":212.38,"e":213.5,"text":"that’s strength, my guy."},{"s":213.56,"e":214.94,"text":"Put some humanity in it."},{"s":214.94,"e":215.44,"text":"**[Bridge]**"},{"s":215.44,"e":218.16,"text":"My father’s fear doesn’t have to be mine."},{"s":218.18,"e":220.66,"text":"My mother’s wounds don’t determine my mind."},{"s":220.7,"e":223.12,"text":"My neighborhood’s anger don’t own my design."},{"s":223.18,"e":224.66,"text":"I can love my own people"},{"s":224.66,"e":226.66,"text":"without hatin’ your kind."},{"s":226.66,"e":229.2,"text":"If hate came knockin’ before I was born,"},{"s":229.22,"e":231.88,"text":"I can still be the house where the habit gets torn."},{"s":231.92,"e":234.56,"text":"I can be the last link, last lie, last thorn—"},{"s":234.58,"e":236.28,"text":"turn generational grief"},{"s":236.28,"e":238.56,"text":"into a different dawn."},{"s":238.56,"e":239.06,"text":"**[Breakdown]**"},{"s":239.74,"e":240.84,"text":"Who taught you hate?"},{"s":241.34,"e":242.76,"text":"Who made you scared?"},{"s":242.78,"e":243.66,"text":"Who got paid"},{"s":244.04,"e":245.64,"text":"every time you stared"},{"s":245.72,"e":248.16,"text":"at another human like they shouldn’t be there?"},{"s":248.58,"e":249.98,"text":"Nah. Look again."},{"s":249.98,"e":251.68,"text":"That’s somebody’s baby,"},{"s":251.76,"e":252.86,"text":"somebody’s brother,"},{"s":253.02,"e":254.22,"text":"somebody’s sister,"},{"s":254.32,"e":255.48,"text":"somebody’s mother."},{"s":255.9,"e":257.88,"text":"Different story. Same storm."},{"s":258.4,"e":260.74,"text":"Same tears when a loved one’s gone."},{"s":260.64,"e":261.14,"text":"**[Final Chorus]**"},{"s":260.84,"e":261.66,"text":"**HATE DIES HERE.**"},{"s":261.68,"e":264.18,"text":"Put the whole damn world on notice this year."},{"s":264.32,"e":266.78,"text":"Manufactured madness disappears right here."},{"s":266.78,"e":270.44,"text":"No slur gets a successor, no prejudice heir—"},{"s":270.68,"e":272.08,"text":"**HATE DIES HERE.**"},{"s":272.08,"e":274.78,"text":"Let the next generation inherit somethin’ clear:"},{"s":274.82,"e":277.24,"text":"more love, less labels, more truth, less fear."},{"s":277.36,"e":280.12,"text":"We can bury that bullshit we been draggin’ for years—"},{"s":280.12,"e":283.14,"text":"chain breaks, hearts change—"},{"s":283.8,"e":284.56,"text":"Not tomorrow."},{"s":284.82,"e":286.16,"text":"Not someday."},{"s":286.98,"e":287.7,"text":"Right here."},{"s":287.74,"e":289.24,"text":"No forwarding address."},{"s":289.38,"e":291.14,"text":"No next generation."},{"s":291.36,"e":292.94,"text":"No encore."},{"s":293.62,"e":295.6,"text":"Let that hatred hit the floor—"},{"s":295.52,"e":303.46,"text":"**and die here.**"}],"duration":304.6,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.795Z","stats":{"whisperWords":782,"polishedWords":763,"matched":659,"matchRate":0.864}}