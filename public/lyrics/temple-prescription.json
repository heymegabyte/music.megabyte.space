,"e":197.76,"line":66},{"w":"before:","s":197.76,"e":198.447,"line":66},{"w":"maybe","s":198.447,"e":198.79,"line":67},{"w":"people","s":198.79,"e":199.477,"line":67},{"w":"are","s":199.477,"e":199.821,"line":67},{"w":"the","s":199.821,"e":200.165,"line":67},{"w":"difference,","s":200.165,"e":201.195,"line":67},{"w":"and","s":201.195,"e":201.539,"line":68},{"w":"the","s":201.539,"e":201.882,"line":68},{"w":"drug","s":201.882,"e":202.226,"line":68},{"w":"is","s":202.226,"e":202.569,"line":68},{"w":"just","s":202.569,"e":202.913,"line":68},{"w":"the","s":202.913,"e":203.256,"line":68},{"w":"door.","s":203.256,"e":203.6,"line":68}],"lines":[{"s":21.52,"e":24.955,"text":"I was standing by the Hindu temple,"},{"s":24.955,"e":27.36,"text":"gold light folding through the street,"},{"s":27.36,"e":30.452,"text":"bells in the air like ancient questions,"},{"s":30.452,"e":32.857,"text":"dust and incense at my feet."},{"s":32.857,"e":35.605,"text":"And I thought about attention,"},{"s":35.605,"e":38.354,"text":"how the mind becomes a flame,"},{"s":38.354,"e":41.102,"text":"how two people take the same thing"},{"s":41.102,"e":43.507,"text":"and it never feels the same."},{"s":43.507,"e":46.255,"text":"My Adderall is good to me,"},{"s":46.255,"e":49.347,"text":"it clears the fog, it tunes the wire,"},{"s":49.347,"e":52.783,"text":"but hers feels like it was made of lightning,"},{"s":52.783,"e":55.188,"text":"cleaner spark and brighter fire."},{"s":55.188,"e":58.28,"text":"Then I wondered, half in silence,"},{"s":58.28,"e":60.684,"text":"half in trouble, half in art,"},{"s":60.684,"e":63.433,"text":"if Bebe Rexha held that thunder,"},{"s":63.433,"e":65.838,"text":"would it sing inside her heart?"},{"s":65.838,"e":68.586,"text":"Not because the pill is magic,"},{"s":68.586,"e":70.991,"text":"not because the name is gold,"},{"s":70.991,"e":73.739,"text":"but because a soul’s chemistry"},{"s":73.739,"e":77.862,"text":"can turn the same key into a different world."},{"s":77.862,"e":80.61,"text":"Maybe the medicine is equal,"},{"s":80.61,"e":83.015,"text":"maybe the bodies make it strange,"},{"s":83.015,"e":86.45,"text":"same little storm in different heavens,"},{"s":86.45,"e":88.855,"text":"same white spark, different flame."},{"s":88.855,"e":91.604,"text":"Maybe one mind makes it music,"},{"s":91.604,"e":93.665,"text":"maybe one makes it war,"},{"s":93.665,"e":96.07,"text":"maybe what we call a dosage"},{"s":96.07,"e":98.475,"text":"is a doorway, not a score."},{"s":98.475,"e":101.91,"text":"I’m not chasing anybody’s bottle,"},{"s":101.91,"e":104.315,"text":"I’m not worshiping the rush,"},{"s":104.315,"e":106.72,"text":"I’m just thinking like a poet"},{"s":106.72,"e":109.125,"text":"in a city full of dust."},{"s":109.125,"e":111.873,"text":"How the same rain hits a window,"},{"s":111.873,"e":114.278,"text":"a garden, a wound, a sea,"},{"s":114.278,"e":117.026,"text":"how the same word from a stranger"},{"s":117.026,"e":120.118,"text":"can mean nothing — or set you free."},{"s":120.118,"e":122.523,"text":"So if Bebe ever heard me,"},{"s":122.523,"e":125.271,"text":"I’d say, “I think too much, it’s true,"},{"s":125.271,"e":128.02,"text":"but I don’t think drugs are simple,"},{"s":128.02,"e":130.424,"text":"I think people change them too.”"},{"s":130.424,"e":133.86,"text":"The molecule may be identical,"},{"s":133.86,"e":135.921,"text":"the label may be plain,"},{"s":135.921,"e":139.013,"text":"but the temple inside the body"},{"s":139.013,"e":141.418,"text":"does not echo sound the same."},{"s":141.418,"e":144.166,"text":"Maybe the medicine is equal,"},{"s":144.166,"e":146.571,"text":"maybe the bodies make it strange,"},{"s":146.571,"e":150.007,"text":"same little storm in different heavens,"},{"s":150.007,"e":152.411,"text":"same white spark, different flame."},{"s":152.411,"e":155.16,"text":"Maybe one mind makes it music,"},{"s":155.16,"e":157.221,"text":"maybe one makes it war,"},{"s":157.221,"e":159.626,"text":"maybe what we call a dosage"},{"s":159.626,"e":162.031,"text":"is a doorway, not a score."},{"s":162.031,"e":164.779,"text":"And maybe that’s the whole religion:"},{"s":164.779,"e":167.184,"text":"not the substance, but the soul,"},{"s":167.184,"e":169.932,"text":"not the thunder, but the mountain"},{"s":169.932,"e":172.681,"text":"that decides how it will roll."},{"s":172.681,"e":175.086,"text":"Maybe beauty is translation,"},{"s":175.086,"e":177.147,"text":"maybe genius is response,"},{"s":177.147,"e":179.895,"text":"maybe one person gets a whisper"},{"s":179.895,"e":182.3,"text":"where another gets a god."},{"s":182.3,"e":183.331,"text":"Final Hook"},{"s":183.331,"e":186.423,"text":"Same medicine, different thunder,"},{"s":186.423,"e":188.484,"text":"same match, different sky,"},{"s":188.484,"e":191.232,"text":"one heart turns it into focus,"},{"s":191.232,"e":193.294,"text":"one turns it into why."},{"s":193.294,"e":196.042,"text":"So I stood there by the temple,"},{"s":196.042,"e":198.447,"text":"thinking deeper than before:"},{"s":198.447,"e":201.195,"text":"maybe people are the difference,"},{"s":201.195,"e":203.6,"text":"and the drug is just the door."}],"duration":214.8,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.856Z","realignedFrom":"whisper-aligned","vocalStart":21.52,"vocalEnd":203.6}