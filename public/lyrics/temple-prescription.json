,"e":187.56,"line":62},{"w":"match,","s":187.56,"e":188.1,"line":62},{"w":"different","s":188.22,"e":188.62,"line":62},{"w":"sky,","s":188.62,"e":189.18,"line":62},{"w":"one","s":189.18,"e":189.62,"line":63},{"w":"heart","s":189.62,"e":189.94,"line":63},{"w":"turns","s":189.94,"e":190.26,"line":63},{"w":"it","s":190.26,"e":190.6,"line":63},{"w":"into","s":190.6,"e":191.08,"line":63},{"w":"focus,","s":191.08,"e":191.68,"line":63},{"w":"one","s":191.98,"e":192.3,"line":64},{"w":"turns","s":192.3,"e":192.62,"line":64},{"w":"it","s":192.62,"e":193,"line":64},{"w":"into","s":193,"e":193.54,"line":64},{"w":"why.","s":193.54,"e":194,"line":64},{"w":"So","s":194,"e":194.34,"line":65},{"w":"I","s":194.34,"e":194.66,"line":65},{"w":"stood","s":194.66,"e":194.88,"line":65},{"w":"there","s":194.88,"e":195.3,"line":65},{"w":"by","s":195.3,"e":195.58,"line":65},{"w":"the","s":195.58,"e":196.3,"line":65},{"w":"temple,","s":196.3,"e":196.38,"line":65},{"w":"thinking","s":196.3,"e":196.94,"line":66},{"w":"deeper","s":196.94,"e":197.48,"line":66},{"w":"than","s":197.48,"e":197.94,"line":66},{"w":"before:","s":197.94,"e":198.7,"line":66},{"w":"maybe","s":198.7,"e":199.26,"line":67},{"w":"people","s":199.26,"e":199.92,"line":67},{"w":"are","s":199.92,"e":200.38,"line":67},{"w":"the","s":200.38,"e":200.74,"line":67},{"w":"difference,","s":200.74,"e":201.2,"line":67},{"w":"and","s":201.2,"e":201.66,"line":68},{"w":"the","s":201.66,"e":201.86,"line":68},{"w":"drug","s":201.86,"e":202.14,"line":68},{"w":"is","s":202.14,"e":202.42,"line":68},{"w":"just","s":202.42,"e":202.7,"line":68},{"w":"the","s":202.7,"e":203.02,"line":68},{"w":"door.","s":203.02,"e":203.6,"line":68}],"lines":[{"s":21.52,"e":25.82,"text":"I was standing by the Hindu temple,"},{"s":26.3,"e":28.14,"text":"gold light folding through the street,"},{"s":28.14,"e":30.68,"text":"bells in the air like ancient questions,"},{"s":30.74,"e":33.26,"text":"dust and incense at my feet."},{"s":33.26,"e":34.8,"text":"And I thought about attention,"},{"s":35.48,"e":37.2,"text":"how the mind becomes a flame,"},{"s":37.64,"e":39.88,"text":"how two people take the same thing"},{"s":39.88,"e":42.06,"text":"and it never feels the same."},{"s":42.16,"e":43.9,"text":"My Adderall is good to me,"},{"s":44.06,"e":46.62,"text":"it clears the fog, it tunes the wire,"},{"s":46.62,"e":48.74,"text":"but hers feels like it was made of lightning,"},{"s":48.74,"e":51.36,"text":"cleaner spark and brighter fire."},{"s":51.36,"e":53.82,"text":"Then I wondered, half in silence,"},{"s":53.94,"e":56.06,"text":"half in trouble, half in art,"},{"s":56.06,"e":58.54,"text":"if Bebe Rexha held that thunder,"},{"s":58.54,"e":60.96,"text":"would it sing inside her heart?"},{"s":61.16,"e":63.3,"text":"Not because the pill is magic,"},{"s":63.32,"e":65.68,"text":"not because the name is gold,"},{"s":65.68,"e":67.86,"text":"but because a soul’s chemistry"},{"s":67.78,"e":70.46,"text":"can turn the same key into a different world."},{"s":70.46,"e":72.86,"text":"Maybe the medicine is equal,"},{"s":72.94,"e":75.28,"text":"maybe the bodies make it strange,"},{"s":75.2,"e":77.56,"text":"same little storm in different heavens,"},{"s":77.56,"e":79.92,"text":"same white spark, different flame."},{"s":79.92,"e":82.38,"text":"Maybe one mind makes it music,"},{"s":82.68,"e":84.7,"text":"maybe one makes it war,"},{"s":84.7,"e":87.12,"text":"maybe what we call a dosage"},{"s":87.12,"e":94.24,"text":"is a doorway, not a score."},{"s":98.48,"e":101.02,"text":"I’m not chasing anybody’s bottle,"},{"s":101.08,"e":103.74,"text":"I’m not worshiping the rush,"},{"s":103.74,"e":105.98,"text":"I’m just thinking like a poet"},{"s":105.96,"e":108.5,"text":"in a city full of dust."},{"s":108.44,"e":110.54,"text":"How the same rain hits a window,"},{"s":111.08,"e":113.04,"text":"a garden, a wound, a sea,"},{"s":113.04,"e":115.34,"text":"how the same word from a stranger"},{"s":115.26,"e":117.9,"text":"can mean nothing — or set you free."},{"s":117.9,"e":120.12,"text":"So if Bebe ever heard me,"},{"s":120.16,"e":122.62,"text":"I’d say, “I think too much, it’s true,"},{"s":122.62,"e":125.06,"text":"but I don’t think drugs are simple,"},{"s":125.06,"e":127.28,"text":"I think people change them too.”"},{"s":127.28,"e":129.1,"text":"The molecule may be identical,"},{"s":129.1,"e":132.26,"text":"the label may be plain,"},{"s":132.2,"e":134.4,"text":"but the temple inside the body"},{"s":134.4,"e":136.98,"text":"does not echo sound the same."},{"s":136.98,"e":139.32,"text":"Maybe the medicine is equal,"},{"s":139.42,"e":141.68,"text":"maybe the bodies make it strange,"},{"s":141.68,"e":144.08,"text":"same little storm in different heavens,"},{"s":144.16,"e":146.48,"text":"same white spark, different flame."},{"s":146.48,"e":148.92,"text":"Maybe one mind makes it music,"},{"s":148.92,"e":151.24,"text":"maybe one makes it war,"},{"s":151.24,"e":153.64,"text":"maybe what we call a dosage"},{"s":153.64,"e":156.1,"text":"is a doorway, not a score."},{"s":160.36,"e":167.46,"text":"And maybe that’s the whole religion:"},{"s":167.96,"e":170.3,"text":"not the substance, but the soul,"},{"s":170.84,"e":172.54,"text":"not the thunder, but the mountain"},{"s":172.54,"e":175,"text":"that decides how it will roll."},{"s":175,"e":177.28,"text":"Maybe beauty is translation,"},{"s":177.5,"e":179.7,"text":"maybe genius is response,"},{"s":179.7,"e":182.12,"text":"maybe one person gets a whisper"},{"s":182.04,"e":184.32,"text":"where another gets a god."},{"s":184.24,"e":184.32,"text":"Final Hook"},{"s":184.28,"e":186.86,"text":"Same medicine, different thunder,"},{"s":187.22,"e":189.18,"text":"same match, different sky,"},{"s":189.18,"e":191.68,"text":"one heart turns it into focus,"},{"s":191.98,"e":194,"text":"one turns it into why."},{"s":194,"e":196.38,"text":"So I stood there by the temple,"},{"s":196.3,"e":198.7,"text":"thinking deeper than before:"},{"s":198.7,"e":201.2,"text":"maybe people are the difference,"},{"s":201.2,"e":203.6,"text":"and the drug is just the door."}],"duration":214.8,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.403Z","stats":{"whisperWords":412,"polishedWords":410,"matched":395,"matchRate":0.963}}