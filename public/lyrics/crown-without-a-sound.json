4.154,"e":304.465,"line":93},{"w":"down.","s":304.465,"e":304.776,"line":93},{"w":"Charm","s":304.776,"e":305.087,"line":94},{"w":"with","s":305.087,"e":305.398,"line":94},{"w":"a","s":305.398,"e":305.708,"line":94},{"w":"choice,","s":305.708,"e":306.019,"line":94},{"w":"never","s":306.019,"e":306.641,"line":94},{"w":"choke,","s":306.641,"e":306.952,"line":94},{"w":"never","s":306.952,"e":307.573,"line":94},{"w":"chase,","s":307.573,"e":307.884,"line":94},{"w":"Power","s":307.884,"e":308.506,"line":95},{"w":"is","s":308.506,"e":308.816,"line":95},{"w":"patience","s":308.816,"e":309.438,"line":95},{"w":"with","s":309.438,"e":309.749,"line":95},{"w":"poise","s":309.749,"e":310.06,"line":95},{"w":"in","s":310.06,"e":310.37,"line":95},{"w":"its","s":310.37,"e":310.681,"line":95},{"w":"place.","s":310.681,"e":310.992,"line":95},{"w":"Read","s":310.992,"e":311.303,"line":96},{"w":"every","s":311.303,"e":312.235,"line":96},{"w":"rhythm,","s":312.235,"e":312.546,"line":96},{"w":"then","s":312.546,"e":312.857,"line":96},{"w":"rise","s":312.857,"e":313.168,"line":96},{"w":"when","s":313.168,"e":313.478,"line":96},{"w":"it’s","s":313.478,"e":313.789,"line":96},{"w":"right,","s":313.789,"e":314.1,"line":96},{"w":"Seduce","s":314.1,"e":314.722,"line":97},{"w":"with","s":314.722,"e":315.032,"line":97},{"w":"the","s":315.032,"e":315.343,"line":97},{"w":"soul,","s":315.343,"e":315.654,"line":97},{"w":"not","s":315.654,"e":315.965,"line":97},{"w":"a","s":315.965,"e":316.276,"line":97},{"w":"snare","s":316.276,"e":316.586,"line":97},{"w":"in","s":316.586,"e":316.897,"line":97},{"w":"the","s":316.897,"e":317.208,"line":97},{"w":"night.","s":317.208,"e":317.519,"line":97},{"w":"Formless","s":317.519,"e":318.141,"line":98},{"w":"and","s":318.141,"e":318.451,"line":98},{"w":"fearless,","s":318.451,"e":319.073,"line":98},{"w":"yet","s":319.073,"e":319.384,"line":98},{"w":"fluid","s":319.384,"e":319.695,"line":98},{"w":"and","s":319.695,"e":320.005,"line":98},{"w":"free,","s":320.005,"e":320.316,"line":98},{"w":"Master","s":320.316,"e":320.938,"line":99},{"w":"the","s":320.938,"e":321.249,"line":99},{"w":"moment—then","s":321.249,"e":322.181,"line":99},{"w":"masterfully","s":322.181,"e":323.424,"line":99},{"w":"leave.","s":323.424,"e":323.735,"line":99},{"w":"**[Outro]**","s":323.735,"e":324.635,"line":100},{"w":"No","s":324.635,"e":324.946,"line":101},{"w":"boast,","s":324.946,"e":325.257,"line":101},{"w":"only","s":325.257,"e":325.878,"line":101},{"w":"balance;","s":325.878,"e":326.5,"line":101},{"w":"no","s":326.5,"e":326.811,"line":101},{"w":"panic,","s":326.811,"e":327.432,"line":101},{"w":"just","s":327.432,"e":327.743,"line":101},{"w":"poise,","s":327.743,"e":328.054,"line":101},{"w":"No","s":328.054,"e":328.365,"line":102},{"w":"throne","s":328.365,"e":328.675,"line":102},{"w":"needs","s":328.675,"e":328.986,"line":102},{"w":"thunder","s":328.986,"e":329.608,"line":102},{"w":"when","s":329.608,"e":329.919,"line":102},{"w":"silence","s":329.919,"e":330.54,"line":102},{"w":"has","s":330.54,"e":330.851,"line":102},{"w":"voice.","s":330.851,"e":331.162,"line":102},{"w":"Win","s":331.162,"e":331.473,"line":103},{"w":"without","s":331.473,"e":332.094,"line":103},{"w":"wasting,","s":332.094,"e":332.716,"line":103},{"w":"love","s":332.716,"e":333.027,"line":103},{"w":"without","s":333.027,"e":333.648,"line":103},{"w":"chains—","s":333.648,"e":333.959,"line":103},{"w":"A","s":333.959,"e":334.27,"line":104},{"w":"crown","s":334.27,"e":334.581,"line":104},{"w":"without","s":334.581,"e":334.84,"line":104},{"w":"sound,","s":334.84,"e":334.92,"line":104},{"w":"but","s":334.84,"e":334.92,"line":104},{"w":"the","s":334.84,"e":334.92,"line":104},{"w":"kingdom","s":334.84,"e":334.92,"line":104},{"w":"remains.","s":334.84,"e":334.92,"line":104}],"lines":[{"s":17.82,"e":19.685,"text":"# CROWN WITHOUT A SOUND"},{"s":19.685,"e":20.585,"text":"**[Intro]**"},{"s":20.585,"e":23.693,"text":"Soft steps, sharp sight—I arrive in the night,"},{"s":23.693,"e":26.801,"text":"Low flame, no name, yet the whole room turns right."},{"s":26.801,"e":30.531,"text":"Never outshine the sun; let the sovereign glow,"},{"s":30.531,"e":33.328,"text":"Then quietly climb where the cold winds blow."},{"s":33.328,"e":34.228,"text":"**[Verse 1]**"},{"s":34.228,"e":37.957,"text":"Mask every motive; make mystery your might,"},{"s":37.957,"e":41.376,"text":"Speak spare, stare steady—silence sharpens the bite."},{"s":41.376,"e":44.484,"text":"Guard your good name like a gate made of gold,"},{"s":44.484,"e":47.903,"text":"Court every eye, but let nothing be told."},{"s":47.903,"e":51.322,"text":"Let laborers labor, then label the lore,"},{"s":51.322,"e":54.741,"text":"Make rivals come calling and kneel at your door."},{"s":54.741,"e":57.849,"text":"Win with the deed; let debate disappear,"},{"s":57.849,"e":61.268,"text":"Flee fatal moods and the miserable sphere."},{"s":61.268,"e":64.376,"text":"Make value feel vital, make absence increase,"},{"s":64.376,"e":67.795,"text":"Give measured mercy, but purchase your peace."},{"s":67.795,"e":71.524,"text":"One honest confession can camouflage schemes,"},{"s":71.524,"e":74.632,"text":"Ask through their appetite, not through your dreams."},{"s":74.632,"e":77.74,"text":"Study each shadow; let secrets report,"},{"s":77.74,"e":81.781,"text":"End every enemy’s echo—cut conflict short."},{"s":81.781,"e":82.713,"text":"**[Pre-Chorus]**"},{"s":82.713,"e":85.821,"text":"Come close, then coast—let the distance delight,"},{"s":85.821,"e":89.24,"text":"Warm words, withdrawn worlds, make the hunger ignite."},{"s":89.24,"e":92.659,"text":"A whisper can wander where weapons can’t win,"},{"s":92.659,"e":96.389,"text":"The velvet invites while the vision slips in."},{"s":96.389,"e":97.289,"text":"**[Chorus]**"},{"s":97.289,"e":100.397,"text":"Rule without rage, wear the crown without sound,"},{"s":100.397,"e":103.505,"text":"Move like the moon while the masses look down."},{"s":103.505,"e":106.613,"text":"Charm with a choice, never choke, never chase,"},{"s":106.613,"e":109.721,"text":"Power is patience with poise in its place."},{"s":109.721,"e":112.829,"text":"Read every rhythm, then rise when it’s right,"},{"s":112.829,"e":116.248,"text":"Seduce with the soul, not a snare in the night."},{"s":116.248,"e":119.045,"text":"Formless and fearless, yet fluid and free,"},{"s":119.045,"e":122.464,"text":"Master the moment—then masterfully leave."},{"s":122.464,"e":123.364,"text":"**[Verse 2]**"},{"s":123.364,"e":126.472,"text":"Use absence as art; let affection accrue,"},{"s":126.472,"e":129.58,"text":"Keep patterns perplexing, predictions untrue."},{"s":129.58,"e":132.688,"text":"Never build fortresses, frozen and frail,"},{"s":132.688,"e":136.417,"text":"Know every nature, each nerve, every veil."},{"s":136.417,"e":139.836,"text":"Commit to no camp; let contenders compete,"},{"s":139.836,"e":143.255,"text":"Surrender can soften, then strengthen your seat."},{"s":143.255,"e":146.674,"text":"Concentrate force where the fractures are found,"},{"s":146.674,"e":149.782,"text":"Play perfect courtier—polished, profound."},{"s":149.782,"e":152.89,"text":"Recreate your character, cast it with care,"},{"s":152.89,"e":156.309,"text":"Keep hands clean and gleaming while helpers repair."},{"s":156.309,"e":159.106,"text":"Be bold in the breach; bashfulness bleeds,"},{"s":159.106,"e":162.214,"text":"Plan past the ending, plant roots for your deeds."},{"s":162.214,"e":165.633,"text":"Make mastery look like a marvelous breeze,"},{"s":165.633,"e":168.741,"text":"Offer two doors, but keep both of the keys."},{"s":168.741,"e":169.641,"text":"**[Verse 3]**"},{"s":169.641,"e":172.749,"text":"Feed them a fantasy, fragrant and bright,"},{"s":172.749,"e":175.857,"text":"Find their soft center, then frame it just right."},{"s":175.857,"e":179.276,"text":"Stand regal and radiant; respect follows form,"},{"s":179.276,"e":182.695,"text":"Time every tide, never wrestle the storm."},{"s":182.695,"e":186.114,"text":"Disdain what you cannot attain or control,"},{"s":186.114,"e":189.222,"text":"Take nothing “free” that can fracture the soul."},{"s":189.222,"e":192.33,"text":"Don’t wear old crowns or repeat old renown,"},{"s":192.33,"e":195.438,"text":"Strike at the shepherd and scatter the town."},{"s":195.438,"e":198.546,"text":"Win hearts before hands, win minds before might,"},{"s":198.546,"e":201.654,"text":"Mirror their motion till mirrors feel right."},{"s":201.654,"e":204.762,"text":"Preach change with care; keep the customs in view,"},{"s":204.762,"e":208.181,"text":"At victory’s summit, stop—don’t overdo."},{"s":208.181,"e":211.6,"text":"Stay shapeless as smoke, stay sleek as the sea,"},{"s":211.6,"e":215.018,"text":"No cage can contain what it cannot foresee."},{"s":215.018,"e":215.918,"text":"**[Bridge]**"},{"s":215.918,"e":219.026,"text":"Choose with compassion; let chemistry choose,"},{"s":219.026,"e":222.756,"text":"Build safety, not slavery—nothing to lose."},{"s":222.756,"e":226.175,"text":"Send mixed sparks softly, but signal respect,"},{"s":226.175,"e":229.594,"text":"Be wanted, not wicked; let trust intersect."},{"s":229.594,"e":232.702,"text":"Name hidden longings with lyrical light,"},{"s":232.702,"e":235.81,"text":"Enter their spirit, then elevate night."},{"s":235.81,"e":238.918,"text":"Tempt through a promise, not pressure or pain,"},{"s":238.918,"e":242.337,"text":"Suspend the conclusion like sweet summer rain."},{"s":242.337,"e":245.445,"text":"Poeticize moments; make memory bloom,"},{"s":245.445,"e":248.553,"text":"Disarm with your warmth, let wonder fill rooms."},{"s":248.553,"e":251.972,"text":"Blend dream into daylight, but never deceive,"},{"s":251.972,"e":255.08,"text":"Give space for desire and freedom to leave."},{"s":255.08,"e":255.98,"text":"**[Verse 4]**"},{"s":255.98,"e":259.088,"text":"Prove with a gesture; let grandstanding cease,"},{"s":259.088,"e":262.507,"text":"Awaken their playfulness, pleasure, and peace."},{"s":262.507,"e":265.925,"text":"Break stale conventions, not boundaries or trust,"},{"s":265.925,"e":269.655,"text":"Lift love into meaning, not merely to lust."},{"s":269.655,"e":273.074,"text":"Mix honey with heat, mix retreat with return,"},{"s":273.074,"e":276.804,"text":"Withdraw without cruelty; let mutual fires burn."},{"s":276.804,"e":280.533,"text":"Dress every detail with deliberate grace,"},{"s":280.533,"e":284.263,"text":"Then move with conviction when consent sets the pace."},{"s":284.263,"e":287.371,"text":"After the rapture, bring reverence near,"},{"s":287.371,"e":290.79,"text":"No vanishing act, no convenient veneer."},{"s":290.79,"e":293.898,"text":"The strongest seduction is seeing them whole,"},{"s":293.898,"e":297.317,"text":"The finest dominion is ruling your soul."},{"s":297.317,"e":298.56,"text":"**[Final Chorus]**"},{"s":298.56,"e":301.668,"text":"Rule without rage, wear the crown without sound,"},{"s":301.668,"e":304.776,"text":"Move like the moon while the masses look down."},{"s":304.776,"e":307.884,"text":"Charm with a choice, never choke, never chase,"},{"s":307.884,"e":310.992,"text":"Power is patience with poise in its place."},{"s":310.992,"e":314.1,"text":"Read every rhythm, then rise when it’s right,"},{"s":314.1,"e":317.519,"text":"Seduce with the soul, not a snare in the night."},{"s":317.519,"e":320.316,"text":"Formless and fearless, yet fluid and free,"},{"s":320.316,"e":323.735,"text":"Master the moment—then masterfully leave."},{"s":323.735,"e":324.635,"text":"**[Outro]**"},{"s":324.635,"e":328.054,"text":"No boast, only balance; no panic, just poise,"},{"s":328.054,"e":331.162,"text":"No throne needs thunder when silence has voice."},{"s":331.162,"e":333.959,"text":"Win without wasting, love without chains—"},{"s":333.959,"e":334.92,"text":"A crown without sound, but the kingdom remains."}],"duration":335.72,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.017Z","realignedFrom":"whisper-aligned","vocalStart":17.82,"vocalEnd":334.84}