12.7,"line":153},{"w":"lighter,","s":312.7,"e":313.28,"line":153},{"w":"your","s":313.28,"e":313.92,"line":154},{"w":"wiser","s":313.92,"e":314.74,"line":154},{"w":"mind","s":314.74,"e":315.52,"line":154},{"w":"keeps","s":315.52,"e":315.82,"line":154},{"w":"showing","s":315.82,"e":316.44,"line":154},{"w":"you","s":316.44,"e":317.34,"line":154},{"w":"how.","s":317.34,"e":317.82,"line":154},{"w":"There","s":319.82,"e":320.58,"line":155},{"w":"are","s":320.58,"e":320.7,"line":155},{"w":"hands","s":320.7,"e":320.92,"line":155},{"w":"you'll","s":320.92,"e":321.44,"line":155},{"w":"hold,","s":321.44,"e":321.54,"line":155},{"w":"stories","s":321.54,"e":322.1,"line":156},{"w":"untold,","s":322.1,"e":322.72,"line":156},{"w":"whole","s":322.72,"e":323.16,"line":157},{"w":"cities","s":323.16,"e":323.52,"line":157},{"w":"beneath","s":323.52,"e":324.06,"line":157},{"w":"your","s":324.06,"e":324.38,"line":157},{"w":"feet.","s":324.38,"e":324.56,"line":157},{"w":"There","s":324.56,"e":324.94,"line":158},{"w":"are","s":324.94,"e":325.1,"line":158},{"w":"versions","s":325.1,"e":325.4,"line":158},{"w":"of","s":325.4,"e":325.86,"line":158},{"w":"you","s":325.86,"e":326,"line":158},{"w":"you","s":326,"e":326.36,"line":159},{"w":"would","s":326.36,"e":326.56,"line":159},{"w":"barely","s":326.56,"e":326.92,"line":159},{"w":"believe","s":326.92,"e":327.66,"line":159},{"w":"if","s":327.66,"e":327.94,"line":160},{"w":"tonight","s":327.94,"e":328.54,"line":160},{"w":"was","s":328.54,"e":328.92,"line":160},{"w":"all","s":328.92,"e":329.42,"line":160},{"w":"you","s":329.42,"e":331.7,"line":160},{"w":"could","s":331.7,"e":332.6,"line":160},{"w":"see.","s":332.6,"e":333.76,"line":160},{"w":"So","s":333.9,"e":334.66,"line":161},{"w":"breathe.","s":334.66,"e":334.96,"line":161},{"w":"Check","s":335.48,"e":335.84,"line":162},{"w":"the","s":335.84,"e":336.14,"line":162},{"w":"facts.","s":336.14,"e":336.54,"line":162},{"w":"Choose","s":336.54,"e":336.82,"line":163},{"w":"what","s":336.82,"e":337.38,"line":163},{"w":"matters.","s":337.38,"e":337.54,"line":163},{"w":"Come","s":337.54,"e":338.02,"line":164},{"w":"back","s":338.02,"e":338.32,"line":164},{"w":"to","s":338.32,"e":338.56,"line":164},{"w":"now.","s":338.56,"e":338.94,"line":164},{"w":"Build","s":338.94,"e":339.28,"line":165},{"w":"one","s":339.28,"e":339.54,"line":165},{"w":"beautiful","s":339.54,"e":340.2,"line":165},{"w":"decision","s":340.2,"e":340.84,"line":165},{"w":"on","s":340.84,"e":341.32,"line":166},{"w":"another","s":341.32,"e":341.8,"line":166},{"w":"somehow.","s":341.8,"e":342.7,"line":166},{"w":"Stay","s":342.7,"e":343.28,"line":167},{"w":"present.","s":343.28,"e":343.78,"line":167},{"w":"Stay","s":343.78,"e":344.32,"line":168},{"w":"grateful.","s":344.32,"e":344.72,"line":168},{"w":"Let","s":344.72,"e":345.04,"line":169},{"w":"your","s":345.04,"e":345.34,"line":169},{"w":"values","s":345.34,"e":345.74,"line":169},{"w":"lead","s":345.74,"e":346.04,"line":169},{"w":"you","s":346.04,"e":346.28,"line":169},{"w":"out.","s":346.28,"e":346.5,"line":169},{"w":"Someday","s":346.5,"e":346.94,"line":170},{"w":"you'll","s":346.94,"e":347.07,"line":170},{"w":"look","s":347.2,"e":347.54,"line":170},{"w":"backward","s":347.54,"e":348.16,"line":170},{"w":"and","s":348.16,"e":348.5,"line":171},{"w":"wish","s":348.5,"e":348.88,"line":171},{"w":"you","s":348.88,"e":349.44,"line":171},{"w":"could","s":349.44,"e":349.66,"line":171},{"w":"tell","s":349.66,"e":350.16,"line":171},{"w":"yourself","s":350.16,"e":351.1,"line":171},{"w":"now:","s":351.1,"e":352,"line":171},{"w":"You","s":352,"e":352.22,"line":172},{"w":"have","s":352.22,"e":352.54,"line":172},{"w":"no","s":352.54,"e":353.5,"line":172},{"w":"idea—","s":353.5,"e":354.86,"line":172},{"w":"no","s":354.86,"e":355.32,"line":173},{"w":"idea—","s":355.32,"e":355.84,"line":173},{"w":"no","s":355.84,"e":356.3,"line":174},{"w":"idea","s":356.3,"e":356.82,"line":174},{"w":"how","s":357.2,"e":358.24,"line":174},{"w":"much","s":358.24,"e":359.28,"line":174},{"w":"works","s":359.28,"e":359.88,"line":174},{"w":"out.","s":359.88,"e":360.34,"line":174},{"w":"**PRESENT:**","s":361.54,"e":362.58,"line":176},{"w":"Will","s":362.58,"e":362.96,"line":177},{"w":"I","s":362.96,"e":363.4,"line":177},{"w":"ever","s":363.4,"e":363.84,"line":177},{"w":"see","s":363.84,"e":364.78,"line":177},{"w":"you","s":364.78,"e":366.7,"line":177},{"w":"again?","s":366.7,"e":367.94,"line":177},{"w":"**FUTURE:**","s":367.94,"e":368.22,"line":178},{"w":"Every","s":368.5,"e":368.86,"line":179},{"w":"morning.","s":368.86,"e":369.38,"line":179},{"w":"Every","s":369.38,"e":369.66,"line":180},{"w":"good","s":369.66,"e":369.96,"line":180},{"w":"choice.","s":369.96,"e":370.34,"line":180},{"w":"Every","s":370.34,"e":370.86,"line":181},{"w":"time","s":370.86,"e":371.4,"line":181},{"w":"you","s":371.4,"e":371.86,"line":181},{"w":"choose","s":371.86,"e":372.46,"line":181},{"w":"the","s":372.46,"e":372.84,"line":182},{"w":"life","s":372.84,"e":373.3,"line":182},{"w":"you're","s":373.3,"e":373.9,"line":182},{"w":"becoming.","s":374.5,"e":375.36,"line":182}],"lines":[{"s":0,"e":0.5,"text":"[Intro — distant piano, tape hiss]"},{"s":2.448,"e":2.648,"text":"**PRESENT:**"},{"s":8.16,"e":14.28,"text":"Three in the morning, ceiling turning into space,"},{"s":16.7,"e":22.94,"text":"Breathing slow and steady, letting stillness set the pace."},{"s":23.64,"e":29.76,"text":"I keep asking tomorrow what it wants me to become—"},{"s":31.2,"e":34.02,"text":"Then somebody knocked three times,"},{"s":34.02,"e":38.1,"text":"and I knew my answer had come."},{"s":38.1,"e":38.6,"text":"[Verse 1 — Present Me]"},{"s":39.74,"e":44.66,"text":"Door cracked open, there I stood, but older in the eyes,"},{"s":44.66,"e":48.34,"text":"Same spark, same soul, just calmer, clearer, more alive."},{"s":48.34,"e":50.22,"text":"I said, “Who the hell are you?”"},{"s":50.26,"e":52.12,"text":"He said, “You already know."},{"s":52.12,"e":54.28,"text":"I’ve only got three minutes—"},{"s":54.38,"e":56.08,"text":"there are things you need to know.”"},{"s":56.08,"e":58.22,"text":"I said, “Do we make it?"},{"s":58.24,"e":60.12,"text":"Do the pieces come in place?"},{"s":60.16,"e":62.04,"text":"Do I learn to trust the process"},{"s":62.04,"e":64.48,"text":"without needing every answer traced?"},{"s":64.7,"e":66.56,"text":"Do the dreams inside my mind"},{"s":66.48,"e":68.12,"text":"become something I can see?”"},{"s":68.14,"e":70.34,"text":"He smiled like he'd been waiting years:"},{"s":70.34,"e":70.56,"text":"**FUTURE:**"},{"s":70.78,"e":73.62,"text":"“You have no idea what happens to me.”"},{"s":73.62,"e":74.12,"text":"[Pre-Chorus]"},{"s":73.62,"e":74,"text":"**PRESENT:**"},{"s":74.38,"e":76.86,"text":"Tell me the ending."},{"s":76.86,"e":76.94,"text":"**FUTURE:**"},{"s":76.86,"e":77.26,"text":"No."},{"s":77.26,"e":77.34,"text":"**PRESENT:**"},{"s":77.26,"e":81.26,"text":"Tell me the way."},{"s":81.26,"e":81.67,"text":"**FUTURE:**"},{"s":82.08,"e":84.48,"text":"Better than that—"},{"s":84.48,"e":88.38,"text":"you learn to choose today."},{"s":88.38,"e":88.88,"text":"[Chorus]"},{"s":88.38,"e":88.46,"text":"**FUTURE:**"},{"s":88.38,"e":89.94,"text":"Keep moving with faith,"},{"s":89.94,"e":93.55,"text":"you have no idea how much works out."},{"s":94.8,"e":96.88,"text":"Thoughts are just thoughts,"},{"s":96.88,"e":98.98,"text":"you can question the story"},{"s":98.98,"e":103.76,"text":"and choose what you believe about now."},{"s":103.76,"e":104.9,"text":"Breathe into the moment,"},{"s":104.98,"e":106.02,"text":"put both feet down,"},{"s":106.02,"e":107.94,"text":"let the present become solid ground."},{"s":107.94,"e":109.38,"text":"You don't need every answer"},{"s":109.38,"e":111.18,"text":"to take one good step"},{"s":111.18,"e":113.52,"text":"toward the life you're building now."},{"s":113.52,"e":115.12,"text":"You don't need the map."},{"s":115.12,"e":119.58,"text":"You don't need to know how."},{"s":119.8,"e":121.08,"text":"Stay present."},{"s":121.38,"e":122.22,"text":"Choose wisely."},{"s":122.22,"e":123.98,"text":"Keep becoming now."},{"s":123.98,"e":126.86,"text":"'Cause you have no idea—"},{"s":126.96,"e":128.72,"text":"no idea—"},{"s":130.48,"e":134.72,"text":"how much works out."},{"s":134.72,"e":135.22,"text":"[Verse 2 — Present Me]"},{"s":134.72,"e":135.03,"text":"**PRESENT:**"},{"s":135.34,"e":136.46,"text":"“Do I find love?”"},{"s":136.84,"e":136.94,"text":"**FUTURE:**"},{"s":136.94,"e":138.4,"text":"“Yes—when you learn to receive.”"},{"s":138.32,"e":138.4,"text":"**PRESENT:**"},{"s":138.32,"e":140.46,"text":"“Do I find purpose?”"},{"s":140.46,"e":140.63,"text":"**FUTURE:**"},{"s":140.8,"e":142.08,"text":"“More than you currently believe.”"},{"s":142.08,"e":142.16,"text":"**PRESENT:**"},{"s":142.08,"e":144,"text":"“Do I understand myself?”"},{"s":144,"e":144.14,"text":"**FUTURE:**"},{"s":144.14,"e":145.46,"text":"“More deeply every year.”"},{"s":145.46,"e":145.54,"text":"**PRESENT:**"},{"s":145.46,"e":147.16,"text":"“What changes everything?”"},{"s":147.16,"e":147.26,"text":"**FUTURE:**"},{"s":147.36,"e":151.08,"text":"“You learn you can choose your response with clarity.”"},{"s":151.08,"e":153.08,"text":"A thought isn't a prophecy."},{"s":153,"e":154.64,"text":"A feeling isn't fate."},{"s":154.64,"e":156.68,"text":"You notice what's arising,"},{"s":157.12,"e":158.48,"text":"then decide what you create."},{"s":158.48,"e":160.32,"text":"Name what you're feeling."},{"s":160.34,"e":162.08,"text":"Breathe before reacting."},{"s":162.08,"e":164.44,"text":"Let your values choose the next move"},{"s":164.44,"e":165.83,"text":"instead of simply acting."},{"s":166.18,"e":168.16,"text":"You learn to hold two truths at once:"},{"s":168.16,"e":170.1,"text":"“I accept where I am today,"},{"s":170.1,"e":172.26,"text":"and I can still keep growing"},{"s":172.26,"e":173.94,"text":"in a beautiful new way.”"},{"s":173.94,"e":175.76,"text":"You stop demanding certainty"},{"s":175.76,"e":177.58,"text":"before you take a chance."},{"s":177.58,"e":179.46,"text":"You let your wiser mind"},{"s":179.46,"e":181.22,"text":"put intention into action."},{"s":181.22,"e":181.72,"text":"[Chorus]"},{"s":181.22,"e":181.387,"text":"**FUTURE:**"},{"s":181.387,"e":182.053,"text":"Keep moving with faith,"},{"s":182.22,"e":186.68,"text":"you have no idea how much works out."},{"s":186.68,"e":189.68,"text":"People you haven't even met yet"},{"s":189.68,"e":195.66,"text":"will one day know what you're about."},{"s":196.06,"e":198.32,"text":"Songs you haven't written,"},{"s":198.32,"e":200.2,"text":"rooms you haven't entered,"},{"s":200.2,"e":202.26,"text":"sunrises you've never seen—"},{"s":203.99,"e":206.08,"text":"There's a whole bright life"},{"s":206.08,"e":208.1,"text":"already unfolding"},{"s":208.1,"e":211.58,"text":"beyond what you currently believe."},{"s":211.78,"e":214.66,"text":"You don't need the map."},{"s":214.66,"e":216.66,"text":"You don't need to know how."},{"s":216.66,"e":217.68,"text":"Stay present."},{"s":217.68,"e":218.76,"text":"Choose wisely."},{"s":218.76,"e":220.54,"text":"Keep becoming now."},{"s":220.54,"e":223.38,"text":"You have no idea—"},{"s":223.38,"e":225.3,"text":"no idea—"},{"s":225.66,"e":229.14,"text":"how much works out."},{"s":229.14,"e":229.64,"text":"[Bridge — music nearly disappears]"},{"s":229.14,"e":229.22,"text":"**PRESENT:**"},{"s":229.14,"e":229.62,"text":"Wait."},{"s":229.7,"e":231.26,"text":"Before you go—"},{"s":231.26,"e":232.46,"text":"What's the one thing"},{"s":232.46,"e":235.1,"text":"you came all this way to tell me?"},{"s":235.1,"e":235.6,"text":"[Silence]"},{"s":235.1,"e":235.22,"text":"**FUTURE:**"},{"s":235.34,"e":236.88,"text":"I came back"},{"s":236.88,"e":238.8,"text":"to remind you you're becoming."},{"s":239.08,"e":240.58,"text":"I came back"},{"s":240.58,"e":242.86,"text":"because your choices compound."},{"s":242.92,"e":245.16,"text":"Every time you pause, breathe,"},{"s":245.28,"e":246.14,"text":"check the facts,"},{"s":246.14,"e":248.88,"text":"and put both feet on the ground—"},{"s":250.55,"e":251.84,"text":"you change your direction."},{"s":251.84,"e":253.4,"text":"Every time you choose patience"},{"s":253.4,"e":254.48,"text":"instead of impulse—"},{"s":254.68,"e":255.72,"text":"you strengthen your future."},{"s":255.72,"e":257.7,"text":"Every time you speak to yourself"},{"s":257.7,"e":259.5,"text":"like someone worth guiding—"},{"s":259.5,"e":261.98,"text":"you become your own teacher."},{"s":261.98,"e":264.02,"text":"I remember this room."},{"s":264.02,"e":265.84,"text":"I remember tonight."},{"s":265.84,"e":268.28,"text":"I remember the exact moment"},{"s":268.28,"e":269.96,"text":"you realized:"},{"s":269.96,"e":272.18,"text":"Your mind can suggest a thought"},{"s":272.18,"e":274.36,"text":"without making that thought right."},{"s":274.36,"e":275.68,"text":"You can observe it."},{"s":275.68,"e":276.54,"text":"Question it."},{"s":276.54,"e":277.64,"text":"Reframe it."},{"s":277.64,"e":278.44,"text":"Choose again."},{"s":278.44,"e":279.84,"text":"And that tiny space"},{"s":279.84,"e":282.58,"text":"between feeling and action?"},{"s":282.94,"e":287.72,"text":"That's where your future begins."},{"s":287.72,"e":288.22,"text":"[Build]"},{"s":287.72,"e":287.8,"text":"**FUTURE:**"},{"s":287.72,"e":291.22,"text":"So if I could put one sentence"},{"s":292.18,"e":295.22,"text":"inside your bones forever—"},{"s":296.48,"e":297.94,"text":"It would be:"},{"s":297.94,"e":300.96,"text":"You don't have to control the whole sky"},{"s":300.96,"e":304.5,"text":"to learn to enjoy the weather."},{"s":304.5,"e":305,"text":"[Final Chorus — full choir, orchestra, 808s]"},{"s":304.76,"e":306.46,"text":"KEEP MOVING WITH FAITH—"},{"s":306.46,"e":309.82,"text":"YOU HAVE NO IDEA HOW MUCH WORKS OUT!"},{"s":309.82,"e":311.4,"text":"The road gets wider,"},{"s":311.4,"e":313.28,"text":"the heart gets lighter,"},{"s":313.28,"e":317.82,"text":"your wiser mind keeps showing you how."},{"s":319.82,"e":321.54,"text":"There are hands you'll hold,"},{"s":321.54,"e":322.72,"text":"stories untold,"},{"s":322.72,"e":324.56,"text":"whole cities beneath your feet."},{"s":324.56,"e":326,"text":"There are versions of you"},{"s":326,"e":327.66,"text":"you would barely believe"},{"s":327.66,"e":333.76,"text":"if tonight was all you could see."},{"s":333.9,"e":334.96,"text":"So breathe."},{"s":335.48,"e":336.54,"text":"Check the facts."},{"s":336.54,"e":337.54,"text":"Choose what matters."},{"s":337.54,"e":338.94,"text":"Come back to now."},{"s":338.94,"e":340.84,"text":"Build one beautiful decision"},{"s":340.84,"e":342.7,"text":"on another somehow."},{"s":342.7,"e":343.78,"text":"Stay present."},{"s":343.78,"e":344.72,"text":"Stay grateful."},{"s":344.72,"e":346.5,"text":"Let your values lead you out."},{"s":346.5,"e":348.16,"text":"Someday you'll look backward"},{"s":348.16,"e":352,"text":"and wish you could tell yourself now:"},{"s":352,"e":354.86,"text":"You have no idea—"},{"s":354.86,"e":355.84,"text":"no idea—"},{"s":355.84,"e":360.34,"text":"no idea how much works out."},{"s":360.34,"e":360.84,"text":"[Outro — future voice fading]"},{"s":361.54,"e":362.58,"text":"**PRESENT:**"},{"s":362.58,"e":367.94,"text":"Will I ever see you again?"},{"s":367.94,"e":368.22,"text":"**FUTURE:**"},{"s":368.5,"e":369.38,"text":"Every morning."},{"s":369.38,"e":370.34,"text":"Every good choice."},{"s":370.34,"e":372.46,"text":"Every time you choose"},{"s":372.46,"e":375.36,"text":"the life you're becoming."}],"duration":379.16,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.817Z","stats":{"whisperWords":734,"polishedWords":752,"matched":718,"matchRate":0.955}}