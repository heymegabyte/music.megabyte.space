.953,"line":90},{"w":"smoke","s":244.953,"e":245.233,"line":90},{"w":"in","s":245.233,"e":245.513,"line":90},{"w":"the","s":245.513,"e":245.793,"line":90},{"w":"sun,","s":245.793,"e":246.073,"line":90},{"w":"no","s":246.073,"e":246.353,"line":90},{"w":"fire","s":246.353,"e":246.634,"line":90},{"w":"in","s":246.634,"e":246.914,"line":90},{"w":"the","s":246.914,"e":247.194,"line":90},{"w":"skies.","s":247.194,"e":247.474,"line":90},{"w":"Every","s":247.474,"e":248.314,"line":91},{"w":"mother","s":248.314,"e":248.874,"line":91},{"w":"gets","s":248.874,"e":249.154,"line":91},{"w":"her","s":249.154,"e":249.434,"line":91},{"w":"child","s":249.434,"e":249.714,"line":91},{"w":"back","s":249.714,"e":249.994,"line":91},{"w":"alive,","s":249.994,"e":250.554,"line":91},{"w":"Every","s":250.554,"e":251.395,"line":92},{"w":"enemy","s":251.395,"e":252.235,"line":92},{"w":"becomes","s":252.235,"e":253.075,"line":92},{"w":"somebody","s":253.075,"e":254.195,"line":92},{"w":"we","s":254.195,"e":254.475,"line":92},{"w":"survived","s":254.475,"e":255.315,"line":92},{"w":"**with**.","s":255.315,"e":255.596,"line":92},{"w":"**Give","s":255.596,"e":255.876,"line":93},{"w":"me","s":255.876,"e":256.156,"line":93},{"w":"a","s":256.156,"e":256.436,"line":93},{"w":"victory","s":256.436,"e":257.276,"line":93},{"w":"with","s":257.276,"e":257.556,"line":93},{"w":"nobody","s":257.556,"e":258.396,"line":93},{"w":"dead,**","s":258.396,"e":258.676,"line":93},{"w":"Hope","s":258.676,"e":258.956,"line":94},{"w":"in","s":258.956,"e":259.236,"line":94},{"w":"the","s":259.236,"e":259.516,"line":94},{"w":"heart","s":259.516,"e":259.796,"line":94},{"w":"and","s":259.796,"e":260.076,"line":94},{"w":"a","s":260.076,"e":260.357,"line":94},{"w":"roof","s":260.357,"e":260.637,"line":94},{"w":"overhead.","s":260.637,"e":261.477,"line":94},{"w":"Stars","s":261.477,"e":261.757,"line":95},{"w":"still","s":261.757,"e":262.037,"line":95},{"w":"shining","s":262.037,"e":262.597,"line":95},{"w":"when","s":262.597,"e":262.877,"line":95},{"w":"the","s":262.877,"e":263.157,"line":95},{"w":"history","s":263.157,"e":263.997,"line":95},{"w":"gets","s":263.997,"e":264.277,"line":95},{"w":"read—","s":264.277,"e":264.557,"line":95},{"w":"**That’s","s":264.557,"e":264.838,"line":96},{"w":"my","s":264.838,"e":265.118,"line":96},{"w":"kind","s":265.118,"e":265.398,"line":96},{"w":"of","s":265.398,"e":265.678,"line":96},{"w":"victory:","s":265.678,"e":266.518,"line":96},{"w":"nobody","s":266.518,"e":267.358,"line":96},{"w":"dead.**","s":267.358,"e":267.638,"line":96},{"w":"Nobody","s":267.638,"e":268.478,"line":97},{"w":"dead.","s":268.478,"e":268.758,"line":97},{"w":"Everybody","s":268.758,"e":270.159,"line":98},{"w":"fed.","s":270.159,"e":270.439,"line":98},{"w":"Nobody","s":270.439,"e":271.279,"line":99},{"w":"dead.","s":271.279,"e":271.559,"line":99},{"w":"Let","s":271.559,"e":271.839,"line":100},{"w":"tomorrow","s":271.839,"e":272.679,"line":100},{"w":"live","s":272.679,"e":272.959,"line":100},{"w":"instead.","s":272.959,"e":273.519,"line":100},{"w":"**Nobody","s":273.519,"e":274.24,"line":101},{"w":"dead.**","s":274.24,"e":274.32,"line":101}],"lines":[{"s":1.18,"e":3.701,"text":"# Victory With Nobody Dead"},{"s":3.701,"e":5.941,"text":"**[Intro – piano, distant choir]**"},{"s":5.941,"e":7.901,"text":"What if the bravest battle"},{"s":7.901,"e":9.862,"text":"was the one we never had?"},{"s":9.862,"e":12.102,"text":"What if the greatest victory"},{"s":12.102,"e":14.063,"text":"sent every soldier back?"},{"s":14.063,"e":15.183,"text":"**[Verse 1 – rap]**"},{"s":15.183,"e":18.544,"text":"They said pick a side, I said pick up the pieces,"},{"s":18.544,"e":21.624,"text":"Peace got a price, but revenge never ceases."},{"s":21.624,"e":24.705,"text":"Preachers preach peace while the presidents posture,"},{"s":24.705,"e":28.066,"text":"Families fracture while the cameras capture."},{"s":28.066,"e":30.867,"text":"Maps get marked by a man in a room,"},{"s":30.867,"e":34.787,"text":"Then a mother gets flowers where a son used to bloom."},{"s":34.787,"e":38.428,"text":"Medals on a mantle, names carved in granite,"},{"s":38.428,"e":42.349,"text":"Everybody screaming they’re defending the planet."},{"s":42.349,"e":45.43,"text":"But tell me who won when the playground burned?"},{"s":45.43,"e":49.071,"text":"Who gained ground when the children never returned?"},{"s":49.071,"e":52.151,"text":"Who conquered what when the hospitals fell?"},{"s":52.151,"e":55.792,"text":"If victory looks like this, victory looks like hell."},{"s":55.792,"e":58.032,"text":"**[Pre-Chorus – female vocal]**"},{"s":58.032,"e":59.713,"text":"Bring them home, bring them home,"},{"s":59.713,"e":61.393,"text":"Let the babies grow old."},{"s":61.393,"e":63.354,"text":"Let the stories get written"},{"s":63.354,"e":65.594,"text":"without names carved in stone."},{"s":65.594,"e":67.275,"text":"**[Chorus – massive duet]**"},{"s":67.275,"e":69.795,"text":"**I want a win where nobody dies,**"},{"s":69.795,"e":72.596,"text":"No smoke in the sun, no fire in the skies."},{"s":72.596,"e":75.676,"text":"No mother on the phone asking heaven why,"},{"s":75.676,"e":78.477,"text":"No folded-up flag where her child should lie."},{"s":78.477,"e":81.558,"text":"**Give me a victory with nobody dead,**"},{"s":81.558,"e":84.358,"text":"Bread on the table, not bloodshed instead."},{"s":84.358,"e":86.879,"text":"Hands held high but no guns overhead—"},{"s":86.879,"e":89.96,"text":"**That’s my kind of victory: nobody dead.**"},{"s":89.96,"e":91.08,"text":"**[Verse 2 – rap]**"},{"s":91.08,"e":93.88,"text":"Real strength ain’t rage, real power is patience,"},{"s":93.88,"e":96.681,"text":"Talk through the tension, transform the nations."},{"s":96.681,"e":99.482,"text":"Courage is calling when hatred says hide,"},{"s":99.482,"e":102.842,"text":"Finding some humanity over the divide."},{"s":102.842,"e":105.643,"text":"The enemy eats, the enemy sleeps,"},{"s":105.643,"e":108.724,"text":"The enemy laughs and the enemy weeps."},{"s":108.724,"e":111.804,"text":"The enemy’s daughter draws stars on a page,"},{"s":111.804,"e":115.445,"text":"The enemy’s father gets scared and gets aged."},{"s":115.445,"e":118.246,"text":"Same little heartbeat, same oxygen breath,"},{"s":118.246,"e":121.326,"text":"Same desperate instinct to bargain with death."},{"s":121.326,"e":124.407,"text":"Different translation, identical prayer:"},{"s":124.407,"e":127.208,"text":"“Please bring my family home from out there.”"},{"s":127.208,"e":130.008,"text":"So cancel the countdown, cut through the pride,"},{"s":130.008,"e":133.369,"text":"Put diplomats deep where the missiles would ride."},{"s":133.369,"e":136.73,"text":"If somebody tells me compassion is weak,"},{"s":136.73,"e":140.091,"text":"I’ll tell ’em restraint takes the strength of the meek."},{"s":140.091,"e":140.991,"text":"**[Pre-Chorus]**"},{"s":140.991,"e":142.671,"text":"Bring them home, bring them home,"},{"s":142.671,"e":145.191,"text":"Every daughter, every son."},{"s":145.191,"e":147.432,"text":"The greatest war we’ll ever win"},{"s":147.432,"e":149.672,"text":"is the war that never comes."},{"s":149.672,"e":150.572,"text":"**[Chorus]**"},{"s":150.572,"e":153.093,"text":"**I want a win where nobody dies,**"},{"s":153.093,"e":155.894,"text":"No smoke in the sun, no fire in the skies."},{"s":155.894,"e":158.974,"text":"No mother on the phone asking heaven why,"},{"s":158.974,"e":161.775,"text":"No folded-up flag where her child should lie."},{"s":161.775,"e":164.856,"text":"**Give me a victory with nobody dead,**"},{"s":164.856,"e":167.656,"text":"Bread on the table, not bloodshed instead."},{"s":167.656,"e":170.177,"text":"Hands held high but no guns overhead—"},{"s":170.177,"e":173.257,"text":"**That’s my kind of victory: nobody dead.**"},{"s":173.257,"e":176.058,"text":"**[Bridge – stripped piano / female lead]**"},{"s":176.058,"e":178.579,"text":"What if mercy made the headlines?"},{"s":178.579,"e":180.819,"text":"What if treaties topped the charts?"},{"s":180.819,"e":183.34,"text":"What if leaders measured greatness"},{"s":183.34,"e":185.58,"text":"by the number of beating hearts?"},{"s":185.58,"e":188.661,"text":"No revenge passed down like inheritance,"},{"s":188.661,"e":191.181,"text":"No child taught an ancient arrogance."},{"s":191.181,"e":194.262,"text":"Let tomorrow wake without yesterday’s debt—"},{"s":194.262,"e":195.662,"text":"Forgive what we can."},{"s":195.662,"e":197.343,"text":"Prevent what comes next."},{"s":197.343,"e":199.023,"text":"**[Final Rap – drums build]**"},{"s":199.023,"e":202.384,"text":"Let the tanks turn tractors, let the trenches grow trees,"},{"s":202.384,"e":206.305,"text":"Let the factories manufacture medicine and peace."},{"s":206.305,"e":209.665,"text":"Let the pilots fly people safely back home,"},{"s":209.665,"e":213.306,"text":"Let the drones shoot movies, let the battlefields grow."},{"s":213.306,"e":216.667,"text":"Spend the billions on bridges, on bedrooms, on bread,"},{"s":216.667,"e":220.588,"text":"On keeping people living instead of counting the dead."},{"s":220.588,"e":222.828,"text":"Call me naïve—I’d rather be that"},{"s":222.828,"e":226.469,"text":"Than clever enough to make a cemetery map."},{"s":226.469,"e":229.83,"text":"We’ve mastered destruction, now master restraint,"},{"s":229.83,"e":232.911,"text":"Make peace look powerful, make mercy look great."},{"s":232.911,"e":235.991,"text":"The hardest flex left on this planet instead"},{"s":235.991,"e":237.672,"text":"Is winning the whole thing—"},{"s":237.672,"e":239.072,"text":"**with nobody dead.**"},{"s":239.072,"e":242.153,"text":"**[Final Chorus – huge choir + rap ad-libs]**"},{"s":242.153,"e":244.673,"text":"**I want a win where nobody dies,**"},{"s":244.673,"e":247.474,"text":"No smoke in the sun, no fire in the skies."},{"s":247.474,"e":250.554,"text":"Every mother gets her child back alive,"},{"s":250.554,"e":255.596,"text":"Every enemy becomes somebody we survived **with**."},{"s":255.596,"e":258.676,"text":"**Give me a victory with nobody dead,**"},{"s":258.676,"e":261.477,"text":"Hope in the heart and a roof overhead."},{"s":261.477,"e":264.557,"text":"Stars still shining when the history gets read—"},{"s":264.557,"e":267.638,"text":"**That’s my kind of victory: nobody dead.**"},{"s":267.638,"e":268.758,"text":"Nobody dead."},{"s":268.758,"e":270.439,"text":"Everybody fed."},{"s":270.439,"e":271.559,"text":"Nobody dead."},{"s":271.559,"e":273.519,"text":"Let tomorrow live instead."},{"s":273.519,"e":274.32,"text":"**Nobody dead.**"}],"duration":279.4,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.140Z","realignedFrom":"whisper-aligned","vocalStart":1.18,"vocalEnd":274.24}