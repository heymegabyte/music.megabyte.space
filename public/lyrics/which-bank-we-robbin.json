"e":269.58,"line":72},{"w":"kingdom","s":269.58,"e":269.66,"line":72},{"w":"from","s":269.58,"e":269.98,"line":72},{"w":"a","s":269.98,"e":270.38,"line":72},{"w":"night","s":270.38,"e":270.64,"line":72},{"w":"worth","s":270.64,"e":270.92,"line":72},{"w":"becoming","s":270.92,"e":271.5,"line":72},{"w":"My","s":271.5,"e":271.58,"line":72},{"w":"My","s":271.5,"e":272,"line":73},{"w":"first","s":272,"e":272.5,"line":73},{"w":"love","s":272.5,"e":273.34,"line":73},{"w":"story","s":273.34,"e":273.72,"line":73},{"w":"started","s":273.72,"e":274.14,"line":73},{"w":"With","s":274.5,"e":275.1,"line":74},{"w":"the","s":275.1,"e":275.26,"line":74},{"w":"middle","s":275.26,"e":275.84,"line":74},{"w":"finger","s":275.84,"e":276.52,"line":74},{"w":"coming","s":276.52,"e":277.4,"line":74},{"w":"One","s":277.4,"e":277.48,"line":74},{"w":"One","s":277.4,"e":277.86,"line":75},{"w":"finger","s":277.86,"e":278.6,"line":75},{"w":"raised","s":278.6,"e":279.26,"line":75},{"w":"One","s":279.26,"e":279.34,"line":75},{"w":"One","s":279.26,"e":279.72,"line":76},{"w":"blonde","s":279.72,"e":280.38,"line":76},{"w":"flame","s":280.38,"e":281.06,"line":76},{"w":"Ten","s":281.06,"e":281.14,"line":76},{"w":"Ten","s":281.06,"e":281.6,"line":77},{"w":"thousand","s":281.6,"e":282.18,"line":77},{"w":"faces","s":282.18,"e":282.86,"line":77},{"w":"No","s":282.86,"e":282.94,"line":77},{"w":"No","s":282.86,"e":283.38,"line":78},{"w":"last","s":283.38,"e":284.1,"line":78},{"w":"name","s":284.1,"e":284.7,"line":78},{"w":"moonlight","s":285.82,"e":286.64,"line":79},{"w":"Wherever","s":286.64,"e":286.72,"line":79},{"w":"Wherever","s":286.64,"e":287.32,"line":80},{"w":"you're","s":287.32,"e":287.78,"line":80},{"w":"running","s":287.78,"e":288.3,"line":80},{"w":"come","s":288.36,"e":288.88,"line":80},{"w":"finish","s":288.88,"e":289.28,"line":80},{"w":"our","s":289.28,"e":289.78,"line":80},{"w":"story","s":289.78,"e":290.2,"line":80},{"w":"Which","s":290.2,"e":290.28,"line":80},{"w":"Which","s":290.2,"e":290.68,"line":81},{"w":"bank","s":290.68,"e":291.1,"line":81},{"w":"we","s":291.1,"e":291.4,"line":81},{"w":"robbing","s":291.4,"e":292.06,"line":81}],"lines":[{"s":30.3,"e":34.86,"text":"Blue beams bend heaven, bass breathe fire"},{"s":34.78,"e":38.34,"text":"I stood at the front where the wild hearts run"},{"s":38.26,"e":42.28,"text":"Six foot five silhouette, blocking somebody's sun"},{"s":42.2,"e":45.94,"text":"Move from behind me, moon's mounting again"},{"s":45.86,"e":49.92,"text":"Like I owed every stranger an apology for my frame"},{"s":49.84,"e":53.68,"text":"I crouched through crowds, bowed down, bent low"},{"s":53.6,"e":57.52,"text":"Spent years making space everywhere I would go"},{"s":57.44,"e":61.16,"text":"But pain makes a promise when patience is done"},{"s":61.08,"e":65.1,"text":"So I raised one finger underneath the false sun"},{"s":65.02,"e":68.98,"text":"One finger through the fog, one flare through the night"},{"s":68.9,"e":72.64,"text":"Not hatred, just a tired man reclaiming his height"},{"s":72.56,"e":76.44,"text":"The whole crowd complained, but one woman smiled"},{"s":76.36,"e":80.26,"text":"Blonde hair, bold stare, something fearless and wild"},{"s":80.18,"e":84.3,"text":"She fell for the finger, the fury, the flame"},{"s":84.22,"e":87.94,"text":"The moment I stopped being sorry for my shape and my name"},{"s":87.86,"e":91.58,"text":"Gold hair glowing while the whole world blurred"},{"s":91.5,"e":95.42,"text":"She crossed ten thousand people without saying a word"},{"s":95.34,"e":98.98,"text":"Then her lips met mine while the lasers kept coming"},{"s":98.9,"e":102.72,"text":"Heartbeats hit hard, four on the floor drumming"},{"s":102.64,"e":106.54,"text":"One kiss turned the riot into roses and humming"},{"s":106.46,"e":110.58,"text":"She whispered with a grin, which bank we robbing?"},{"s":110.66,"e":113.02,"text":"No name, no number, no care for hello"},{"s":112.94,"e":116.2,"text":"Just chemistry crackling the ultraviolet glow"},{"s":117.78,"e":120.28,"text":"Her hand on my chest, my hand at her waist"},{"s":120.2,"e":123.98,"text":"Like time took ten thousand and erased every face"},{"s":124.86,"e":128.98,"text":"Three beers had me floating, but her eyes made me fly"},{"s":128.9,"e":132.64,"text":"Green, blue, truth underneath the black sky"},{"s":132.56,"e":136.34,"text":"She laughed at my anger, then kissed through the ache"},{"s":136.26,"e":140.2,"text":"Like she knew every wound that the world didn't make"},{"s":140.12,"e":144.08,"text":"I told her they hate when a tall man stands tall"},{"s":144,"e":147.72,"text":"She said, let them stare, you were born above it all"},{"s":147.64,"e":151.24,"text":"That sanity struck deeper than the kick or the snare"},{"s":151.16,"e":155.12,"text":"She didn't ask me to shrink, she just met me up there"},{"s":155.04,"e":159.2,"text":"She fell for the finger, the fury, the flame"},{"s":159.12,"e":162.8,"text":"The moment I stopped being sorry for my shape and my name"},{"s":162.76,"e":166.4,"text":"Gold hair glowing while the whole world blurred"},{"s":166.32,"e":170.2,"text":"She crossed ten thousand people without saying a word"},{"s":170.12,"e":173.58,"text":"Then her lips met mine, while the lasers kept coming"},{"s":174.02,"e":177.4,"text":"Heartbeats hit hard, four on the floor drumming"},{"s":177.32,"e":181.14,"text":"One kiss turned the riot into roses and humming"},{"s":181.06,"e":185.16,"text":"She whispered with a grin, which bank we robbing?"},{"s":185.32,"e":187.32,"text":"Maybe the bank was the years that had stolen my peace"},{"s":187.24,"e":189.42,"text":"Maybe love was the weapon that demanded release"},{"s":189.34,"e":191.48,"text":"Maybe we robbed back the youth I had buried in pain"},{"s":191.4,"e":193.36,"text":"Took the gold from the grief, left the guilt in the rain"},{"s":193.28,"e":195.18,"text":"I had suffered through seasons, no song could explain"},{"s":195.1,"e":197.04,"text":"Carry cold conversations, confusion and shame"},{"s":196.96,"e":198.92,"text":"Maybe every heart might let my feet to that stand"},{"s":198.84,"e":201.36,"text":"So the Kia boys could hear there's another command"},{"s":201.28,"e":203.64,"text":"Don't steal someone's future just to feel one night free"},{"s":204.04,"e":207.42,"text":"Build something brilliant from the same wild energy"},{"s":207.34,"e":210.96,"text":"Take motors apart, make machines, make a living"},{"s":210.88,"e":215.48,"text":"Real rebellion is building when the world isn't giving"},{"s":215.64,"e":217.56,"text":"Blind girl, did you know?"},{"s":217.88,"e":219.72,"text":"When you moved through the masses"},{"s":219.64,"e":223.24,"text":"You turned broken glass into rose-colored glasses"},{"s":223.16,"e":226.22,"text":"Did you know that your kiss made the whole night?"},{"s":226.64,"e":230.58,"text":"Forgive me for being too tall, too loud, too alive, too risky"},{"s":230.5,"e":232.42,"text":"Was it random romance?"},{"s":232.74,"e":234.08,"text":"Was the whole thing arranged?"},{"s":234.26,"e":237.96,"text":"Did some clandestine Cupid put our names on a page?"},{"s":238.04,"e":239.72,"text":"Are we partners in something?"},{"s":240.12,"e":244.54,"text":"The stars started running, come find me and tell me"},{"s":244.46,"e":246.2,"text":"Which bank we robbing?"},{"s":246.12,"e":249.98,"text":"She fell for the finger, then stayed for the soul"},{"s":249.9,"e":253.78,"text":"Saw fire in the fractures, saw the half become whole"},{"s":253.7,"e":257.04,"text":"Gold hair going wild, the whole crowd spun"},{"s":256.96,"e":260.74,"text":"Two strangers became something before the night was done"},{"s":260.66,"e":262.46,"text":"Arm in race, heaven"},{"s":262.38,"e":264.3,"text":"Every heartbeat was drumming"},{"s":264.22,"e":266.04,"text":"And send me somewhere laughing"},{"s":266.1,"e":267.94,"text":"Lake, wine coming"},{"s":267.86,"e":271.58,"text":"One kiss made a kingdom from a night worth becoming"},{"s":271.5,"e":274.14,"text":"My first love story started"},{"s":274.5,"e":277.48,"text":"With the middle finger coming"},{"s":277.4,"e":279.34,"text":"One finger raised"},{"s":279.26,"e":281.14,"text":"One blonde flame"},{"s":281.06,"e":282.94,"text":"Ten thousand faces"},{"s":282.86,"e":284.7,"text":"No last name"},{"s":285.82,"e":286.72,"text":"Milwaukee moonlight"},{"s":286.64,"e":290.28,"text":"Wherever you're running, come finish our story"},{"s":290.2,"e":292.06,"text":"Which bank we robbing?"}],"duration":297.16,"source":"whisper","generatedAt":"2026-06-01T00:00:00.000Z"}