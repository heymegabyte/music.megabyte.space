ve","s":272.5,"e":273.34,"line":87},{"w":"story","s":273.34,"e":273.72,"line":87},{"w":"started","s":273.72,"e":274.14,"line":87},{"w":"With","s":274.5,"e":275.1,"line":88},{"w":"the","s":275.1,"e":275.26,"line":88},{"w":"middle","s":275.26,"e":275.84,"line":88},{"w":"finger","s":275.84,"e":276.52,"line":88},{"w":"coming.","s":276.52,"e":277.4,"line":88},{"w":"One","s":277.4,"e":277.86,"line":90},{"w":"finger","s":277.86,"e":278.6,"line":90},{"w":"raised.","s":278.6,"e":279.26,"line":90},{"w":"One","s":279.26,"e":279.72,"line":91},{"w":"blonde","s":279.72,"e":280.38,"line":91},{"w":"flame.","s":280.38,"e":281.06,"line":91},{"w":"Ten","s":281.06,"e":281.6,"line":92},{"w":"thousand","s":281.6,"e":282.18,"line":92},{"w":"faces.","s":282.18,"e":282.86,"line":92},{"w":"No","s":282.86,"e":283.38,"line":93},{"w":"last","s":283.38,"e":284.1,"line":93},{"w":"name.","s":284.1,"e":284.7,"line":93},{"w":"Milwaukee","s":285.28,"e":285.82,"line":94},{"w":"moonlight,","s":285.82,"e":286.64,"line":94},{"w":"wherever","s":286.64,"e":287.32,"line":94},{"w":"you’re","s":287.32,"e":287.55,"line":94},{"w":"running—","s":287.78,"e":288.3,"line":94},{"w":"Come","s":288.36,"e":288.88,"line":95},{"w":"finish","s":288.88,"e":289.28,"line":95},{"w":"our","s":289.28,"e":289.78,"line":95},{"w":"story.","s":289.78,"e":290.2,"line":95},{"w":"**Which","s":290.2,"e":290.68,"line":96},{"w":"bank","s":290.68,"e":291.1,"line":96},{"w":"we","s":291.1,"e":291.4,"line":96},{"w":"robbin’?**","s":291.4,"e":292.06,"line":96}],"lines":[{"s":0,"e":0.5,"text":"**[Intro]**"},{"s":9.09,"e":11.463,"text":"Milwaukee moon, music moving through the mist,"},{"s":11.463,"e":15.448,"text":"Aunt Cindi at the door with a blessing and a kiss."},{"s":15.448,"e":17.984,"text":"Three beers, clear fear, summer burning bright—"},{"s":17.984,"e":21.968,"text":"I didn’t know rebellion would introduce me to my life."},{"s":21.968,"e":22.468,"text":"**[Verse 1]**"},{"s":21.968,"e":24.142,"text":"Summerfest thunder, lakefront lit in gold,"},{"s":24.142,"e":27.04,"text":"Ten thousand bodies, but the evening felt cold."},{"s":27.04,"e":29.938,"text":"Armin in the distance, every synth climbing higher,"},{"s":30.3,"e":34.78,"text":"Blue beams bent heaven, bass breathed fire."},{"s":34.78,"e":38.26,"text":"I stood at the front where the wild hearts run,"},{"s":38.86,"e":42.2,"text":"Six-foot-five silhouette blocking somebody’s sun."},{"s":42.2,"e":45.86,"text":"“Move!” from behind me, moans mounting again—"},{"s":45.86,"e":49.84,"text":"Like I owed every stranger an apology for my frame."},{"s":49.84,"e":53.6,"text":"I’d crouched through crowds, bowed down, bent low,"},{"s":53.6,"e":57.44,"text":"Spent years making space everywhere I would go."},{"s":57.44,"e":61.08,"text":"But pain makes a promise when patience is done—"},{"s":61.08,"e":65.02,"text":"So I raised one finger underneath the false sun."},{"s":65.02,"e":65.52,"text":"**[Pre-Chorus]**"},{"s":65.02,"e":68.9,"text":"One finger through the fog, one flare through the night,"},{"s":68.9,"e":72.56,"text":"Not hatred—just a tired man reclaiming his height."},{"s":72.56,"e":76.36,"text":"The whole crowd complained, but one woman smiled—"},{"s":76.36,"e":80.18,"text":"Blonde hair, bold stare, something fearless and wild."},{"s":80.18,"e":80.68,"text":"**[Chorus]**"},{"s":80.18,"e":84.22,"text":"She fell for the finger, the fury, the flame,"},{"s":84.22,"e":87.86,"text":"The moment I stopped being sorry for my shape and my name."},{"s":87.86,"e":91.5,"text":"Gold hair glowing while the whole world blurred,"},{"s":91.5,"e":95.42,"text":"She crossed ten thousand people without saying a word."},{"s":95.34,"e":98.9,"text":"Then her lips met mine while the lasers kept coming,"},{"s":98.9,"e":102.64,"text":"Heartbeats hit hard, four-on-the-floor drumming."},{"s":102.64,"e":106.46,"text":"One kiss turned the riot into roses and humming—"},{"s":106.46,"e":108.38,"text":"She whispered with a grin,"},{"s":108.3,"e":110.58,"text":"**“Which bank we robbin’?”**"},{"s":110.58,"e":111.08,"text":"**[Verse 2]**"},{"s":110.66,"e":112.94,"text":"No name, no number, no careful hello,"},{"s":112.94,"e":116.2,"text":"Just chemistry crackling in the ultraviolet glow."},{"s":117.78,"e":120.2,"text":"Her hand on my chest, my hand at her waist,"},{"s":120.2,"e":123.98,"text":"Like time took ten thousand and erased every face."},{"s":124.86,"e":128.9,"text":"Three beers had me floating, but her eyes made me fly,"},{"s":129.86,"e":132.56,"text":"Green-blue truth underneath the black sky."},{"s":132.56,"e":136.34,"text":"She laughed at my anger, then kissed through the ache,"},{"s":136.26,"e":140.12,"text":"Like she knew every wound that the world didn’t make."},{"s":140.12,"e":144,"text":"I told her, “They hate when a tall man stands tall.”"},{"s":144,"e":147.64,"text":"She said, “Let them stare—you were born above it all.”"},{"s":147.64,"e":151.16,"text":"That sentence struck deeper than the kick or the snare—"},{"s":151.16,"e":155.04,"text":"She didn’t ask me to shrink; she just met me up there."},{"s":155.04,"e":155.54,"text":"**[Chorus]**"},{"s":155.04,"e":159.12,"text":"She fell for the finger, the fury, the flame,"},{"s":159.12,"e":162.8,"text":"The moment I stopped being sorry for my shape and my name."},{"s":162.76,"e":166.32,"text":"Gold hair glowing while the whole world blurred,"},{"s":166.32,"e":170.2,"text":"She crossed ten thousand people without saying a word."},{"s":170.12,"e":173.58,"text":"Then her lips met mine while the lasers kept coming,"},{"s":174.02,"e":177.32,"text":"Heartbeats hit hard, four-on-the-floor drumming."},{"s":177.32,"e":181.06,"text":"One kiss turned the riot into roses and humming—"},{"s":181.06,"e":182.96,"text":"She whispered with a grin,"},{"s":182.94,"e":185.16,"text":"**“Which bank we robbin’?”**"},{"s":185.16,"e":185.66,"text":"**[Verse 3]**"},{"s":185.32,"e":187.24,"text":"Maybe the bank was the years that had stolen my peace,"},{"s":187.24,"e":189.34,"text":"Maybe love was the weapon that demanded release."},{"s":189.34,"e":191.4,"text":"Maybe we robbed back the youth I had buried in pain,"},{"s":191.4,"e":193.28,"text":"Took the gold from the grief, left the guilt in the rain."},{"s":193.28,"e":195.1,"text":"I had suffered through seasons no song could explain,"},{"s":195.1,"e":196.98,"text":"Carried cold conversations, confusion and shame."},{"s":196.96,"e":198.84,"text":"Maybe every hard mile led my feet to that stand,"},{"s":198.84,"e":201.28,"text":"So the Kia Boys could hear there’s another command:"},{"s":201.28,"e":203.64,"text":"Don’t steal someone’s future just to feel one night free,"},{"s":204.04,"e":207.34,"text":"Build something brilliant from the same wild energy."},{"s":207.34,"e":210.88,"text":"Take motors apart, make machines, make a living—"},{"s":210.88,"e":215.48,"text":"Real rebellion is building when the world isn’t giving."},{"s":215.48,"e":215.98,"text":"**[Bridge]**"},{"s":215.64,"e":219.64,"text":"Blonde girl, did you know when you moved through the masses"},{"s":219.64,"e":223.16,"text":"You turned broken glass into rose-colored glasses?"},{"s":223.16,"e":226.92,"text":"Did you know that your kiss made the whole night forgive me—"},{"s":226.92,"e":230.5,"text":"For being too tall, too loud, too alive, too risky?"},{"s":230.5,"e":234.08,"text":"Was it random romance? Was the whole thing arranged?"},{"s":234.26,"e":237.96,"text":"Did some clandestine cupid put our names on a page?"},{"s":238.04,"e":241.42,"text":"Are we partners in something the stars started running?"},{"s":241.5,"e":244.46,"text":"Come find me and tell me—"},{"s":244.46,"e":246.12,"text":"**Which bank we robbin’?**"},{"s":246.12,"e":246.62,"text":"**[Final Chorus]**"},{"s":246.12,"e":249.9,"text":"She fell for the finger, then stayed for the soul,"},{"s":249.9,"e":253.7,"text":"Saw fire in the fracture, saw the half become whole."},{"s":253.7,"e":256.96,"text":"Gold hair glowing while the whole crowd spun,"},{"s":256.96,"e":260.66,"text":"Two strangers became something before the night was done."},{"s":261.36,"e":264.22,"text":"Armin raised heaven, every heartbeat was drumming,"},{"s":264.76,"e":267.86,"text":"Aunt Cindi somewhere laughing, lake wind coming."},{"s":267.86,"e":271.5,"text":"One kiss made a kingdom from a night worth becoming—"},{"s":271.5,"e":274.14,"text":"My first love story started"},{"s":274.5,"e":277.4,"text":"With the middle finger coming."},{"s":277.4,"e":277.9,"text":"**[Outro]**"},{"s":277.4,"e":279.26,"text":"One finger raised."},{"s":279.26,"e":281.06,"text":"One blonde flame."},{"s":281.06,"e":282.86,"text":"Ten thousand faces."},{"s":282.86,"e":284.7,"text":"No last name."},{"s":285.28,"e":288.3,"text":"Milwaukee moonlight, wherever you’re running—"},{"s":288.36,"e":290.2,"text":"Come finish our story."},{"s":290.2,"e":292.06,"text":"**Which bank we robbin’?**"}],"duration":297.16,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.465Z","stats":{"whisperWords":667,"polishedWords":712,"matched":623,"matchRate":0.875}}