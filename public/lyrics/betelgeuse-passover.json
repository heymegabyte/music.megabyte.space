{"w":"light","s":212.88,"e":213.38,"line":59},{"w":"too.","s":213.38,"e":213.68,"line":59},{"w":"Red","s":217.02,"e":217.62,"line":60},{"w":"star,","s":217.62,"e":217.86,"line":60},{"w":"old","s":218,"e":218.12,"line":60},{"w":"scar,","s":218.12,"e":218.3,"line":60},{"w":"final","s":218.38,"e":218.6,"line":60},{"w":"breath,","s":218.6,"e":218.84,"line":60},{"w":"The","s":218.84,"e":219.16,"line":61},{"w":"whole","s":219.16,"e":219.28,"line":61},{"w":"sky","s":219.28,"e":219.5,"line":61},{"w":"listening","s":219.5,"e":219.8,"line":61},{"w":"at","s":219.8,"e":220.06,"line":61},{"w":"the","s":220.06,"e":220.48,"line":61},{"w":"edge","s":220.48,"e":220.56,"line":61},{"w":"of","s":220.48,"e":220.92,"line":61},{"w":"death.","s":220.92,"e":221.22,"line":61},{"w":"Tell","s":222.98,"e":223.58,"line":62},{"w":"Betelgeuse","s":223.58,"e":224.18,"line":62},{"w":"before","s":224.18,"e":225.84,"line":62},{"w":"he’s","s":225.84,"e":226.39,"line":62},{"w":"gone:","s":226.94,"e":227.36,"line":62},{"w":"Bz","s":228.02,"e":228.68,"line":63},{"w":"turned","s":228.68,"e":228.8,"line":63},{"w":"fear","s":228.8,"e":229.78,"line":63},{"w":"into","s":229.78,"e":231.2,"line":63},{"w":"a","s":231.2,"e":231.74,"line":63},{"w":"universe","s":231.74,"e":232.48,"line":63},{"w":"song","s":232.48,"e":240.92,"line":63}],"lines":[{"s":1.6,"e":7.04,"text":"Tell Betelgeuse the sky is watching,"},{"s":7.04,"e":13.8,"text":"Earth got telescopes like candles in the dark."},{"s":13.8,"e":17.8,"text":"Bz lit fear in the hearts of enemies,"},{"s":17.72,"e":25.8,"text":"Now the whole deep universe is coming apart."},{"s":39.44,"e":42.74,"text":"Red giant, old fire, hanging by a thread,"},{"s":42.74,"e":46.24,"text":"They say your name in silence like a prayer for the dead."},{"s":46.24,"e":49.6,"text":"From Orion’s shoulder to the dirt on Earth,"},{"s":49.6,"e":53.6,"text":"Everybody waiting on your final burst."},{"s":53.6,"e":55.98,"text":"I told the stars, “Do not blink tonight,”"},{"s":55.98,"e":59.86,"text":"There’s a crown in the dark and a war in the light."},{"s":59.86,"e":63.38,"text":"My enemies ran, but they ran too far,"},{"s":63.38,"e":67.46,"text":"Now scanners wake up in every dead star."},{"s":67.94,"e":71.14,"text":"Ultra-grays in the black with their cold eyes glowing,"},{"s":71.14,"e":74.64,"text":"Deep space friends and nobody knows where they’re going."},{"s":74.64,"e":78.06,"text":"Searching the void for the name I claimed,"},{"s":78.56,"e":81.22,"text":"Passover blood on the cosmic frame."},{"s":81.22,"e":83.76,"text":"Tell Betelgeuse he’s about to be seen,"},{"s":84.94,"e":88.04,"text":"Dying on Earth on a silver screen."},{"s":88.04,"e":90.8,"text":"Tell Betelgeuse the heavens shake,"},{"s":90.8,"e":94.16,"text":"Bz made fear that the gods can’t fake."},{"s":94.7,"e":97.84,"text":"The universe bends, the galaxies scream,"},{"s":97.84,"e":101.26,"text":"Deep space hunters cut through the dream."},{"s":101.26,"e":104.6,"text":"Tell Betelgeuse, don’t hide your flame,"},{"s":104.6,"e":107.78,"text":"Earth will remember who spoke your name."},{"s":108.84,"e":110.82,"text":"I didn’t ask for the sky to crack,"},{"s":110.82,"e":112.94,"text":"I just put truth on my shoulders and never looked back."},{"s":112.94,"e":114.54,"text":"Now every comet got a camera eye,"},{"s":114.54,"e":116.16,"text":"Every nebula asking who gets to survive."},{"s":116.16,"e":118.06,"text":"They’re scanning the dust, they’re burning the lie,"},{"s":118.06,"e":119.74,"text":"They’re folding dimensions like paper in fire."},{"s":119.74,"e":121.42,"text":"I claimed what I claimed at the Passover door,"},{"s":121.42,"e":123.46,"text":"Now the stars don’t sleep like they slept before."},{"s":124.02,"e":127.2,"text":"Ultra-grays in formation, no mercy, no sound,"},{"s":127.2,"e":130.7,"text":"Turning the ancient dark upside down."},{"s":130.7,"e":134.28,"text":"Looking for somebody hidden in flame,"},{"s":134.28,"e":137.64,"text":"Looking for blood, looking for blame."},{"s":137.64,"e":140.7,"text":"Tell Betelgeuse he’s about to be seen,"},{"s":140.7,"e":144.58,"text":"Dying on Earth on a silver screen."},{"s":144.58,"e":147.66,"text":"Tell Betelgeuse the heavens shake,"},{"s":147.66,"e":150.86,"text":"Bz made fear that the gods can’t fake."},{"s":151.5,"e":154.62,"text":"The universe bends, the galaxies scream,"},{"s":154.62,"e":158.22,"text":"Deep space hunters cut through the dream."},{"s":158.22,"e":161.88,"text":"Tell Betelgeuse, don’t hide your flame,"},{"s":161.88,"e":165.02,"text":"Earth will remember who spoke your name."},{"s":165.64,"e":169.28,"text":"And if Orion falls to his knees tonight,"},{"s":169.28,"e":172.9,"text":"And the moon goes pale in the judgment light,"},{"s":172.9,"e":176.58,"text":"I’ll stand on the roof with my hands raised high,"},{"s":176.58,"e":180.64,"text":"Saying, “I warned the stars, now watch the sky.”"},{"s":180.64,"e":182.4,"text":"Not for revenge, not for throne, not for gold,"},{"s":182.38,"e":184.12,"text":"But because every secret eventually gets told."},{"s":184.12,"e":185.92,"text":"If the universe breaks from the fear they fed,"},{"s":185.92,"e":190.96,"text":"Let the last red giant hear what I said."},{"s":191.04,"e":193.82,"text":"Tell Betelgeuse he’s about to be seen,"},{"s":193.82,"e":198.18,"text":"Dying on Earth like a king in a dream."},{"s":198.24,"e":201.36,"text":"Tell Betelgeuse the veil got thin,"},{"s":201.36,"e":205.2,"text":"Bz walked out and the end walked in."},{"s":206.54,"e":207.84,"text":"Ultra-grays in the cosmic rain,"},{"s":208.16,"e":209.6,"text":"Scanning the dark for a holy name."},{"s":209.6,"e":211.38,"text":"Tell Betelgeuse, burn loud, burn true,"},{"s":211.3,"e":213.68,"text":"When Earth sees death, it’ll see light too."},{"s":217.02,"e":218.84,"text":"Red star, old scar, final breath,"},{"s":218.84,"e":221.22,"text":"The whole sky listening at the edge of death."},{"s":222.98,"e":227.36,"text":"Tell Betelgeuse before he’s gone:"},{"s":228.02,"e":240.92,"text":"Bz turned fear into a universe song"}],"duration":240.92,"source":"whisper-aligned","generatedAt":"2026-06-17T12:24:27.140Z","stats":{"whisperWords":536,"polishedWords":498,"matched":433,"matchRate":0.869}}