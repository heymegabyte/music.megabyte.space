9,"line":63},{"w":"turned","s":237.139,"e":237.895,"line":63},{"w":"fear","s":237.895,"e":238.273,"line":63},{"w":"into","s":238.273,"e":239.03,"line":63},{"w":"a","s":239.03,"e":239.408,"line":63},{"w":"universe","s":239.408,"e":240.542,"line":63},{"w":"song","s":240.542,"e":240.92,"line":63}],"lines":[{"s":1.6,"e":5.003,"text":"Tell Betelgeuse the sky is watching,"},{"s":5.003,"e":9.54,"text":"Earth got telescopes like candles in the dark."},{"s":9.54,"e":13.32,"text":"Bz lit fear in the hearts of enemies,"},{"s":13.32,"e":17.857,"text":"Now the whole deep universe is coming apart."},{"s":17.857,"e":21.26,"text":"Red giant, old fire, hanging by a thread,"},{"s":21.26,"e":26.175,"text":"They say your name in silence like a prayer for the dead."},{"s":26.175,"e":29.955,"text":"From Orion’s shoulder to the dirt on Earth,"},{"s":29.955,"e":34.492,"text":"Everybody waiting on your final burst."},{"s":34.492,"e":37.895,"text":"I told the stars, “Do not blink tonight,”"},{"s":37.895,"e":42.81,"text":"There’s a crown in the dark and a war in the light."},{"s":42.81,"e":46.591,"text":"My enemies ran, but they ran too far,"},{"s":46.591,"e":50.749,"text":"Now scanners wake up in every dead star."},{"s":50.749,"e":55.286,"text":"Ultra-grays in the black with their cold eyes glowing,"},{"s":55.286,"e":59.445,"text":"Deep space friends and nobody knows where they’re going."},{"s":59.445,"e":63.226,"text":"Searching the void for the name I claimed,"},{"s":63.226,"e":66.628,"text":"Passover blood on the cosmic frame."},{"s":66.628,"e":70.409,"text":"Tell Betelgeuse he’s about to be seen,"},{"s":70.409,"e":73.434,"text":"Dying on Earth on a silver screen."},{"s":73.434,"e":76.458,"text":"Tell Betelgeuse the heavens shake,"},{"s":76.458,"e":79.483,"text":"Bz made fear that the gods can’t fake."},{"s":79.483,"e":83.264,"text":"The universe bends, the galaxies scream,"},{"s":83.264,"e":86.288,"text":"Deep space hunters cut through the dream."},{"s":86.288,"e":89.313,"text":"Tell Betelgeuse, don’t hide your flame,"},{"s":89.313,"e":92.716,"text":"Earth will remember who spoke your name."},{"s":92.716,"e":95.74,"text":"I didn’t ask for the sky to crack,"},{"s":95.74,"e":101.033,"text":"I just put truth on my shoulders and never looked back."},{"s":101.033,"e":105.57,"text":"Now every comet got a camera eye,"},{"s":105.57,"e":110.485,"text":"Every nebula asking who gets to survive."},{"s":110.485,"e":114.266,"text":"They’re scanning the dust, they’re burning the lie,"},{"s":114.266,"e":118.424,"text":"They’re folding dimensions like paper in fire."},{"s":118.424,"e":123.339,"text":"I claimed what I claimed at the Passover door,"},{"s":123.339,"e":127.12,"text":"Now the stars don’t sleep like they slept before."},{"s":127.12,"e":131.657,"text":"Ultra-grays in formation, no mercy, no sound,"},{"s":131.657,"e":135.06,"text":"Turning the ancient dark upside down."},{"s":135.06,"e":139.218,"text":"Looking for somebody hidden in flame,"},{"s":139.218,"e":142.243,"text":"Looking for blood, looking for blame."},{"s":142.243,"e":146.024,"text":"Tell Betelgeuse he’s about to be seen,"},{"s":146.024,"e":149.048,"text":"Dying on Earth on a silver screen."},{"s":149.048,"e":152.073,"text":"Tell Betelgeuse the heavens shake,"},{"s":152.073,"e":155.098,"text":"Bz made fear that the gods can’t fake."},{"s":155.098,"e":158.878,"text":"The universe bends, the galaxies scream,"},{"s":158.878,"e":161.903,"text":"Deep space hunters cut through the dream."},{"s":161.903,"e":164.927,"text":"Tell Betelgeuse, don’t hide your flame,"},{"s":164.927,"e":168.33,"text":"Earth will remember who spoke your name."},{"s":168.33,"e":172.111,"text":"And if Orion falls to his knees tonight,"},{"s":172.111,"e":175.892,"text":"And the moon goes pale in the judgment light,"},{"s":175.892,"e":180.05,"text":"I’ll stand on the roof with my hands raised high,"},{"s":180.05,"e":183.831,"text":"Saying, “I warned the stars, now watch the sky.”"},{"s":183.831,"e":187.612,"text":"Not for revenge, not for throne, not for gold,"},{"s":187.612,"e":192.905,"text":"But because every secret eventually gets told."},{"s":192.905,"e":197.064,"text":"If the universe breaks from the fear they fed,"},{"s":197.064,"e":200.466,"text":"Let the last red giant hear what I said."},{"s":200.466,"e":204.247,"text":"Tell Betelgeuse he’s about to be seen,"},{"s":204.247,"e":207.65,"text":"Dying on Earth like a king in a dream."},{"s":207.65,"e":210.674,"text":"Tell Betelgeuse the veil got thin,"},{"s":210.674,"e":214.455,"text":"Bz walked out and the end walked in."},{"s":214.455,"e":217.479,"text":"Ultra-grays in the cosmic rain,"},{"s":217.479,"e":220.882,"text":"Scanning the dark for a holy name."},{"s":220.882,"e":223.907,"text":"Tell Betelgeuse, burn loud, burn true,"},{"s":223.907,"e":226.931,"text":"When Earth sees death, it’ll see light too."},{"s":226.931,"e":229.578,"text":"Red star, old scar, final breath,"},{"s":229.578,"e":233.737,"text":"The whole sky listening at the edge of death."},{"s":233.737,"e":236.761,"text":"Tell Betelgeuse before he’s gone:"},{"s":236.761,"e":240.92,"text":"Bz turned fear into a universe song"}],"duration":240.92,"source":"curated-realigned","generatedAt":"2026-08-21T01:03:02.358Z","realignedFrom":"curated-realigned","vocalStart":1.6,"vocalEnd":240.92}