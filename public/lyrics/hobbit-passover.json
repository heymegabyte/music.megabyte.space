.08,"line":128},{"w":"Carry","s":305.48,"e":306.36,"line":129},{"w":"hope","s":306.36,"e":306.66,"line":129},{"w":"through","s":306.66,"e":306.86,"line":129},{"w":"the","s":306.86,"e":307.8,"line":129},{"w":"horror,","s":307.8,"e":307.88,"line":129},{"w":"make","s":307.8,"e":308.94,"line":129},{"w":"the","s":308.94,"e":309.2,"line":129},{"w":"frightened","s":309.2,"e":309.42,"line":129},{"w":"feel","s":309.42,"e":309.86,"line":129},{"w":"safe.","s":309.86,"e":311.16,"line":129},{"w":"Bring","s":311.16,"e":311.88,"line":130},{"w":"builders,","s":311.88,"e":312.68,"line":130},{"w":"bring","s":312.98,"e":313.32,"line":130},{"w":"teachers,","s":313.32,"e":314.08,"line":130},{"w":"bring","s":314.08,"e":314.66,"line":130},{"w":"shelter,","s":314.66,"e":315.34,"line":130},{"w":"bring","s":316,"e":316.08,"line":130},{"w":"song,","s":316.02,"e":316.78,"line":130},{"w":"When","s":316.78,"e":317.34,"line":131},{"w":"the","s":317.34,"e":317.56,"line":131},{"w":"whole","s":317.56,"e":317.92,"line":131},{"w":"world","s":317.92,"e":318.06,"line":131},{"w":"is","s":318.06,"e":318.94,"line":131},{"w":"wounded,","s":318.94,"e":319.02,"line":131},{"w":"the","s":318.94,"e":319.92,"line":131},{"w":"whole","s":319.92,"e":320.3,"line":131},{"w":"world","s":320.3,"e":320.64,"line":131},{"w":"belongs.","s":320.64,"e":321.66,"line":131},{"w":"From","s":322.47,"e":322.86,"line":133},{"w":"the","s":322.86,"e":323.12,"line":133},{"w":"Hobbit","s":323.12,"e":323.38,"line":133},{"w":"Passover,","s":323.38,"e":324.24,"line":133},{"w":"rise","s":324.24,"e":324.8,"line":133},{"w":"from","s":324.8,"e":325,"line":133},{"w":"the","s":325,"e":325.22,"line":133},{"w":"table,","s":325.22,"e":325.62,"line":133},{"w":"Make","s":325.62,"e":326.06,"line":134},{"w":"mercy","s":326.06,"e":326.4,"line":134},{"w":"organized,","s":327.18,"e":327.32,"line":134},{"w":"fearless","s":327.32,"e":327.6,"line":134},{"w":"and","s":327.6,"e":327.98,"line":134},{"w":"stable.","s":327.98,"e":328.38,"line":134},{"w":"Let","s":328.38,"e":328.7,"line":135},{"w":"brilliance","s":328.7,"e":328.98,"line":135},{"w":"serve","s":328.98,"e":329.32,"line":135},{"w":"people,","s":329.32,"e":329.84,"line":135},{"w":"let","s":329.84,"e":330.08,"line":135},{"w":"privilege","s":330.08,"e":330.4,"line":135},{"w":"restore,","s":330.4,"e":331.02,"line":135},{"w":"Let","s":331.02,"e":331.32,"line":136},{"w":"hands","s":331.32,"e":331.62,"line":136},{"w":"lift","s":331.62,"e":331.86,"line":136},{"w":"humanity","s":331.86,"e":332.66,"line":136},{"w":"higher","s":332.66,"e":333.1,"line":136},{"w":"than","s":333.1,"e":333.36,"line":136},{"w":"before.","s":333.36,"e":334,"line":136},{"w":"The","s":334,"e":334.34,"line":140},{"w":"Salon","s":334.34,"e":335,"line":140},{"w":"grows","s":335,"e":336.36,"line":140},{"w":"silent.","s":336.36,"e":337.42,"line":140},{"w":"The","s":337.42,"e":340.28,"line":141},{"w":"candles","s":340.28,"e":340.36,"line":141},{"w":"burn","s":340.28,"e":341.26,"line":141},{"w":"low.","s":341.26,"e":343.24,"line":141},{"w":"But","s":343.24,"e":345.86,"line":142},{"w":"the","s":345.86,"e":346.14,"line":142},{"w":"questions","s":346.14,"e":346.76,"line":142},{"w":"became","s":346.76,"e":347.72,"line":142},{"w":"marching","s":347.72,"e":349.74,"line":142},{"w":"orders:","s":349.74,"e":351.54,"line":142},{"w":"Learn.","s":351.54,"e":355.1,"line":144},{"w":"Lead.","s":355.1,"e":356.22,"line":145},{"w":"Love.","s":357.34,"e":360.38,"line":146},{"w":"Go.","s":362.44,"e":367.42,"line":147}],"lines":[{"s":2.664,"e":10.36,"text":"# Hobbit Passover: Answer the Call"},{"s":10.28,"e":10.78,"text":""},{"s":10.78,"e":11.28,"text":"[Intro — Piano, soft female vocal]"},{"s":11.28,"e":11.78,"text":""},{"s":10.28,"e":15.06,"text":"Candles in the window, questions in the room,"},{"s":14.98,"e":21.06,"text":"Wisdom in the whisper, warning in the gloom."},{"s":21.06,"e":25.82,"text":"Bread upon the table, truth upon the tongue—"},{"s":25.74,"e":32.3,"text":"The Hobbits raised a vision, now the work’s begun."},{"s":32.12,"e":32.62,"text":""},{"s":32.62,"e":33.12,"text":"[Verse 1 — Melodic rap]"},{"s":33.12,"e":33.62,"text":""},{"s":32.58,"e":35.12,"text":"Monthly at the Salon, Dad gathered the great,"},{"s":35.12,"e":37.98,"text":"Genius minds grinding while I listened and ate."},{"s":37.9,"e":40.66,"text":"Small kid, tall thoughts, caught sparks in the air,"},{"s":40.66,"e":43.5,"text":"They debated what was broken and what made it fair."},{"s":43.32,"e":43.82,"text":""},{"s":43.8,"e":46.5,"text":"Professors with perspectives, poets with a plan,"},{"s":46.5,"e":49.26,"text":"History and mystery, the measure of a man."},{"s":49.22,"e":52,"text":"They didn’t chase clout, they were chasing what’s true,"},{"s":52,"e":55.04,"text":"Asking what the blessed and the brilliant ought to do."},{"s":55.04,"e":55.54,"text":""},{"s":55.42,"e":57.6,"text":"Matzah cracked sharply like a map of the earth,"},{"s":57.6,"e":60.2,"text":"Bitter herbs reminding us what freedom is worth."},{"s":60.2,"e":63.06,"text":"Every cup carried memory, every question carried weight:"},{"s":63.06,"e":65.9,"text":"How can we feast freely while the hungry have to wait?"},{"s":65.82,"e":66.32,"text":""},{"s":65.9,"e":68.72,"text":"I was quiet in the corner, but the calling came clear:"},{"s":68.72,"e":71.48,"text":"Knowledge without kindness is a crown made of fear."},{"s":71.48,"e":74.3,"text":"So we carry what they taught us, turn the lesson into labor—"},{"s":74.3,"e":77.16,"text":"No border makes a stranger, every stranger is a neighbor."},{"s":77.08,"e":77.58,"text":""},{"s":77.58,"e":78.08,"text":"[Pre-Chorus — Female vocal]"},{"s":78.08,"e":78.58,"text":""},{"s":77.08,"e":80.62,"text":"Can you hear the children calling"},{"s":83.14,"e":87,"text":"Through the sirens, smoke and rain?"},{"s":88.22,"e":92.72,"text":"We can’t claim that we are free"},{"s":92.72,"e":99.26,"text":"While another wears the chain."},{"s":99.26,"e":99.76,"text":""},{"s":99.76,"e":100.26,"text":"[Chorus — Duet]"},{"s":100.26,"e":100.76,"text":""},{"s":99.26,"e":104.16,"text":"This is a call to arms—but the arms bring aid,"},{"s":104.16,"e":110.28,"text":"Carry food through the flood, bring the light through the shade."},{"s":110.28,"e":115.8,"text":"Bring doctors, bring water, bring shelter, bring song,"},{"s":115.8,"e":120.9,"text":"When the whole world is hurting, the whole world belongs."},{"s":120.9,"e":121.4,"text":""},{"s":121.26,"e":124.68,"text":"From the Hobbit Passover, rise from the table,"},{"s":124.68,"e":127.42,"text":"Give what you have, do whatever you’re able."},{"s":127.42,"e":130.1,"text":"No guns in the gathering, no glory in war—"},{"s":130.1,"e":132.94,"text":"Just hands lifting humanity higher than before."},{"s":132.94,"e":133.44,"text":""},{"s":133.44,"e":133.94,"text":"[Verse 2 — Faster rap]"},{"s":133.94,"e":134.44,"text":""},{"s":132.94,"e":135.58,"text":"Pack medicine, meals, maps, masks in the crates,"},{"s":135.56,"e":138.46,"text":"Move fast when disaster is testing the gates."},{"s":138.38,"e":141.16,"text":"From famine to fire, from the quake to the cold,"},{"s":141.14,"e":143.94,"text":"Let compassion move quicker than silver and gold."},{"s":143.94,"e":144.44,"text":""},{"s":143.94,"e":146.9,"text":"Build bridges, not bases; bring blankets, not blame,"},{"s":146.9,"e":149.48,"text":"Feed families first, never market their pain."},{"s":149.48,"e":152.34,"text":"Let the wealthy write checks, let the workers take flight,"},{"s":152.34,"e":155.24,"text":"Let the coders build systems that deliver it right."},{"s":155.24,"e":155.74,"text":""},{"s":155.24,"e":157.76,"text":"Track every dollar, every pallet, every plane,"},{"s":157.76,"e":160.64,"text":"Cut fraud from the flow, keep relief in the lane."},{"s":160.66,"e":163.58,"text":"Local leaders lead; we support, never steer,"},{"s":163.58,"e":166.38,"text":"Put dignity first and make every mission clear."},{"s":166.38,"e":166.88,"text":""},{"s":166.38,"e":169.16,"text":"The Hobbits taught discussion, but discussion must deploy;"},{"s":169.16,"e":171.92,"text":"A theory can’t feed every girl and every boy."},{"s":171.9,"e":174.58,"text":"We need wisdom with wheels, we need mercy with might,"},{"s":174.58,"e":177.2,"text":"We need thousands moving through the middle of the night."},{"s":177.2,"e":177.7,"text":""},{"s":177.2,"e":178.98,"text":"Not conquest—coordination."},{"s":178.98,"e":181.04,"text":"Not control—cooperation."},{"s":181.04,"e":184.24,"text":"A global generation building bold humanitarian stations."},{"s":184.24,"e":186.86,"text":"From Newark to Nairobi, Gaza, Haiti, Ukraine,"},{"s":186.78,"e":189.44,"text":"Wherever people suffer, we respond to the pain."},{"s":189.36,"e":189.86,"text":""},{"s":189.86,"e":190.36,"text":"[Pre-Chorus — Female vocal]"},{"s":190.36,"e":190.86,"text":""},{"s":189.36,"e":193.9,"text":"Every candle is a promise,"},{"s":193.82,"e":199.84,"text":"Every promise needs a hand."},{"s":201.02,"e":204.92,"text":"Freedom isn’t merely leaving—"},{"s":204.92,"e":210.36,"text":"Freedom helps another stand."},{"s":210.36,"e":210.86,"text":""},{"s":210.86,"e":211.36,"text":"[Chorus — Duet]"},{"s":211.36,"e":211.86,"text":""},{"s":210.36,"e":216.1,"text":"This is a call to arms—but the arms bring aid,"},{"s":216.22,"e":221.8,"text":"Carry food through the flood, bring the light through the shade."},{"s":221.84,"e":227.44,"text":"Bring doctors, bring water, bring shelter, bring song,"},{"s":227.44,"e":232.32,"text":"When the whole world is hurting, the whole world belongs."},{"s":232.32,"e":232.82,"text":""},{"s":232.82,"e":236.32,"text":"From the Hobbit Passover, rise from the table,"},{"s":236.32,"e":239.06,"text":"Give what you have, do whatever you’re able."},{"s":239.06,"e":241.74,"text":"No guns in the gathering, no glory in war—"},{"s":241.74,"e":244.78,"text":"Just hands lifting humanity higher than before."},{"s":244.78,"e":245.28,"text":""},{"s":245.28,"e":245.78,"text":"[Bridge — Piano and choir]"},{"s":245.78,"e":246.28,"text":""},{"s":244.78,"e":247.28,"text":"Why is this night different?"},{"s":247.88,"e":250.1,"text":"Because tonight we decide"},{"s":250.1,"e":253.1,"text":"That no child faces hunger"},{"s":253.1,"e":256,"text":"While abundance waits outside."},{"s":256,"e":256.5,"text":""},{"s":256,"e":257.68,"text":"Why do we remember?"},{"s":259.04,"e":261.26,"text":"So oppression can’t repeat."},{"s":261.26,"e":263.84,"text":"Why do we keep asking?"},{"s":264.78,"e":267.06,"text":"So our answers grow feet."},{"s":267.06,"e":267.56,"text":""},{"s":267.5,"e":268.68,"text":"Dayenu for the dialogue,"},{"s":268.68,"e":272.46,"text":"But dialogue isn’t done."},{"s":273.06,"e":274.42,"text":"Dayenu for the candle—"},{"s":274.42,"e":278.36,"text":"Now we carry out the sun."},{"s":278.36,"e":278.86,"text":""},{"s":278.86,"e":279.36,"text":"[Breakdown — Heavy bass]"},{"s":279.36,"e":279.86,"text":""},{"s":279.1,"e":280.9,"text":"Bread breaks—teams move."},{"s":281.82,"e":283.7,"text":"Truth speaks—prove, improve."},{"s":283.84,"e":286.48,"text":"Planes rise—aid lands."},{"s":286.48,"e":289.54,"text":"Hope lives—helping hands."},{"s":289.54,"e":290.04,"text":""},{"s":289.54,"e":292.04,"text":"Think deep. Move smart."},{"s":292.04,"e":294.82,"text":"Lead strong. Keep heart."},{"s":294.82,"e":297.54,"text":"One world. One fight:"},{"s":297.54,"e":300.22,"text":"Keep every human life in sight."},{"s":300.2,"e":300.7,"text":""},{"s":300.7,"e":301.2,"text":"[Final Chorus — Huge duet and choir]"},{"s":301.2,"e":301.7,"text":""},{"s":300.2,"e":305.08,"text":"This is a call to arms—but the arms bring aid,"},{"s":305.48,"e":311.16,"text":"Carry hope through the horror, make the frightened feel safe."},{"s":311.16,"e":316.78,"text":"Bring builders, bring teachers, bring shelter, bring song,"},{"s":316.78,"e":321.66,"text":"When the whole world is wounded, the whole world belongs."},{"s":321.66,"e":322.16,"text":""},{"s":322.47,"e":325.62,"text":"From the Hobbit Passover, rise from the table,"},{"s":325.62,"e":328.38,"text":"Make mercy organized, fearless and stable."},{"s":328.38,"e":331.02,"text":"Let brilliance serve people, let privilege restore,"},{"s":331.02,"e":334,"text":"Let hands lift humanity higher than before."},{"s":334,"e":334.5,"text":""},{"s":334.5,"e":335,"text":"[Outro]"},{"s":335,"e":335.5,"text":""},{"s":334,"e":337.42,"text":"The Salon grows silent."},{"s":337.42,"e":343.24,"text":"The candles burn low."},{"s":343.24,"e":351.54,"text":"But the questions became marching orders:"},{"s":351.54,"e":352.04,"text":""},{"s":351.54,"e":355.1,"text":"Learn."},{"s":355.1,"e":356.22,"text":"Lead."},{"s":357.34,"e":360.38,"text":"Love."},{"s":362.44,"e":367.42,"text":"Go."}],"duration":371.48,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.454Z","stats":{"whisperWords":712,"polishedWords":709,"matched":661,"matchRate":0.932}}