,"line":55},{"w":"meme","s":163.454,"e":163.791,"line":55},{"w":"my","s":163.791,"e":164.128,"line":55},{"w":"broken","s":164.128,"e":164.803,"line":55},{"w":"dream,","s":164.803,"e":165.14,"line":55},{"w":"I’ll","s":165.14,"e":165.477,"line":56},{"w":"be","s":165.477,"e":165.814,"line":56},{"w":"wrong","s":165.814,"e":166.152,"line":56},{"w":"in","s":166.152,"e":166.489,"line":56},{"w":"every","s":166.489,"e":167.5,"line":56},{"w":"room","s":167.5,"e":167.838,"line":56},{"w":"If","s":167.838,"e":168.175,"line":57},{"w":"being","s":168.175,"e":168.512,"line":57},{"w":"right","s":168.512,"e":168.849,"line":57},{"w":"means","s":168.849,"e":169.186,"line":57},{"w":"cheering","s":169.186,"e":169.861,"line":57},{"w":"doom.","s":169.861,"e":170.198,"line":57},{"w":"Peace","s":170.198,"e":170.535,"line":58},{"w":"sounds","s":170.535,"e":170.872,"line":58},{"w":"stupid","s":170.872,"e":171.547,"line":58},{"w":"till","s":171.547,"e":171.884,"line":58},{"w":"the","s":171.884,"e":172.221,"line":58},{"w":"sirens","s":172.221,"e":172.896,"line":58},{"w":"start,","s":172.896,"e":173.233,"line":58},{"w":"Peace","s":173.233,"e":173.57,"line":59},{"w":"looks","s":173.57,"e":173.907,"line":59},{"w":"weak","s":173.907,"e":174.244,"line":59},{"w":"till","s":174.244,"e":174.582,"line":59},{"w":"it","s":174.582,"e":174.919,"line":59},{"w":"saves","s":174.919,"e":175.593,"line":59},{"w":"your","s":175.593,"e":175.93,"line":59},{"w":"heart,","s":175.93,"e":176.268,"line":59},{"w":"Call","s":176.268,"e":176.605,"line":60},{"w":"me","s":176.605,"e":176.942,"line":60},{"w":"whatever,","s":176.942,"e":177.954,"line":60},{"w":"drag","s":177.954,"e":178.291,"line":60},{"w":"me","s":178.291,"e":178.628,"line":60},{"w":"all","s":178.628,"e":178.965,"line":60},{"w":"night,","s":178.965,"e":179.302,"line":60},{"w":"I","s":179.302,"e":179.64,"line":61},{"w":"still","s":179.64,"e":179.977,"line":61},{"w":"don’t","s":179.977,"e":180.314,"line":61},{"w":"think","s":180.314,"e":180.651,"line":61},{"w":"the","s":180.651,"e":180.988,"line":61},{"w":"war","s":180.988,"e":181.326,"line":61},{"w":"is","s":181.326,"e":181.663,"line":61},{"w":"right.","s":181.663,"e":182,"line":61}],"lines":[{"s":1.26,"e":5.306,"text":"I walked into the room with a cardboard sign,"},{"s":5.306,"e":8.341,"text":"Said, “Maybe don’t kill people all the time,”"},{"s":8.341,"e":12.388,"text":"Everybody laughed like I broke the law,"},{"s":12.388,"e":16.097,"text":"Like mercy was a glitch that nobody saw."},{"s":16.097,"e":19.132,"text":"I said, “Kids don’t care who drew the map,”"},{"s":19.132,"e":22.504,"text":"They said, “That’s problematic, take it back,”"},{"s":22.504,"e":25.876,"text":"I said, “Moms are crying on both sides too,”"},{"s":25.876,"e":29.248,"text":"They said, “We’re making a thread about you.”"},{"s":29.248,"e":32.283,"text":"I’m not a prophet, I’m not that smart,"},{"s":32.283,"e":35.655,"text":"I just got a dent in my bleeding heart,"},{"s":35.655,"e":38.352,"text":"If peace is cringe, then let me be,"},{"s":38.352,"e":41.05,"text":"The dumbest man in history."},{"s":41.05,"e":43.073,"text":"Stop the bombs, stop the tanks,"},{"s":43.073,"e":46.108,"text":"Stop the blood in the rivers and banks,"},{"s":46.108,"e":48.805,"text":"Stop the kings with their golden lies,"},{"s":48.805,"e":51.84,"text":"Stop the drones in the children’s skies."},{"s":51.84,"e":52.852,"text":"And they said,"},{"s":52.852,"e":55.887,"text":"“Boo, you said it wrong, you don’t belong,"},{"s":55.887,"e":59.259,"text":"We clipped your face, we tagged your song,"},{"s":59.259,"e":62.631,"text":"You asked for peace but your tone was off,"},{"s":62.631,"e":65.665,"text":"So now you’re canceled, now get lost.”"},{"s":65.665,"e":68.7,"text":"I tried to say, “Can we save the town?”"},{"s":68.7,"e":71.735,"text":"They said, “Your language is violence, clown,”"},{"s":71.735,"e":75.107,"text":"I said, “No more widows, no more graves,”"},{"s":75.107,"e":78.479,"text":"They said, “That’s centering yourself today.”"},{"s":78.479,"e":81.851,"text":"They formed a choir with nails and phones,"},{"s":81.851,"e":86.235,"text":"Threw digital stones from ergonomic thrones,"},{"s":86.235,"e":89.607,"text":"I said, “Please don’t cheer when missiles fly,”"},{"s":89.607,"e":92.304,"text":"They said, “Actually, here’s why.”"},{"s":92.304,"e":95.676,"text":"I’m not a genius, I’m barely fine,"},{"s":95.676,"e":98.711,"text":"I lose my keys and my train of mind,"},{"s":98.711,"e":101.409,"text":"But I know one thing in my chest:"},{"s":101.409,"e":104.106,"text":"Dead kids don’t make flags look blessed."},{"s":104.106,"e":106.13,"text":"Stop the bombs, stop the tanks,"},{"s":106.13,"e":109.164,"text":"Stop the blood in the rivers and banks,"},{"s":109.164,"e":111.862,"text":"Stop the kings with their golden lies,"},{"s":111.862,"e":114.897,"text":"Stop the drones in the children’s skies."},{"s":114.897,"e":115.909,"text":"And they said,"},{"s":115.909,"e":118.943,"text":"“Boo, you said it wrong, you don’t belong,"},{"s":118.943,"e":122.315,"text":"We clipped your face, we tagged your song,"},{"s":122.315,"e":125.687,"text":"You asked for peace but your tone was off,"},{"s":125.687,"e":128.722,"text":"So now you’re canceled, now get lost.”"},{"s":128.722,"e":131.083,"text":"Maybe I’m foolish, maybe I’m slow,"},{"s":131.083,"e":133.443,"text":"Maybe there’s nuance I don’t know,"},{"s":133.443,"e":136.141,"text":"But if the nuance needs more graves,"},{"s":136.141,"e":138.164,"text":"Maybe the nuance should behave."},{"s":138.164,"e":141.199,"text":"I don’t want medals, I don’t want fame,"},{"s":141.199,"e":144.233,"text":"I don’t want hashtags eating my name,"},{"s":144.233,"e":146.931,"text":"I just want babies waking up"},{"s":146.931,"e":149.966,"text":"Without the sky exploding above."},{"s":149.966,"e":151.989,"text":"Stop the bombs, stop the tanks,"},{"s":151.989,"e":155.024,"text":"Stop the blood in the rivers and banks,"},{"s":155.024,"e":157.721,"text":"Stop the men with the holy scripts,"},{"s":157.721,"e":160.419,"text":"Signing death with their fingertips."},{"s":160.419,"e":162.78,"text":"Let them mock me, let them scream,"},{"s":162.78,"e":165.14,"text":"Let them meme my broken dream,"},{"s":165.14,"e":167.838,"text":"I’ll be wrong in every room"},{"s":167.838,"e":170.198,"text":"If being right means cheering doom."},{"s":170.198,"e":173.233,"text":"Peace sounds stupid till the sirens start,"},{"s":173.233,"e":176.268,"text":"Peace looks weak till it saves your heart,"},{"s":176.268,"e":179.302,"text":"Call me whatever, drag me all night,"},{"s":179.302,"e":182,"text":"I still don’t think the war is right."}],"duration":194.64,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.853Z","realignedFrom":"whisper-aligned","vocalStart":1.26,"vocalEnd":182}