164.22,"e":165.12,"line":58},{"w":"Peace","s":166.24,"e":167.24,"line":59},{"w":"looks","s":167.24,"e":167.54,"line":59},{"w":"weak","s":167.54,"e":168.26,"line":59},{"w":"till","s":168.26,"e":168.78,"line":59},{"w":"it","s":168.78,"e":169.02,"line":59},{"w":"saves","s":169.02,"e":169.26,"line":59},{"w":"your","s":169.26,"e":169.58,"line":59},{"w":"heart,","s":169.58,"e":170.4,"line":59},{"w":"Call","s":171.14,"e":172.14,"line":60},{"w":"me","s":172.14,"e":172.58,"line":60},{"w":"whatever,","s":172.58,"e":173.5,"line":60},{"w":"drag","s":174.18,"e":174.38,"line":60},{"w":"me","s":174.38,"e":174.7,"line":60},{"w":"all","s":174.7,"e":175.18,"line":60},{"w":"night,","s":175.18,"e":175.46,"line":60},{"w":"I","s":176.3,"e":177.3,"line":61},{"w":"still","s":177.3,"e":177.66,"line":61},{"w":"don’t","s":177.66,"e":177.86,"line":61},{"w":"think","s":178.06,"e":178.72,"line":61},{"w":"the","s":178.72,"e":179.4,"line":61},{"w":"war","s":179.4,"e":179.78,"line":61},{"w":"is","s":179.78,"e":180.98,"line":61},{"w":"right.","s":180.98,"e":182,"line":61}],"lines":[{"s":1.26,"e":4.64,"text":"I walked into the room with a cardboard sign,"},{"s":4.64,"e":7.2,"text":"Said, “Maybe don’t kill people all the time,”"},{"s":7.32,"e":9.58,"text":"Everybody laughed like I broke the law,"},{"s":9.52,"e":12.4,"text":"Like mercy was a glitch that nobody saw."},{"s":12.4,"e":15.3,"text":"I said, “Kids don’t care who drew the map,”"},{"s":15.24,"e":17.86,"text":"They said, “That’s problematic, take it back,”"},{"s":17.86,"e":20.46,"text":"I said, “Moms are crying on both sides too,”"},{"s":20.46,"e":22.78,"text":"They said, “We’re making a thread about you.”"},{"s":22.78,"e":25.1,"text":"I’m not a prophet, I’m not that smart,"},{"s":25.1,"e":27.82,"text":"I just got a dent in my bleeding heart,"},{"s":27.82,"e":30.4,"text":"If peace is cringe, then let me be,"},{"s":30.4,"e":33.14,"text":"The dumbest man in history."},{"s":33.14,"e":35.66,"text":"Stop the bombs, stop the tanks,"},{"s":35.6,"e":38.14,"text":"Stop the blood in the rivers and banks,"},{"s":38.16,"e":40.98,"text":"Stop the kings with their golden lies,"},{"s":40.98,"e":43.32,"text":"Stop the drones in the children’s skies."},{"s":43.32,"e":44.1,"text":"And they said,"},{"s":44.32,"e":46.64,"text":"“Boo, you said it wrong, you don’t belong,"},{"s":46.66,"e":49.24,"text":"We clipped your face, we tagged your song,"},{"s":49.24,"e":52.02,"text":"You asked for peace but your tone was off,"},{"s":52.02,"e":54.94,"text":"So now you’re canceled, now get lost.”"},{"s":58.55,"e":61.34,"text":"I tried to say, “Can we save the town?”"},{"s":61.54,"e":64,"text":"They said, “Your language is violence, clown,”"},{"s":63.92,"e":66.8,"text":"I said, “No more widows, no more graves,”"},{"s":66.8,"e":69.34,"text":"They said, “That’s centering yourself today.”"},{"s":69.34,"e":71.42,"text":"They formed a choir with nails and phones,"},{"s":71.42,"e":74.56,"text":"Threw digital stones from ergonomic thrones,"},{"s":74.56,"e":77.28,"text":"I said, “Please don’t cheer when missiles fly,”"},{"s":77.28,"e":79.58,"text":"They said, “Actually, here’s why.”"},{"s":79.58,"e":81.8,"text":"I’m not a genius, I’m barely fine,"},{"s":81.8,"e":84.48,"text":"I lose my keys and my train of mind,"},{"s":84.48,"e":87.08,"text":"But I know one thing in my chest:"},{"s":87.08,"e":90,"text":"Dead kids don’t make flags look blessed."},{"s":90,"e":92.26,"text":"Stop the bombs, stop the tanks,"},{"s":92.26,"e":94.8,"text":"Stop the blood in the rivers and banks,"},{"s":94.84,"e":97.64,"text":"Stop the kings with their golden lies,"},{"s":97.64,"e":100,"text":"Stop the drones in the children’s skies."},{"s":100,"e":100.78,"text":"And they said,"},{"s":100.88,"e":103.22,"text":"“Boo, you said it wrong, you don’t belong,"},{"s":103.3,"e":105.6,"text":"We clipped your face, we tagged your song,"},{"s":105.86,"e":108.54,"text":"You asked for peace but your tone was off,"},{"s":108.54,"e":111.6,"text":"So now you’re canceled, now get lost.”"},{"s":116,"e":118.62,"text":"Maybe I’m foolish, maybe I’m slow,"},{"s":118.62,"e":121.1,"text":"Maybe there’s nuance I don’t know,"},{"s":121.1,"e":123.8,"text":"But if the nuance needs more graves,"},{"s":123.8,"e":126.14,"text":"Maybe the nuance should behave."},{"s":126.14,"e":128.7,"text":"I don’t want medals, I don’t want fame,"},{"s":128.7,"e":131.34,"text":"I don’t want hashtags eating my name,"},{"s":131.34,"e":133.92,"text":"I just want babies waking up"},{"s":133.92,"e":138,"text":"Without the sky exploding above."},{"s":138.2,"e":141.1,"text":"Stop the bombs, stop the tanks,"},{"s":141.02,"e":143.6,"text":"Stop the blood in the rivers and banks,"},{"s":143.6,"e":146.2,"text":"Stop the men with the holy scripts,"},{"s":146.2,"e":148.94,"text":"Signing death with their fingertips."},{"s":148.94,"e":151.38,"text":"Let them mock me, let them scream,"},{"s":151.38,"e":153.96,"text":"Let them meme my broken dream,"},{"s":153.96,"e":156.66,"text":"I’ll be wrong in every room"},{"s":156.66,"e":160.52,"text":"If being right means cheering doom."},{"s":161.34,"e":165.12,"text":"Peace sounds stupid till the sirens start,"},{"s":166.24,"e":170.4,"text":"Peace looks weak till it saves your heart,"},{"s":171.14,"e":175.46,"text":"Call me whatever, drag me all night,"},{"s":176.3,"e":182,"text":"I still don’t think the war is right."}],"duration":194.64,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.396Z","stats":{"whisperWords":466,"polishedWords":464,"matched":457,"matchRate":0.985}}