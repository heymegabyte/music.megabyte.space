5},{"w":"ain’t","s":235.261,"e":235.554,"line":85},{"w":"cheap,","s":235.554,"e":235.847,"line":85},{"w":"I","s":235.847,"e":236.14,"line":86},{"w":"don’t","s":236.14,"e":236.433,"line":86},{"w":"wrestle","s":236.433,"e":237.018,"line":86},{"w":"every","s":237.018,"e":237.897,"line":86},{"w":"nightmare","s":237.897,"e":238.483,"line":86},{"w":"that","s":238.483,"e":238.776,"line":86},{"w":"comes","s":238.776,"e":239.362,"line":86},{"w":"crawling","s":239.362,"e":239.948,"line":86},{"w":"through","s":239.948,"e":240.241,"line":86},{"w":"my","s":240.241,"e":240.534,"line":86},{"w":"sleep,","s":240.534,"e":240.827,"line":86},{"w":"Let","s":240.827,"e":241.12,"line":87},{"w":"it","s":241.12,"e":241.413,"line":87},{"w":"knock,","s":241.413,"e":241.706,"line":87},{"w":"let","s":241.706,"e":241.999,"line":87},{"w":"it","s":241.999,"e":242.292,"line":87},{"w":"talk,","s":242.292,"e":242.585,"line":87},{"w":"let","s":242.585,"e":242.878,"line":87},{"w":"it","s":242.878,"e":243.171,"line":87},{"w":"promise,","s":243.171,"e":243.757,"line":87},{"w":"let","s":243.757,"e":244.05,"line":87},{"w":"it","s":244.05,"e":244.343,"line":87},{"w":"plead—","s":244.343,"e":244.636,"line":87},{"w":"I","s":244.636,"e":244.929,"line":88},{"w":"decide","s":244.929,"e":245.515,"line":88},{"w":"what","s":245.515,"e":245.808,"line":88},{"w":"gets","s":245.808,"e":246.101,"line":88},{"w":"my","s":246.101,"e":246.394,"line":88},{"w":"focus.","s":246.394,"e":246.98,"line":88},{"w":"I","s":246.98,"e":247.272,"line":89},{"w":"decide","s":247.272,"e":247.858,"line":89},{"w":"what","s":247.858,"e":248.151,"line":89},{"w":"I","s":248.151,"e":248.444,"line":89},{"w":"believe.","s":248.444,"e":249.03,"line":89},{"w":"**[Outro","s":249.03,"e":249.616,"line":90},{"w":"—","s":249.616,"e":249.909,"line":90},{"w":"piano","s":249.909,"e":250.495,"line":90},{"w":"only]**","s":250.495,"e":251.081,"line":90},{"w":"There","s":251.081,"e":251.374,"line":91},{"w":"you","s":251.374,"e":251.667,"line":91},{"w":"go","s":251.667,"e":251.96,"line":91},{"w":"again...","s":251.96,"e":252.546,"line":91},{"w":"Tryin’","s":252.546,"e":252.839,"line":92},{"w":"to","s":252.839,"e":253.132,"line":92},{"w":"sound","s":253.132,"e":253.425,"line":92},{"w":"important.","s":253.425,"e":254.304,"line":92},{"w":"Ha.","s":254.304,"e":255.204,"line":93},{"w":"Almost","s":253.8,"e":253.88,"line":94},{"w":"had","s":253.8,"e":253.88,"line":94},{"w":"me.","s":253.8,"e":253.88,"line":94}],"lines":[{"s":0.672,"e":2.43,"text":"# You Almost Had Me"},{"s":2.43,"e":6.824,"text":"**[Intro — male lead, intimate, over lonely piano]**"},{"s":6.824,"e":8.289,"text":"There you go again..."},{"s":8.289,"e":11.219,"text":"Talkin’ like a thought is a prophecy."},{"s":11.219,"e":12.119,"text":"Ha."},{"s":12.119,"e":13.584,"text":"You almost had me."},{"s":13.584,"e":14.484,"text":"**[Verse 1]**"},{"s":14.484,"e":17.414,"text":"Woke up, mind already makin’ a movie,"},{"s":17.414,"e":20.343,"text":"Worst-case scenes tryna shake and move me,"},{"s":20.343,"e":23.859,"text":"“You gon’ lose this, everybody sees through me,”"},{"s":23.859,"e":27.375,"text":"Old voice talkin’ like it ever really knew me."},{"s":27.375,"e":30.89,"text":"Used to grab every thought like evidence,"},{"s":30.89,"e":33.527,"text":"Give fear a throne, give doubt residence,"},{"s":33.527,"e":36.457,"text":"Now I watch that noise with intelligence—"},{"s":36.457,"e":38.801,"text":"Thought ain’t fact, that’s the difference."},{"s":38.801,"e":42.023,"text":"Here come anger with a match and gasoline,"},{"s":42.023,"e":44.953,"text":"Here come shame tryna edit what I’ve seen,"},{"s":44.953,"e":48.176,"text":"Here come fear dressed sharp, lookin’ evergreen,"},{"s":48.176,"e":51.984,"text":"But I caught that little hook before it got in me."},{"s":51.984,"e":52.884,"text":"**[Pre-Chorus]**"},{"s":52.884,"e":54.935,"text":"Oh, you wanted my pulse up,"},{"s":54.935,"e":56.4,"text":"Wanted my fists shut,"},{"s":56.4,"e":60.209,"text":"Wanted one bad thought to make my whole day fucked up—"},{"s":60.209,"e":62.259,"text":"Then I saw what you were doin’..."},{"s":62.259,"e":64.017,"text":"And I started laughin’."},{"s":64.017,"e":66.654,"text":"**[Chorus — huge melodic release]**"},{"s":66.654,"e":69.877,"text":"You almost had me, almost made me believe,"},{"s":69.877,"e":74.271,"text":"Almost turned a little thought to a life sentence on me,"},{"s":74.271,"e":77.787,"text":"But I saw you reachin’, saw the trick up your sleeve,"},{"s":77.787,"e":81.889,"text":"Now I’m laughin’ while you’re talkin’—you got nothin’ I need."},{"s":81.889,"e":84.818,"text":"You almost had me, almost stole my peace,"},{"s":84.818,"e":88.92,"text":"But the second I could see you, you got weaker to me,"},{"s":88.92,"e":92.436,"text":"You can scream, you can scheme, you can beg me to bleed—"},{"s":92.436,"e":95.951,"text":"You’re a thought, not a truth, you don’t get to be me."},{"s":95.951,"e":96.851,"text":"**[Post-Chorus]**"},{"s":96.851,"e":98.023,"text":"Ha—almost had me."},{"s":98.023,"e":98.923,"text":"Not today."},{"s":98.923,"e":99.823,"text":"Thought, not fact."},{"s":99.823,"e":100.723,"text":"Watch it fade."},{"s":100.723,"e":102.774,"text":"**[Verse 2 — drums hit harder]**"},{"s":102.774,"e":105.997,"text":"Now my mind throws bait and I notice the line,"},{"s":105.997,"e":109.219,"text":"“Get mad right now!” — nah, I’m takin’ my time,"},{"s":109.219,"e":113.321,"text":"“Everybody hates you!” — cute story, nice try,"},{"s":113.321,"e":117.423,"text":"I don’t gotta climb aboard every train passing by."},{"s":117.423,"e":120.938,"text":"I can feel what I feel without feeding the flame,"},{"s":120.938,"e":123.868,"text":"Name the emotion, don’t become its name,"},{"s":123.868,"e":127.091,"text":"Let the wave roll through, let it rise, let it change,"},{"s":127.091,"e":130.313,"text":"Wise mind at the wheel while the weather gets strange."},{"s":130.313,"e":133.536,"text":"See, peace ain’t never having darkness appear,"},{"s":133.536,"e":136.759,"text":"Peace is darkness knockin’ and me staying right here,"},{"s":136.759,"e":141.446,"text":"I can hear every threat that imagination declares"},{"s":141.446,"e":145.255,"text":"And still choose my next move instead of choosing my fear."},{"s":145.255,"e":146.155,"text":"**[Pre-Chorus]**"},{"s":146.155,"e":147.62,"text":"You wanted reaction,"},{"s":147.62,"e":149.085,"text":"Wanted distraction,"},{"s":149.085,"e":152.893,"text":"Wanted one assumption turned into an action,"},{"s":152.893,"e":155.237,"text":"But I caught you in the act and—"},{"s":155.237,"e":156.995,"text":"Damn, that’s kinda funny."},{"s":156.995,"e":157.895,"text":"**[Chorus]**"},{"s":157.895,"e":161.118,"text":"You almost had me, almost made me believe,"},{"s":161.118,"e":165.512,"text":"Almost turned a little thought to a life sentence on me,"},{"s":165.512,"e":169.028,"text":"But I saw you reachin’, saw the trick up your sleeve,"},{"s":169.028,"e":173.129,"text":"Now I’m laughin’ while you’re talkin’—you got nothin’ I need."},{"s":173.129,"e":176.059,"text":"You almost had me, almost stole my peace,"},{"s":176.059,"e":180.161,"text":"But the second I could see you, you got weaker to me,"},{"s":180.161,"e":183.676,"text":"You can scream, you can scheme, you can beg me to bleed—"},{"s":183.676,"e":187.192,"text":"You’re a thought, not a truth, you don’t get to be me."},{"s":187.192,"e":191.88,"text":"**[Bridge — drums disappear, exposed piano + distant vocal]**"},{"s":191.88,"e":193.637,"text":"I don’t have to fight you."},{"s":193.637,"e":195.102,"text":"I don’t have to flee."},{"s":195.102,"e":197.153,"text":"I don’t have to prove you wrong"},{"s":197.153,"e":199.497,"text":"To keep you from controlling me."},{"s":199.497,"e":200.669,"text":"I can watch you."},{"s":200.669,"e":201.841,"text":"I can name you."},{"s":201.841,"e":203.892,"text":"I can smile and let you leave."},{"s":203.892,"e":205.942,"text":"Funny how the monster shrinks"},{"s":205.942,"e":207.7,"text":"The second that I see..."},{"s":207.7,"e":209.458,"text":"**[Beat Drop — near silence]**"},{"s":209.458,"e":210.358,"text":"Oh."},{"s":210.358,"e":212.116,"text":"You wanted a reaction."},{"s":212.116,"e":216.51,"text":"**[Final Chorus — massive bass, piano, stacked harmonies]**"},{"s":216.51,"e":219.733,"text":"YOU ALMOST HAD ME—now I know what you do,"},{"s":219.733,"e":223.835,"text":"Take a maybe, make it misery, then masquerade as truth,"},{"s":223.835,"e":228.522,"text":"But I’m quicker with the distance, I’m deliberate with moves,"},{"s":228.522,"e":232.917,"text":"I can hear you without serving you—that’s freedom coming through."},{"s":232.917,"e":235.847,"text":"You almost had me, but my peace ain’t cheap,"},{"s":235.847,"e":240.827,"text":"I don’t wrestle every nightmare that comes crawling through my sleep,"},{"s":240.827,"e":244.636,"text":"Let it knock, let it talk, let it promise, let it plead—"},{"s":244.636,"e":246.98,"text":"I decide what gets my focus."},{"s":246.98,"e":249.03,"text":"I decide what I believe."},{"s":249.03,"e":251.081,"text":"**[Outro — piano only]**"},{"s":251.081,"e":252.546,"text":"There you go again..."},{"s":252.546,"e":254.304,"text":"Tryin’ to sound important."},{"s":254.304,"e":255.204,"text":"Ha."},{"s":253.8,"e":253.88,"text":"Almost had me."}],"duration":254.68,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.127Z","realignedFrom":"whisper-aligned","vocalStart":0.672,"vocalEnd":253.8}