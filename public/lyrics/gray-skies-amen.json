e":208.838,"line":56},{"w":"enough","s":208.838,"e":209.571,"line":56},{"w":"to","s":209.571,"e":209.937,"line":56},{"w":"heal","s":209.937,"e":210.304,"line":56},{"w":"the","s":210.304,"e":210.67,"line":56},{"w":"Earth.","s":210.67,"e":211.037,"line":56},{"w":"Let","s":211.037,"e":211.403,"line":57},{"w":"peace","s":211.403,"e":211.77,"line":57},{"w":"have","s":211.77,"e":212.136,"line":57},{"w":"power.","s":212.136,"e":212.869,"line":57},{"w":"Let","s":212.869,"e":213.236,"line":58},{"w":"love","s":213.236,"e":213.602,"line":58},{"w":"have","s":213.602,"e":213.969,"line":58},{"w":"law.","s":213.969,"e":214.335,"line":58},{"w":"Let","s":214.335,"e":214.702,"line":59},{"w":"the","s":214.702,"e":215.068,"line":59},{"w":"world","s":215.068,"e":215.435,"line":59},{"w":"remember","s":215.435,"e":216.534,"line":59},{"w":"why","s":216.534,"e":216.901,"line":60},{"w":"it","s":216.901,"e":217.267,"line":60},{"w":"was","s":217.267,"e":217.634,"line":60},{"w":"made","s":217.634,"e":218,"line":60}],"lines":[{"s":2.14,"e":3.606,"text":"Father of light,"},{"s":3.606,"e":5.072,"text":"God of mercy,"},{"s":5.072,"e":6.538,"text":"Spirit of truth,"},{"s":6.538,"e":9.47,"text":"Creator known by many names—"},{"s":9.47,"e":10.569,"text":"Hear us now."},{"s":10.569,"e":12.035,"text":"The Earth is crying,"},{"s":12.035,"e":14.234,"text":"the children are watching,"},{"s":14.234,"e":16.433,"text":"and heaven is waiting"},{"s":16.433,"e":18.265,"text":"for love to stand up."},{"s":18.265,"e":22.297,"text":"No matter the color, no matter the name,"},{"s":22.297,"e":26.328,"text":"No matter the temple, the cross, or the flame,"},{"s":26.328,"e":30.359,"text":"No matter the scripture, the song, or the sound,"},{"s":30.359,"e":34.757,"text":"We need help from above and we need it right now."},{"s":34.757,"e":38.789,"text":"The rivers are choking, the skies turning gray,"},{"s":38.789,"e":42.82,"text":"The innocent suffer while kings disobey,"},{"s":42.82,"e":46.851,"text":"The poor carry burdens the powerful made,"},{"s":46.851,"e":51.249,"text":"And hatred keeps marching in polished parade."},{"s":51.249,"e":55.647,"text":"So we lift up our hands, but we rise from our knees,"},{"s":55.647,"e":59.312,"text":"Prayer without action won’t set the world free,"},{"s":59.312,"e":62.977,"text":"Love is not silent when evil gets loud,"},{"s":62.977,"e":67.008,"text":"Heaven, give us courage to stand as one crowd."},{"s":67.008,"e":71.039,"text":"We put our foot down, no more war in Your name,"},{"s":71.039,"e":75.071,"text":"We put our foot down, no more feeding the flame,"},{"s":75.071,"e":79.102,"text":"We put our foot down, let the hate hit the ground,"},{"s":79.102,"e":83.133,"text":"Restore the order, Lord, restore it right now."},{"s":83.133,"e":86.432,"text":"Clean up the water, clean up the air,"},{"s":86.432,"e":90.463,"text":"Heal every nation with justice and care,"},{"s":90.463,"e":94.128,"text":"No more excuses, no turning around,"},{"s":94.128,"e":97.793,"text":"For love and for life, we put our foot down."},{"s":97.793,"e":102.191,"text":"For the child in the rubble, the bird in the smoke,"},{"s":102.191,"e":106.588,"text":"For the worker exhausted, the family broke,"},{"s":106.588,"e":111.353,"text":"For the stranger rejected, the prophet ignored,"},{"s":111.353,"e":116.117,"text":"For the Earth You entrusted that we treated like war."},{"s":116.117,"e":120.148,"text":"Let mercy be thunder, let wisdom be fire,"},{"s":120.148,"e":124.18,"text":"Let peace be the law that the nations require,"},{"s":124.18,"e":128.211,"text":"Let greed lose its crown, let compassion be found,"},{"s":128.211,"e":132.242,"text":"Let every false idol come crashing down."},{"s":132.242,"e":135.907,"text":"If you call Him Jesus, stand up for peace."},{"s":135.907,"e":139.572,"text":"If you call Him Allah, let hatred cease."},{"s":139.572,"e":143.237,"text":"If you call Her Mother, protect the ground."},{"s":143.237,"e":146.535,"text":"If you seek no name, still love out loud."},{"s":146.535,"e":152.399,"text":"Every race, every creed, every soul, every town,"},{"s":152.399,"e":156.064,"text":"This is the moment we put our foot down."},{"s":156.064,"e":161.195,"text":"Against every weapon, every poisoned stream,"},{"s":161.195,"e":165.959,"text":"Against every lie killing somebody’s dream."},{"s":165.959,"e":169.99,"text":"We put our foot down, no more war in Your name,"},{"s":169.99,"e":174.022,"text":"We put our foot down, no more feeding the flame,"},{"s":174.022,"e":178.053,"text":"We put our foot down, let the hate hit the ground,"},{"s":178.053,"e":182.084,"text":"Restore the order, Lord, restore it right now."},{"s":182.084,"e":185.383,"text":"Clean up the water, clean up the air,"},{"s":185.383,"e":189.414,"text":"Heal every nation with justice and care,"},{"s":189.414,"e":193.079,"text":"No more excuses, no turning around,"},{"s":193.079,"e":196.744,"text":"For love and for life, we put our foot down."},{"s":196.744,"e":201.142,"text":"Make us brave enough to protect what is holy."},{"s":201.142,"e":204.074,"text":"Make us humble enough to change."},{"s":204.074,"e":207.738,"text":"Make us strong enough to stop the violence."},{"s":207.738,"e":211.037,"text":"Make us clean enough to heal the Earth."},{"s":211.037,"e":212.869,"text":"Let peace have power."},{"s":212.869,"e":214.335,"text":"Let love have law."},{"s":214.335,"e":216.534,"text":"Let the world remember"},{"s":216.534,"e":218,"text":"why it was made"}],"duration":233.04,"source":"curated-realigned","generatedAt":"2026-08-21T01:15:14.852Z","realignedFrom":"curated-realigned","vocalStart":2.14,"vocalEnd":218}