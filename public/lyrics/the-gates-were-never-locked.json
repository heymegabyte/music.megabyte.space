54,"e":211,"line":98},{"w":"isn't","s":211,"e":211.21,"line":98},{"w":"feeling","s":211.42,"e":211.94,"line":98},{"w":"fearless—","s":211.94,"e":212.38,"line":98},{"w":"**Freedom's","s":212.38,"e":212.98,"line":99},{"w":"moving","s":212.98,"e":213.26,"line":99},{"w":"through","s":213.26,"e":213.56,"line":99},{"w":"it","s":213.56,"e":214.18,"line":99},{"w":"all.**","s":214.18,"e":215.3,"line":99},{"w":"Push","s":215.3,"e":215.94,"line":100},{"w":"once.","s":215.94,"e":216.44,"line":100},{"w":"Break","s":216.72,"e":216.88,"line":101},{"w":"through.","s":216.88,"e":217.34,"line":101},{"w":"Bring","s":217.34,"e":217.7,"line":102},{"w":"everybody","s":217.7,"e":218.56,"line":102},{"w":"up.","s":218.56,"e":219.12,"line":102},{"w":"Turn","s":219.12,"e":219.4,"line":103},{"w":"the","s":219.4,"e":219.7,"line":103},{"w":"keys","s":219.7,"e":219.9,"line":103},{"w":"into","s":219.9,"e":220.24,"line":103},{"w":"a","s":220.24,"e":220.82,"line":103},{"w":"kingdom,","s":220.82,"e":220.9,"line":103},{"w":"Turn","s":220.82,"e":221.2,"line":104},{"w":"the","s":221.2,"e":221.46,"line":104},{"w":"scars","s":221.46,"e":221.7,"line":104},{"w":"into","s":221.7,"e":222.08,"line":104},{"w":"enough.","s":222.08,"e":222.64,"line":104},{"w":"No","s":222.64,"e":223.22,"line":105},{"w":"cage.","s":223.22,"e":223.64,"line":105},{"w":"No","s":223.72,"e":224.24,"line":106},{"w":"crown","s":224.24,"e":224.46,"line":106},{"w":"Can","s":224.46,"e":224.82,"line":107},{"w":"tell","s":225.18,"e":225.26,"line":107},{"w":"me","s":225.26,"e":225.54,"line":107},{"w":"where","s":225.54,"e":225.72,"line":107},{"w":"I","s":225.72,"e":226.06,"line":107},{"w":"stop.","s":226.06,"e":226.18,"line":107},{"w":"I","s":226.18,"e":227.18,"line":108},{"w":"finally","s":227.18,"e":228.58,"line":108},{"w":"touched","s":228.58,"e":228.9,"line":108},{"w":"the","s":228.9,"e":229.26,"line":108},{"w":"doorway—","s":229.26,"e":229.88,"line":108},{"w":"**THE","s":230.43,"e":230.98,"line":109},{"w":"GATES","s":230.98,"e":231.56,"line":109},{"w":"WERE","s":231.56,"e":232.72,"line":110},{"w":"NEVER","s":237.16,"e":238.56,"line":111},{"w":"LOCKED.**","s":238.56,"e":239.46,"line":112}],"lines":[{"s":0,"e":0.5,"text":"**[Intro]**"},{"s":11.82,"e":15.38,"text":"I wore the weight of a wall that was smoke,"},{"s":15.7,"e":19.32,"text":"Called it a cage, never questioned the joke."},{"s":19.32,"e":22.8,"text":"Hands on the bars, heart hard in the dark,"},{"s":22.8,"e":24.64,"text":"Till I pushed once lightly—"},{"s":26.5,"e":28.12,"text":"and everything sparked."},{"s":28.12,"e":28.62,"text":"**[Verse 1]**"},{"s":30.9,"e":32.98,"text":"I counted my losses like locks on a door,"},{"s":32.98,"e":34.8,"text":"Fed every fear till it begged me for more."},{"s":34.8,"e":36.68,"text":"Doubt did the talking, I treated it true,"},{"s":36.68,"e":38.46,"text":"Built me a border nobody else drew."},{"s":38.46,"e":40.42,"text":"I made every maybe a mountain of stone,"},{"s":40.42,"e":42.22,"text":"Made every silence mean I was alone."},{"s":42.22,"e":44,"text":"Mind made a movie, then called it a fact,"},{"s":44,"e":45.94,"text":"But thoughts are just thoughts—I can question the act."},{"s":45.94,"e":47.76,"text":"Pressure made diamonds, but patience made plans,"},{"s":47.76,"e":49.52,"text":"Pain made me panic, then purpose made hands."},{"s":49.52,"e":51.32,"text":"I stopped asking shadows which road I should take,"},{"s":51.32,"e":53.3,"text":"Put truth to the test and discovered the fake."},{"s":53.3,"e":53.8,"text":"**[Pre-Chorus]**"},{"s":53.3,"e":55.16,"text":"All of that running, all of that strain,"},{"s":55.16,"e":56.86,"text":"All of those stories rehearsing the pain—"},{"s":56.86,"e":58.74,"text":"I reached for the handle expecting a fight..."},{"s":58.74,"e":59.48,"text":"It opened."},{"s":59.48,"e":59.98,"text":"**[Chorus]**"},{"s":59.48,"e":61.06,"text":"**THE GATES WERE NEVER LOCKED.**"},{"s":61.06,"e":62.98,"text":"I was waiting for a key."},{"s":62.9,"e":64.76,"text":"Had the whole wide world ahead,"},{"s":64.76,"e":66.68,"text":"Had the warden inside me."},{"s":66.68,"e":68.38,"text":"**THE GATES WERE NEVER LOCKED.**"},{"s":68.38,"e":70.4,"text":"All that thunder, all that talk—"},{"s":70.4,"e":72.02,"text":"Fear can paint a prison,"},{"s":72.04,"e":74.82,"text":"But it cannot stop the walk."},{"s":75.06,"e":76.18,"text":"Push once."},{"s":76.18,"e":77.04,"text":"Step through."},{"s":77.04,"e":78.92,"text":"See what the light does."},{"s":78.92,"e":81.06,"text":"I thought freedom had to find me—"},{"s":81.06,"e":83.18,"text":"**I just had to rise up.**"},{"s":88.34,"e":90.22,"text":"**I just had to rise up.**"},{"s":90.22,"e":90.72,"text":"**[Verse 2]**"},{"s":90.22,"e":92.08,"text":"Now I don't bow to the first thing I feel,"},{"s":92.08,"e":93.88,"text":"Feeling is weather—it isn't the wheel."},{"s":93.88,"e":95.7,"text":"Storm in my skull? Let it thunder, then pass."},{"s":95.7,"e":97.5,"text":"I steer by the compass, not clouds in the glass."},{"s":97.5,"e":99.82,"text":"Wise mind, wide eyes, both feet on the ground,"},{"s":99.82,"e":101.62,"text":"Breathe through the noise till the signal gets found."},{"s":101.62,"e":103.56,"text":"Facts over fiction, intention over fear,"},{"s":103.56,"e":105.26,"text":"One clean decision can change a whole year."},{"s":105.26,"e":107.12,"text":"I used to need certainty carved into gold,"},{"s":107.12,"e":109,"text":"Now I move carefully even when cold."},{"s":109,"e":111.36,"text":"Courage ain't knowing the ending beforehand—"},{"s":111.36,"e":113.04,"text":"Courage is moving with doubt in your hand."},{"s":113.04,"e":114.9,"text":"And winning ain't proving the doubters were wrong,"},{"s":114.9,"e":116.98,"text":"Winning is learning you belonged all along."},{"s":116.98,"e":118.84,"text":"Winning is opening doors as you climb,"},{"s":118.84,"e":122.44,"text":"Then holding them open for somebody behind."},{"s":122.44,"e":122.94,"text":"**[Pre-Chorus]**"},{"s":122.44,"e":124.32,"text":"So if there's a wall where your daylight should be,"},{"s":124.32,"e":126.1,"text":"Don't worship the wall—check what you can see."},{"s":126.1,"e":128.3,"text":"Don't bleed on a barrier built out of thought..."},{"s":128.3,"e":129.36,"text":"**Try the lock.**"},{"s":129.36,"e":129.86,"text":"**[Chorus]**"},{"s":130.3,"e":132.08,"text":"**THE GATES WERE NEVER LOCKED.**"},{"s":132.08,"e":133.96,"text":"I was waiting for a key."},{"s":133.88,"e":135.78,"text":"Had the whole wide world ahead,"},{"s":135.78,"e":137.58,"text":"Had the warden inside me."},{"s":137.58,"e":139.36,"text":"**THE GATES WERE NEVER LOCKED.**"},{"s":139.36,"e":141.36,"text":"All that thunder, all that talk—"},{"s":141.36,"e":143.08,"text":"Fear can paint a prison,"},{"s":143.02,"e":145.3,"text":"But it cannot stop the walk."},{"s":145.9,"e":147.1,"text":"Push once."},{"s":147.1,"e":147.98,"text":"Step through."},{"s":148.18,"e":149.84,"text":"See what the light does."},{"s":149.84,"e":151.98,"text":"I thought freedom had to find me—"},{"s":151.98,"e":153.8,"text":"**I just had to rise up.**"},{"s":153.8,"e":154.3,"text":"**[Bridge — piano drops almost alone]**"},{"s":157.1,"e":159.12,"text":"Maybe the mountain is massive."},{"s":159.04,"e":160.84,"text":"Maybe the road really hurts."},{"s":160.84,"e":162.96,"text":"Maybe some chains are actual chains,"},{"s":162.96,"e":164.58,"text":"And breaking them takes real work."},{"s":164.58,"e":166.2,"text":"But never let fear forge another"},{"s":166.2,"e":168.08,"text":"And fasten it onto your name."},{"s":168.08,"e":169.48,"text":"Separate fact from the prophecy—"},{"s":169.48,"e":172.24,"text":"Then walk through whatever remains."},{"s":172.24,"e":173.16,"text":"One breath."},{"s":173.24,"e":174.1,"text":"One truth."},{"s":174.1,"e":175.92,"text":"One deliberate move."},{"s":175.92,"e":177.8,"text":"No prophecy needed—"},{"s":177.8,"e":179.98,"text":"Just something to prove."},{"s":181.52,"e":183.26,"text":"Not to them."},{"s":183.26,"e":185.18,"text":"**To you.**"},{"s":185.18,"e":185.68,"text":"**[Final Chorus — huge choir]**"},{"s":199.26,"e":201.44,"text":"**THE GATES WERE NEVER LOCKED.**"},{"s":201.44,"e":203.28,"text":"Hear the hinges when they swing."},{"s":203.28,"e":205.16,"text":"Every step beyond the boundary"},{"s":205.08,"e":206.98,"text":"Makes another spirit sing."},{"s":206.98,"e":208.6,"text":"**THE GATES WERE NEVER LOCKED.**"},{"s":208.6,"e":210.54,"text":"Let the old illusion fall."},{"s":210.54,"e":212.38,"text":"Freedom isn't feeling fearless—"},{"s":212.38,"e":215.3,"text":"**Freedom's moving through it all.**"},{"s":215.3,"e":216.44,"text":"Push once."},{"s":216.72,"e":217.34,"text":"Break through."},{"s":217.34,"e":219.12,"text":"Bring everybody up."},{"s":219.12,"e":220.9,"text":"Turn the keys into a kingdom,"},{"s":220.82,"e":222.64,"text":"Turn the scars into enough."},{"s":222.64,"e":223.64,"text":"No cage."},{"s":223.72,"e":224.46,"text":"No crown"},{"s":224.46,"e":226.18,"text":"Can tell me where I stop."},{"s":226.18,"e":229.88,"text":"I finally touched the doorway—"},{"s":230.43,"e":231.56,"text":"**THE GATES"},{"s":231.56,"e":232.72,"text":"WERE"},{"s":237.16,"e":238.56,"text":"NEVER"},{"s":238.56,"e":239.46,"text":"LOCKED.**"}],"duration":240.56,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.812Z","stats":{"whisperWords":618,"polishedWords":602,"matched":570,"matchRate":0.947}}