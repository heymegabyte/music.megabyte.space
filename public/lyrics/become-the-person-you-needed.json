":234.011,"line":90},{"w":"leave.","s":234.011,"e":234.295,"line":90},{"w":"Not","s":234.295,"e":234.579,"line":91},{"w":"what","s":234.579,"e":234.863,"line":91},{"w":"you","s":234.863,"e":235.147,"line":91},{"w":"owned,","s":235.147,"e":235.715,"line":91},{"w":"not","s":235.715,"e":235.999,"line":91},{"w":"who","s":235.999,"e":236.283,"line":91},{"w":"knew","s":236.283,"e":236.567,"line":91},{"w":"you—","s":236.567,"e":236.851,"line":91},{"w":"but","s":236.851,"e":237.135,"line":92},{"w":"who","s":237.135,"e":237.419,"line":92},{"w":"stood","s":237.419,"e":237.703,"line":92},{"w":"taller","s":237.703,"e":238.271,"line":92},{"w":"because","s":238.271,"e":238.839,"line":92},{"w":"you","s":238.839,"e":239.123,"line":92},{"w":"believed.","s":239.123,"e":239.975,"line":92},{"w":"If","s":239.975,"e":240.259,"line":93},{"w":"you","s":240.259,"e":240.543,"line":93},{"w":"needed","s":240.543,"e":241.111,"line":93},{"w":"somebody—**be","s":241.111,"e":242.248,"line":93},{"w":"somebody.**","s":242.248,"e":243.384,"line":93},{"w":"If","s":243.384,"e":243.668,"line":94},{"w":"you","s":243.668,"e":243.952,"line":94},{"w":"needed","s":243.952,"e":244.52,"line":94},{"w":"some","s":244.52,"e":244.804,"line":94},{"w":"mercy—**give.**","s":244.804,"e":245.656,"line":94},{"w":"Leave","s":245.656,"e":245.94,"line":95},{"w":"more","s":245.94,"e":246.224,"line":95},{"w":"light","s":246.224,"e":246.508,"line":95},{"w":"than","s":246.508,"e":246.792,"line":95},{"w":"you","s":246.792,"e":247.076,"line":95},{"w":"borrowed—","s":247.076,"e":247.928,"line":95},{"w":"that’s","s":247.928,"e":248.212,"line":96},{"w":"a","s":248.212,"e":248.496,"line":96},{"w":"beautiful","s":248.496,"e":249.348,"line":96},{"w":"reason","s":249.348,"e":249.916,"line":96},{"w":"to","s":249.916,"e":250.2,"line":96},{"w":"live.","s":250.2,"e":250.484,"line":96},{"w":"**[Outro]**","s":250.484,"e":251.384,"line":97},{"w":"One","s":251.384,"e":251.668,"line":98},{"w":"better","s":251.668,"e":252.236,"line":98},{"w":"choice.","s":252.236,"e":252.52,"line":98},{"w":"One","s":252.52,"e":252.804,"line":99},{"w":"kinder","s":252.804,"e":253.372,"line":99},{"w":"deed.","s":253.372,"e":253.656,"line":99},{"w":"One","s":253.656,"e":253.94,"line":100},{"w":"promise","s":253.94,"e":254.508,"line":100},{"w":"kept.","s":254.508,"e":254.792,"line":100},{"w":"One","s":254.792,"e":255.076,"line":101},{"w":"person","s":255.076,"e":255.644,"line":101},{"w":"freed.","s":255.644,"e":255.928,"line":101},{"w":"I","s":255.928,"e":256.212,"line":102},{"w":"stopped","s":256.212,"e":256.78,"line":102},{"w":"asking","s":256.78,"e":257.348,"line":102},{"w":"the","s":257.348,"e":257.632,"line":102},{"w":"world","s":257.632,"e":257.916,"line":102},{"w":"for","s":257.916,"e":258.2,"line":103},{"w":"everything","s":258.2,"e":259.336,"line":103},{"w":"I","s":259.336,"e":259.62,"line":103},{"w":"didn’t","s":259.62,"e":259.904,"line":103},{"w":"receive.","s":259.904,"e":260.472,"line":103},{"w":"Now","s":260.472,"e":260.756,"line":104},{"w":"I’m","s":260.756,"e":261.04,"line":104},{"w":"becoming","s":261.04,"e":261.892,"line":104},{"w":"the","s":261.892,"e":262.192,"line":105},{"w":"person","s":262.192,"e":262.792,"line":105},{"w":"I","s":262.792,"e":263.092,"line":106},{"w":"needed","s":263.092,"e":263.692,"line":106},{"w":"to","s":261.74,"e":261.82,"line":107},{"w":"meet.","s":261.74,"e":261.82,"line":107}],"lines":[{"s":3.58,"e":6.136,"text":"# Become the Person You Needed"},{"s":6.136,"e":7.036,"text":"**[Intro]**"},{"s":7.036,"e":10.16,"text":"I used to ask the dark, “Why’d you pick me?”"},{"s":10.16,"e":13,"text":"Now I ask the light, “Who can I help see?”"},{"s":13,"e":17.544,"text":"Every scar got a story, every story got a seed—"},{"s":17.544,"e":21.52,"text":"I became the kind of person that I used to need."},{"s":21.52,"e":22.42,"text":"**[Verse 1]**"},{"s":22.42,"e":26.396,"text":"If I needed someone patient, I can practice being still,"},{"s":26.396,"e":31.224,"text":"if I needed someone honest, I can tell it even when it kills"},{"s":31.224,"e":35.2,"text":"my pride, not my purpose—let the ego lose its seat,"},{"s":35.2,"e":38.893,"text":"I don’t gotta win the argument to leave with peace."},{"s":38.893,"e":43.153,"text":"If I needed reassurance, I can give somebody grace,"},{"s":43.153,"e":47.413,"text":"if I needed someone listening, I can slow my own pace."},{"s":47.413,"e":51.957,"text":"Everybody got a battle they don’t broadcast on the screen,"},{"s":51.957,"e":55.649,"text":"so I’m softer with the stranger, stronger with the mean."},{"s":55.649,"e":57.921,"text":"Thoughts can knock, they don’t own my home,"},{"s":57.921,"e":61.045,"text":"feelings get a voice, but they don’t hold the throne."},{"s":61.045,"e":63.885,"text":"Pause, breathe, choose—let the wiser mind lead,"},{"s":63.885,"e":68.145,"text":"I’m becoming every person that I once prayed I’d meet."},{"s":68.145,"e":69.045,"text":"**[Pre-Chorus]**"},{"s":69.045,"e":71.601,"text":"What hurt me doesn’t have to hurt through me,"},{"s":71.601,"e":75.009,"text":"what burned me doesn’t get to become what I breathe."},{"s":75.009,"e":78.133,"text":"I can break the chain without breaking a soul—"},{"s":78.133,"e":82.109,"text":"turn the pain into purpose, turn the pressure into gold."},{"s":82.109,"e":83.009,"text":"**[Chorus]**"},{"s":83.009,"e":85.281,"text":"**Become the person you needed,**"},{"s":85.281,"e":87.553,"text":"give the love you were pleading for."},{"s":87.553,"e":89.257,"text":"Hold the door, hold your word,"},{"s":89.257,"e":91.529,"text":"hold a heart when it hits the floor."},{"s":91.529,"e":93.801,"text":"**Become the person you needed,**"},{"s":93.801,"e":96.357,"text":"be the proof that the cycle can cease."},{"s":96.357,"e":98.629,"text":"Leave more light than you borrowed,"},{"s":98.629,"e":100.333,"text":"leave more love, leave more peace."},{"s":100.333,"e":103.741,"text":"If you needed somebody—**be somebody.**"},{"s":103.741,"e":106.014,"text":"If you needed belief—**believe.**"},{"s":106.014,"e":108.286,"text":"Every day I’m becoming"},{"s":108.286,"e":110.558,"text":"the person I needed to see."},{"s":110.558,"e":111.458,"text":"**[Verse 2]**"},{"s":111.458,"e":114.014,"text":"Real strength ain’t loud, real power repairs,"},{"s":114.014,"e":117.138,"text":"real wealth is having enough heart left to share."},{"s":117.138,"e":119.978,"text":"Tip well, speak well, make room at the table,"},{"s":119.978,"e":123.67,"text":"help somebody stand when you know that you’re able."},{"s":123.67,"e":126.226,"text":"Keep the promise when nobody checks,"},{"s":126.226,"e":129.066,"text":"give respect before demanding respect."},{"s":129.066,"e":132.19,"text":"Pick the trash up, call your people, feed a soul,"},{"s":132.19,"e":135.598,"text":"little good deeds compound till the little gets whole."},{"s":135.598,"e":139.29,"text":"And when anger comes knocking like thunder at night,"},{"s":139.29,"e":142.698,"text":"I don’t hand it my mouth just because it feels right."},{"s":142.698,"e":145.538,"text":"Name it, tame it, breathe before the flame spreads—"},{"s":145.538,"e":149.514,"text":"I can choose my next action, not obey what my brain says."},{"s":149.514,"e":152.922,"text":"When I’m wrong, I can say it: “Yeah, that one was mine.”"},{"s":152.922,"e":156.898,"text":"No excuses dressed fancy, no defensive disguise."},{"s":156.898,"e":160.306,"text":"“Sorry” ain’t surrender when repair is the aim—"},{"s":160.306,"e":164.282,"text":"accountability’s courage with humility’s name."},{"s":164.282,"e":165.182,"text":"**[Pre-Chorus]**"},{"s":165.182,"e":167.738,"text":"What hurt me doesn’t have to hurt through me,"},{"s":167.738,"e":171.147,"text":"what burned me doesn’t get to become what I breathe."},{"s":171.147,"e":174.271,"text":"I can break the chain without breaking a soul—"},{"s":174.271,"e":178.247,"text":"turn the pain into purpose, turn the pressure into gold."},{"s":178.247,"e":179.147,"text":"**[Chorus]**"},{"s":179.147,"e":181.419,"text":"**Become the person you needed,**"},{"s":181.419,"e":183.691,"text":"give the love you were pleading for."},{"s":183.691,"e":185.395,"text":"Hold the door, hold your word,"},{"s":185.395,"e":187.667,"text":"hold a heart when it hits the floor."},{"s":187.667,"e":189.939,"text":"**Become the person you needed,**"},{"s":189.939,"e":192.495,"text":"be the proof that the cycle can cease."},{"s":192.495,"e":194.767,"text":"Leave more light than you borrowed,"},{"s":194.767,"e":196.471,"text":"leave more love, leave more peace."},{"s":196.471,"e":198.175,"text":"**[Bridge — Piano Drops Bare]**"},{"s":198.175,"e":199.075,"text":"Listen first."},{"s":199.075,"e":199.975,"text":"Speak with care."},{"s":199.975,"e":200.875,"text":"Tell the truth."},{"s":200.875,"e":201.775,"text":"Always share."},{"s":201.775,"e":202.911,"text":"Protect the small."},{"s":202.911,"e":204.047,"text":"Forgive, but learn."},{"s":204.047,"e":205.183,"text":"Give what you can."},{"s":205.183,"e":206.603,"text":"Let kindness return."},{"s":206.603,"e":207.503,"text":"Build, don’t break."},{"s":207.503,"e":208.403,"text":"Bless, don’t boast."},{"s":208.403,"e":209.823,"text":"Love the lonely."},{"s":209.823,"e":210.723,"text":"Feed the hope."},{"s":210.723,"e":213.847,"text":"And when you can’t fix the whole damn world tonight—"},{"s":213.847,"e":215.551,"text":"make one corner kinder."},{"s":215.551,"e":216.971,"text":"That still counts as light."},{"s":216.971,"e":218.675,"text":"**[Final Chorus — Huge]**"},{"s":218.675,"e":220.947,"text":"**Become the person you needed,**"},{"s":220.947,"e":224.071,"text":"make your history useful somehow."},{"s":224.071,"e":226.911,"text":"You can’t rewrite every yesterday,"},{"s":226.911,"e":229.467,"text":"but you’re writing tomorrow right now."},{"s":229.467,"e":231.739,"text":"**Become the person you needed,**"},{"s":231.739,"e":234.295,"text":"let your character speak when you leave."},{"s":234.295,"e":236.851,"text":"Not what you owned, not who knew you—"},{"s":236.851,"e":239.975,"text":"but who stood taller because you believed."},{"s":239.975,"e":243.384,"text":"If you needed somebody—**be somebody.**"},{"s":243.384,"e":245.656,"text":"If you needed some mercy—**give.**"},{"s":245.656,"e":247.928,"text":"Leave more light than you borrowed—"},{"s":247.928,"e":250.484,"text":"that’s a beautiful reason to live."},{"s":250.484,"e":251.384,"text":"**[Outro]**"},{"s":251.384,"e":252.52,"text":"One better choice."},{"s":252.52,"e":253.656,"text":"One kinder deed."},{"s":253.656,"e":254.792,"text":"One promise kept."},{"s":254.792,"e":255.928,"text":"One person freed."},{"s":255.928,"e":257.916,"text":"I stopped asking the world"},{"s":257.916,"e":260.472,"text":"for everything I didn’t receive."},{"s":260.472,"e":261.892,"text":"Now I’m becoming"},{"s":261.892,"e":262.792,"text":"the person"},{"s":262.792,"e":263.692,"text":"I needed"},{"s":261.74,"e":261.82,"text":"to meet."}],"duration":266.76,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.139Z","realignedFrom":"whisper-aligned","vocalStart":3.58,"vocalEnd":261.74}