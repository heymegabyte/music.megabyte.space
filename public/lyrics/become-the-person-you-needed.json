45.62,"e":246.04,"line":101},{"w":"I","s":246.04,"e":246.76,"line":102},{"w":"stopped","s":246.76,"e":246.84,"line":102},{"w":"asking","s":246.76,"e":247.2,"line":102},{"w":"the","s":247.2,"e":248.08,"line":102},{"w":"world","s":248.08,"e":248.16,"line":102},{"w":"for","s":248.12,"e":249.04,"line":103},{"w":"everything","s":249.04,"e":249.46,"line":103},{"w":"I","s":249.46,"e":249.88,"line":103},{"w":"didn’t","s":249.88,"e":249.99,"line":103},{"w":"receive.","s":250.1,"e":250.84,"line":103},{"w":"Now","s":250.84,"e":251.18,"line":104},{"w":"I’m","s":251.18,"e":251.39,"line":104},{"w":"becoming","s":251.6,"e":252.82,"line":104},{"w":"the","s":253.92,"e":254.84,"line":105},{"w":"person","s":254.84,"e":255.76,"line":105},{"w":"I","s":255.76,"e":257.7,"line":106},{"w":"needed","s":257.7,"e":258.74,"line":106},{"w":"to","s":258.74,"e":261.18,"line":107},{"w":"meet.","s":261.18,"e":261.74,"line":107}],"lines":[{"s":1.074,"e":3.119,"text":"# Become the Person You Needed"},{"s":3.119,"e":3.619,"text":"**[Intro]**"},{"s":3.58,"e":8.52,"text":"I used to ask the dark, “Why’d you pick me?”"},{"s":10.28,"e":14.36,"text":"Now I ask the light, “Who can I help see?”"},{"s":15.3,"e":20.36,"text":"Every scar got a story, every story got a seed—"},{"s":20.62,"e":27.14,"text":"I became the kind of person that I used to need."},{"s":26.96,"e":27.46,"text":"**[Verse 1]**"},{"s":27.68,"e":30.74,"text":"If I needed someone patient, I can practice being still,"},{"s":30.74,"e":34.04,"text":"if I needed someone honest, I can tell it even when it kills"},{"s":34.16,"e":37.02,"text":"my pride, not my purpose—let the ego lose its seat,"},{"s":37.02,"e":39.56,"text":"I don’t gotta win the argument to leave with peace."},{"s":39.56,"e":42.6,"text":"If I needed reassurance, I can give somebody grace,"},{"s":42.6,"e":45.42,"text":"if I needed someone listening, I can slow my own pace."},{"s":45.52,"e":48.12,"text":"Everybody got a battle they don’t broadcast on the screen,"},{"s":48.12,"e":51.06,"text":"so I’m softer with the stranger, stronger with the mean."},{"s":51.2,"e":53.62,"text":"Thoughts can knock, they don’t own my home,"},{"s":53.98,"e":56.22,"text":"feelings get a voice, but they don’t hold the throne."},{"s":56.14,"e":59.36,"text":"Pause, breathe, choose—let the wiser mind lead,"},{"s":59.36,"e":62.12,"text":"I’m becoming every person that I once prayed I’d meet."},{"s":62.12,"e":62.62,"text":"**[Pre-Chorus]**"},{"s":62.12,"e":64.92,"text":"What hurt me doesn’t have to hurt through me,"},{"s":64.92,"e":67.7,"text":"what burned me doesn’t get to become what I breathe."},{"s":67.7,"e":70.46,"text":"I can break the chain without breaking a soul—"},{"s":70.46,"e":73.58,"text":"turn the pain into purpose, turn the pressure into gold."},{"s":73.58,"e":74.08,"text":"**[Chorus]**"},{"s":73.82,"e":76.36,"text":"**Become the person you needed,**"},{"s":76.38,"e":79.14,"text":"give the love you were pleading for."},{"s":79.36,"e":81.36,"text":"Hold the door, hold your word,"},{"s":82.2,"e":84.56,"text":"hold a heart when it hits the floor."},{"s":84.56,"e":87.56,"text":"**Become the person you needed,**"},{"s":87.56,"e":90.14,"text":"be the proof that the cycle can cease."},{"s":90.16,"e":92.48,"text":"Leave more light than you borrowed,"},{"s":92.4,"e":94.88,"text":"leave more love, leave more peace."},{"s":94.88,"e":97.72,"text":"If you needed somebody—**be somebody.**"},{"s":97.72,"e":99.84,"text":"If you needed belief—**believe.**"},{"s":99.84,"e":102.18,"text":"Every day I’m becoming"},{"s":102.18,"e":105.4,"text":"the person I needed to see."},{"s":105.4,"e":105.9,"text":"**[Verse 2]**"},{"s":106.14,"e":108.8,"text":"Real strength ain’t loud, real power repairs,"},{"s":108.94,"e":111.54,"text":"real wealth is having enough heart left to share."},{"s":111.48,"e":114.62,"text":"Tip well, speak well, make room at the table,"},{"s":114.54,"e":117.18,"text":"help somebody stand when you know that you’re able."},{"s":117.18,"e":119.04,"text":"Keep the promise when nobody checks,"},{"s":119.52,"e":121.7,"text":"give respect before demanding respect."},{"s":121.76,"e":124.76,"text":"Pick the trash up, call your people, feed a soul,"},{"s":124.76,"e":128.4,"text":"little good deeds compound till the little gets whole."},{"s":128.4,"e":131.2,"text":"And when anger comes knocking like thunder at night,"},{"s":131.12,"e":134.2,"text":"I don’t hand it my mouth just because it feels right."},{"s":134.2,"e":136.72,"text":"Name it, tame it, breathe before the flame spreads—"},{"s":136.72,"e":139.54,"text":"I can choose my next action, not obey what my brain says."},{"s":139.54,"e":142.3,"text":"When I’m wrong, I can say it: “Yeah, that one was mine.”"},{"s":142.3,"e":145.06,"text":"No excuses dressed fancy, no defensive disguise."},{"s":145.06,"e":147.78,"text":"“Sorry” ain’t surrender when repair is the aim—"},{"s":148.22,"e":151.1,"text":"accountability’s courage with humility’s name."},{"s":151.1,"e":151.6,"text":"**[Pre-Chorus]**"},{"s":151.1,"e":154.2,"text":"What hurt me doesn’t have to hurt through me,"},{"s":154.2,"e":156.96,"text":"what burned me doesn’t get to become what I breathe."},{"s":156.96,"e":159.72,"text":"I can break the chain without breaking a soul—"},{"s":159.72,"e":162.86,"text":"turn the pain into purpose, turn the pressure into gold."},{"s":162.86,"e":163.36,"text":"**[Chorus]**"},{"s":162.86,"e":165.66,"text":"**Become the person you needed,**"},{"s":165.66,"e":168.36,"text":"give the love you were pleading for."},{"s":168.36,"e":170.64,"text":"Hold the door, hold your word,"},{"s":170.64,"e":173.9,"text":"hold a heart when it hits the floor."},{"s":173.9,"e":176.88,"text":"**Become the person you needed,**"},{"s":176.88,"e":179.78,"text":"be the proof that the cycle can cease."},{"s":179.78,"e":181.56,"text":"Leave more light than you borrowed,"},{"s":181.56,"e":184.22,"text":"leave more love, leave more peace."},{"s":184.22,"e":184.72,"text":"**[Bridge — Piano Drops Bare]**"},{"s":184.22,"e":184.94,"text":"Listen first."},{"s":185,"e":186.3,"text":"Speak with care."},{"s":186.44,"e":187.68,"text":"Tell the truth."},{"s":188.4,"e":189.1,"text":"Always share."},{"s":189.1,"e":190.56,"text":"Protect the small."},{"s":190.78,"e":192.08,"text":"Forgive, but learn."},{"s":192.08,"e":193.34,"text":"Give what you can."},{"s":193.52,"e":194.78,"text":"Let kindness return."},{"s":194.78,"e":196.12,"text":"Build, don’t break."},{"s":196.12,"e":197.5,"text":"Bless, don’t boast."},{"s":197.5,"e":199.04,"text":"Love the lonely."},{"s":199.34,"e":200.28,"text":"Feed the hope."},{"s":200.24,"e":203.7,"text":"And when you can’t fix the whole damn world tonight—"},{"s":203.7,"e":205.1,"text":"make one corner kinder."},{"s":205.1,"e":207.72,"text":"That still counts as light."},{"s":207.72,"e":208.22,"text":"**[Final Chorus — Huge]**"},{"s":207.72,"e":210.42,"text":"**Become the person you needed,**"},{"s":210.42,"e":213.12,"text":"make your history useful somehow."},{"s":213.54,"e":216.34,"text":"You can’t rewrite every yesterday,"},{"s":216.34,"e":218.64,"text":"but you’re writing tomorrow right now."},{"s":218.64,"e":221.48,"text":"**Become the person you needed,**"},{"s":221.48,"e":224.12,"text":"let your character speak when you leave."},{"s":224.12,"e":226.22,"text":"Not what you owned, not who knew you—"},{"s":226.22,"e":228.82,"text":"but who stood taller because you believed."},{"s":228.82,"e":231.66,"text":"If you needed somebody—**be somebody.**"},{"s":231.66,"e":233.34,"text":"If you needed some mercy—**give.**"},{"s":234.04,"e":236.62,"text":"Leave more light than you borrowed—"},{"s":236.6,"e":240.34,"text":"that’s a beautiful reason to live."},{"s":240.34,"e":240.84,"text":"**[Outro]**"},{"s":240.34,"e":241.92,"text":"One better choice."},{"s":241.92,"e":243.3,"text":"One kinder deed."},{"s":243.3,"e":244.74,"text":"One promise kept."},{"s":244.74,"e":246.04,"text":"One person freed."},{"s":246.04,"e":248.16,"text":"I stopped asking the world"},{"s":248.12,"e":250.84,"text":"for everything I didn’t receive."},{"s":250.84,"e":252.82,"text":"Now I’m becoming"},{"s":253.92,"e":255.76,"text":"the person"},{"s":255.76,"e":258.74,"text":"I needed"},{"s":258.74,"e":261.74,"text":"to meet."}],"duration":266.76,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.607Z","stats":{"whisperWords":682,"polishedWords":679,"matched":634,"matchRate":0.934}}