nds","s":157.68,"e":158.86,"line":47},{"w":"of","s":158.86,"e":159.16,"line":47},{"w":"all","s":159.16,"e":159.64,"line":47},{"w":"time.","s":159.64,"e":159.9,"line":47},{"w":"Happy","s":159.9,"e":160.54,"line":48},{"w":"birthday,","s":160.54,"e":160.96,"line":48},{"w":"Chris,","s":160.96,"e":161.36,"line":48},{"w":"let","s":161.36,"e":161.58,"line":48},{"w":"the","s":161.58,"e":161.72,"line":48},{"w":"whole","s":161.72,"e":162.2,"line":48},{"w":"room","s":162.2,"e":162.28,"line":48},{"w":"know,","s":162.28,"e":162.56,"line":48},{"w":"From","s":162.56,"e":162.92,"line":49},{"w":"down","s":162.92,"e":163.26,"line":49},{"w":"the","s":163.26,"e":163.62,"line":49},{"w":"street","s":163.62,"e":163.7,"line":49},{"w":"to","s":163.62,"e":163.94,"line":49},{"w":"wherever","s":163.94,"e":164.38,"line":49},{"w":"we","s":164.38,"e":164.84,"line":49},{"w":"go.","s":164.84,"e":165,"line":49},{"w":"Some","s":165,"e":165.42,"line":50},{"w":"friends","s":165.42,"e":165.82,"line":50},{"w":"fade,","s":165.82,"e":166.24,"line":50},{"w":"but","s":166.24,"e":166.6,"line":50},{"w":"real","s":166.6,"e":167,"line":50},{"w":"ones","s":167,"e":167.24,"line":50},{"w":"shine—","s":167.24,"e":168.76,"line":50},{"w":"Chris","s":178.66,"e":179.36,"line":51},{"w":"Kalwa,","s":179.36,"e":180.38,"line":51},{"w":"best","s":181.32,"e":182.72,"line":51},{"w":"friend","s":182.72,"e":183.2,"line":51},{"w":"of","s":183.2,"e":183.9,"line":51},{"w":"all","s":183.9,"e":184.32,"line":51},{"w":"time.","s":184.32,"e":185.26,"line":51}],"lines":[{"s":9.44,"e":13.04,"text":"Happy birthday, Chris Kalwa, man, where do we start?"},{"s":14.98,"e":19.26,"text":"Grew up down the street, you’ve been family from the heart."},{"s":19.26,"e":24.12,"text":"Boy Scouts with Justin Hoffer, learning knots and making plans,"},{"s":24.12,"e":29.18,"text":"Little kids with big dreams and the whole world in our hands."},{"s":29.1,"e":32.62,"text":"Building forts up in the woods like we owned that land,"},{"s":32.62,"e":35.2,"text":"Stick swords, dirt floors, every tree was a stand."},{"s":35.16,"e":37.62,"text":"From the block to the trails, every day was a win,"},{"s":37.56,"e":41.24,"text":"And every crazy story starts with, “Remember back when?”"},{"s":41.24,"e":43.74,"text":"So raise one up for Chris tonight,"},{"s":43.74,"e":46.36,"text":"For every laugh and every ride."},{"s":46.36,"e":48.86,"text":"From the woods to New York lights,"},{"s":48.86,"e":51.28,"text":"You’ve been a brother for life."},{"s":51.72,"e":53.82,"text":"Happy birthday, best friend,"},{"s":53.82,"e":56.32,"text":"Here’s to the years and the stories again."},{"s":56.32,"e":58.7,"text":"Chris Kalwa, one of a kind,"},{"s":58.7,"e":63.68,"text":"One of the best friends of all time."},{"s":66.32,"e":69.22,"text":"We were both so hyped when you got your first girl,"},{"s":69.22,"e":71.64,"text":"Like Chris just leveled up and conquered the world."},{"s":71.64,"e":74.22,"text":"Then Pacha in New York, lights flashing in the air,"},{"s":74.22,"e":76.84,"text":"Dancing like legends like we had no cares."},{"s":76.84,"e":79.68,"text":"Rutgers Newark, TEEK parties, walking in proud,"},{"s":79.68,"e":82.14,"text":"Rutgers New Brunswick, getting lost in the crowd."},{"s":82.14,"e":84.62,"text":"Every campus, every weekend, every ridiculous plan,"},{"s":84.66,"e":87.44,"text":"Somehow we survived and came out as men."},{"s":88.14,"e":90.8,"text":"So raise one up for Chris tonight,"},{"s":90.8,"e":93.36,"text":"For every laugh and every ride."},{"s":93.36,"e":95.86,"text":"From the woods to New York lights,"},{"s":95.86,"e":98.26,"text":"You’ve been a brother for life."},{"s":98.32,"e":100.82,"text":"Happy birthday, best friend,"},{"s":100.82,"e":103.4,"text":"Here’s to the years and the stories again."},{"s":103.4,"e":105.78,"text":"Chris Kalwa, one of a kind,"},{"s":105.78,"e":110.24,"text":"One of the best friends of all time."},{"s":118.62,"e":121,"text":"Paper airplanes out the window, sparks in the sky,"},{"s":121,"e":123.76,"text":"My dad yelling, “What are you doing?!” while we tried not to die."},{"s":123.76,"e":126.04,"text":"Pulling up to parties with a boat on the lake,"},{"s":126.22,"e":128.62,"text":"Jon Lam beside us like, “What move should we make?”"},{"s":129.28,"e":131.1,"text":"Lakehouse nights and summer air,"},{"s":131.1,"e":133.5,"text":"Laughing so hard we forgot to care."},{"s":133.46,"e":136.1,"text":"Through every chapter, every road, every climb,"},{"s":136.1,"e":139,"text":"You stayed solid every single time."},{"s":139,"e":141.48,"text":"So raise one up for Chris tonight,"},{"s":141.48,"e":143.98,"text":"For every memory burning bright."},{"s":143.98,"e":146.52,"text":"From Boy Scouts to the party lights,"},{"s":146.52,"e":149.06,"text":"You’ve been a brother for life."},{"s":149.12,"e":151.54,"text":"Happy birthday, best friend,"},{"s":151.54,"e":154.02,"text":"Here’s to the legends we’ll tell again."},{"s":154.02,"e":156.46,"text":"Chris Kalwa, one of a kind,"},{"s":156.46,"e":159.9,"text":"One of the best friends of all time."},{"s":159.9,"e":162.56,"text":"Happy birthday, Chris, let the whole room know,"},{"s":162.56,"e":165,"text":"From down the street to wherever we go."},{"s":165,"e":168.76,"text":"Some friends fade, but real ones shine—"},{"s":178.66,"e":185.26,"text":"Chris Kalwa, best friend of all time."}],"duration":187.12,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.394Z","stats":{"whisperWords":429,"polishedWords":406,"matched":386,"matchRate":0.951}}