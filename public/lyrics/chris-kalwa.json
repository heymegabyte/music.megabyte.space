","s":163.574,"e":164.242,"line":45},{"w":"best","s":164.242,"e":164.575,"line":45},{"w":"friend,","s":164.575,"e":164.909,"line":45},{"w":"Here’s","s":164.909,"e":165.576,"line":46},{"w":"to","s":165.576,"e":165.91,"line":46},{"w":"the","s":165.91,"e":166.243,"line":46},{"w":"legends","s":166.243,"e":166.911,"line":46},{"w":"we’ll","s":166.911,"e":167.244,"line":46},{"w":"tell","s":167.244,"e":167.578,"line":46},{"w":"again.","s":167.578,"e":168.245,"line":46},{"w":"Chris","s":168.245,"e":168.579,"line":47},{"w":"Kalwa,","s":168.579,"e":169.246,"line":47},{"w":"one","s":169.246,"e":169.58,"line":47},{"w":"of","s":169.58,"e":169.913,"line":47},{"w":"a","s":169.913,"e":170.247,"line":47},{"w":"kind,","s":170.247,"e":170.581,"line":47},{"w":"One","s":170.581,"e":170.914,"line":48},{"w":"of","s":170.914,"e":171.248,"line":48},{"w":"the","s":171.248,"e":171.581,"line":48},{"w":"best","s":171.581,"e":171.915,"line":48},{"w":"friends","s":171.915,"e":172.249,"line":48},{"w":"of","s":172.249,"e":172.582,"line":48},{"w":"all","s":172.582,"e":172.916,"line":48},{"w":"time.","s":172.916,"e":173.25,"line":48},{"w":"Happy","s":173.25,"e":173.917,"line":49},{"w":"birthday,","s":173.917,"e":174.584,"line":49},{"w":"Chris,","s":174.584,"e":174.918,"line":49},{"w":"let","s":174.918,"e":175.251,"line":49},{"w":"the","s":175.251,"e":175.585,"line":49},{"w":"whole","s":175.585,"e":175.919,"line":49},{"w":"room","s":175.919,"e":176.252,"line":49},{"w":"know,","s":176.252,"e":176.586,"line":49},{"w":"From","s":176.586,"e":176.919,"line":50},{"w":"down","s":176.919,"e":177.253,"line":50},{"w":"the","s":177.253,"e":177.587,"line":50},{"w":"street","s":177.587,"e":177.92,"line":50},{"w":"to","s":177.92,"e":178.254,"line":50},{"w":"wherever","s":178.254,"e":179.255,"line":50},{"w":"we","s":179.255,"e":179.588,"line":50},{"w":"go.","s":179.588,"e":179.922,"line":50},{"w":"Some","s":179.922,"e":180.256,"line":51},{"w":"friends","s":180.256,"e":180.589,"line":51},{"w":"fade,","s":180.589,"e":180.923,"line":51},{"w":"but","s":180.923,"e":181.257,"line":51},{"w":"real","s":181.257,"e":181.59,"line":51},{"w":"ones","s":181.59,"e":182.257,"line":51},{"w":"shine—","s":182.257,"e":182.591,"line":51},{"w":"Chris","s":182.591,"e":182.925,"line":52},{"w":"Kalwa,","s":182.925,"e":183.592,"line":52},{"w":"best","s":183.592,"e":183.926,"line":52},{"w":"friend","s":183.926,"e":184.259,"line":52},{"w":"of","s":184.259,"e":184.593,"line":52},{"w":"all","s":184.593,"e":184.926,"line":52},{"w":"time.","s":184.926,"e":185.26,"line":52}],"lines":[{"s":9.44,"e":13.443,"text":"Happy birthday, Chris Kalwa, man, where do we start?"},{"s":13.443,"e":17.781,"text":"Grew up down the street, you’ve been family from the heart."},{"s":17.781,"e":22.451,"text":"Boy Scouts with Justin Hoffer, learning knots and making plans,"},{"s":22.451,"e":26.788,"text":"Little kids with big dreams and the whole world in our hands."},{"s":26.788,"e":31.126,"text":"Building forts up in the woods like we owned that land,"},{"s":31.126,"e":34.795,"text":"Stick swords, dirt floors, every tree was a stand."},{"s":34.795,"e":39.133,"text":"From the block to the trails, every day was a win,"},{"s":39.133,"e":44.137,"text":"And every crazy story starts with, “Remember back when?”"},{"s":44.137,"e":46.806,"text":"So raise one up for Chris tonight,"},{"s":46.806,"e":50.142,"text":"For every laugh and every ride."},{"s":50.142,"e":52.478,"text":"From the woods to New York lights,"},{"s":52.478,"e":54.813,"text":"You’ve been a brother for life."},{"s":54.813,"e":56.815,"text":"Happy birthday, best friend,"},{"s":56.815,"e":60.485,"text":"Here’s to the years and the stories again."},{"s":60.485,"e":62.82,"text":"Chris Kalwa, one of a kind,"},{"s":62.82,"e":65.489,"text":"One of the best friends of all time."},{"s":65.489,"e":69.492,"text":"We were both so hyped when you got your first girl,"},{"s":69.492,"e":73.829,"text":"Like Chris just leveled up and conquered the world."},{"s":73.829,"e":77.833,"text":"Then Pacha in New York, lights flashing in the air,"},{"s":77.833,"e":81.503,"text":"Dancing like legends like we had no cares."},{"s":81.503,"e":85.173,"text":"Rutgers Newark, TEEK parties, walking in proud,"},{"s":85.173,"e":88.843,"text":"Rutgers New Brunswick, getting lost in the crowd."},{"s":88.843,"e":94.848,"text":"Every campus, every weekend, every ridiculous plan,"},{"s":94.848,"e":98.851,"text":"Somehow we survived and came out as men."},{"s":98.851,"e":101.52,"text":"So raise one up for Chris tonight,"},{"s":101.52,"e":104.857,"text":"For every laugh and every ride."},{"s":104.857,"e":107.192,"text":"From the woods to New York lights,"},{"s":107.192,"e":109.527,"text":"You’ve been a brother for life."},{"s":109.527,"e":111.529,"text":"Happy birthday, best friend,"},{"s":111.529,"e":115.199,"text":"Here’s to the years and the stories again."},{"s":115.199,"e":117.534,"text":"Chris Kalwa, one of a kind,"},{"s":117.534,"e":120.203,"text":"One of the best friends of all time."},{"s":120.203,"e":124.54,"text":"Paper airplanes out the window, sparks in the sky,"},{"s":124.54,"e":129.211,"text":"My dad yelling, “What are you doing?!” while we tried not to die."},{"s":129.211,"e":133.215,"text":"Pulling up to parties with a boat on the lake,"},{"s":133.215,"e":136.884,"text":"Jon Lam beside us like, “What move should we make?”"},{"s":136.884,"e":139.553,"text":"Lakehouse nights and summer air,"},{"s":139.553,"e":142.556,"text":"Laughing so hard we forgot to care."},{"s":142.556,"e":147.227,"text":"Through every chapter, every road, every climb,"},{"s":147.227,"e":150.563,"text":"You stayed solid every single time."},{"s":150.563,"e":151.898,"text":"Final Chorus"},{"s":151.898,"e":154.567,"text":"So raise one up for Chris tonight,"},{"s":154.567,"e":157.903,"text":"For every memory burning bright."},{"s":157.903,"e":160.572,"text":"From Boy Scouts to the party lights,"},{"s":160.572,"e":162.907,"text":"You’ve been a brother for life."},{"s":162.907,"e":164.909,"text":"Happy birthday, best friend,"},{"s":164.909,"e":168.245,"text":"Here’s to the legends we’ll tell again."},{"s":168.245,"e":170.581,"text":"Chris Kalwa, one of a kind,"},{"s":170.581,"e":173.25,"text":"One of the best friends of all time."},{"s":173.25,"e":176.586,"text":"Happy birthday, Chris, let the whole room know,"},{"s":176.586,"e":179.922,"text":"From down the street to wherever we go."},{"s":179.922,"e":182.591,"text":"Some friends fade, but real ones shine—"},{"s":182.591,"e":185.26,"text":"Chris Kalwa, best friend of all time."}],"duration":187.12,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.983Z","realignedFrom":"whisper-aligned","vocalStart":9.44,"vocalEnd":185.26}