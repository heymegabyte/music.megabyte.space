le","s":254.66,"e":255.02,"line":101},{"w":"light,","s":255.02,"e":255.54,"line":101},{"w":"look","s":255.58,"e":255.94,"line":101},{"w":"far,","s":255.94,"e":256.44,"line":101},{"w":"look","s":256.5,"e":256.84,"line":101},{"w":"free,","s":256.84,"e":257.3,"line":101},{"w":"Every","s":257.3,"e":257.82,"line":102},{"w":"soul","s":257.82,"e":258.16,"line":102},{"w":"starts","s":258.16,"e":258.68,"line":102},{"w":"small","s":258.68,"e":259.1,"line":102},{"w":"beneath","s":259.1,"e":259.48,"line":102},{"w":"eternity.","s":259.48,"e":260.2,"line":102},{"w":"Algenib,","s":262.04,"e":262.58,"line":103},{"w":"Betelgeuse,","s":262.58,"e":262.94,"line":103},{"w":"Sirius,","s":264.06,"e":264.14,"line":103},{"w":"Polaris—","s":264.06,"e":264.68,"line":103},{"w":"Four","s":264.68,"e":265.12,"line":104},{"w":"flames,","s":265.12,"e":265.66,"line":104},{"w":"four","s":265.78,"e":266.2,"line":104},{"w":"names,","s":266.2,"e":266.6,"line":104},{"w":"four","s":266.66,"e":267.2,"line":104},{"w":"reasons","s":267.2,"e":267.54,"line":104},{"w":"wonder","s":267.62,"e":268,"line":104},{"w":"carries","s":268,"e":268.58,"line":104},{"w":"us.","s":268.58,"e":268.94,"line":104},{"w":"Look","s":268.94,"e":269.42,"line":105},{"w":"up,","s":269.42,"e":269.62,"line":105},{"w":"little","s":269.62,"e":269.84,"line":105},{"w":"light—though","s":270.34,"e":270.56,"line":105},{"w":"the","s":270.56,"e":270.84,"line":105},{"w":"years","s":270.84,"e":271.24,"line":105},{"w":"race","s":271.24,"e":271.6,"line":105},{"w":"by,","s":271.6,"e":272.14,"line":105},{"w":"Keep","s":272.14,"e":272.36,"line":106},{"w":"the","s":272.36,"e":272.64,"line":106},{"w":"kid","s":272.64,"e":272.94,"line":106},{"w":"who","s":272.94,"e":273.12,"line":106},{"w":"kissed","s":273.12,"e":273.38,"line":106},{"w":"infinity","s":273.38,"e":274.06,"line":106},{"w":"alive","s":274.06,"e":274.72,"line":106},{"w":"behind","s":274.72,"e":275.14,"line":106},{"w":"your","s":275.14,"e":275.5,"line":106},{"w":"eyes.","s":275.5,"e":275.92,"line":106},{"w":"Algenib,","s":276.82,"e":277.2,"line":107},{"w":"Betelgeuse,","s":277.2,"e":277.62,"line":107},{"w":"Sirius,","s":277.66,"e":278.58,"line":107},{"w":"Polaris—","s":278.58,"e":279.4,"line":107},{"w":"I","s":279.4,"e":279.78,"line":108},{"w":"was","s":279.78,"e":279.96,"line":108},{"w":"small","s":279.96,"e":280.28,"line":108},{"w":"beneath","s":280.28,"e":280.68,"line":108},{"w":"it","s":280.68,"e":281.06,"line":108},{"w":"all,","s":281.06,"e":281.36,"line":108},{"w":"but","s":281.36,"e":281.58,"line":108},{"w":"the","s":281.58,"e":281.84,"line":108},{"w":"whole","s":281.84,"e":282.24,"line":108},{"w":"sky","s":282.24,"e":282.62,"line":108},{"w":"felt","s":282.62,"e":283.1,"line":108},{"w":"like","s":283.1,"e":283.54,"line":108},{"w":"ours.","s":283.54,"e":284.18,"line":108},{"w":"Algenib","s":284.8,"e":285.04,"line":110},{"w":"beat.","s":285.32,"e":285.94,"line":110},{"w":"Betelgeuse","s":285.94,"e":286.32,"line":111},{"w":"burned.","s":287.8,"e":287.88,"line":111},{"w":"Sirius","s":287.84,"e":288.56,"line":112},{"w":"shimmered.","s":288.56,"e":289.18,"line":112},{"w":"Polaris","s":289.18,"e":289.94,"line":113},{"w":"turned.","s":289.94,"e":291.48,"line":113},{"w":"They","s":292.48,"e":293.12,"line":114},{"w":"called","s":293.12,"e":293.6,"line":114},{"w":"it","s":293.6,"e":293.94,"line":114},{"w":"space—","s":293.94,"e":294.58,"line":114},{"w":"Cold,","s":295.22,"e":296.5,"line":115},{"w":"endless","s":296.54,"e":297.06,"line":115},{"w":"and","s":297.06,"e":297.5,"line":115},{"w":"far.","s":297.5,"e":298.4,"line":115},{"w":"I","s":298.4,"e":299.3,"line":116},{"w":"called","s":299.3,"e":299.82,"line":116},{"w":"it","s":299.82,"e":300.3,"line":116},{"w":"the","s":300.3,"e":300.96,"line":116},{"w":"first","s":300.96,"e":301.48,"line":116},{"w":"place","s":301.48,"e":302.42,"line":116},{"w":"I","s":302.76,"e":304.04,"line":117},{"w":"learned","s":304.04,"e":304.72,"line":117},{"w":"who","s":304.72,"e":305.46,"line":117},{"w":"we","s":305.46,"e":306.28,"line":117},{"w":"are.","s":306.28,"e":307.68,"line":117}],"lines":[{"s":0,"e":0.5,"text":"[Intro]"},{"s":2.92,"e":6.1,"text":"They called it space—"},{"s":6.1,"e":10.06,"text":"I called it impossible."},{"s":10.06,"e":14.06,"text":"They called them stars—"},{"s":14.42,"e":19,"text":"I called them by name."},{"s":19,"e":19.5,"text":"[Chorus]"},{"s":23.94,"e":27.02,"text":"Look up, little light, look far, look free,"},{"s":27.02,"e":30.8,"text":"Every star has a story crossing centuries."},{"s":31.06,"e":34.4,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":34.4,"e":38.44,"text":"Say the names till the night knows where your heart is."},{"s":38.44,"e":41.86,"text":"Look up, little light, let wonder lead the way,"},{"s":41.86,"e":45.32,"text":"We see ancient fire arriving here today."},{"s":46.4,"e":49.2,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":49.2,"e":53.44,"text":"I was small beneath it all, but the whole sky felt like ours."},{"s":53.44,"e":53.94,"text":"[Verse 1]"},{"s":53.84,"e":56.16,"text":"Bare feet, back field, black-blue ceiling,"},{"s":56.16,"e":60.04,"text":"Bright beads burning gave my young blood feeling."},{"s":60.36,"e":62.08,"text":"Grass on my back, galaxy in my gaze,"},{"s":62.08,"e":64.02,"text":"Lost in the vastness, amazed for days."},{"s":67.14,"e":69.26,"text":"One light-year stretched nearly six trillion miles;"},{"s":69.26,"e":71.08,"text":"I was six years old with a universe smile."},{"s":71.08,"e":72.92,"text":"I could count to a hundred, not infinity high,"},{"s":72.92,"e":74.74,"text":"So I counted cold candles in the cathedral sky."},{"s":74.74,"e":76.84,"text":"Every beam was a time machine, clean and bright,"},{"s":76.76,"e":78.88,"text":"Old news crossing new moons, cruising through night."},{"s":78.88,"e":80.74,"text":"What looked like now had already moved on,"},{"s":80.74,"e":82.76,"text":"Yet the past passed through me and kept shining strong."},{"s":82.76,"e":83.26,"text":"[Pre-Chorus]"},{"s":82.76,"e":84.56,"text":"How can a fire be farther than fear?"},{"s":84.68,"e":86.38,"text":"How can forever feel suddenly near?"},{"s":86.48,"e":88.2,"text":"How can the darkness hold oceans of flame?"},{"s":88.32,"e":91.74,"text":"Maybe the heavens were teaching me names."},{"s":91.74,"e":92.24,"text":"[Chorus]"},{"s":91.74,"e":95.18,"text":"Look up, little light, look far, look free,"},{"s":95.18,"e":98.68,"text":"Every star has a story crossing centuries."},{"s":98.68,"e":102.38,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":102.38,"e":107.14,"text":"I was small beneath it all, but the whole sky felt like ours."},{"s":107.14,"e":107.64,"text":"[Verse 2]"},{"s":107.66,"e":108.86,"text":"Algenib—blue beat, deep-space drum,"},{"s":111,"e":113.14,"text":"Three-point-six-hour rhythm saying, “Come, child, come.”"},{"s":113.14,"e":115.26,"text":"Pressure waves race while the gravity rolls,"},{"s":115.26,"e":117.14,"text":"A pulsing blue jewel in the Pegasus folds."},{"s":117.44,"e":118.82,"text":"Blue-white blaze with a heartbeat hidden,"},{"s":119.28,"e":120.6,"text":"Cosmic code in a cadence unwritten."},{"s":120.6,"e":123.4,"text":"I couldn’t spell pulsation or chart its flight,"},{"s":123.4,"e":127.44,"text":"But I felt that distant drummer drum through night."},{"s":127.44,"e":127.94,"text":"[Hook]"},{"s":129.16,"e":130.42,"text":"Beat, beat—blue flame, bright."},{"s":131.24,"e":132.18,"text":"Beat, beat—through the night."},{"s":132.82,"e":133.94,"text":"Far, far—still you came."},{"s":134.92,"e":135.9,"text":"Algenib—I learned your name."},{"s":135.9,"e":136.4,"text":"[Verse 3]"},{"s":136,"e":137.7,"text":"Betelgeuse burns on Orion’s broad shoulder,"},{"s":137.7,"e":139.52,"text":"Red as a ruby, enormous and older."},{"s":139.52,"e":141.44,"text":"A supergiant swelling, a furnace unfurled—"},{"s":141.44,"e":143.12,"text":"Placed where our Sun is, it could swallow inner worlds."},{"s":143.12,"e":145.04,"text":"Then the giant dimmed and the whole Earth stared;"},{"s":145.04,"e":146.74,"text":"It hurled out matter and its brilliance was impaired."},{"s":146.74,"e":148.62,"text":"Cooling gas formed dust, making red fire hide—"},{"s":148.62,"e":150.62,"text":"Even wounded wonders still illuminate the sky."},{"s":150.62,"e":151.12,"text":"[Hook]"},{"s":150.7,"e":153.38,"text":"Burn, Betelgeuse, burn—red gold, red glow."},{"s":153.38,"e":157.26,"text":"Teach a little dreamer there is more than we know."},{"s":157.82,"e":160.48,"text":"Dim, then return; let the darkness testify:"},{"s":161.16,"e":164.8,"text":"Even wounded wonders still illuminate the sky."},{"s":164.8,"e":165.3,"text":"[Verse 4]"},{"s":165.32,"e":167.08,"text":"Sirius—serious shimmer, sharp silver flame,"},{"s":167.08,"e":168.78,"text":"Brightest star at nighttime, Dog Star by name."},{"s":169.08,"e":170.58,"text":"Eight-point-six years for its light to arrive—"},{"s":170.58,"e":172.56,"text":"Every glance at Sirius sees an earlier sky."},{"s":172.56,"e":174.38,"text":"One blaze is two in a beautiful spin:"},{"s":174.38,"e":176.06,"text":"Sirius A with a secret companion within."},{"s":176.06,"e":177.68,"text":"Sirius B, Earth-small, nearly Sun-heavy,"},{"s":177.68,"e":179.74,"text":"A white-dwarf diamond, collapsed and steady."},{"s":179.74,"e":181.66,"text":"Ten thousand times fainter beneath all that glare,"},{"s":181.66,"e":183.46,"text":"A hidden little heavyweight quietly there."},{"s":183.46,"e":185.24,"text":"The brightest may never be burning alone,"},{"s":185.24,"e":187.22,"text":"And the smallest-looking light may be denser than stone."},{"s":187.22,"e":187.72,"text":"[Verse 5]"},{"s":187.22,"e":189.02,"text":"Polaris isn’t brightest—it is faithful in the frame,"},{"s":189.4,"e":190.74,"text":"A northern-pointing promise with a navigator’s name."},{"s":190.7,"e":192.64,"text":"Not one lonely lantern but a family of three,"},{"s":192.64,"e":194.28,"text":"A Cepheid softly breathing in celestial harmony."},{"s":194.28,"e":196.3,"text":"Sailors found salvation in its steady-seeming role,"},{"s":196.3,"e":198.08,"text":"A silver signal sitting near the northern pole."},{"s":198.08,"e":199.98,"text":"But Earth spins and sways like a slow, dreaming top,"},{"s":199.98,"e":202.18,"text":"So even North is borrowed; even guide stars swap."},{"s":202.18,"e":203.52,"text":"Thuban held the title; Vega waits beyond,"},{"s":203.52,"e":205.38,"text":"The sky keeps rearranging what we thought would carry on."},{"s":205.38,"e":207.3,"text":"Still Polaris keeps pointing while our brief years pass,"},{"s":207.3,"e":209.2,"text":"A pin through the heavens, a compass through the black."},{"s":209.2,"e":209.7,"text":"[Bridge]"},{"s":209.2,"e":215.79,"text":"Maybe awe is intelligence before it learns a word."},{"s":215.82,"e":222.48,"text":"Maybe wonder is the wisest thing a child has ever heard."},{"s":222.48,"e":230.4,"text":"Maybe every distant sun is someone else’s dawn,"},{"s":230.4,"e":238.2,"text":"And someone there is wondering if our little light lives on."},{"s":238.2,"e":242.46,"text":"Do they lie beneath strange leaves, looking toward our flame?"},{"s":242.7,"e":246.34,"text":"Do they whisper “Sol” with wonder? Did they give our Sun a name?"},{"s":246.34,"e":249.9,"text":"Are they staring at old Earthlight traveling through the dark,"},{"s":250.32,"e":253.7,"text":"Seeing ancient human history as a tiny golden spark?"},{"s":253.7,"e":254.2,"text":"[Final Chorus]"},{"s":253.7,"e":257.3,"text":"Look up, little light, look far, look free,"},{"s":257.3,"e":260.2,"text":"Every soul starts small beneath eternity."},{"s":262.04,"e":264.68,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":264.68,"e":268.94,"text":"Four flames, four names, four reasons wonder carries us."},{"s":268.94,"e":272.14,"text":"Look up, little light—though the years race by,"},{"s":272.14,"e":275.92,"text":"Keep the kid who kissed infinity alive behind your eyes."},{"s":276.82,"e":279.4,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":279.4,"e":284.18,"text":"I was small beneath it all, but the whole sky felt like ours."},{"s":284.18,"e":284.68,"text":"[Outro]"},{"s":284.8,"e":285.94,"text":"Algenib beat."},{"s":285.94,"e":287.88,"text":"Betelgeuse burned."},{"s":287.84,"e":289.18,"text":"Sirius shimmered."},{"s":289.18,"e":291.48,"text":"Polaris turned."},{"s":292.48,"e":294.58,"text":"They called it space—"},{"s":295.22,"e":298.4,"text":"Cold, endless and far."},{"s":298.4,"e":302.42,"text":"I called it the first place"},{"s":302.76,"e":307.68,"text":"I learned who we are."}],"duration":311.24,"source":"whisper-aligned","generatedAt":"2026-08-06T19:43:40.483Z","stats":{"whisperWords":797,"polishedWords":758,"matched":663,"matchRate":0.875}}