mall","s":292.947,"e":293.22,"line":96},{"w":"beneath","s":293.22,"e":293.765,"line":96},{"w":"it","s":293.765,"e":294.038,"line":96},{"w":"all,","s":294.038,"e":294.311,"line":96},{"w":"but","s":294.311,"e":294.584,"line":96},{"w":"the","s":294.584,"e":294.857,"line":96},{"w":"whole","s":294.857,"e":295.129,"line":96},{"w":"sky","s":295.129,"e":295.402,"line":96},{"w":"felt","s":295.402,"e":295.675,"line":96},{"w":"like","s":295.675,"e":295.948,"line":96},{"w":"ours.","s":295.948,"e":296.221,"line":96},{"w":"Algenib","s":296.221,"e":297.039,"line":97},{"w":"beat.","s":297.039,"e":297.312,"line":97},{"w":"Betelgeuse","s":297.312,"e":298.131,"line":98},{"w":"burned.","s":298.131,"e":298.676,"line":98},{"w":"Sirius","s":298.676,"e":299.222,"line":99},{"w":"shimmered.","s":299.222,"e":300.041,"line":99},{"w":"Polaris","s":300.041,"e":300.859,"line":100},{"w":"turned.","s":300.859,"e":301.405,"line":100},{"w":"They","s":301.405,"e":301.678,"line":101},{"w":"called","s":301.678,"e":302.223,"line":101},{"w":"it","s":302.223,"e":302.496,"line":101},{"w":"space—","s":302.496,"e":302.769,"line":101},{"w":"Cold,","s":302.769,"e":303.042,"line":102},{"w":"endless","s":303.042,"e":303.587,"line":102},{"w":"and","s":303.587,"e":303.86,"line":102},{"w":"far.","s":303.86,"e":304.133,"line":102},{"w":"I","s":304.133,"e":304.406,"line":103},{"w":"called","s":304.406,"e":304.952,"line":103},{"w":"it","s":304.952,"e":305.224,"line":103},{"w":"the","s":305.224,"e":305.497,"line":103},{"w":"first","s":305.497,"e":305.77,"line":103},{"w":"place","s":305.77,"e":306.043,"line":103},{"w":"I","s":306.043,"e":306.316,"line":104},{"w":"learned","s":306.316,"e":306.861,"line":104},{"w":"who","s":306.861,"e":307.134,"line":104},{"w":"we","s":307.134,"e":307.407,"line":104},{"w":"are.","s":307.407,"e":307.68,"line":104}],"lines":[{"s":2.92,"e":4.284,"text":"THE NIGHT KNEW MY NAME"},{"s":4.284,"e":5.648,"text":"They called it space—"},{"s":5.648,"e":7.831,"text":"I called it impossible."},{"s":7.831,"e":9.195,"text":"They called them stars—"},{"s":9.195,"e":10.832,"text":"I called them by name."},{"s":10.832,"e":13.288,"text":"Look up, little light, look far, look free,"},{"s":13.288,"e":16.835,"text":"Every star has a story crossing centuries."},{"s":16.835,"e":19.836,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":19.836,"e":23.11,"text":"Say the names till the night knows where your heart is."},{"s":23.11,"e":26.111,"text":"Look up, little light, let wonder lead the way,"},{"s":26.111,"e":29.112,"text":"We see ancient fire arriving here today."},{"s":29.112,"e":32.114,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":32.114,"e":35.933,"text":"I was small beneath it all, but the whole sky felt like ours."},{"s":35.933,"e":37.843,"text":"Bare feet, back field, black-blue ceiling,"},{"s":37.843,"e":40.572,"text":"Bright beads burning gave my young blood feeling."},{"s":40.572,"e":43.3,"text":"Grass on my back, galaxy in my gaze,"},{"s":43.3,"e":46.028,"text":"Lost in the vastness, amazed for days."},{"s":46.028,"e":49.302,"text":"One light-year stretched nearly six trillion miles;"},{"s":49.302,"e":52.304,"text":"I was six years old with a universe smile."},{"s":52.304,"e":55.851,"text":"I could count to a hundred, not infinity high,"},{"s":55.851,"e":59.397,"text":"So I counted cold candles in the cathedral sky."},{"s":59.397,"e":62.672,"text":"Every beam was a time machine, clean and bright,"},{"s":62.672,"e":65.4,"text":"Old news crossing new moons, cruising through night."},{"s":65.4,"e":68.674,"text":"What looked like now had already moved on,"},{"s":68.674,"e":71.948,"text":"Yet the past passed through me and kept shining strong."},{"s":71.948,"e":74.404,"text":"How can a fire be farther than fear?"},{"s":74.404,"e":77.132,"text":"How can forever feel suddenly near?"},{"s":77.132,"e":79.86,"text":"How can the darkness hold oceans of flame?"},{"s":79.86,"e":82.589,"text":"Maybe the heavens were teaching me names."},{"s":82.589,"e":85.044,"text":"Look up, little light, look far, look free,"},{"s":85.044,"e":88.591,"text":"Every star has a story crossing centuries."},{"s":88.591,"e":91.592,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":91.592,"e":95.412,"text":"I was small beneath it all, but the whole sky felt like ours."},{"s":95.412,"e":97.322,"text":"Algenib—blue beat, deep-space drum,"},{"s":97.322,"e":99.777,"text":"Three-point-six-hour rhythm saying, “Come, child, come.”"},{"s":99.777,"e":102.779,"text":"Pressure waves race while the gravity rolls,"},{"s":102.779,"e":106.053,"text":"A pulsing blue jewel in the Pegasus folds."},{"s":106.053,"e":108.508,"text":"Blue-white blaze with a heartbeat hidden,"},{"s":108.508,"e":111.237,"text":"Cosmic code in a cadence unwritten."},{"s":111.237,"e":113.965,"text":"I couldn’t spell pulsation or chart its flight,"},{"s":113.965,"e":116.966,"text":"But I felt that distant drummer drum through night."},{"s":116.966,"e":118.058,"text":"Beat, beat—blue flame, bright."},{"s":118.058,"e":119.422,"text":"Beat, beat—through the night."},{"s":119.422,"e":120.786,"text":"Far, far—still you came."},{"s":120.786,"e":122.969,"text":"Algenib—I learned your name."},{"s":122.969,"e":125.697,"text":"Betelgeuse burns on Orion’s broad shoulder,"},{"s":125.697,"e":128.698,"text":"Red as a ruby, enormous and older."},{"s":128.698,"e":131.972,"text":"A supergiant swelling, a furnace unfurled—"},{"s":131.972,"e":135.519,"text":"Placed where our Sun is, it could swallow inner worlds."},{"s":135.519,"e":138.52,"text":"Then the giant dimmed and the whole Earth stared;"},{"s":138.52,"e":142.34,"text":"It hurled out matter and its brilliance was impaired."},{"s":142.34,"e":145.341,"text":"Cooling gas formed dust, making red fire hide—"},{"s":145.341,"e":148.888,"text":"Even wounded wonders still illuminate the sky."},{"s":148.888,"e":151.344,"text":"Burn, Betelgeuse, burn—red gold, red glow."},{"s":151.344,"e":154.618,"text":"Teach a little dreamer there is more than we know."},{"s":154.618,"e":157.619,"text":"Dim, then return; let the darkness testify:"},{"s":157.619,"e":161.166,"text":"Even wounded wonders still illuminate the sky."},{"s":161.166,"e":163.894,"text":"Sirius—serious shimmer, sharp silver flame,"},{"s":163.894,"e":166.623,"text":"Brightest star at nighttime, Dog Star by name."},{"s":166.623,"e":169.351,"text":"Eight-point-six years for its light to arrive—"},{"s":169.351,"e":172.625,"text":"Every glance at Sirius sees an earlier sky."},{"s":172.625,"e":175.354,"text":"One blaze is two in a beautiful spin:"},{"s":175.354,"e":178.628,"text":"Sirius A with a secret companion within."},{"s":178.628,"e":181.356,"text":"Sirius B, Earth-small, nearly Sun-heavy,"},{"s":181.356,"e":184.63,"text":"A white-dwarf diamond, collapsed and steady."},{"s":184.63,"e":187.904,"text":"Ten thousand times fainter beneath all that glare,"},{"s":187.904,"e":190.905,"text":"A hidden little heavyweight quietly there."},{"s":190.905,"e":193.907,"text":"The brightest may never be burning alone,"},{"s":193.907,"e":197.453,"text":"And the smallest-looking light may be denser than stone."},{"s":197.453,"e":201,"text":"Polaris isn’t brightest—it is faithful in the frame,"},{"s":201,"e":204.82,"text":"A northern-pointing promise with a navigator’s name."},{"s":204.82,"e":208.64,"text":"Not one lonely lantern but a family of three,"},{"s":208.64,"e":212.46,"text":"A Cepheid softly breathing in celestial harmony."},{"s":212.46,"e":216.006,"text":"Sailors found salvation in its steady-seeming role,"},{"s":216.006,"e":219.281,"text":"A silver signal sitting near the northern pole."},{"s":219.281,"e":222.282,"text":"But Earth spins and sways like a slow, dreaming top,"},{"s":222.282,"e":225.829,"text":"So even North is borrowed; even guide stars swap."},{"s":225.829,"e":228.557,"text":"Thuban held the title; Vega waits beyond,"},{"s":228.557,"e":232.104,"text":"The sky keeps rearranging what we thought would carry on."},{"s":232.104,"e":235.378,"text":"Still Polaris keeps pointing while our brief years pass,"},{"s":235.378,"e":238.652,"text":"A pin through the heavens, a compass through the black."},{"s":238.652,"e":242.199,"text":"Maybe awe is intelligence before it learns a word."},{"s":242.199,"e":246.019,"text":"Maybe wonder is the wisest thing a child has ever heard."},{"s":246.019,"e":249.566,"text":"Maybe every distant sun is someone else’s dawn,"},{"s":249.566,"e":253.931,"text":"And someone there is wondering if our little light lives on."},{"s":253.931,"e":257.751,"text":"Do they lie beneath strange leaves, looking toward our flame?"},{"s":257.751,"e":261.843,"text":"Do they whisper “Sol” with wonder? Did they give our Sun a name?"},{"s":261.843,"e":265.663,"text":"Are they staring at old Earthlight traveling through the dark,"},{"s":265.663,"e":269.756,"text":"Seeing ancient human history as a tiny golden spark?"},{"s":269.756,"e":272.211,"text":"Look up, little light, look far, look free,"},{"s":272.211,"e":275.485,"text":"Every soul starts small beneath eternity."},{"s":275.485,"e":278.486,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":278.486,"e":282.306,"text":"Four flames, four names, four reasons wonder carries us."},{"s":282.306,"e":285.034,"text":"Look up, little light—though the years race by,"},{"s":285.034,"e":289.4,"text":"Keep the kid who kissed infinity alive behind your eyes."},{"s":289.4,"e":292.401,"text":"Algenib, Betelgeuse, Sirius, Polaris—"},{"s":292.401,"e":296.221,"text":"I was small beneath it all, but the whole sky felt like ours."},{"s":296.221,"e":297.312,"text":"Algenib beat."},{"s":297.312,"e":298.676,"text":"Betelgeuse burned."},{"s":298.676,"e":300.041,"text":"Sirius shimmered."},{"s":300.041,"e":301.405,"text":"Polaris turned."},{"s":301.405,"e":302.769,"text":"They called it space—"},{"s":302.769,"e":304.133,"text":"Cold, endless and far."},{"s":304.133,"e":306.043,"text":"I called it the first place"},{"s":306.043,"e":307.68,"text":"I learned who we are."}],"duration":311.24,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.015Z","realignedFrom":"whisper-aligned","vocalStart":2.92,"vocalEnd":307.68}