6,"e":140.76,"line":40},{"w":"when","s":140.76,"e":141.02,"line":40},{"w":"the","s":141.02,"e":141.38,"line":40},{"w":"lanes","s":141.38,"e":141.54,"line":40},{"w":"are","s":141.54,"e":141.98,"line":40},{"w":"lit.","s":141.98,"e":142.06,"line":40},{"w":"Spina","s":142.04,"e":142.9,"line":41},{"w":"bifida","s":142.9,"e":143.54,"line":41},{"w":"doesn’t","s":143.54,"e":143.75,"line":41},{"w":"get","s":143.96,"e":144.3,"line":41},{"w":"the","s":144.3,"e":144.56,"line":41},{"w":"final","s":144.56,"e":145.18,"line":41},{"w":"say—","s":145.18,"e":145.88,"line":41},{"w":"Danny’s","s":146,"e":146.56,"line":42},{"w":"gonna","s":146.56,"e":146.66,"line":42},{"w":"beat","s":146.76,"e":147.02,"line":42},{"w":"you","s":147.02,"e":147.28,"line":42},{"w":"at","s":147.28,"e":147.54,"line":42},{"w":"bowling","s":147.54,"e":148.24,"line":42},{"w":"anyway.","s":148.24,"e":150.84,"line":42}],"lines":[{"s":12.76,"e":15.06,"text":"They say life comes with labels,"},{"s":15.04,"e":17.28,"text":"some easy, some unfair,"},{"s":18.28,"e":20.52,"text":"but Danny walks in laughing"},{"s":20.52,"e":22.88,"text":"like she owns the whole damn air."},{"s":24.52,"e":26.32,"text":"Spina bifida? She’ll say it,"},{"s":26.56,"e":28.58,"text":"then she’ll lace up for the game,"},{"s":29.32,"e":32.62,"text":"because a diagnosis isn’t destiny,"},{"s":33.32,"e":35.6,"text":"and it sure ain’t her whole name."},{"s":36.3,"e":38.84,"text":"You can talk all day, you can act real slick,"},{"s":39.12,"e":41.6,"text":"you can stretch, warm up, pick your perfect grip,"},{"s":41.66,"e":44.64,"text":"but when the pins start shaking and the scoreboard glows,"},{"s":44.84,"e":47.6,"text":"everybody in the alley already knows—"},{"s":47.6,"e":50.86,"text":"Danny’s gonna beat you at bowling anyway,"},{"s":50.86,"e":53.76,"text":"strike in the tenth like she planned it all day."},{"s":53.84,"e":56.76,"text":"Rolls that thunder straight down the lane,"},{"s":56.68,"e":59.4,"text":"leaves your ego in the gutter again."},{"s":59.42,"e":61.5,"text":"Doesn’t matter what you thought,"},{"s":62.26,"e":64.3,"text":"doesn’t matter what they say,"},{"s":64.54,"e":67.66,"text":"Danny’s gonna beat you at bowling anyway."},{"s":68.98,"e":71.12,"text":"She’s got that quiet confidence,"},{"s":71.12,"e":74.1,"text":"that “watch this” kind of grin,"},{"s":74.54,"e":77.98,"text":"like she’s already heard the doubts"},{"s":77.9,"e":80.32,"text":"and turned them into wins."},{"s":80.36,"e":81.88,"text":"You see a challenge, she sees rhythm,"},{"s":82.98,"e":84.94,"text":"you see limits, she sees aim,"},{"s":85.9,"e":89.42,"text":"and by frame five you’re reconsidering"},{"s":89.42,"e":91.78,"text":"why you ever played this game."},{"s":92.1,"e":94.48,"text":"So raise up a soda, raise up a cheer,"},{"s":94.68,"e":97.28,"text":"for Danielle with the cannon arm, calm and clear."},{"s":97.42,"e":100.08,"text":"Life threw curves, but she learned the spin,"},{"s":100.16,"e":103.26,"text":"now she’s picking up spares with a champion grin."},{"s":103.26,"e":103.66,"text":"Final Hook"},{"s":103.86,"e":107.04,"text":"Danny’s gonna beat you at bowling anyway,"},{"s":107.18,"e":110.16,"text":"left pin, right pin, all gone, hey."},{"s":110.16,"e":112.5,"text":"Call it heart, call it skill, call it family pride,"},{"s":112.5,"e":115.42,"text":"she’s got the whole damn alley on her side."},{"s":115.42,"e":117.66,"text":"Doesn’t matter what you thought,"},{"s":118.46,"e":120.4,"text":"doesn’t matter what they say,"},{"s":121.08,"e":124.88,"text":"Danny’s gonna beat you at bowling anyway."},{"s":136.04,"e":139.34,"text":"So don’t judge the story by the first line written,"},{"s":139.62,"e":142.06,"text":"don’t bet against Danny when the lanes are lit."},{"s":142.04,"e":145.88,"text":"Spina bifida doesn’t get the final say—"},{"s":146,"e":150.84,"text":"Danny’s gonna beat you at bowling anyway."}],"duration":161.52,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.412Z","stats":{"whisperWords":357,"polishedWords":315,"matched":303,"matchRate":0.962}}