,"s":294.971,"e":295.517,"line":101},{"w":"the","s":295.517,"e":295.79,"line":101},{"w":"stars","s":295.79,"e":296.063,"line":101},{"w":"through","s":296.063,"e":296.335,"line":101},{"w":"the","s":296.335,"e":296.608,"line":101},{"w":"psychic","s":296.608,"e":297.154,"line":101},{"w":"machine.”","s":297.154,"e":297.7,"line":101}],"lines":[{"s":29.98,"e":32.163,"text":"**“Quarter in the Psychic Machine”**"},{"s":32.163,"e":34.892,"text":"Drop a quarter in the psychic machine,"},{"s":34.892,"e":38.167,"text":"By the tarot-card table in velvet and green,"},{"s":38.167,"e":40.623,"text":"Stars spark, hearts start, love leaks through the screen,"},{"s":40.623,"e":43.352,"text":"Moonlight moves like a mystic machine."},{"s":43.352,"e":46.354,"text":"I asked one question, the glass eyes gleamed,"},{"s":46.354,"e":49.083,"text":"The brass bell rang and the bright lights beamed,"},{"s":49.083,"e":51.812,"text":"Leet hax in the zodiac, fate in the code,"},{"s":51.812,"e":54.814,"text":"Then my mind took flight down a moon-mapped road."},{"s":54.814,"e":57.816,"text":"Pages are sparks, fresh starts, first art from the soul,"},{"s":57.816,"e":60,"text":"Knights are the chase, the race, the road,"},{"s":60,"e":62.729,"text":"Queens are the knowing, the glowing inside,"},{"s":62.729,"e":65.731,"text":"Kings are command, calm crowns, mastered tides."},{"s":65.731,"e":69.005,"text":"Then I zoned out, rolled out, soul spun around,"},{"s":69.005,"e":71.734,"text":"Fell through the stars without touching the ground,"},{"s":71.734,"e":74.191,"text":"Love got loud, fate got found, time broke down,"},{"s":74.191,"e":77.466,"text":"And the court cards crowned me in a dream-drift town."},{"s":77.466,"e":80.74,"text":"Cups are the heart, the art, the ache, the affection,"},{"s":80.74,"e":83.742,"text":"Wands are the fire, desire, divine direction,"},{"s":83.742,"e":86.744,"text":"Swords are the thought, the truth, the sharp selection,"},{"s":86.744,"e":89.746,"text":"Coins are the work, the worth, the world’s reflection."},{"s":89.746,"e":91.657,"text":"Page of Cups came soft as rain,"},{"s":91.657,"e":93.84,"text":"New love, true love, dew on the vein,"},{"s":93.84,"e":96.569,"text":"Dreaming and feeling, revealing what’s real,"},{"s":96.569,"e":99.844,"text":"A tender little message from the heart you heal."},{"s":99.844,"e":102.573,"text":"Knight of Cups rode with a rose and a rhyme,"},{"s":102.573,"e":105.029,"text":"Charm in his arms, moon-music in time,"},{"s":105.029,"e":107.758,"text":"Romance in motion, devotion in flight,"},{"s":107.758,"e":110.214,"text":"But fast stars fade when they burn too bright."},{"s":110.214,"e":112.397,"text":"Queen of Cups in a silver sea,"},{"s":112.397,"e":114.854,"text":"Psychic and soft, she could see through me,"},{"s":114.854,"e":117.583,"text":"Mercy in motion, emotion in bloom,"},{"s":117.583,"e":120.585,"text":"She haxed my heart by the light of the moon."},{"s":120.585,"e":122.768,"text":"King of Cups kept calm in the crash,"},{"s":122.768,"e":125.224,"text":"Storms may roar, but he never acts rash,"},{"s":125.224,"e":127.68,"text":"Master of feeling, healing the tide,"},{"s":127.68,"e":129.863,"text":"Love stays strong when the soul can guide."},{"s":129.863,"e":132.047,"text":"Page of Wands had a wild flame grin,"},{"s":132.047,"e":134.503,"text":"Bright new beginnings burning within,"},{"s":134.503,"e":136.686,"text":"Spark in the dark, art in the air,"},{"s":136.686,"e":139.415,"text":"Saying, “Start that dream if you dare, if you dare.”"},{"s":139.415,"e":141.325,"text":"Knight of Wands came bold, fast, loud,"},{"s":141.325,"e":144.054,"text":"Thunder in his tires, fire in his cloud,"},{"s":144.054,"e":146.783,"text":"Passion and action, attraction and speed,"},{"s":146.783,"e":150.331,"text":"A pickup-truck comet with a rocket-fueled need."},{"s":150.331,"e":152.514,"text":"Queen of Wands wore a sunlit stare,"},{"s":152.514,"e":154.971,"text":"Black-cat magic in her midnight hair,"},{"s":154.971,"e":157.427,"text":"Confidence, courage, charm in her chest,"},{"s":157.427,"e":159.883,"text":"Love like lightning made the stars confess."},{"s":159.883,"e":162.339,"text":"King of Wands held a vision so wide,"},{"s":162.339,"e":165.068,"text":"Fire in his fist and the future inside,"},{"s":165.068,"e":167.797,"text":"Leader and dreamer, commander of flame,"},{"s":167.797,"e":170.799,"text":"He made one spark into a kingdom of fame."},{"s":170.799,"e":174.074,"text":"The machine said, “Listen, the lesson is coded,"},{"s":174.074,"e":176.803,"text":"Stars are the script and your heart is loaded,"},{"s":176.803,"e":179.532,"text":"Love is the password, spirit is the map,"},{"s":179.532,"e":182.261,"text":"Fate is a firewall the brave can hax.”"},{"s":182.261,"e":184.444,"text":"Page of Swords had a curious crown,"},{"s":184.444,"e":187.173,"text":"Sharp little spark where the truth comes down,"},{"s":187.173,"e":190.175,"text":"Questions and messages, whispers and wires,"},{"s":190.175,"e":193.45,"text":"A mind like a blade with electric desires."},{"s":193.45,"e":195.633,"text":"Knight of Swords flew swift through the storm,"},{"s":195.633,"e":197.817,"text":"Fast with the facts and fierce in form,"},{"s":197.817,"e":200,"text":"Truth in his teeth, lightning in flight,"},{"s":200,"e":203.002,"text":"But speed needs wisdom or it misses what’s right."},{"s":203.002,"e":205.458,"text":"Queen of Swords had a boundary blade,"},{"s":205.458,"e":207.641,"text":"Clear cold calm from the scars she made,"},{"s":207.641,"e":210.37,"text":"Honest and healed, she could cut through lies,"},{"s":210.37,"e":212.826,"text":"A sorrow-born star with diamond eyes."},{"s":212.826,"e":215.283,"text":"King of Swords ruled reason and right,"},{"s":215.283,"e":217.466,"text":"Law like lightning, logic like light,"},{"s":217.466,"e":219.649,"text":"Clean command, clear crown, cosmic sight,"},{"s":219.649,"e":222.651,"text":"He haxed the chaos and restored the night."},{"s":222.651,"e":224.834,"text":"Page of Coins held a golden seed,"},{"s":224.834,"e":227.018,"text":"Study and skill, plan and proceed,"},{"s":227.018,"e":228.928,"text":"New work, new worth, earth-born spell,"},{"s":228.928,"e":231.657,"text":"A star-rooted dream learning how to dwell."},{"s":231.657,"e":234.113,"text":"Knight of Coins moved steady and slow,"},{"s":234.113,"e":236.296,"text":"Patient and loyal, making roots grow,"},{"s":236.296,"e":239.025,"text":"Grit over glitter, labor over luck,"},{"s":239.025,"e":242.027,"text":"Leet hax in the habit when the hard road’s stuck."},{"s":242.027,"e":244.211,"text":"Queen of Coins had a hearth-fire glow,"},{"s":244.211,"e":246.667,"text":"Comfort and care where the good things grow,"},{"s":246.667,"e":249.396,"text":"Love made practical, peaceful, and known,"},{"s":249.396,"e":252.671,"text":"A garden of stars around a generous home."},{"s":252.671,"e":254.854,"text":"King of Coins wore a harvest crown,"},{"s":254.854,"e":257.31,"text":"Built from the dirt, not a hand-me-down,"},{"s":257.31,"e":260.039,"text":"Stable and able, secure on his throne,"},{"s":260.039,"e":263.041,"text":"He made love last by building it stone by stone."},{"s":263.041,"e":264.133,"text":"Final Chorus"},{"s":264.133,"e":267.408,"text":"Then I zoned out, rolled out, soul spun around,"},{"s":267.408,"e":270.137,"text":"Fell through the stars without touching the ground,"},{"s":270.137,"e":272.593,"text":"Love got loud, fate got found, time broke down,"},{"s":272.593,"e":275.868,"text":"And the court cards crowned me in a dream-drift town."},{"s":275.868,"e":278.051,"text":"Pages are sparks, Knights are motion,"},{"s":278.051,"e":280.78,"text":"Queens are the magic, deep as an ocean,"},{"s":280.78,"e":283.236,"text":"Kings are mastery, steady and proud,"},{"s":283.236,"e":285.692,"text":"Stars sang love through a tarot-card cloud."},{"s":285.692,"e":288.148,"text":"The reader smiled, said, “Now you see,"},{"s":288.148,"e":291.15,"text":"The cards were a mirror, the code was the key,"},{"s":291.15,"e":294.698,"text":"Your heart asked the question, your soul answered free,"},{"s":294.698,"e":297.7,"text":"Love haxed the stars through the psychic machine.”"}],"duration":309.16,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.995Z","realignedFrom":"whisper-aligned","vocalStart":29.98,"vocalEnd":297.7}