":249.44,"e":249.88,"line":99},{"w":"you","s":249.88,"e":250.16,"line":99},{"w":"as","s":250.16,"e":250.46,"line":99},{"w":"a","s":250.46,"e":250.68,"line":99},{"w":"stranger…","s":250.68,"e":251.66,"line":99},{"w":"And","s":252.76,"e":254.16,"line":100},{"w":"fall","s":254.16,"e":254.4,"line":100},{"w":"in","s":254.4,"e":255.28,"line":100},{"w":"love","s":255.28,"e":255.46,"line":100},{"w":"with","s":255.98,"e":257.38,"line":100},{"w":"you.","s":257.38,"e":258.78,"line":100}],"lines":[{"s":0,"e":0.5,"text":"[INTRO — FEMALE, SOLO PIANO]"},{"s":1.94,"e":7.74,"text":"If the whole world washed my memory clean,"},{"s":7.74,"e":12.4,"text":"No photographs, no proof we'd ever been,"},{"s":12.4,"e":17.68,"text":"If you walked by like somebody brand-new…"},{"s":17.68,"e":23.58,"text":"Would something in my soul still turn to you?"},{"s":23.58,"e":24.08,"text":"[VERSE 1 — MALE, MELODIC RAP]"},{"s":41.84,"e":44.36,"text":"If we met again, no names, no past,"},{"s":44.36,"e":46.3,"text":"No pain in the frame, no flame that lasts,"},{"s":46.3,"e":48.16,"text":"Just two strangers crossing through a crowded room,"},{"s":48.16,"e":50.12,"text":"Would my eyes find yours like the tide finds moon?"},{"s":50.22,"e":52.04,"text":"Would I crack that smile? Would you catch that clue?"},{"s":52.04,"e":53.98,"text":"Would the bass hit hard when I looked at you?"},{"s":54.04,"e":55.98,"text":"Would my chest go boom with a truth I can't prove?"},{"s":56.04,"e":57.9,"text":"Like, “I don't know this girl, but I know this groove.”"},{"s":57.9,"e":59.84,"text":"No history, mystery, memory missing,"},{"s":59.84,"e":61.84,"text":"Still feel electricity every time we're grinning,"},{"s":61.76,"e":63.7,"text":"Maybe love ain't files that the mind keeps spinning,"},{"s":63.7,"e":65.68,"text":"Maybe hearts keep score when the head quits listening."},{"s":65.68,"e":67.62,"text":"I'd probably play cool, probably talk too slick,"},{"s":67.62,"e":69.52,"text":"You'd probably see through every trick real quick,"},{"s":69.52,"e":71.66,"text":"I'd say, “What you doing?” You'd laugh like, “Please,”"},{"s":71.58,"e":73.48,"text":"Then somehow we're talking till a quarter past three."},{"s":73.48,"e":73.98,"text":"[PRE-CHORUS — FEMALE]"},{"s":73.48,"e":76.34,"text":"If every chapter disappeared tonight,"},{"s":76.34,"e":80.42,"text":"Would we still somehow read between the lines?"},{"s":80.42,"e":84.64,"text":"No map, no memory, no reason why—"},{"s":84.64,"e":88.82,"text":"Would your heart recognize mine?"},{"s":88.82,"e":89.32,"text":"[CHORUS — BOTH]"},{"s":88.86,"e":91.98,"text":"If we met again, would you fall for me?"},{"s":92.28,"e":95.82,"text":"Would I fall for you like gravity?"},{"s":96.22,"e":99.7,"text":"Different day, different street, different life, different view,"},{"s":99.7,"e":105.24,"text":"I think I'd still find my way back to you."},{"s":105.24,"e":106.9,"text":"If we met again with nothing to explain,"},{"s":106.9,"e":108.84,"text":"No old photographs, no familiar names,"},{"s":108.84,"e":110.76,"text":"I'd choose your laugh, your light, your truth—"},{"s":110.76,"e":117.3,"text":"I think I'd choose you every life I move through."},{"s":117.3,"e":121.32,"text":"Every life, every time, every road, every view,"},{"s":123.06,"e":128.28,"text":"Lose the memories—I still think I'd love you."},{"s":128.28,"e":128.78,"text":"[VERSE 2 — FEMALE]"},{"s":128.28,"e":130.6,"text":"Maybe we'd meet where the midnight trains run,"},{"s":130.6,"e":132.56,"text":"Maybe beneath some impossible sun,"},{"s":132.56,"e":134.62,"text":"Maybe you're broke, maybe I'm doing fine,"},{"s":134.62,"e":136.52,"text":"Maybe we're older in another timeline."},{"s":136.52,"e":138.88,"text":"But I know that kindness behind your eyes,"},{"s":138.88,"e":140.94,"text":"Even without knowing the reason why."},{"s":141.06,"e":143.72,"text":"Some things are deeper than dates and details,"},{"s":143.72,"e":145.56,"text":"Deeper than stories a photograph tells."},{"s":145.56,"e":147.46,"text":"I'd hear your voice and the room might slow,"},{"s":147.46,"e":149.38,"text":"Something inside me would quietly know,"},{"s":149.38,"e":151.4,"text":"Not “this is destiny carved into stone,”"},{"s":151.4,"e":153.24,"text":"Just “I feel safer when I'm not alone.”"},{"s":153.24,"e":155.18,"text":"We'd build it again, brick after brick,"},{"s":155.18,"e":157.06,"text":"Choosing what's real when the feelings get thick,"},{"s":157.06,"e":159.08,"text":"No perfect prophecy, no fairy-tale proof—"},{"s":159.08,"e":162.58,"text":"Just patience and presence and telling the truth."},{"s":162.58,"e":163.08,"text":"[VERSE 3 — MALE, BASS DROPS HARD]"},{"s":162.58,"e":162.66,"text":"Yeah—"},{"s":162.58,"e":165.28,"text":"New city, new century, new set of scars,"},{"s":165.28,"e":167.28,"text":"Same strange spark underneath different stars,"},{"s":167.28,"e":169.18,"text":"Could be no money, no mansion, no car,"},{"s":169.18,"e":171.06,"text":"Still I'd pull up wherever you are."},{"s":171.06,"e":172.9,"text":"Heart got a compass, yours got a code,"},{"s":172.88,"e":174.8,"text":"Love ain't possession, it's choosing the road,"},{"s":174.8,"e":176.7,"text":"Choosing to listen when tempers explode,"},{"s":176.7,"e":178.62,"text":"Choosing what's true over stories we're told."},{"s":178.62,"e":180.1,"text":"I ain't saying every life painless,"},{"s":180.1,"e":182.06,"text":"Rain still rain and change still changes,"},{"s":182.06,"e":184.38,"text":"But if we start fresh, nameless, stainless,"},{"s":184.38,"e":186.3,"text":"I'd learn your language through all your phases."},{"s":186.3,"e":188.2,"text":"Maybe that's love—not chains, but choice,"},{"s":188.2,"e":190.12,"text":"Room for your mind, room for your voice,"},{"s":190.12,"e":191.82,"text":"Two whole people making one loud noise,"},{"s":191.82,"e":195,"text":"Still choosing each other when we got other choices."},{"s":195,"e":195.5,"text":"[BRIDGE — FEMALE, NEAR-SILENT PIANO]"},{"s":195.36,"e":197.98,"text":"Erase the first kiss."},{"s":198.3,"e":199.84,"text":"Erase the first dance."},{"s":199.84,"e":203.58,"text":"Erase every photograph, every romance."},{"s":203.58,"e":206.42,"text":"Take every memory heaven could hide…"},{"s":206.42,"e":210.32,"text":"Then put you before me for the very first time."},{"s":210.32,"e":212.8,"text":"I think my heart would still decide."},{"s":212.8,"e":213.3,"text":"[FINAL CHORUS — BOTH, MASSIVE]"},{"s":212.8,"e":216.9,"text":"IF WE MET AGAIN, I'D FALL FOR YOU,"},{"s":216.9,"e":220.84,"text":"Like the sky falls gold when the daylight's through,"},{"s":220.84,"e":224.68,"text":"Different name, different age, different world, different view—"},{"s":224.68,"e":228.32,"text":"I think I'd still find my way back to you."},{"s":228.32,"e":230.16,"text":"If we met again with the whole slate clean,"},{"s":230.22,"e":232.18,"text":"No clue what we were, no proof what we'd seen,"},{"s":232.1,"e":233.98,"text":"I'd choose your laugh, your light, your truth—"},{"s":233.98,"e":239.88,"text":"I think I'd choose you every life I move through."},{"s":239.88,"e":240.38,"text":"[FEMALE]"},{"s":239.88,"e":240.9,"text":"Every life—"},{"s":240.9,"e":241.4,"text":"[MALE]"},{"s":240.9,"e":241.8,"text":"Every road—"},{"s":241.8,"e":242.3,"text":"[FEMALE]"},{"s":241.8,"e":242.32,"text":"Every star—"},{"s":242.32,"e":242.82,"text":"[MALE]"},{"s":242.58,"e":243.22,"text":"Every soul—"},{"s":243.14,"e":243.64,"text":"[BOTH]"},{"s":243.14,"e":249.06,"text":"If forever forgot everything we knew,"},{"s":249.06,"e":251.66,"text":"I'd meet you as a stranger…"},{"s":252.76,"e":258.78,"text":"And fall in love with you."}],"duration":260.92,"source":"whisper-aligned","generatedAt":"2026-08-21T00:35:51.786Z","stats":{"whisperWords":672,"polishedWords":678,"matched":630,"matchRate":0.929}}