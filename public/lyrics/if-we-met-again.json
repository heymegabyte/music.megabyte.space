,{"w":"your","s":242.538,"e":242.833,"line":79},{"w":"light,","s":242.833,"e":243.129,"line":79},{"w":"your","s":243.129,"e":243.424,"line":79},{"w":"truth—","s":243.424,"e":243.72,"line":79},{"w":"I","s":243.72,"e":244.015,"line":80},{"w":"think","s":244.015,"e":244.311,"line":80},{"w":"I'd","s":244.311,"e":244.607,"line":80},{"w":"choose","s":244.607,"e":244.902,"line":80},{"w":"you","s":244.902,"e":245.198,"line":80},{"w":"every","s":245.198,"e":246.084,"line":80},{"w":"life","s":246.084,"e":246.38,"line":80},{"w":"I","s":246.38,"e":246.675,"line":80},{"w":"move","s":246.675,"e":246.971,"line":80},{"w":"through.","s":246.971,"e":247.267,"line":80},{"w":"Every","s":247.267,"e":248.153,"line":81},{"w":"life—","s":248.153,"e":248.449,"line":81},{"w":"Every","s":248.449,"e":249.335,"line":82},{"w":"road—","s":249.335,"e":249.631,"line":82},{"w":"Every","s":249.631,"e":250.518,"line":83},{"w":"star—","s":250.518,"e":250.813,"line":83},{"w":"Every","s":250.813,"e":251.7,"line":84},{"w":"soul—","s":251.7,"e":251.995,"line":84},{"w":"If","s":251.995,"e":252.291,"line":85},{"w":"forever","s":252.291,"e":253.178,"line":85},{"w":"forgot","s":253.178,"e":253.769,"line":85},{"w":"everything","s":253.769,"e":254.951,"line":85},{"w":"we","s":254.951,"e":255.247,"line":85},{"w":"knew,","s":255.247,"e":255.542,"line":85},{"w":"I'd","s":255.542,"e":255.838,"line":86},{"w":"meet","s":255.838,"e":256.133,"line":86},{"w":"you","s":256.133,"e":256.429,"line":86},{"w":"as","s":256.429,"e":256.724,"line":86},{"w":"a","s":256.724,"e":257.02,"line":86},{"w":"stranger…","s":257.02,"e":257.611,"line":86},{"w":"And","s":257.611,"e":257.907,"line":87},{"w":"fall","s":257.907,"e":258.202,"line":87},{"w":"in","s":258.202,"e":258.498,"line":87},{"w":"love","s":258.498,"e":258.78,"line":87},{"w":"with","s":258.78,"e":258.86,"line":87},{"w":"you.","s":258.78,"e":258.86,"line":87}],"lines":[{"s":1.94,"e":5.191,"text":"If the whole world washed my memory clean,"},{"s":5.191,"e":8.147,"text":"No photographs, no proof we'd ever been,"},{"s":8.147,"e":11.693,"text":"If you walked by like somebody brand-new…"},{"s":11.693,"e":14.945,"text":"Would something in my soul still turn to you?"},{"s":14.945,"e":17.9,"text":"If we met again, no names, no past,"},{"s":17.9,"e":20.56,"text":"No pain in the frame, no flame that lasts,"},{"s":20.56,"e":23.811,"text":"Just two strangers crossing through a crowded room,"},{"s":23.811,"e":26.767,"text":"Would my eyes find yours like the tide finds moon?"},{"s":26.767,"e":29.722,"text":"Would I crack that smile? Would you catch that clue?"},{"s":29.722,"e":32.974,"text":"Would the bass hit hard when I looked at you?"},{"s":32.974,"e":36.225,"text":"Would my chest go boom with a truth I can't prove?"},{"s":36.225,"e":39.476,"text":"Like, “I don't know this girl, but I know this groove.”"},{"s":39.476,"e":43.023,"text":"No history, mystery, memory missing,"},{"s":43.023,"e":47.16,"text":"Still feel electricity every time we're grinning,"},{"s":47.16,"e":50.412,"text":"Maybe love ain't files that the mind keeps spinning,"},{"s":50.412,"e":53.663,"text":"Maybe hearts keep score when the head quits listening."},{"s":53.663,"e":57.209,"text":"I'd probably play cool, probably talk too slick,"},{"s":57.209,"e":60.756,"text":"You'd probably see through every trick real quick,"},{"s":60.756,"e":63.416,"text":"I'd say, “What you doing?” You'd laugh like, “Please,”"},{"s":63.416,"e":67.258,"text":"Then somehow we're talking till a quarter past three."},{"s":67.258,"e":70.805,"text":"If every chapter disappeared tonight,"},{"s":70.805,"e":74.352,"text":"Would we still somehow read between the lines?"},{"s":74.352,"e":77.307,"text":"No map, no memory, no reason why—"},{"s":77.307,"e":79.376,"text":"Would your heart recognize mine?"},{"s":79.376,"e":82.332,"text":"If we met again, would you fall for me?"},{"s":82.332,"e":84.992,"text":"Would I fall for you like gravity?"},{"s":84.992,"e":89.721,"text":"Different day, different street, different life, different view,"},{"s":89.721,"e":92.676,"text":"I think I'd still find my way back to you."},{"s":92.676,"e":95.927,"text":"If we met again with nothing to explain,"},{"s":95.927,"e":99.179,"text":"No old photographs, no familiar names,"},{"s":99.179,"e":101.543,"text":"I'd choose your laugh, your light, your truth—"},{"s":101.543,"e":105.09,"text":"I think I'd choose you every life I move through."},{"s":105.09,"e":109.819,"text":"Every life, every time, every road, every view,"},{"s":109.819,"e":113.07,"text":"Lose the memories—I still think I'd love you."},{"s":113.07,"e":115.73,"text":"Maybe we'd meet where the midnight trains run,"},{"s":115.73,"e":118.39,"text":"Maybe beneath some impossible sun,"},{"s":118.39,"e":120.459,"text":"Maybe you're broke, maybe I'm doing fine,"},{"s":120.459,"e":123.71,"text":"Maybe we're older in another timeline."},{"s":123.71,"e":126.666,"text":"But I know that kindness behind your eyes,"},{"s":126.666,"e":129.621,"text":"Even without knowing the reason why."},{"s":129.621,"e":132.872,"text":"Some things are deeper than dates and details,"},{"s":132.872,"e":135.828,"text":"Deeper than stories a photograph tells."},{"s":135.828,"e":138.488,"text":"I'd hear your voice and the room might slow,"},{"s":138.488,"e":141.443,"text":"Something inside me would quietly know,"},{"s":141.443,"e":144.695,"text":"Not “this is destiny carved into stone,”"},{"s":144.695,"e":147.65,"text":"Just “I feel safer when I'm not alone.”"},{"s":147.65,"e":150.31,"text":"We'd build it again, brick after brick,"},{"s":150.31,"e":153.266,"text":"Choosing what's real when the feelings get thick,"},{"s":153.266,"e":156.517,"text":"No perfect prophecy, no fairy-tale proof—"},{"s":156.517,"e":159.768,"text":"Just patience and presence and telling the truth."},{"s":159.768,"e":160.668,"text":"Yeah—"},{"s":160.668,"e":163.919,"text":"New city, new century, new set of scars,"},{"s":163.919,"e":166.875,"text":"Same strange spark underneath different stars,"},{"s":166.875,"e":169.83,"text":"Could be no money, no mansion, no car,"},{"s":169.83,"e":172.49,"text":"Still I'd pull up wherever you are."},{"s":172.49,"e":175.15,"text":"Heart got a compass, yours got a code,"},{"s":175.15,"e":178.106,"text":"Love ain't possession, it's choosing the road,"},{"s":178.106,"e":181.062,"text":"Choosing to listen when tempers explode,"},{"s":181.062,"e":184.017,"text":"Choosing what's true over stories we're told."},{"s":184.017,"e":186.677,"text":"I ain't saying every life painless,"},{"s":186.677,"e":189.042,"text":"Rain still rain and change still changes,"},{"s":189.042,"e":191.997,"text":"But if we start fresh, nameless, stainless,"},{"s":191.997,"e":194.953,"text":"I'd learn your language through all your phases."},{"s":194.953,"e":197.317,"text":"Maybe that's love—not chains, but choice,"},{"s":197.317,"e":199.682,"text":"Room for your mind, room for your voice,"},{"s":199.682,"e":202.342,"text":"Two whole people making one loud noise,"},{"s":202.342,"e":206.184,"text":"Still choosing each other when we got other choices."},{"s":206.184,"e":207.662,"text":"Erase the first kiss."},{"s":207.662,"e":209.14,"text":"Erase the first dance."},{"s":209.14,"e":212.982,"text":"Erase every photograph, every romance."},{"s":212.982,"e":216.233,"text":"Take every memory heaven could hide…"},{"s":216.233,"e":219.78,"text":"Then put you before me for the very first time."},{"s":219.78,"e":222.144,"text":"I think my heart would still decide."},{"s":222.144,"e":224.804,"text":"IF WE MET AGAIN, I'D FALL FOR YOU,"},{"s":224.804,"e":227.76,"text":"Like the sky falls gold when the daylight's through,"},{"s":227.76,"e":232.489,"text":"Different name, different age, different world, different view—"},{"s":232.489,"e":235.444,"text":"I think I'd still find my way back to you."},{"s":235.444,"e":238.4,"text":"If we met again with the whole slate clean,"},{"s":238.4,"e":241.355,"text":"No clue what we were, no proof what we'd seen,"},{"s":241.355,"e":243.72,"text":"I'd choose your laugh, your light, your truth—"},{"s":243.72,"e":247.267,"text":"I think I'd choose you every life I move through."},{"s":247.267,"e":248.449,"text":"Every life—"},{"s":248.449,"e":249.631,"text":"Every road—"},{"s":249.631,"e":250.813,"text":"Every star—"},{"s":250.813,"e":251.995,"text":"Every soul—"},{"s":251.995,"e":255.542,"text":"If forever forgot everything we knew,"},{"s":255.542,"e":257.611,"text":"I'd meet you as a stranger…"},{"s":257.611,"e":258.86,"text":"And fall in love with you."}],"duration":260.92,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.134Z","realignedFrom":"whisper-aligned","vocalStart":1.94,"vocalEnd":258.78}