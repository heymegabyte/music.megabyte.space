ne":77},{"w":"Future-self","s":259.748,"e":261.047,"line":77},{"w":"/","s":261.047,"e":261.371,"line":77},{"w":"distant","s":261.371,"e":262.02,"line":77},{"w":"choir]**","s":262.02,"e":262.345,"line":77},{"w":"Maybe","s":262.345,"e":262.669,"line":78},{"w":"prayer","s":262.669,"e":262.994,"line":78},{"w":"is","s":262.994,"e":263.319,"line":78},{"w":"more","s":263.319,"e":263.643,"line":78},{"w":"than","s":263.643,"e":263.968,"line":78},{"w":"asking","s":263.968,"e":264.617,"line":78},{"w":"to","s":264.617,"e":264.941,"line":78},{"w":"be","s":264.941,"e":265.266,"line":78},{"w":"saved.","s":265.266,"e":265.915,"line":78},{"w":"Maybe","s":265.915,"e":266.24,"line":79},{"w":"sometimes","s":266.24,"e":267.538,"line":79},{"w":"prayer","s":267.538,"e":267.862,"line":79},{"w":"says:","s":267.862,"e":268.187,"line":79},{"w":"“Remember","s":268.187,"e":269.161,"line":80},{"w":"what","s":269.161,"e":269.485,"line":80},{"w":"You","s":269.485,"e":269.81,"line":80},{"w":"taught","s":269.81,"e":270.134,"line":80},{"w":"us—","s":270.134,"e":270.459,"line":80},{"w":"and","s":270.459,"e":270.783,"line":81},{"w":"we’ll","s":270.783,"e":271.108,"line":81},{"w":"remember","s":271.108,"e":272.082,"line":81},{"w":"too.”","s":272.082,"e":272.406,"line":81},{"w":"Grace","s":272.406,"e":272.731,"line":82},{"w":"under","s":272.731,"e":273.38,"line":82},{"w":"pressure.","s":273.38,"e":274.029,"line":82},{"w":"Grace","s":274.029,"e":274.353,"line":83},{"w":"with","s":274.353,"e":274.678,"line":83},{"w":"power.","s":274.678,"e":275.327,"line":83},{"w":"Grace","s":275.327,"e":275.652,"line":84},{"w":"when","s":275.652,"e":275.976,"line":84},{"w":"the","s":275.976,"e":276.301,"line":84},{"w":"whole","s":276.301,"e":276.625,"line":84},{"w":"sky","s":276.625,"e":276.95,"line":84},{"w":"shakes.","s":276.95,"e":277.599,"line":84},{"w":"That’s","s":277.599,"e":277.924,"line":85},{"w":"when","s":277.924,"e":278.248,"line":85},{"w":"grace","s":278.248,"e":278.573,"line":85},{"w":"becomes","s":278.573,"e":279.546,"line":85},{"w":"grace.","s":279.546,"e":279.63,"line":85}],"lines":[{"s":1.8,"e":4.396,"text":"**[Intro — Male Lead, sparse piano]**"},{"s":4.396,"e":8.291,"text":"If Heaven’s holy, why it feel like martial law?"},{"s":8.291,"e":12.186,"text":"Why mercy disappear the minute pressure calls?"},{"s":12.186,"e":16.405,"text":"I’m not asking for a throne, I’m asking what I saw—"},{"s":16.405,"e":20.949,"text":"If power means perfection, then perfection needs a pause."},{"s":20.949,"e":24.843,"text":"**[Verse 1 — Male Lead, controlled melodic rap]**"},{"s":24.843,"e":28.089,"text":"You taught us turn the cheek, tell truth, forgive,"},{"s":28.089,"e":31.659,"text":"Leave room for every wounded soul to live."},{"s":31.659,"e":35.554,"text":"But when the stakes rise high and the sirens start,"},{"s":35.554,"e":39.449,"text":"Does Heaven trade its halo for a harder heart?"},{"s":39.449,"e":43.668,"text":"Orders from above, everybody fall in line,"},{"s":43.668,"e":47.562,"text":"Sacred surveillance like the stars became the signs."},{"s":47.562,"e":50.808,"text":"Fear dressed as faith, force dressed as fate,"},{"s":50.808,"e":55.027,"text":"“Trust the greater plan” while they’re locking every gate."},{"s":55.027,"e":59.246,"text":"But leadership ain’t domination dressed in white,"},{"s":59.246,"e":63.141,"text":"Grace means keeping grace when you’re terrified at night."},{"s":63.141,"e":67.685,"text":"Anybody can be gentle when the garden’s going great—"},{"s":67.685,"e":71.58,"text":"Character gets counted when catastrophe awaits."},{"s":71.58,"e":75.474,"text":"**[Pre-Chorus — Female Vocal, piano rising]**"},{"s":75.474,"e":80.018,"text":"If love is really endless, let it live beneath the strain,"},{"s":80.018,"e":84.562,"text":"Let mercy keep its meaning when the whole sky screams in pain."},{"s":84.562,"e":89.755,"text":"We learned the lesson Heaven gave—now Heaven, do the same:"},{"s":89.755,"e":94.298,"text":"Power without compassion only magnifies the flame."},{"s":94.298,"e":98.193,"text":"**[Chorus — Male + Female, huge melodic lift]**"},{"s":98.193,"e":100.14,"text":"Maybe we can teach God grace,"},{"s":100.14,"e":102.412,"text":"Not with hate, but face to face."},{"s":102.412,"e":105.009,"text":"If Heaven feels like martial law,"},{"s":105.009,"e":107.605,"text":"Let love repeal the fear in all."},{"s":107.605,"e":110.526,"text":"Because half this world looks close to hell—"},{"s":110.526,"e":112.798,"text":"Children under bombs and shells,"},{"s":112.798,"e":116.368,"text":"Families erased, whole cities scarred—"},{"s":116.368,"e":118.64,"text":"How can “great” look this damn hard?"},{"s":118.64,"e":121.561,"text":"If You’re greater, then be greater still,"},{"s":121.561,"e":124.158,"text":"Choose mercy when You could choose will."},{"s":124.158,"e":126.754,"text":"No crown should make compassion small—"},{"s":126.754,"e":129.675,"text":"The highest power should love us all."},{"s":129.675,"e":132.272,"text":"**[Verse 2 — Male Lead, harder drums]**"},{"s":132.272,"e":136.166,"text":"Genocide beneath a blue and beautiful sky,"},{"s":136.166,"e":140.385,"text":"Mothers learning names they never should’ve had to cry."},{"s":140.385,"e":144.28,"text":"Mass graves, burned homes, borders drawn in blood,"},{"s":144.28,"e":148.175,"text":"While prayers rise upward through the ash and through the mud."},{"s":148.175,"e":152.719,"text":"So forgive the question if the question comes severe:"},{"s":152.719,"e":156.938,"text":"If God is truly greatness, why’s creation drowning here?"},{"s":156.938,"e":161.806,"text":"Not saying every tragedy was authored by Your hand—"},{"s":161.806,"e":167.324,"text":"I’m saying unexplained suffering deserves more than “understand.”"},{"s":167.324,"e":171.218,"text":"Maybe freedom has a cost, maybe humans make the blade,"},{"s":171.218,"e":175.437,"text":"Maybe Heaven doesn’t cause each evil choice that people make."},{"s":175.438,"e":180.306,"text":"Still, if You can lead the leaders, if You whisper through the dark,"},{"s":180.306,"e":185.823,"text":"Teach restraint before revenge becomes somebody’s sacred spark."},{"s":185.823,"e":189.069,"text":"**[Bridge — Nearly silent, female vocal]**"},{"s":189.069,"e":192.964,"text":"We don’t need perfection proved through punishment."},{"s":192.964,"e":197.183,"text":"We need power brave enough to practice tenderness."},{"s":197.183,"e":199.13,"text":"No manipulation."},{"s":199.13,"e":201.402,"text":"No coercion dressed as care."},{"s":201.402,"e":205.621,"text":"No “greater good” that makes the innocent despair."},{"s":205.621,"e":206.521,"text":"**[Male Lead]**"},{"s":206.521,"e":209.118,"text":"You told us love our enemies."},{"s":209.118,"e":210.416,"text":"We listened."},{"s":210.416,"e":212.363,"text":"You told us mercy triumphs."},{"s":212.363,"e":213.986,"text":"We remembered."},{"s":213.986,"e":216.582,"text":"You told us pride can poison kings."},{"s":216.582,"e":219.179,"text":"So if Heaven ever trembles—"},{"s":219.179,"e":220.477,"text":"remember too."},{"s":220.477,"e":224.372,"text":"**[Final Chorus — Orchestra, choir, massive drums]**"},{"s":224.372,"e":226.319,"text":"Maybe we can teach God grace,"},{"s":226.319,"e":228.591,"text":"Hold the mirror, hold our place."},{"s":228.591,"e":231.187,"text":"If Heaven feels like martial law,"},{"s":231.187,"e":233.784,"text":"Let mercy be the higher law."},{"s":233.784,"e":236.38,"text":"When half the earth resembles hell,"},{"s":236.38,"e":239.301,"text":"We don’t look away, we break the spell."},{"s":239.301,"e":241.573,"text":"Feed the hungry, stop the guns,"},{"s":241.573,"e":243.845,"text":"Count each stranger as someone."},{"s":243.845,"e":246.766,"text":"If You’re greater, show what greater means:"},{"s":246.766,"e":249.038,"text":"Less control and cleaner hands,"},{"s":249.038,"e":251.959,"text":"More forgiveness, fewer demands,"},{"s":251.959,"e":254.88,"text":"Truth without terror, strength without chains—"},{"s":254.88,"e":258.775,"text":"A God who keeps His grace when everything strains."},{"s":258.775,"e":262.345,"text":"**[Outro — Future-self / distant choir]**"},{"s":262.345,"e":265.915,"text":"Maybe prayer is more than asking to be saved."},{"s":265.915,"e":268.187,"text":"Maybe sometimes prayer says:"},{"s":268.187,"e":270.459,"text":"“Remember what You taught us—"},{"s":270.459,"e":272.406,"text":"and we’ll remember too.”"},{"s":272.406,"e":274.029,"text":"Grace under pressure."},{"s":274.029,"e":275.327,"text":"Grace with power."},{"s":275.327,"e":277.599,"text":"Grace when the whole sky shakes."},{"s":277.599,"e":279.63,"text":"That’s when grace becomes grace."}],"duration":282.44,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:14.136Z","realignedFrom":"whisper-aligned","vocalStart":1.8,"vocalEnd":279.62}