  "lines": [
    {
      "s": 24.22,
      "e": 28.91,
      "text": "I closed my eyes and walked backward through time,"
    },
    {
      "s": 28.91,
      "e": 33.209,
      "text": "Past every thought I had claimed was mine,"
    },
    {
      "s": 33.209,
      "e": 37.117,
      "text": "Past little fears with their teeth in a row,"
    },
    {
      "s": 37.117,
      "e": 41.416,
      "text": "Past names I forgot I was trying to know."
    },
    {
      "s": 41.416,
      "e": 45.324,
      "text": "I went so far where the memories thin,"
    },
    {
      "s": 45.324,
      "e": 49.233,
      "text": "Where the walls turn soft and the lights cave in,"
    },
    {
      "s": 49.233,
      "e": 53.141,
      "text": "I reached the place where the first dream grew,"
    },
    {
      "s": 53.141,
      "e": 57.44,
      "text": "Then somebody behind me whispered—"
    },
    {
      "s": 57.44,
      "e": 58.34,
      "text": "“Boo.”"
    },
    {
      "s": 58.34,
      "e": 61.076,
      "text": "Boo from the back of my mind,"
    },
    {
      "s": 61.076,
      "e": 64.593,
      "text": "Something old but alive inside,"
    },
    {
      "s": 64.593,
      "e": 68.892,
      "text": "I turned around but there was no one there,"
    },
    {
      "s": 68.892,
      "e": 73.191,
      "text": "Just my own little ghost in a folding chair."
    },
    {
      "s": 73.191,
      "e": 75.927,
      "text": "Boo from the back of my soul,"
    },
    {
      "s": 75.927,
      "e": 79.444,
      "text": "Like the dark had learned rock and roll,"
    },
    {
      "s": 79.444,
      "e": 83.743,
      "text": "I laughed so hard that the fear laughed too,"
    },
    {
      "s": 83.743,
      "e": 87.261,
      "text": "When the thing behind my thinking said,"
