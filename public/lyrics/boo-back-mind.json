:52},{"w":"and","s":184.06,"e":184.26,"line":52},{"w":"I","s":184.26,"e":184.78,"line":52},{"w":"made","s":184.78,"e":184.86,"line":52},{"w":"it","s":184.84,"e":185.24,"line":52},{"w":"through,","s":185.24,"e":185.54,"line":52},{"w":"With","s":185.54,"e":185.8,"line":53},{"w":"the","s":185.8,"e":186.04,"line":53},{"w":"thing","s":186.04,"e":186.18,"line":53},{"w":"behind","s":186.18,"e":186.5,"line":53},{"w":"my","s":186.5,"e":186.8,"line":53},{"w":"thinking","s":186.8,"e":187.04,"line":53},{"w":"saying,","s":187.04,"e":187.48,"line":53},{"w":"“Boo.”","s":203.38,"e":204.78,"line":54}],"lines":[{"s":24.22,"e":28.18,"text":"I closed my eyes and walked backward through time,"},{"s":28.18,"e":31.3,"text":"Past every thought I had claimed was mine,"},{"s":31.3,"e":33.96,"text":"Past little fears with their teeth in a row,"},{"s":33.96,"e":37.12,"text":"Past names I forgot I was trying to know."},{"s":37.12,"e":40.24,"text":"I went so far where the memories thin,"},{"s":40.24,"e":43.44,"text":"Where the walls turn soft and the lights cave in,"},{"s":43.44,"e":46.44,"text":"I reached the place where the first dream grew,"},{"s":46.44,"e":49.32,"text":"Then somebody behind me whispered—"},{"s":49.32,"e":49.64,"text":"“Boo.”"},{"s":50.54,"e":53.8,"text":"Boo from the back of my mind,"},{"s":53.82,"e":56.82,"text":"Something old but alive inside,"},{"s":56.82,"e":59.56,"text":"I turned around but there was no one there,"},{"s":59.56,"e":63,"text":"Just my own little ghost in a folding chair."},{"s":63.06,"e":66.06,"text":"Boo from the back of my soul,"},{"s":66.06,"e":68.76,"text":"Like the dark had learned rock and roll,"},{"s":68.76,"e":71.82,"text":"I laughed so hard that the fear laughed too,"},{"s":71.82,"e":73.74,"text":"When the thing behind my thinking said,"},{"s":74.94,"e":75.62,"text":"“Boo.”"},{"s":80.34,"e":84,"text":"I said, “Who’s there?” and the silence grinned,"},{"s":84,"e":87.26,"text":"Like it knew every door I had ever been in,"},{"s":87.26,"e":90.34,"text":"It wore my voice but a stranger’s shoes,"},{"s":90.26,"e":93.36,"text":"Said, “I’ve been waiting in here for you.”"},{"s":93.36,"e":95.7,"text":"Not a demon, not a dream, not a curse,"},{"s":95.62,"e":99.06,"text":"Just the punchline hiding at the edge of the universe,"},{"s":99.06,"e":102.64,"text":"I was digging for wisdom, ancient and true,"},{"s":102.64,"e":104.54,"text":"And all I got back was—"},{"s":104.62,"e":104.84,"text":"“Boo.”"},{"s":104.92,"e":109.2,"text":"Boo from the back of my mind,"},{"s":109.2,"e":112.16,"text":"Something old but alive inside,"},{"s":112.16,"e":114.9,"text":"I turned around but there was no one there,"},{"s":114.9,"e":118.34,"text":"Just my own little ghost in a folding chair."},{"s":118.46,"e":121.42,"text":"Boo from the back of my soul,"},{"s":121.42,"e":124.18,"text":"Like the dark had learned rock and roll,"},{"s":124.18,"e":127.16,"text":"I laughed so hard that the fear laughed too,"},{"s":127.16,"e":129.1,"text":"When the thing behind my thinking said,"},{"s":130.36,"e":131.04,"text":"“Boo.”"},{"s":135.66,"e":139,"text":"Maybe the mind is a haunted house,"},{"s":139,"e":141.9,"text":"Maybe the self is a tiny mouse,"},{"s":141.9,"e":145.1,"text":"Maybe the truth wears a bedsheet crown,"},{"s":145.14,"e":148.62,"text":"Jumping out when you finally sit down."},{"s":148.62,"e":151.76,"text":"So I bowed to the ghost in the back of my head,"},{"s":151.76,"e":154.9,"text":"Said, “You scared me once, but you’re not the dead.”"},{"s":154.9,"e":157.86,"text":"It tipped its hat like it always knew,"},{"s":158.9,"e":160.78,"text":"And whispered softer—"},{"s":162.74,"e":162.92,"text":"“Boo.”"},{"s":164.48,"e":167.76,"text":"Boo from the back of my mind,"},{"s":167.76,"e":170.2,"text":"Oldest joke in the oldest shrine,"},{"s":170.2,"e":173.28,"text":"I went looking for God in the deepest blue,"},{"s":173.28,"e":175.3,"text":"And God jumped out like—"},{"s":176.58,"e":176.76,"text":"“Boo.”"},{"s":176.86,"e":179.76,"text":"Boo from the back of my soul,"},{"s":179.76,"e":182.64,"text":"Now the fear don’t own control,"},{"s":182.64,"e":185.54,"text":"I walked to the edge and I made it through,"},{"s":185.54,"e":187.48,"text":"With the thing behind my thinking saying,"},{"s":203.38,"e":204.78,"text":"“Boo.”"}],"duration":204.8,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.409Z","stats":{"whisperWords":392,"polishedWords":385,"matched":377,"matchRate":0.979}}