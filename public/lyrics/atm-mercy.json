nk","s":174.86,"e":174.94,"line":46},{"w":"and","s":174.94,"e":175.46,"line":46},{"w":"pass","s":175.46,"e":175.86,"line":46},{"w":"it","s":175.86,"e":176.4,"line":46},{"w":"through","s":176.4,"e":176.52,"line":46},{"w":"the","s":176.52,"e":177.18,"line":46},{"w":"crowd.","s":177.18,"e":177.26,"line":46},{"w":"No","s":177.18,"e":177.68,"line":47},{"w":"crown,","s":177.68,"e":178.02,"line":47},{"w":"no","s":178.02,"e":178.56,"line":47},{"w":"stage,","s":178.56,"e":179.06,"line":47},{"w":"no","s":179.06,"e":179.48,"line":47},{"w":"need","s":179.48,"e":179.9,"line":47},{"w":"to","s":179.9,"e":180.18,"line":47},{"w":"be","s":180.18,"e":180.62,"line":47},{"w":"known—","s":180.62,"e":180.86,"line":47},{"w":"Just","s":180.86,"e":181.78,"line":48},{"w":"don’t","s":181.78,"e":182,"line":48},{"w":"let","s":182.22,"e":182.54,"line":48},{"w":"a","s":182.54,"e":182.9,"line":48},{"w":"hungry","s":182.9,"e":183.06,"line":48},{"w":"soul","s":183.06,"e":183.56,"line":48},{"w":"stand","s":183.56,"e":184.4,"line":48},{"w":"alone.","s":184.4,"e":185.2,"line":48}],"lines":[{"s":12.12,"e":16.36,"text":"A couple dollars in the cup, yeah, that’s cool,"},{"s":16.36,"e":19.78,"text":"But sometimes love gotta break its own rules."},{"s":19.78,"e":23.38,"text":"Not just spare change from the bottom of jeans,"},{"s":23.38,"e":27.18,"text":"But a real-life answer to somebody’s needs."},{"s":27.18,"e":31.72,"text":"You see a man in the cold with the world on his back,"},{"s":31.72,"e":35.18,"text":"And your heart says, “Don’t just walk past that.”"},{"s":35.18,"e":38.84,"text":"There’s a bank on the corner, a chance in your hand,"},{"s":38.84,"e":42.72,"text":"Go pull out mercy, let it rain where he stands."},{"s":42.72,"e":46.52,"text":"Go to the ATM, unload a little grace,"},{"s":46.52,"e":50.08,"text":"Put some hope back in a forgotten face."},{"s":50.08,"e":53.72,"text":"Not for the camera, not for applause,"},{"s":53.72,"e":57.14,"text":"Just love in motion, just because."},{"s":57.14,"e":60.5,"text":"A few dollars is kind, but every now and then,"},{"s":60.5,"e":63.86,"text":"Be the miracle that shows up again."},{"s":63.86,"e":67.5,"text":"When heaven moves, it don’t always glow—"},{"s":67.5,"e":71.08,"text":"Sometimes it’s cash in a hand in the snow."},{"s":71.08,"e":75.56,"text":"Don’t ask too many questions like you own their pain,"},{"s":75.56,"e":79.1,"text":"Don’t make them prove they deserve the rain."},{"s":79.44,"e":82.8,"text":"Everybody’s fighting something you can’t see,"},{"s":82.8,"e":86.08,"text":"Everybody’s one bad month from the street."},{"s":86.06,"e":87.346,"text":"Give with wisdom, give with heart,"},{"s":87.56,"e":90.54,"text":"Give like the world can still restart."},{"s":90.54,"e":93.38,"text":"Food, socks, shelter, twenty, fifty, more—"},{"s":93.38,"e":97.38,"text":"Sometimes God is waiting at the ATM door."},{"s":97.38,"e":101.06,"text":"Go to the ATM, unload a little grace,"},{"s":101.06,"e":104.58,"text":"Put some hope back in a forgotten face."},{"s":104.58,"e":108.14,"text":"Not for the camera, not for applause,"},{"s":108.14,"e":111.44,"text":"Just love in motion, just because."},{"s":111.44,"e":115.02,"text":"A few dollars is kind, but every now and then,"},{"s":115.02,"e":118.32,"text":"Be the miracle that shows up again."},{"s":118.32,"e":121.92,"text":"When heaven moves, it don’t always glow—"},{"s":121.92,"e":125.42,"text":"Sometimes it’s cash in a hand in the snow."},{"s":125.42,"e":130.54,"text":"No lecture, no judgment, no holy disguise,"},{"s":130.54,"e":134.18,"text":"Just look another human being straight in the eyes."},{"s":134.18,"e":137.38,"text":"Say, “I hope this helps you make it through,”"},{"s":137.38,"e":140.6,"text":"Then let the blessing bless you too."},{"s":140.6,"e":141.217,"text":"Final Chorus"},{"s":141.217,"e":144.74,"text":"Go to the ATM, unload a little grace,"},{"s":144.74,"e":147.513,"text":"Put some hope back in a forgotten face."},{"s":147.86,"e":151.3,"text":"Friends get fed, family too,"},{"s":151.3,"e":154.76,"text":"But strangers need miracles coming through."},{"s":154.76,"e":158.233,"text":"A few dollars is kind, but every now and then,"},{"s":158.58,"e":162.06,"text":"Give like the world can become good again."},{"s":162.06,"e":165.56,"text":"When heaven moves, it don’t always glow—"},{"s":165.56,"e":168.96,"text":"Sometimes it’s cash in a hand in the snow."},{"s":169.62,"e":173.36,"text":"Spare change is cool, but love can be loud,"},{"s":173.36,"e":177.26,"text":"Pull it from the bank and pass it through the crowd."},{"s":177.18,"e":180.86,"text":"No crown, no stage, no need to be known—"},{"s":180.86,"e":185.2,"text":"Just don’t let a hungry soul stand alone."}],"duration":212.68,"source":"whisper-aligned","generatedAt":"2026-08-29T02:49:44.392Z","stats":{"whisperWords":385,"polishedWords":404,"matched":362,"matchRate":0.896}}