w":"love","s":171.83,"e":172.23,"line":51},{"w":"can","s":172.23,"e":172.67,"line":51},{"w":"be","s":172.67,"e":172.95,"line":51},{"w":"loud,","s":172.95,"e":173.35,"line":51},{"w":"Pull","s":173.35,"e":173.87,"line":52},{"w":"it","s":173.87,"e":174.07,"line":52},{"w":"from","s":174.07,"e":174.27,"line":52},{"w":"the","s":174.27,"e":174.77,"line":52},{"w":"bank","s":174.77,"e":174.89,"line":52},{"w":"and","s":174.89,"e":175.47,"line":52},{"w":"pass","s":175.47,"e":175.89,"line":52},{"w":"it","s":175.89,"e":176.37,"line":52},{"w":"through","s":176.37,"e":176.55,"line":52},{"w":"the","s":176.55,"e":177.23,"line":52},{"w":"crowd.","s":177.23,"e":177.31,"line":52},{"w":"No","s":177.23,"e":177.69,"line":53},{"w":"crown,","s":177.69,"e":178.03,"line":53},{"w":"no","s":178.03,"e":178.55,"line":53},{"w":"stage,","s":178.55,"e":179.05,"line":53},{"w":"no","s":179.05,"e":179.47,"line":53},{"w":"need","s":179.47,"e":179.91,"line":53},{"w":"to","s":179.91,"e":180.21,"line":53},{"w":"be","s":180.21,"e":180.49,"line":53},{"w":"known—","s":180.49,"e":181.07,"line":53},{"w":"Just","s":181.07,"e":181.77,"line":54},{"w":"don’t","s":181.77,"e":182.02,"line":54},{"w":"let","s":182.27,"e":182.53,"line":54},{"w":"a","s":182.53,"e":182.91,"line":54},{"w":"hungry","s":182.91,"e":183.05,"line":54},{"w":"soul","s":183.05,"e":183.71,"line":54},{"w":"stand","s":183.71,"e":184.37,"line":54},{"w":"alone.","s":184.37,"e":185.81,"line":54}],"lines":[{"s":0,"e":5.64,"text":"Verse 1"},{"s":5.64,"e":16.36,"text":"A couple dollars in the cup, yeah, that’s cool,"},{"s":16.36,"e":19.8,"text":"But sometimes love gotta break its own rules."},{"s":19.8,"e":23.38,"text":"Not just spare change from the bottom of jeans,"},{"s":23.38,"e":27.22,"text":"But a real-life answer to somebody’s needs."},{"s":27.2,"e":31.72,"text":"You see a man in the cold with the world on his back,"},{"s":31.72,"e":35.16,"text":"And your heart says, “Don’t just walk past that.”"},{"s":35.16,"e":38.84,"text":"There’s a bank on the corner, a chance in your hand,"},{"s":38.84,"e":42.72,"text":"Go pull out mercy, let it rain where he stands."},{"s":42.72,"e":42.8,"text":"Chorus"},{"s":42.72,"e":46.52,"text":"Go to the ATM, unload a little grace,"},{"s":46.52,"e":50.08,"text":"Put some hope back in a forgotten face."},{"s":50.08,"e":53.72,"text":"Not for the camera, not for applause,"},{"s":53.72,"e":57.14,"text":"Just love in motion, just because."},{"s":57.14,"e":60.5,"text":"A few dollars is kind, but every now and then,"},{"s":60.5,"e":63.86,"text":"Be the miracle that shows up again."},{"s":63.86,"e":67.5,"text":"When heaven moves, it don’t always glow—"},{"s":67.5,"e":71.08,"text":"Sometimes it’s cash in a hand in the snow."},{"s":71.08,"e":71.16,"text":"Verse 2"},{"s":71.08,"e":75.56,"text":"Don’t ask too many questions like you own their pain,"},{"s":75.56,"e":78.34,"text":"Don’t make them prove they deserve the rain."},{"s":78.34,"e":82.84,"text":"Everybody’s fighting something you can’t see,"},{"s":82.84,"e":86.18,"text":"Everybody’s one bad month from the street."},{"s":87.14,"e":88.68,"text":"Give with wisdom, give with heart,"},{"s":88.68,"e":90.48,"text":"Give like the world can still restart."},{"s":90.48,"e":93.22,"text":"Food, socks, shelter, twenty, fifty, more—"},{"s":93.22,"e":96.99,"text":"Sometimes God is waiting at the ATM door."},{"s":96.99,"e":97.07,"text":"Chorus"},{"s":96.99,"e":101.03,"text":"Go to the ATM, unload a little grace,"},{"s":101.03,"e":104.57,"text":"Put some hope back in a forgotten face."},{"s":104.57,"e":108.11,"text":"Not for the camera, not for applause,"},{"s":108.11,"e":111.43,"text":"Just love in motion, just because."},{"s":111.43,"e":115.09,"text":"A few dollars is kind, but every now and then,"},{"s":115.09,"e":118.29,"text":"Be the miracle that shows up again."},{"s":118.29,"e":121.93,"text":"When heaven moves, it don’t always glow—"},{"s":121.93,"e":125.53,"text":"Sometimes it’s cash in a hand in the snow."},{"s":125.53,"e":125.61,"text":"Bridge"},{"s":125.53,"e":130.51,"text":"No lecture, no judgment, no holy disguise,"},{"s":130.51,"e":134.17,"text":"Just look another human being straight in the eyes."},{"s":134.17,"e":137.29,"text":"Say, “I hope this helps you make it through,”"},{"s":137.29,"e":140.67,"text":"Then let the blessing bless you too."},{"s":140.67,"e":140.75,"text":"Final Chorus"},{"s":140.67,"e":144.59,"text":"Go to the ATM, unload a little grace,"},{"s":144.59,"e":148.15,"text":"Put some hope back in a forgotten face."},{"s":148.15,"e":151.33,"text":"Friends get fed, family too,"},{"s":151.33,"e":154.83,"text":"But strangers need miracles coming through."},{"s":154.83,"e":158.67,"text":"A few dollars is kind, but every now and then,"},{"s":158.67,"e":162.05,"text":"Give like the world can become good again."},{"s":162.05,"e":165.49,"text":"When heaven moves, it don’t always glow—"},{"s":165.49,"e":169.07,"text":"Sometimes it’s cash in a hand in the snow."},{"s":169.07,"e":169.15,"text":"Outro"},{"s":169.07,"e":173.35,"text":"Spare change is cool, but love can be loud,"},{"s":173.35,"e":177.31,"text":"Pull it from the bank and pass it through the crowd."},{"s":177.23,"e":181.07,"text":"No crown, no stage, no need to be known—"},{"s":181.07,"e":185.81,"text":"Just don’t let a hungry soul stand alone."}],"duration":212.68,"source":"whisper-aligned","generatedAt":"2026-06-17T12:24:27.147Z","stats":{"whisperWords":411,"polishedWords":412,"matched":382,"matchRate":0.927}}