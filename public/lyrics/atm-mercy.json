,"s":170.695,"e":171.063,"line":44},{"w":"snow.","s":171.063,"e":171.432,"line":44},{"w":"Spare","s":171.432,"e":171.801,"line":45},{"w":"change","s":171.801,"e":172.169,"line":45},{"w":"is","s":172.169,"e":172.538,"line":45},{"w":"cool,","s":172.538,"e":172.907,"line":45},{"w":"but","s":172.907,"e":173.275,"line":45},{"w":"love","s":173.275,"e":173.644,"line":45},{"w":"can","s":173.644,"e":174.013,"line":45},{"w":"be","s":174.013,"e":174.381,"line":45},{"w":"loud,","s":174.381,"e":174.75,"line":45},{"w":"Pull","s":174.75,"e":175.119,"line":46},{"w":"it","s":175.119,"e":175.487,"line":46},{"w":"from","s":175.487,"e":175.856,"line":46},{"w":"the","s":175.856,"e":176.225,"line":46},{"w":"bank","s":176.225,"e":176.593,"line":46},{"w":"and","s":176.593,"e":176.962,"line":46},{"w":"pass","s":176.962,"e":177.331,"line":46},{"w":"it","s":177.331,"e":177.699,"line":46},{"w":"through","s":177.699,"e":178.068,"line":46},{"w":"the","s":178.068,"e":178.437,"line":46},{"w":"crowd.","s":178.437,"e":178.805,"line":46},{"w":"No","s":178.805,"e":179.174,"line":47},{"w":"crown,","s":179.174,"e":179.543,"line":47},{"w":"no","s":179.543,"e":179.911,"line":47},{"w":"stage,","s":179.911,"e":180.28,"line":47},{"w":"no","s":180.28,"e":180.649,"line":47},{"w":"need","s":180.649,"e":181.017,"line":47},{"w":"to","s":181.017,"e":181.386,"line":47},{"w":"be","s":181.386,"e":181.755,"line":47},{"w":"known—","s":181.755,"e":182.123,"line":47},{"w":"Just","s":182.123,"e":182.492,"line":48},{"w":"don’t","s":182.492,"e":182.861,"line":48},{"w":"let","s":182.861,"e":183.229,"line":48},{"w":"a","s":183.229,"e":183.598,"line":48},{"w":"hungry","s":183.598,"e":184.335,"line":48},{"w":"soul","s":184.335,"e":184.704,"line":48},{"w":"stand","s":184.704,"e":185.073,"line":48},{"w":"alone.","s":185.073,"e":185.81,"line":48}],"lines":[{"s":0,"e":4.055,"text":"A couple dollars in the cup, yeah, that’s cool,"},{"s":4.055,"e":8.848,"text":"But sometimes love gotta break its own rules."},{"s":8.848,"e":12.535,"text":"Not just spare change from the bottom of jeans,"},{"s":12.535,"e":16.959,"text":"But a real-life answer to somebody’s needs."},{"s":16.959,"e":21.752,"text":"You see a man in the cold with the world on his back,"},{"s":21.752,"e":25.07,"text":"And your heart says, “Don’t just walk past that.”"},{"s":25.07,"e":29.862,"text":"There’s a bank on the corner, a chance in your hand,"},{"s":29.862,"e":33.918,"text":"Go pull out mercy, let it rain where he stands."},{"s":33.918,"e":37.604,"text":"Go to the ATM, unload a little grace,"},{"s":37.604,"e":41.291,"text":"Put some hope back in a forgotten face."},{"s":41.291,"e":44.978,"text":"Not for the camera, not for applause,"},{"s":44.978,"e":47.927,"text":"Just love in motion, just because."},{"s":47.927,"e":52.72,"text":"A few dollars is kind, but every now and then,"},{"s":52.72,"e":56.407,"text":"Be the miracle that shows up again."},{"s":56.407,"e":60.093,"text":"When heaven moves, it don’t always glow—"},{"s":60.093,"e":64.517,"text":"Sometimes it’s cash in a hand in the snow."},{"s":64.517,"e":68.941,"text":"Don’t ask too many questions like you own their pain,"},{"s":68.941,"e":72.259,"text":"Don’t make them prove they deserve the rain."},{"s":72.259,"e":77.052,"text":"Everybody’s fighting something you can’t see,"},{"s":77.052,"e":81.108,"text":"Everybody’s one bad month from the street."},{"s":81.108,"e":83.688,"text":"Give with wisdom, give with heart,"},{"s":83.688,"e":86.638,"text":"Give like the world can still restart."},{"s":86.638,"e":89.956,"text":"Food, socks, shelter, twenty, fifty, more—"},{"s":89.956,"e":94.38,"text":"Sometimes God is waiting at the ATM door."},{"s":94.38,"e":98.066,"text":"Go to the ATM, unload a little grace,"},{"s":98.066,"e":101.753,"text":"Put some hope back in a forgotten face."},{"s":101.753,"e":105.44,"text":"Not for the camera, not for applause,"},{"s":105.44,"e":108.389,"text":"Just love in motion, just because."},{"s":108.389,"e":113.182,"text":"A few dollars is kind, but every now and then,"},{"s":113.182,"e":116.869,"text":"Be the miracle that shows up again."},{"s":116.869,"e":120.555,"text":"When heaven moves, it don’t always glow—"},{"s":120.555,"e":124.979,"text":"Sometimes it’s cash in a hand in the snow."},{"s":124.979,"e":129.035,"text":"No lecture, no judgment, no holy disguise,"},{"s":129.035,"e":133.459,"text":"Just look another human being straight in the eyes."},{"s":133.459,"e":136.777,"text":"Say, “I hope this helps you make it through,”"},{"s":136.777,"e":139.726,"text":"Then let the blessing bless you too."},{"s":139.726,"e":141.201,"text":"Final Chorus"},{"s":141.201,"e":144.888,"text":"Go to the ATM, unload a little grace,"},{"s":144.888,"e":148.574,"text":"Put some hope back in a forgotten face."},{"s":148.574,"e":151.155,"text":"Friends get fed, family too,"},{"s":151.155,"e":154.842,"text":"But strangers need miracles coming through."},{"s":154.842,"e":159.634,"text":"A few dollars is kind, but every now and then,"},{"s":159.634,"e":163.321,"text":"Give like the world can become good again."},{"s":163.321,"e":167.008,"text":"When heaven moves, it don’t always glow—"},{"s":167.008,"e":171.432,"text":"Sometimes it’s cash in a hand in the snow."},{"s":171.432,"e":174.75,"text":"Spare change is cool, but love can be loud,"},{"s":174.75,"e":178.805,"text":"Pull it from the bank and pass it through the crowd."},{"s":178.805,"e":182.123,"text":"No crown, no stage, no need to be known—"},{"s":182.123,"e":185.81,"text":"Just don’t let a hungry soul stand alone."}],"duration":212.68,"source":"curated-realigned","generatedAt":"2026-08-21T00:55:13.852Z","realignedFrom":"whisper-aligned","vocalStart":0,"vocalEnd":185.81}